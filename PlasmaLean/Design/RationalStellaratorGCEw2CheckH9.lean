/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw2CheckH9`)

The checks of `Design/RationalStellaratorGCEw2CheckH9` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE2`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `q`: truncation norm. -/
theorem kHE2S_q : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_q (1 : Int) 1 0 46 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `q`: a priori `ℓ¹` bound. -/
theorem lHE2_q : nodeL1N SHE2 LHE2 trHE2N_q (1 : Int) 1 0 46 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
