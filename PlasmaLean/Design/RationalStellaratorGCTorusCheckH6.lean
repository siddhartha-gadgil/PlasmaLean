module

public import PlasmaLean.Design.RationalStellaratorGCTorusTreesH

/-!
# Kernel checks of the guiding-centre torus certificate (high resolution, part 6)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the data of
`Design/RationalStellaratorGCTorusDataH*`: the weighted digit sums (`nodeK`, `normK`, `centerK` of
`Certificates/KronBallGrid`) of the Kronecker images of the truncation polynomials of the ball
pipeline, and their a priori `ℓ¹` bounds. Generated by `scripts/gc_kam/emit_lean.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `thZ`. -/
theorem cH_thZ : centerK NH MH KvH 9 132 81 7 6 40 30 ≤  := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thZ`. -/
theorem clH_thZ : LH 9 < 2 ^ (132 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m41`. -/
theorem cH_m41 : centerK NH MH KvH 25 127 81 7 6 40 30 ≤  := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m41`. -/
theorem clH_m41 : LH 25 < 2 ^ (127 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `PuP`. -/
theorem cH_PuP : centerK NH MH KvH 41 127 81 7 6 40 30 ≤  := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `PuP`. -/
theorem clH_PuP : LH 41 < 2 ^ (127 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `R2`. -/
theorem cH_R2 : centerK NH MH KvH 57 127 81 7 6 40 30 ≤  := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `R2`. -/
theorem clH_R2 : LH 57 < 2 ^ (127 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `dB`. -/
theorem kH_dB : normK NH MH WtH KvH trH_dB (1, 0, 0) 141 81 7 6 60 40 30 ≤  := by
  decide +kernel

/-- Kernel check of the norm node `dB`: a priori `ℓ¹` bound. -/
theorem lH_dB : Ex.majN LH trH_dB < 2 ^ (141 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the node `Dp`: truncation norm. -/
theorem kH_Dp : nodeK SH NH MH WtH KvH trH_Dp (8 : ℤ) 0 1 29 134 81 7 6 62 40 31 ≤  := by
  decide +kernel

/-- Kernel check of the node `Dp`: a priori `ℓ¹` bound. -/
theorem lH_Dp : nodeL1 SH LH trH_Dp (8 : ℤ) 0 1 29 < 2 ^ (134 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the node `RDph`: truncation norm. -/
theorem kH_RDph : nodeK SH NH MH WtH KvH trH_RDph (1 : ℤ) 1 0 45 251 161 8 7 120 80 60 ≤  := by
  decide +kernel

/-- Kernel check of the node `RDph`: a priori `ℓ¹` bound. -/
theorem lH_RDph : nodeL1 SH LH trH_RDph (1 : ℤ) 1 0 45 < 2 ^ (251 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the node `A2`: truncation norm. -/
theorem kH_A2 : nodeK SH NH MH WtH KvH trH_A2 (1 : ℤ) 1 0 60 251 161 8 7 120 80 60 ≤  := by
  decide +kernel

/-- Kernel check of the node `A2`: a priori `ℓ¹` bound. -/
theorem lH_A2 : nodeL1 SH LH trH_A2 (1 : ℤ) 1 0 60 < 2 ^ (251 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
