/-!
# The high-resolution environment of the guiding-centre torus family certificate

The variable polynomials `PHF i` (three variables: `θ`-, `ψ`-modes and the Chebyshev variable
`w`), their degree boxes (`boxHF`), static `ℓ¹` bounds (`l1HF`) and Kronecker images (`kronHF`);
the family centres `xHF c i` at the parameter `w = c`; the norm bounds `BHF i` of the centres and
the radii `EHF i` of the balls (supplied by the oracle, checked in
`Design/RationalStellaratorGCFamCheckH*`).
Generated by `scripts/gc_kam/fam_emit_lean.py`.
-/

@[expose] public section
noncomputable section

set_option linter.style.longLine false

namespace PlasmaLean.Design.RationalStellaratorGC

open Polynomial PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall PlasmaLean.Certificates.KronBallCheb PlasmaLean.Theory.KAM

/-- **The variable polynomials** of the family pipeline (by kind, `kindHF`). -/
def PHF (i : ℕ) : P3 :=
  match kindHF i with
  | 0 => T3 SHF NHF MHF DHF
  | 1 => V3
  | 2 => C cPoly
  | 3 => C sPoly
  | 4 => Pr3 SHF NHF MHF DHF
  | 5 => 0
  | _ => famPoly NHF MHF DHF (if oddHF i then -1 else 1) (c0HF i : ℤ) 0 0 0 (famHF i)

/-- The kinds are at most `6`. -/
theorem kindHF_le (i : ℕ) : kindHF i ≤ 6 :=
  getD_prop (Pr := fun k : ℕ => k ≤ 6) (by kernel_fact) (by kernel_fact) i

/-- The variables beyond the last have kind `5` (zero). -/
theorem kindHF_ge {i : ℕ} (h : 78 ≤ i) : kindHF i = 5 := by
  unfold kindHF
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp [kindHFl]; omega)]
  rfl

/-- Stored families are below the last variable. -/
theorem lt_of_kindHF {i : ℕ} (h : kindHF i = 6) : i < 78 := by
  by_contra h'
  rw [kindHF_ge (by omega)] at h
  exact absurd h (by kernel_fact)

set_option maxRecDepth 100000 in
/-- The static conditions of the stored families. -/
theorem staticHF : ∀ i, i < 78 → kindHF i = 6 →
    FamStatic NHF MHF DHF ddHF drHF dwHF (famHF i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The minimal widths of the fast images. -/
theorem dynHF : ∀ i, i < 78 → kindHF i = 6 →
    FamDyn (bMinHF i) (wMinHF i) (c0HF i) (famHF i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The static `ℓ¹` bounds of the stored families. -/
theorem l1famHF : ∀ i, i < 78 → kindHF i = 6 →
    famL1 NHF MHF (c0HF i : ℤ) 0 0 0 (famHF i) ≤ LHF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree boxes of the stored families. -/
theorem bx6HF : ∀ i, i < 78 → kindHF i = 6 → BxHF i = (2 * NHF, 2 * MHF, 2 * DHF) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `t`. -/
theorem bx0HF : ∀ i, i < 78 → kindHF i = 0 → BxHF i = (NHF, MHF, DHF) ∧ 2 ^ SHF ≤ LHF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `V`. -/
theorem bx1HF : ∀ i, i < 78 → kindHF i = 1 → BxHF i = (0, 1, 0) ∧ 2 ≤ LHF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `cos 2φ`. -/
theorem bx2HF : ∀ i, i < 78 → kindHF i = 2 → BxHF i = (0, 2, 0) ∧ 2 ≤ LHF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `sin 2φ`. -/
theorem bx3HF : ∀ i, i < 78 → kindHF i = 3 → BxHF i = (0, 2, 0) ∧ 2 ≤ LHF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of the parameter. -/
theorem bx4HF : ∀ i, i < 78 → kindHF i = 4 →
    BxHF i = (NHF, MHF, DHF + 1) ∧ 2 ^ (SHF + 6) + 2 * 2 ^ (SHF - 1) ≤ LHF i := by
  kernel_fact

/-- The polynomial of `t`. -/
theorem PHF_k0 {i : ℕ} (h : kindHF i = 0) : PHF i = T3 SHF NHF MHF DHF := by
  unfold PHF; rw [h]; rfl
/-- The polynomial of `V`. -/
theorem PHF_k1 {i : ℕ} (h : kindHF i = 1) : PHF i = V3 := by unfold PHF; rw [h]; rfl
/-- The polynomial of `cos 2φ`. -/
theorem PHF_k2 {i : ℕ} (h : kindHF i = 2) : PHF i = C cPoly := by unfold PHF; rw [h]; rfl
/-- The polynomial of `sin 2φ`. -/
theorem PHF_k3 {i : ℕ} (h : kindHF i = 3) : PHF i = C sPoly := by unfold PHF; rw [h]; rfl
/-- The polynomial of the parameter. -/
theorem PHF_k4 {i : ℕ} (h : kindHF i = 4) : PHF i = Pr3 SHF NHF MHF DHF := by
  unfold PHF; rw [h]; rfl
/-- The polynomial of a dummy variable. -/
theorem PHF_k5 {i : ℕ} (h : kindHF i = 5) : PHF i = 0 := by unfold PHF; rw [h]; rfl

/-- The polynomial of a stored family. -/
theorem PHF_fam {i : ℕ} (h : kindHF i = 6) :
    PHF i = famPoly NHF MHF DHF (if oddHF i then -1 else 1) (c0HF i : ℤ) 0 0 0 (famHF i) := by
  unfold PHF; rw [h]; rfl

/-- The image of `t`. -/
theorem KvHF_k0 {b W R i : ℕ} (h : kindHF i = 0) : KvHF b W R i =
    ((1 <<< SHF : ℕ) : ℤ) * ((1 <<< (b * (NHF + W * (MHF + R * DHF))) : ℕ) : ℤ) := by
  unfold KvHF; rw [h]; rfl
/-- The image of `V`. -/
theorem KvHF_k1 {b W R i : ℕ} (h : kindHF i = 1) :
    KvHF b W R i = 2 * ((1 <<< (b * W) : ℕ) : ℤ) := by
  unfold KvHF; rw [h]; rfl
/-- The image of `cos 2φ`. -/
theorem KvHF_k2 {b W R i : ℕ} (h : kindHF i = 2) :
    KvHF b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) - 1 := by
  unfold KvHF; rw [h]; rfl
/-- The image of `sin 2φ`. -/
theorem KvHF_k3 {b W R i : ℕ} (h : kindHF i = 3) :
    KvHF b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) + 1 := by
  unfold KvHF; rw [h]; rfl
/-- The image of the parameter. -/
theorem KvHF_k4 {b W R i : ℕ} (h : kindHF i = 4) : KvHF b W R i =
    ((1 <<< (SHF + 6) : ℕ) : ℤ) * ((1 <<< (b * (NHF + W * (MHF + R * DHF))) : ℕ) : ℤ) +
      ((1 <<< (SHF - 1) : ℕ) : ℤ) * (((1 <<< (b * (NHF + W * (MHF + R * (DHF + 1)))) : ℕ) : ℤ) +
        ((1 <<< (b * (NHF + W * (MHF + R * (DHF - 1)))) : ℕ) : ℤ)) := by
  unfold KvHF; rw [h]; rfl
/-- The image of a dummy variable. -/
theorem KvHF_k5 {b W R i : ℕ} (h : kindHF i = 5) : KvHF b W R i = 0 := by unfold KvHF; rw [h]; rfl
/-- The image of a stored family (fast or generic). -/
theorem KvHF_k6 {b W R i : ℕ} (h : kindHF i = 6) : KvHF b W R i =
    if bMinHF i ≤ b ∧ wMinHF i ≤ W then
      ((famTB b W R NHF MHF DHF (c0HF i) (oddHF i) drHF dwHF (famHF i) : ℕ) : ℤ) -
        ((famO b W R NHF MHF DHF dwHF (famHF i) : ℕ) : ℤ)
    else famPack b W R NHF MHF DHF (if oddHF i then -1 else 1) (c0HF i : ℤ) 0 0 ddHF drHF 0
      (famHF i) := by
  unfold KvHF; rw [h]; rfl

/-- The kinds of a variable. -/
theorem kindsHF (i : ℕ) : kindHF i = 0 ∨ kindHF i = 1 ∨ kindHF i = 2 ∨ kindHF i = 3 ∨
    kindHF i = 4 ∨ kindHF i = 5 ∨ kindHF i = 6 := by
  have := kindHF_le i; omega

/-- **The Kronecker images of the variable polynomials.** -/
theorem kronHF (b W R i : ℕ) : kron b W (flat R (PHF i)) = KvHF b W R i := by
  rcases kindsHF i with h | h | h | h | h | h | h
  · rw [PHF_k0 h, KvHF_k0 h, kron_flat_T3, two_pow_eq_shift]
  · rw [PHF_k1 h, KvHF_k1 h]; exact kron_flat_V3 b W R
  · rw [PHF_k2 h, KvHF_k2 h, flat_C]; exact kron_cPoly b W
  · rw [PHF_k3 h, KvHF_k3 h, flat_C]; exact kron_sPoly b W
  · rw [PHF_k4 h, KvHF_k4 h]; exact kron_flat_Pr3 SHF NHF MHF DHF b W R
  · rw [PHF_k5 h, KvHF_k5 h]; simp
  · have hi := lt_of_kindHF h
    rw [PHF_fam h, KvHF_k6 h]
    by_cases hw : bMinHF i ≤ b ∧ wMinHF i ≤ W
    · rw [ite_eq_left hw]
      exact kron_famTB (staticHF i hi h) ((dynHF i hi h).mono hw.1 hw.2) (oddHF i) R
    · rw [ite_eq_right hw]
      exact (famPack_eq b W R NHF MHF DHF _ _ 0 0 0 (famHF i)
        fun sd hsd => ((staticHF i hi h).2.2.2 sd hsd).1).symm

/-- **Degree boxes** of the variable polynomials. -/
theorem boxHF (i : ℕ) : InBox3 (PHF i) (BxHF i).1 (BxHF i).2.1 (BxHF i).2.2 := by
  by_cases hi : i < 78
  · rcases kindsHF i with h | h | h | h | h | h | h
    · rw [PHF_k0 h, (bx0HF i hi h).1]; exact inBox3_T3 SHF NHF MHF DHF
    · rw [PHF_k1 h, (bx1HF i hi h).1]; exact inBox3_V3
    · rw [PHF_k2 h, (bx2HF i hi h).1]; exact InBox3.C box_cPoly
    · rw [PHF_k3 h, (bx3HF i hi h).1]; exact InBox3.C box_sPoly
    · rw [PHF_k4 h, (bx4HF i hi h).1]; exact inBox3_Pr3 SHF NHF MHF DHF
    · rw [PHF_k5 h]; exact inBox3_zero _ _ _
    · rw [PHF_fam h, bx6HF i hi h]
      exact inBox3_famPoly _ _ _ _ _ _ _ 0 _ (by have := (staticHF i hi h).2.1; omega)
  · rw [PHF_k5 (kindHF_ge (by omega))]
    exact inBox3_zero _ _ _

/-- **Static `ℓ¹` bounds** of the flattened variable polynomials. -/
theorem l1HF (R i : ℕ) : l1 (flat R (PHF i)) ≤ LHF i := by
  by_cases hi : i < 78
  · rcases kindsHF i with h | h | h | h | h | h | h
    · rw [PHF_k0 h]; exact (l1_flat_T3 SHF NHF MHF DHF R).trans (bx0HF i hi h).2
    · rw [PHF_k1 h]; exact (l1_flat_V3 R).trans (bx1HF i hi h).2
    · rw [PHF_k2 h, flat_C]; exact l1_cPoly.trans (bx2HF i hi h).2
    · rw [PHF_k3 h, flat_C]; exact l1_sPoly.trans (bx3HF i hi h).2
    · rw [PHF_k4 h]; exact (l1_flat_Pr3 SHF NHF MHF DHF R).trans (bx4HF i hi h).2
    · rw [PHF_k5 h]; simp [l1, liftN]
    · rw [PHF_fam h]
      refine (l1_flat_famPoly_le R NHF MHF DHF (by split_ifs <;> simp) _ 0 0 0 (famHF i)
        fun sd hsd => ((staticHF i hi h).2.2.2 sd hsd).1.2.2.2.2).trans (l1famHF i hi h)
  · rw [PHF_k5 (kindHF_ge (by omega))]
    simp [l1, liftN]

/-- The phases are below `4`. -/
theorem hWHF : ∀ i, (WtHF i).2.2 < 4 :=
  getD_prop (Pr := fun w : ℕ × ℕ × ℕ => w.2.2 < 4) (by kernel_fact) (by kernel_fact)

/-- **The family centres** at the parameter `w = c`. -/
def xHF (c : ℂ) (i : ℕ) : FA := ctr3 SHF NHF MHF DHF c (WtHF i) (PHF i)

/-- The centre of a stored family. -/
theorem xHF_fam {c : ℂ} (hc : c ≠ 0) {i : ℕ} (h : kindHF i = 6) {p : ℕ}
    (hp : WtHF i = (1, 0, p)) :
    xHF c i = famCtr SHF NHF MHF p (if oddHF i then -1 else 1) (c0HF i : ℤ) 0 0 c 0
      (famHF i) := by
  have hi := lt_of_kindHF h
  rw [xHF, hp, PHF_fam h]
  exact ctr3_famPoly _ _ _ _ _ _ _ _ _ hc 0 _ (by have := (staticHF i hi h).2.1; omega)

/-- The centre of `t` is `1`. -/
theorem xHF_t {c : ℂ} (hc : c ≠ 0) : xHF c 0 = 1 := by
  rw [xHF, show WtHF 0 = (1, 0, 0) from rfl, show PHF 0 = T3 SHF NHF MHF DHF from rfl]
  exact ctr3_T3 _ _ _ _ hc

/-- The centre of `V` is `1`. -/
theorem xHF_V (c : ℂ) : xHF c 1 = 1 := by
  rw [xHF, show WtHF 1 = (0, 1, 0) from rfl, show PHF 1 = V3 from rfl]
  exact ctr3_V3 _ _ _ _ c

/-- The centre of `cos 2φ`. -/
theorem xHF_c (c : ℂ) : xHF c 2 = ctr SHF NHF MHF (0, 1, 3) cPoly := by
  rw [xHF, show WtHF 2 = (0, 1, 3) from rfl, show PHF 2 = C cPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 3 cPoly

/-- The centre of `sin 2φ`. -/
theorem xHF_s (c : ℂ) : xHF c 3 = ctr SHF NHF MHF (0, 1, 0) sPoly := by
  rw [xHF, show WtHF 3 = (0, 1, 0) from rfl, show PHF 3 = C sPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 0 sPoly

/-- The centre of the parameter `r` is `64 + (c + c⁻¹)/2`. -/
theorem xHF_r {c : ℂ} (hc : c ≠ 0) : xHF c 71 = algebraMap ℂ FA (64 + (c + c⁻¹) / 2) := by
  rw [xHF, show WtHF 71 = (1, 0, 0) from rfl, show PHF 71 = Pr3 SHF NHF MHF DHF from rfl]
  exact ctr3_Pr3 _ _ _ _ (by kernel_fact) (by kernel_fact) hc

/-- The centres of the variables of kind `5` (dummies) vanish. -/
theorem xHF_zero (c : ℂ) {i : ℕ} (h : kindHF i = 5) : xHF c i = 0 := by
  rw [xHF, PHF_k5 h]
  simp [ctr3]

