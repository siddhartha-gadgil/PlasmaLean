/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw2CheckH26`)

The checks of `Design/RationalStellaratorGCEw2CheckH26` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE2`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZuP`. -/
theorem cHE2S_nZuP : center3KS KvSHE2 NHE2 MHE2 38 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZuP`. -/
theorem clHE2_nZuP : LHE2 38 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZtF`. -/
theorem cHE2S_nZtF : center3KS KvSHE2 NHE2 MHE2 95 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZtF`. -/
theorem clHE2_nZtF : LHE2 95 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m50`: truncation norm. -/
theorem kHE2S_m50 : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_m50 (1 : Int) 1 0 26 226 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m50`: a priori `ℓ¹` bound. -/
theorem lHE2_m50 : nodeL1N SHE2 LHE2 trHE2N_m50 (1 : Int) 1 0 26 < 2 ^ (226 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
