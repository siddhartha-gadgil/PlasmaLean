module

public import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu5CheckH64`)

The checks of `Design/RationalStellaratorGCMu5CheckH64` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu5LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `qR`. -/
theorem cHMS_qR : center3KS KvSHM NHM MHM 47 125 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `qR`. -/
theorem clHM_qR : LHM 47 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `r`. -/
theorem cHMS_r : center3KS KvSHM NHM MHM 71 129 37 28 14 9 8 5 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `r`. -/
theorem clHM_r : LHM 71 < 2 ^ (129 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `Dp`: truncation norm. -/
theorem kHMS_Dp : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_Dp (8 : Int) 0 1 29 127 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `Dp`: a priori `ℓ¹` bound. -/
theorem lHM_Dp : nodeL1N SHM LHM trHMN_Dp (8 : Int) 0 1 29 < 2 ^ (127 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `nRphP`: truncation norm. -/
theorem kHMS_nRphP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nRphP (4 : Int) 0 1 37 124 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nRphP`: a priori `ℓ¹` bound. -/
theorem lHM_nRphP : nodeL1N SHM LHM trHMN_nRphP (4 : Int) 0 1 37 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `nZphP`: truncation norm. -/
theorem kHMS_nZphP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nZphP (8 : Int) 0 1 40 125 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nZphP`: a priori `ℓ¹` bound. -/
theorem lHM_nZphP : nodeL1N SHM LHM trHMN_nZphP (8 : Int) 0 1 40 < 2 ^ (125 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu5
