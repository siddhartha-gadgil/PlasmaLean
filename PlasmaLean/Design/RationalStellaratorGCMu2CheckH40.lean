/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH40`)

The checks of `Design/RationalStellaratorGCMu2CheckH40` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nRuP`. -/
theorem cHMS_nRuP : center3KS KvSHM NHM MHM 35 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRuP`. -/
theorem clHM_nRuP : LHM 35 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `V4n`. -/
theorem cHMS_V4n : center3KS KvSHM NHM MHM 81 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `V4n`. -/
theorem clHM_V4n : LHM 81 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `E4P`: truncation norm. -/
theorem kHMS_E4P : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_E4P (1 : Int) 1 0 76 243 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `E4P`: a priori `ℓ¹` bound. -/
theorem lHM_E4P : nodeL1N SHM LHM trHMN_E4P (1 : Int) 1 0 76 < 2 ^ (243 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
