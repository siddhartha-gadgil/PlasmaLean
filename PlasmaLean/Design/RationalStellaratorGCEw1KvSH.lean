module

public import PlasmaLean.Design.RationalStellaratorGCEw1KvH
public import PlasmaLean.Certificates.KronLowMemCompute

/-!
# Low-memory Kronecker images (`Design/RationalStellaratorGCEw1KvH`)

The signed images `KvSHE1` of the variables of `Design/RationalStellaratorGCEw1KvH` for the low-
memory kernel checks (`Certificates/KronLowMemCompute`). Their integer values are the images `KvHE1`
(`KvSHE1_toInt`, `Design/RationalStellaratorGCEw1LowMemH`). Light module. Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed Kronecker images of the variable polynomials** (`w ↦ 2^{b W R}`): stored
families with fast widths by `famS`, every other variable by its integer image `KvHE1`. -/
def KvSHE1 (b W R : Nat) (i : Nat) : SInt :=
  if kindHE1 i = 6 ∧ bMinHE1 i ≤ b ∧ wMinHE1 i ≤ W then
    famS b W R NHE1 MHE1 DHE1 (c0HE1 i) (oddHE1 i) ddHE1 drHE1 dwHE1 (famHE1 i)
  else SInt.ofInt (KvHE1 b W R i)

end PlasmaLean.Design.RationalStellaratorGC
