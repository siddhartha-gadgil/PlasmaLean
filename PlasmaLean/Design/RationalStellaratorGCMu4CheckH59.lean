module

public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH59`)

The checks of `Design/RationalStellaratorGCMu4CheckH59` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `qph`. -/
theorem cHMS_qph : center3KS KvSHM NHM MHM 49 116 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `qph`. -/
theorem clHM_qph : LHM 49 < 2 ^ (116 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `dZ`. -/
theorem kHMS_dZ : norm3KS WtHM KvSHM NHM MHM trHMN_dZ (1, 0, 1) 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `dZ`: a priori `ℓ¹` bound. -/
theorem lHM_dZ : ExN.majN LHM trHMN_dZ < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `nZzP`: truncation norm. -/
theorem kHMS_nZzP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nZzP (2 : Int) 0 1 39 124 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nZzP`: a priori `ℓ¹` bound. -/
theorem lHM_nZzP : nodeL1N SHM LHM trHMN_nZzP (2 : Int) 0 1 39 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `R8`: truncation norm. -/
theorem kHMS_R8 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_R8 (1 : Int) 1 0 74 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R8`: a priori `ℓ¹` bound. -/
theorem lHM_R8 : nodeL1N SHM LHM trHMN_R8 (1 : Int) 1 0 74 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
