/-- A priori `ℓ¹` bound of the centre `m40`. -/
theorem clHE4_m40 : LHE4 24 < 2 ^ (109 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `V4n`. -/
theorem cHE4S_V4n : center3KS KvSHE4 NHE4 MHE4 81 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `V4n`. -/
theorem clHE4_V4n : LHE4 81 < 2 ^ (123 - 1) := by
