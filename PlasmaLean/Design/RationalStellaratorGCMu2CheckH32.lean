module

public import PlasmaLean.Design.RationalStellaratorGCMu2TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu2KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMu2TreesH
meta import PlasmaLean.Design.RationalStellaratorGCMu2KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu2CheckH32`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `m51`. -/
theorem cHMS_m51 : center3KS KvSHM NHM MHM 27 102 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `m51`. -/
theorem clHM_m51 : LHM 27 < 2 ^ (102 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `R4`. -/
theorem cHMS_R4 : center3KS KvSHM NHM MHM 73 122 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `R4`. -/
theorem clHM_R4 : LHM 73 < 2 ^ (122 - 1) := by
  kron_lt

/-- Proof-term check of the node `W`: truncation norm. -/
theorem kHMS_W : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_W (1 : Int) 1 0 55 244 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `W`: a priori `ℓ¹` bound. -/
theorem lHM_W : nodeL1N SHM LHM trHMN_W (1 : Int) 1 0 55 < 2 ^ (244 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu2
