/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw2CheckH60`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `U`. -/
theorem cHE2S_U : center3KS KvSHE2 NHE2 MHE2 4 119 73 55 25 11 1 73 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `U`. -/
theorem clHE2_U : LHE2 4 < 2 ^ (119 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `m40`. -/
theorem cHE2S_m40 : center3KS KvSHE2 NHE2 MHE2 24 109 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `m40`. -/
theorem clHE2_m40 : LHE2 24 < 2 ^ (109 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `V4n`. -/
theorem cHE2S_V4n : center3KS KvSHE2 NHE2 MHE2 81 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `V4n`. -/
theorem clHE2_V4n : LHE2 81 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `dU`. -/
theorem kHE2S_dU : norm3KS WtHE2 KvSHE2 NHE2 MHE2 trHE2N_dU (1, 0, 0) 120 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `dU`: a priori `ℓ¹` bound. -/
theorem lHE2_dU : ExN.majN LHE2 trHE2N_dU < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the node `R2`: truncation norm. -/
theorem kHE2S_R2 : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_R2 (1 : Int) 1 0 58 236 145 109 49 13 8 19 72 54 ≤
     := by
