public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH31`)

The checks of `Design/RationalStellaratorGCMu4CheckH31` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m50`. -/
theorem cHMS_m50 : center3KS KvSHM NHM MHM 26 107 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m50`. -/
theorem clHM_m50 : LHM 26 < 2 ^ (107 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `P4P`. -/
theorem cHMS_P4P : center3KS KvSHM NHM MHM 72 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `P4P`. -/
theorem clHM_P4P : LHM 72 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `eta`. -/
theorem kHMS_eta : norm3KS WtHM KvSHM NHM MHM trHMN_eta (2, 0, 0) 237 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `eta`: a priori `ℓ¹` bound. -/
theorem lHM_eta : ExN.majN LHM trHMN_eta < 2 ^ (237 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
