private def segment (lo hi : ℤ) : FIv := ⟨lo * 67108864, hi * 67108864, true⟩
private def box (a b c d : ℤ) : Box :=
  ⟨segment a b, segment c d, segment (-64) 64, segment (-64) 64⟩

private theorem segment_mem {a b : ℤ} {x : ℝ} (l : (a : ℝ) / 64 ≤ x) (r : x ≤ (b : ℝ) / 64) :
    (segment a b).Mem x := by
  intro _
  simp only [segment, fxVal, fxScale, Int.cast_mul, Int.cast_ofNat]
  constructor <;> linarith

private theorem input {a b c d : ℤ} {u z : ℝ} (φ : ℝ)
    (l : (a : ℝ) / 64 ≤ u) (r : u ≤ (b : ℝ) / 64)
    (lo : (c : ℝ) / 64 ≤ z) (hi : z ≤ (d : ℝ) / 64) :
    (box a b c d).Mem u z (Real.cos φ) (Real.sin φ) := by
  refine ⟨segment_mem l r, segment_mem lo hi, segment_mem ?_ ?_, segment_mem ?_ ?_⟩
  · simpa using Real.neg_one_le_cos φ
  · simpa using Real.cos_le_one φ
  · simpa using Real.neg_one_le_sin φ
  · simpa using Real.sin_le_one φ

private theorem positive_of_check {a b c d : ℤ} {u z φ : ℝ} {out : FIv}
    (check : BlockCheck (box a b c d) dD out)
    (lo : (1 : ℝ) / 64 < fxVal out.lo) (ok : out.ok = true)
    (mem : (box a b c d).Mem u z (Real.cos φ) (Real.sin φ)) :
    1 / 64 < evR u z (Real.cos φ) (Real.sin φ) dD := by
  have val := polyBox_mem mem dD
  rw [check.eq] at val
  exact lo.trans_le (val ok).1

