    Bd r (Ex.eval (XHE3 c) (toEx trHE3N_dU)) (((1659 / 500000000000 : ℚ) : ℚ) : ℝ) :=
  norm3_fullN hr hq hc hWHE3 boxHE3 (l1HE3 55) (fun _ => rfl) (fun i hi => normHE3 hq hc i (by omega)) (ballHE3_14 hr hq hc) trHE3N_dU (1, 0, 0)
      72 54 24 120 73 25 11 8 10 36 27 
      (1659 / 500000000000 : ℚ) (kronHE3 120 73 55) (by decide +kernel)
      (by decide +kernel) (by decide +kernel) lHE3_dU kHE3_dU (by decide +kernel)

