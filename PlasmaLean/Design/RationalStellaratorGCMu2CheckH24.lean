/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu2CheckH24`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `m21`. -/
theorem cHMS_m21 : center3KS KvSHM NHM MHM 19 111 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `m21`. -/
theorem clHM_m21 : LHM 19 < 2 ^ (111 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `A2`. -/
theorem cHMS_A2 : center3KS KvSHM NHM MHM 61 120 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `A2`. -/
theorem clHM_A2 : LHM 61 < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the node `m51`: truncation norm. -/
theorem kHMS_m51 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m51 (1 : Int) 1 0 27 222 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m51`: a priori `ℓ¹` bound. -/
theorem lHM_m51 : nodeL1N SHM LHM trHMN_m51 (1 : Int) 1 0 27 < 2 ^ (222 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu2
