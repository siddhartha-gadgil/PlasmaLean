meta import PlasmaLean.Design.RationalStellaratorGCEw1KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw1CheckH19`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `nZp`. -/
theorem cHE1S_nZp : center3KS KvSHE1 NHE1 MHE1 31 118 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nZp`. -/
theorem clHE1_nZp : LHE1 31 < 2 ^ (118 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `Nn`. -/
theorem cHE1S_Nn : center3KS KvSHE1 NHE1 MHE1 88 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `Nn`. -/
theorem clHE1_Nn : LHE1 88 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the node `m21`: truncation norm. -/
theorem kHE1S_m21 : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_m21 (1 : Int) 1 0 19 232 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m21`: a priori `ℓ¹` bound. -/
theorem lHE1_m21 : nodeL1N SHE1 LHE1 trHE1N_m21 (1 : Int) 1 0 19 < 2 ^ (232 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
