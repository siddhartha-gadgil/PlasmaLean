/-! ## The family torus is close to the `μ = 0`, `ρ = 1/256` torus -/

/-- The three-step triangle inequality. -/
theorem Bd_three_mu {r : ℝ} {a b x y : FA} {A B C : ℝ} (h1 : Bd r (a - b) A)
    (h2 : Bd r (b - x) B) (h3 : Bd r (y - x) C) : Bd r (a - y) (A + B + C) := by
  have := (h1.add h2).add h3.neg
  rw [show a - b + (b - x) + -(y - x) = a - y by ring] at this
  exact this

/-- The perturbation margin `1.85 × 10⁻³`. -/
theorem margin_le_mu {A B C : ℚ} (h : A + B + C ≤ 185 / 100000) :
    (A : ℝ) + B + C ≤ 185 / 100000 := by
  have h' := (Rat.cast_le (K := ℝ)).2 h
  push_cast at h'
  linarith


