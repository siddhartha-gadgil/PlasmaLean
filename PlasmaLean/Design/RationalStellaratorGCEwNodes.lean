/-- The `R`-residual norm node of node 4 is `2^96` times the flow-form residual at `ρ_4`. -/
theorem eval_trHE4N_resR (c : ℂ) (hc : ‖c‖ = 1) :
    Ex.eval (XHE4 c) (toEx trHE4N_resR) =
      (2 : ℂ) ^ 96 • (gcFlowMu (16777217 / 4294967296 : ℝ) (lamF c)).resR KamTorusA.iota (xHE4 c 4) (xHE4 c 5) := by
