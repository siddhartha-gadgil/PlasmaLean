module

public import PlasmaLean.Design.RationalStellaratorGCFamKvH
public import PlasmaLean.Certificates.KronLowMemCompute

/-!
# Low-memory Kronecker images (`Design/RationalStellaratorGCFamKvH`)

The signed images `KvSHF` of the variables of `Design/RationalStellaratorGCFamKvH` for the low-
memory kernel checks (`Certificates/KronLowMemCompute`). Their integer values are the images `KvHF`
(`KvSHF_toInt`, `Design/RationalStellaratorGCFamLowMemH`). Light module. Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed Kronecker images of the variable polynomials** (`w ↦ 2^{b W R}`): stored
families with fast widths by `famS`, every other variable by its integer image `KvHF`. -/
def KvSHF (b W R : Nat) (i : Nat) : SInt :=
  if kindHF i = 6 ∧ bMinHF i ≤ b ∧ wMinHF i ≤ W then
    famS b W R NHF MHF DHF (c0HF i) (oddHF i) ddHF drHF dwHF (famHF i)
  else SInt.ofInt (KvHF b W R i)

end PlasmaLean.Design.RationalStellaratorGC
