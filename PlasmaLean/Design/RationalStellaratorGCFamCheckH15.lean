/-- Kernel check of the node `m13`: truncation norm. -/
theorem kHF_m13 : node3KN SHF NHF MHF DHF WtHF KvHF trHFN_m13 (1 : Int) 1 0 21 228 145 109 41 13 8 19 72 54 ≤
     := by
