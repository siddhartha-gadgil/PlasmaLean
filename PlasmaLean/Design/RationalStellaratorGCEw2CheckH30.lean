module

public import PlasmaLean.Design.RationalStellaratorGCEw2TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 30)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw2DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 2: gyro-length `ρ_2 = 1/256 − 5 · 2⁻³⁶`, its own family torus `K_2(λ)`; the
fields at `ρ_2` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `RD`. -/
theorem cHE2_RD : center3KN KvHE2 NHE2 MHE2 42 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `RD`. -/
theorem clHE2_RD : LHE2 42 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `r`. -/
theorem cHE2_r : center3KN KvHE2 NHE2 MHE2 71 129 37 28 14 9 8 5 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `r`. -/
theorem clHE2_r : LHE2 71 < 2 ^ (129 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `RDu`: truncation norm. -/
theorem kHE2_RDu : node3KN SHE2 NHE2 MHE2 DHE2 WtHE2 KvHE2 trHE2N_RDu (1 : Int) 1 0 43 240 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `RDu`: a priori `ℓ¹` bound. -/
theorem lHE2_RDu : nodeL1N SHE2 LHE2 trHE2N_RDu (1 : Int) 1 0 43 < 2 ^ (240 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
