/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH41`)

The checks of `Design/RationalStellaratorGCMu2CheckH41` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nRzP`. -/
theorem cHMS_nRzP : center3KS KvSHM NHM MHM 36 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRzP`. -/
theorem clHM_nRzP : LHM 36 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `VV4`. -/
theorem cHMS_VV4 : center3KS KvSHM NHM MHM 82 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `VV4`. -/
theorem clHM_VV4 : LHM 82 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `PP4`: truncation norm. -/
theorem kHMS_PP4 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_PP4 (1 : Int) 1 0 77 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `PP4`: a priori `ℓ¹` bound. -/
theorem lHM_PP4 : nodeL1N SHM LHM trHMN_PP4 (1 : Int) 1 0 77 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
