public import PlasmaLean.Design.DommaschkKamCAdmEnv
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamCAdmEnv

/-!
# Kernel checks: closeness of the data torus C to the low-resolution surrogate

The difference grids `dGU`, `dGZ` of the data torus (`Design/DommaschkKamCTorus`, `96 × 80`, scale
`2^{−128}`) and the embedded surrogate of the admissibility chain (`24 × 28`, scale `2^{−64}`), in
the layout of the data, and the weighted digit sums of their Kronecker images and of the images of
their `θ`- and `ψ`-weighted versions (`kron2_proof`; strip weights `68553^s 2^{16(K − s)}`).
Generated by `scripts/dommaschk_kam/emit_adm.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

/-- The weighted grid `(a (i − N) + b (j − M)) g` of the full layout. -/
def wGc (a b : ℕ) (g : ℕ → ℕ → ℤ) : ℕ → ℕ → ℤ :=
  fun i j => (((a : ℕ) : ℤ) * ((i : ℤ) - Nc) + ((b : ℕ) : ℤ) * ((j : ℤ) - Mc)) * g i j

/-- The difference grid of `U`. -/
def dGU : ℕ → ℕ → ℤ := fun i j => gU i j - embedGrid NA MA 72 52 64 (gA 4) i j

/-- The difference grid of `z`. -/
def dGZ : ℕ → ℕ → ℤ := fun i j => gZ i j - embedGrid NA MA 72 52 64 (gA 5) i j

set_option linter.style.longLine false in
/-- Kernel check: the weighted norm of the tail grid `U`. -/
theorem tk_U : wl1KronP 143 193 8 8 (2 * Mc + 1) (fun i => kwtS 68553 16 Nc (ndist i (1 * Nc)))
    (fun j => kwtS 68553 16 Mc (ndist j (1 * Mc + 0))) (packGridNM 143 193 Nc dGU (2 * Mc + 1)) ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Kernel check: the weighted norm of the tail grid `AU`. -/
theorem tk_AU : wl1KronP 150 193 8 8 (2 * Mc + 1) (fun i => kwtS 68553 16 Nc (ndist i (1 * Nc)))
    (fun j => kwtS 68553 16 Mc (ndist j (1 * Mc + 0))) (packGridNM 150 193 Nc (wGc 1 0 dGU) (2 * Mc + 1)) ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Kernel check: the weighted norm of the tail grid `PU`. -/
theorem tk_PU : wl1KronP 149 193 8 8 (2 * Mc + 1) (fun i => kwtS 68553 16 Nc (ndist i (1 * Nc)))
    (fun j => kwtS 68553 16 Mc (ndist j (1 * Mc + 0))) (packGridNM 149 193 Nc (wGc 0 1 dGU) (2 * Mc + 1)) ≤  := by
  kron2_proof

end PlasmaLean.Design.DommaschkKamC
