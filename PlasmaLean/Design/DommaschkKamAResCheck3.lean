module

public import PlasmaLean.Design.DommaschkKamAResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAResTrees

/-!
# Proof-term checks of the torus-A residual chain (part 3)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamAResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_z5`, `kH_LU`, `kH_LZ`, `kH_Dc8`, `kH_Dc7`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `z5`: truncation norm. -/
theorem kH_z5 : nodeKw 68553 16 SH NH MH WtH KvH trH_z5 (1 : ℤ) 1 0 13 256 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `z5`: a priori `ℓ¹` bound. -/
theorem lH_z5 : nodeL1 SH LH trH_z5 (1 : ℤ) 1 0 13 < 2 ^ (256 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `LU`: truncation norm. -/
theorem kH_LU : nodeKw 68553 16 SH NH MH WtH KvH trH_LU (340282366920938463463374607431768211456 : ℤ) 0 0 14 265 193 8 8 160 96 80 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `LU`: a priori `ℓ¹` bound. -/
theorem lH_LU : nodeL1 SH LH trH_LU (340282366920938463463374607431768211456 : ℤ) 0 0 14 < 2 ^ (265 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `LZ`: truncation norm. -/
theorem kH_LZ : nodeKw 68553 16 SH NH MH WtH KvH trH_LZ (340282366920938463463374607431768211456 : ℤ) 0 0 15 265 193 8 8 160 96 80 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `LZ`: a priori `ℓ¹` bound. -/
theorem lH_LZ : nodeL1 SH LH trH_LZ (340282366920938463463374607431768211456 : ℤ) 0 0 15 < 2 ^ (265 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc8`: truncation norm. -/
theorem kH_Dc8 : nodeKw 68553 16 SH NH MH WtH KvH trH_Dc8 (35840000000000 : ℤ) 0 3 16 189 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc8`: a priori `ℓ¹` bound. -/
theorem lH_Dc8 : nodeL1 SH LH trH_Dc8 (35840000000000 : ℤ) 0 3 16 < 2 ^ (189 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc7`: truncation norm. -/
theorem kH_Dc7 : nodeKw 68553 16 SH NH MH WtH KvH trH_Dc7 (67200000000000 : ℤ) 0 3 17 191 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc7`: a priori `ℓ¹` bound. -/
theorem lH_Dc7 : nodeL1 SH LH trH_Dc7 (67200000000000 : ℤ) 0 3 17 < 2 ^ (191 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamA
