module

public import PlasmaLean.Design.RationalStellaratorGCEw4TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 57)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw4DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 4: gyro-length `ρ_4 = 1/256 + 2⁻³²`, its own family torus `K_4(λ)`; the
fields at `ρ_4` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `thZe`. -/
theorem cHE4_thZe : center3KN KvHE4 NHE4 MHE4 13 125 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thZe`. -/
theorem clHE4_thZe : LHE4 13 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m12`. -/
theorem cHE4_m12 : center3KN KvHE4 NHE4 MHE4 18 111 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m12`. -/
theorem clHE4_m12 : LHE4 18 < 2 ^ (111 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `R8`. -/
theorem cHE4_R8 : center3KN KvHE4 NHE4 MHE4 74 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `R8`. -/
theorem clHE4_R8 : LHE4 74 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `P2`: truncation norm. -/
theorem kHE4_P2 : node3KN SHE4 NHE4 MHE4 DHE4 WtHE4 KvHE4 trHE4N_P2 (1 : Int) 1 0 50 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `P2`: a priori `ℓ¹` bound. -/
theorem lHE4_P2 : nodeL1N SHE4 LHE4 trHE4N_P2 (1 : Int) 1 0 50 < 2 ^ (244 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `P4P`: truncation norm. -/
theorem kHE4_P4P : node3KN SHE4 NHE4 MHE4 DHE4 WtHE4 KvHE4 trHE4N_P4P (1 : Int) 0 0 72 124 73 55 25 11 8 10 36 27 ≤
    0 := by
  decide +kernel

/-- Kernel check of the node `P4P`: a priori `ℓ¹` bound. -/
theorem lHE4_P4P : nodeL1N SHE4 LHE4 trHE4N_P4P (1 : Int) 0 0 72 < 2 ^ (124 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
