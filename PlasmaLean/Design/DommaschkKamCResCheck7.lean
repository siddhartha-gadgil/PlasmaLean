module

public import PlasmaLean.Design.DommaschkKamCResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamCResTrees

/-!
# Proof-term checks of the torus-C residual chain (part 7)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamCResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_G7`, `kH_Gc6`, `kH_G6`, `kH_Gc5`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `G7`: truncation norm. -/
theorem kH_G7 : nodeKw 68553 16 SH NH MH WtH KvH trH_G7 (1 : ℤ) 1 0 35 275 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `G7`: a priori `ℓ¹` bound. -/
theorem lH_G7 : nodeL1 SH LH trH_G7 (1 : ℤ) 1 0 35 < 2 ^ (275 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc6`: truncation norm. -/
theorem kH_Gc6 : nodeKw 68553 16 SH NH MH WtH KvH trH_Gc6 (38400000000000 : ℤ) 0 3 36 191 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc6`: a priori `ℓ¹` bound. -/
theorem lH_Gc6 : nodeL1 SH LH trH_Gc6 (38400000000000 : ℤ) 0 3 36 < 2 ^ (191 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `G6`: truncation norm. -/
theorem kH_G6 : nodeKw 68553 16 SH NH MH WtH KvH trH_G6 (1 : ℤ) 1 0 37 276 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `G6`: a priori `ℓ¹` bound. -/
theorem lH_G6 : nodeL1 SH LH trH_G6 (1 : ℤ) 1 0 37 < 2 ^ (276 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc5`: truncation norm. -/
theorem kH_Gc5 : nodeKw 68553 16 SH NH MH WtH KvH trH_Gc5 (5760000000000 : ℤ) 0 3 38 187 193 8 8 165 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc5`: a priori `ℓ¹` bound. -/
theorem lH_Gc5 : nodeL1 SH LH trH_Gc5 (5760000000000 : ℤ) 0 3 38 < 2 ^ (187 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamC
