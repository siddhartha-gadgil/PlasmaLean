module

public import PlasmaLean.Design.RationalStellaratorGCEw2KvH
public import PlasmaLean.Certificates.KronLowMemCompute

/-!
# Low-memory Kronecker images (`Design/RationalStellaratorGCEw2KvH`)

The signed images `KvSHE2` of the variables of `Design/RationalStellaratorGCEw2KvH` for the low-
memory kernel checks (`Certificates/KronLowMemCompute`). Their integer values are the images `KvHE2`
(`KvSHE2_toInt`, `Design/RationalStellaratorGCEw2LowMemH`). Light module. Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed Kronecker images of the variable polynomials** (`w ↦ 2^{b W R}`): stored
families with fast widths by `famS`, every other variable by its integer image `KvHE2`. -/
def KvSHE2 (b W R : Nat) (i : Nat) : SInt :=
  if kindHE2 i = 6 ∧ bMinHE2 i ≤ b ∧ wMinHE2 i ≤ W then
    famS b W R NHE2 MHE2 DHE2 (c0HE2 i) (oddHE2 i) ddHE2 drHE2 dwHE2 (famHE2 i)
  else SInt.ofInt (KvHE2 b W R i)

end PlasmaLean.Design.RationalStellaratorGC
