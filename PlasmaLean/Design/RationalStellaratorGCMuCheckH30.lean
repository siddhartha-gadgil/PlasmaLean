module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH
public import PlasmaLean.Design.RationalStellaratorGCMuKvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMuTreesH
meta import PlasmaLean.Design.RationalStellaratorGCMuKvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMuCheckH30`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `m41`. -/
theorem cHMS_m41 : center3KS KvSHM NHM MHM 25 105 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `m41`. -/
theorem clHM_m41 : LHM 25 < 2 ^ (105 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `KZ`. -/
theorem cHMS_KZ : center3KS KvSHM NHM MHM 67 124 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `KZ`. -/
theorem clHM_KZ : LHM 67 < 2 ^ (124 - 1) := by
  kron_lt

/-- Proof-term check of the node `E`: truncation norm. -/
theorem kHMS_E : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_E (1 : Int) 1 0 51 243 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `E`: a priori `ℓ¹` bound. -/
theorem lHM_E : nodeL1N SHM LHM trHMN_E (1 : Int) 1 0 51 < 2 ^ (243 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
