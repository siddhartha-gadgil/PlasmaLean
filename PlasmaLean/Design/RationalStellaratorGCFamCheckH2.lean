module

public import PlasmaLean.Design.RationalStellaratorGCFamTreesH
public import PlasmaLean.Design.RationalStellaratorGCFamKvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCFamCheckH2`)

The checks of `Design/RationalStellaratorGCFamCheckH2` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHF`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCFamLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `qz`: truncation norm. -/
theorem kHFS_qz : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_qz (1 : Int) 1 0 48 241 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `qz`: a priori `ℓ¹` bound. -/
theorem lHF_qz : nodeL1N SHF LHF trHFN_qz (1 : Int) 1 0 48 < 2 ^ (241 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `P2`: truncation norm. -/
theorem kHFS_P2 : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_P2 (1 : Int) 1 0 50 244 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `P2`: a priori `ℓ¹` bound. -/
theorem lHF_P2 : nodeL1N SHF LHF trHFN_P2 (1 : Int) 1 0 50 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
