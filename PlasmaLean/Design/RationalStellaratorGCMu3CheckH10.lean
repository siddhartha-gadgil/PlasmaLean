/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution,
part 10)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMu3DataH*`: the weighted digit sums
(`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.

Pitch cell `λ ∈ [1/8, 3/16]`: modules `RationalStellaratorGCMu3*`,
namespace `PlasmaLean.Design.RationalStellaratorGC.Mu3`; generated by
`scripts/gc_kam/lamcell` from the pipeline of the cell `[0, 1/16]`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the node `DtF`: truncation norm. -/
theorem kHM_DtF : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_DtF (512 : Int) 1 0 91 241 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `DtF`: a priori `ℓ¹` bound. -/
theorem lHM_DtF : nodeL1N SHM LHM trHMN_DtF (512 : Int) 1 0 91 < 2 ^ (241 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu3
