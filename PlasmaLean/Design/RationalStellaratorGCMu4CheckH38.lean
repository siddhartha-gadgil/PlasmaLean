module

public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH38`)

The checks of `Design/RationalStellaratorGCMu4CheckH38` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `DzP`. -/
theorem cHMS_DzP : center3KS KvSHM NHM MHM 33 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DzP`. -/
theorem clHM_DzP : LHM 33 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `V40`. -/
theorem cHMS_V40 : center3KS KvSHM NHM MHM 79 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `V40`. -/
theorem clHM_V40 : LHM 79 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `KR`: truncation norm. -/
theorem kHMS_KR : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_KR (1 : Int) 1 0 66 240 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `KR`: a priori `ℓ¹` bound. -/
theorem lHM_KR : nodeL1N SHM LHM trHMN_KR (1 : Int) 1 0 66 < 2 ^ (240 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
