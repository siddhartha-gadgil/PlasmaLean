/-!
# The low-memory kernel checks prove the original checks (`Design/RationalStellaratorGCMu3CheckL*`)

* `KvSLM_toInt`: the signed images `KvSLM` are the Kronecker images `KvLM` (`famS_toInt`);
* every check theorem of `Design/RationalStellaratorGCMu3CheckL*`, with its original name and
  statement, proved from its low-memory version by `node3KN_le_of_S`, `norm3KN_le_of_S` or
  `center3KN_le_of_S`.

No heavy kernel evaluation (only degree conditions). Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed images are the Kronecker images.** -/
theorem KvSLM_toInt (b W R i : ℕ) : (KvSLM b W R i).toInt = KvLM b W R i := by
  unfold KvSLM
  split_ifs with h
  · obtain ⟨hk, hb, hw⟩ := h
    have hi := lt_of_kindLM hk
    rw [KvLM_k6 hk, ite_eq_left ⟨hb, hw⟩,
      famS_toInt (staticLM i hi hk) ((dynLM i hi hk).mono hb hw)]
  · exact SInt.toInt_ofInt _

