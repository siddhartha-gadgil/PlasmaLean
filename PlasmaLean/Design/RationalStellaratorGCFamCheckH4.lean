module

public import PlasmaLean.Design.RationalStellaratorGCFamTreesH
public import PlasmaLean.Design.RationalStellaratorGCFamKvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCFamTreesH
meta import PlasmaLean.Design.RationalStellaratorGCFamKvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCFamCheckH4`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `nZtF`. -/
theorem cHFS_nZtF : center3KS KvSHF NHF MHF 77 118 73 55 21 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nZtF`. -/
theorem clHF_nZtF : LHF 77 < 2 ^ (118 - 1) := by
  kron_lt

/-- Proof-term check of the node `m02`: truncation norm. -/
theorem kHFS_m02 : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_m02 (1 : Int) 1 0 14 236 145 109 41 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m02`: a priori `ℓ¹` bound. -/
theorem lHF_m02 : nodeL1N SHF LHF trHFN_m02 (1 : Int) 1 0 14 < 2 ^ (236 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `resR`. -/
theorem kHFS_resR : norm3KS WtHF KvSHF NHF MHF trHFN_resR (2, 0, 3) 341 145 109 41 13 4 37 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `resR`: a priori `ℓ¹` bound. -/
theorem lHF_resR : ExN.majN LHF trHFN_resR < 2 ^ (341 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
