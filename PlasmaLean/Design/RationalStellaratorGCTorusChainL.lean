/-- The centre `A` is `∂_θ` of the centre `U`. -/
theorem dTh_xL_A : xL 6 = dTh (xL 4) := by
  rw [show dTh (xL 4) = dS (((1 : ℕ) : ℤ) : ℂ) (((0 : ℕ) : ℤ) : ℂ) (xL 4) by simp [dTh]]
  exact (dS_ctr_grid SL NL ML 0 gL_U _ _).symm

