    Bd r (Ex.eval (XHE1 c) (toEx trHE1N_dU)) (((531 / 50000000000 : ℚ) : ℚ) : ℝ) :=
  norm3_fullN hr hq hc hWHE1 boxHE1 (l1HE1 55) (fun _ => rfl) (fun i hi => normHE1 hq hc i (by omega)) (ballHE1_14 hr hq hc) trHE1N_dU (1, 0, 0)
      72 54 24 120 73 25 11 8 10 36 27 
      (531 / 50000000000 : ℚ) (kronHE1 120 73 55) (by kernel_fact)
      (by kernel_fact) (by kernel_fact) lHE1_dU kHE1_dU (by kernel_fact)

