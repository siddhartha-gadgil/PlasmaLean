meta import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu5CheckH60`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `U`. -/
theorem cHMS_U : center3KS KvSHM NHM MHM 4 119 73 55 25 11 1 73 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `U`. -/
theorem clHM_U : LHM 4 < 2 ^ (119 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `LZx`. -/
theorem cHMS_LZx : center3KS KvSHM NHM MHM 7 221 73 55 25 11 1 73 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `LZx`. -/
theorem clHM_LZx : LHM 7 < 2 ^ (221 - 1) := by
  kron_lt

/-- Proof-term check of the node `P42`: truncation norm. -/
theorem kHMS_P42 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_P42 (1 : Int) 1 0 75 244 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `P42`: a priori `ℓ¹` bound. -/
theorem lHM_P42 : nodeL1N SHM LHM trHMN_P42 (1 : Int) 1 0 75 < 2 ^ (244 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu5
