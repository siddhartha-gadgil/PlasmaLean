module

public import PlasmaLean.Design.RationalStellaratorGCFamTreesH
public import PlasmaLean.Design.RationalStellaratorGCFamKvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCFamTreesH
meta import PlasmaLean.Design.RationalStellaratorGCFamKvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCFamCheckH6`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the node `K1`: truncation norm. -/
theorem kHFS_K1 : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_K1 (1 : Int) 1 0 62 242 145 109 41 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `K1`: a priori `ℓ¹` bound. -/
theorem lHF_K1 : nodeL1N SHF LHF trHFN_K1 (1 : Int) 1 0 62 < 2 ^ (242 - 1) := by
  kron_lt

/-- Proof-term check of the node `YnRt`: truncation norm. -/
theorem kHFS_YnRt : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_YnRt (1 : Int) 1 0 74 241 145 109 41 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `YnRt`: a priori `ℓ¹` bound. -/
theorem lHF_YnRt : nodeL1N SHF LHF trHFN_YnRt (1 : Int) 1 0 74 < 2 ^ (241 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
