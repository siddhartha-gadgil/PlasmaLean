  have h1 : |gZ i j| ≤ ((2 ^ Fc : ℕ) : ℤ) := abs_dataGrid_le Nc Mc Fc datZ 1 (by norm_num [Fc]) i j
  have h2 : |embedGrid NA MA 72 52 64 (gA 5) i j| ≤ ((2 ^ 64 * 2 ^ 60 : ℕ) : ℤ) :=
    abs_embedGridN_le NA MA 72 52 64 (fun i j => abs_dataGrid_le NA MA 60 datA_Z 1 (by norm_num) i j) i j
  have h3 := abs_sub (gZ i j) (embedGrid NA MA 72 52 64 (gA 5) i j)
  unfold dGZ; push_cast at h1 h2 ⊢; linarith

