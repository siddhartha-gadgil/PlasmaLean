/-- The family torus is real. -/
theorem isReal_uM {c : ℂ} (hc : ‖c‖ = 1) : IsReal (xHM c 4) := by
  rw [xHM_fam (ne_zero_of_norm_one_mu hc) (i := 4) (by decide_cbv) (p := 0) rfl]
  have := isReal_famCtr SHM NHM MHM 0 1 hc 0 (famHM 4)
