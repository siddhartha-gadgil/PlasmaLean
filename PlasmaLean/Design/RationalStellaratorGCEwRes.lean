/-- The inputs are bounded by `bEw` on the strip `r_A`. -/
theorem inputsEw_bd {c : ℂ} (hc : ‖c‖ = 1) :
    ∀ k i, Bd KamTorusA.rA (inputsEw (UEw c) (ZEw c) k i) (bEw k i) := by
