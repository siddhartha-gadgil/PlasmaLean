/-- The node step: the ball of `(1 + E)^{−1/2}`. -/
theorem vnodeL {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {u z : FA}
    (hU : Bd r (u - xL 4) (EL 4)) (hZ : Bd r (z - xL 5) (EL 5))
    (hA : Bd r (dTh u - xL 6) (EL 6)) (hB : Bd r (dTh z - xL 7) (EL 7))
    (hE : ∀ i, i < 63 → Bd r (XL u z i - xL i) (EL i)) :
