/-! ## The residual -/

/-- The `R`-residual node is `2^96` times the flow-form residual. -/
theorem eval_trHMN_resR (c : ℂ) (hc : ‖c‖ = 1) :
    Ex.eval (XHM c) (toEx trHMN_resR) =
      (2 : ℂ) ^ 96 • (gcFlowMu (1 / 256) (lamF c)).resR KamTorusA.iota (xHM c 4) (xHM c 5) := by
  rw [FlowFieldS.resR_eq]
  have e91 : XHM c 91 = PolyExprS.eval (xB (xHM c 4) (xHM c 5)) (gcDM (1 / 256) (lamF c)) := rfl
  have e93 : XHM c 93 = PolyExprS.eval (xB (xHM c 4) (xHM c 5)) (gcNRM (1 / 256) (lamF c)) := rfl
  have e6 : XHM c 6 = (2 : ℂ) ^ 96 • Lt KamTorusA.iota (xHM c 4) := rfl
  simp only [trHMN_resR, toEx, Ex.eval, e91, e93, e6, XHM_eq_t hc,
      xHM_t (ne_zero_of_norm_one_mu hc),
    FlowFieldS.Dof, gcFlowMu, Algebra.smul_def, map_pow, map_ofNat, Int.cast_ofNat]
  norm_num
  ring

/-- The `z`-residual node is `2^96` times the flow-form residual. -/
theorem eval_trHMN_resZ (c : ℂ) (hc : ‖c‖ = 1) :
    Ex.eval (XHM c) (toEx trHMN_resZ) =
      (2 : ℂ) ^ 96 • (gcFlowMu (1 / 256) (lamF c)).resZ KamTorusA.iota (xHM c 4) (xHM c 5) := by
  rw [FlowFieldS.resZ_eq]
  have e91 : XHM c 91 = PolyExprS.eval (xB (xHM c 4) (xHM c 5)) (gcDM (1 / 256) (lamF c)) := rfl
  have e95 : XHM c 95 = PolyExprS.eval (xB (xHM c 4) (xHM c 5)) (gcNZM (1 / 256) (lamF c)) := rfl
  have e7 : XHM c 7 = (2 : ℂ) ^ 96 • Lt KamTorusA.iota (xHM c 5) := rfl
  simp only [trHMN_resZ, toEx, Ex.eval, e91, e95, e7, XHM_eq_t hc,
      xHM_t (ne_zero_of_norm_one_mu hc),
    FlowFieldS.Dof, gcFlowMu, Algebra.smul_def, map_pow, map_ofNat, Int.cast_ofNat]
  norm_num
  ring

/-- **The residual of the family torus** (`R`-component): `‖D̃ 𝓛u − ñ_R‖_{r_A} ≤ 2.7 × 10⁻²¹`. -/
theorem muResR {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA ((gcFlowMu (1 / 256) (lamF c)).resR KamTorusA.iota (xHM c 4) (xHM c 5)) e0M :=
        by
  have h := normHM_resR rA_nonneg' exp_rA_le' hc
  rw [eval_trHMN_resR c hc] at h
  refine (Bd_inv_pow96 h).le ?_
  norm_num [e0M]

/-- **The residual of the family torus** (`z`-component): `‖D̃ 𝓛z − ñ_z‖_{r_A} ≤ 2.7 × 10⁻²¹`. -/
theorem muResZ {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA ((gcFlowMu (1 / 256) (lamF c)).resZ KamTorusA.iota (xHM c 4) (xHM c 5)) e0M :=
        by
  have h := normHM_resZ rA_nonneg' exp_rA_le' hc
  rw [eval_trHMN_resZ c hc] at h
  refine (Bd_inv_pow96 h).le ?_
  norm_num [e0M]

/-! ## Distances -/

/-- `‖u − u_L‖_{r_A} ≤ 1.163 × 10⁻⁸` (the low-resolution family). -/
theorem mdist_u {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA (xHM c 4 - xLM c 4) ((781 / 2500000000000000 : ℚ) : ℝ) := by
  have h := normHM_dU rA_nonneg' exp_rA_le' hc
  have e : XHM c 10 = xLM c 4 := rfl
  simpa [trHMN_dU, toEx, Ex.eval, XHM_eq_U hc, e] using h

/-- `‖z − z_L‖_{r_A} ≤ 1.145 × 10⁻⁸`. -/
theorem mdist_z {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA (xHM c 5 - xLM c 5) ((1421 / 5000000000000000 : ℚ) : ℝ) := by
  have h := normHM_dZ rA_nonneg' exp_rA_le' hc
  have e : XHM c 11 = xLM c 5 := rfl
  simpa [trHMN_dZ, toEx, Ex.eval, XHM_eq_Z hc, e] using h

/-- `‖∂_θ u − ∂_θ u_L‖_{r_A} ≤ 1.161 × 10⁻⁸`. -/
theorem mdist_a {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA (dTh (xHM c 4) - dTh (xLM c 4)) ((783 / 2000000000000000 : ℚ) : ℝ) := by
  have h := normHM_dA rA_nonneg' exp_rA_le' hc
  have e1 : XHM c 8 = dTh (xHM c 4) := rfl
  have e2 : XHM c 12 = dTh (xLM c 4) := rfl
  simpa [trHMN_dA, toEx, Ex.eval, e1, e2] using h

/-- `‖∂_θ z − ∂_θ z_L‖_{r_A} ≤ 1.159 × 10⁻⁸`. -/
theorem mdist_b {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA (dTh (xHM c 5) - dTh (xLM c 5)) ((751 / 2000000000000000 : ℚ) : ℝ) := by
  have h := normHM_dB rA_nonneg' exp_rA_le' hc
  have e1 : XHM c 9 = dTh (xHM c 5) := rfl
  have e2 : XHM c 13 = dTh (xLM c 5) := rfl
  simpa [trHMN_dB, toEx, Ex.eval, e1, e2] using h


/-! ## The low-resolution family: field, winding form and torsion -/

section Field

variable {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1)
  {u z : FA} (hU : Bd r (u - xLM c 4) (ELM 4)) (hZ : Bd r (z - xLM c 5) (ELM 5))
  (hA : Bd r (dTh u - xLM c 6) (ELM 6)) (hB : Bd r (dTh z - xLM c 7) (ELM 7))
include hr hq hc hU hZ hA hB

/-- `‖D̃ − d₀‖ ≤ 0.3341` at every torus near the low-resolution family torus. -/
theorem Bd_DdevM : Bd r ((gcFlowMu (1 / 256) (lamF c)).Dof u z - algebraMap ℂ FA (d0G : ℂ))
    (751300000000000 / 2 ^ 51) := by
  have h := normLM_DdevF hr hq hc hU hZ hA hB
  have hk : algebraMap ℂ FA ((2 : ℂ) ^ 51 * ((d0G : ℝ) : ℂ)) = (2126414735707981 : FA) := by
    rw [show ((2 : ℂ) ^ 51 * ((d0G : ℝ) : ℂ)) = (2126414735707981 : ℂ) by
      simp only [d0G]; push_cast; ring]
    exact map_ofNat _ _
  have e116 : XLM c u z 154 = PolyExprS.eval (xB u z) (gcDM (1 / 256) (lamF c)) := rfl
  have e0 : XLM c u z 0 = 1 := rfl
  have e : Ex.eval (XLM c u z) (toEx trLMN_DdevF) =
      (2 ^ 51 : ℂ) • ((gcFlowMu (1 / 256) (lamF c)).Dof u z - algebraMap ℂ FA (d0G : ℂ)) := by
    simp only [trLMN_DdevF, toEx, Ex.eval, e116, e0, FlowFieldS.Dof, gcFlowMu, Int.cast_ofNat]
    rw [smul_sub, Algebra.smul_def, Algebra.smul_def, ← map_mul, hk, map_pow, map_ofNat]
    norm_num
  rw [e] at h
  have h2 := h.smul ((2 ^ 51 : ℂ))⁻¹
  rw [smul_smul, inv_mul_cancel₀ (by norm_num), one_smul] at h2
  refine h2.le (le_of_eq ?_)
  rw [norm_inv, norm_pow, Complex.norm_ofNat]; push_cast; ring

/-- `‖W₀ − w₀‖ ≤ 0.003728` at every torus near the low-resolution family torus. -/
theorem Bd_WdevM : Bd r (W0of u z - algebraMap ℂ FA (w0G : ℂ)) (2166000000000000 / 2 ^ 59) := by
  have h := normLM_WdevF hr hq hc hU hZ hA hB
  have hk : algebraMap ℂ FA ((2 : ℂ) ^ 59 * ((w0G : ℝ) : ℂ)) = -(5398240620830529 : FA) := by
    rw [show ((2 : ℂ) ^ 59 * ((w0G : ℝ) : ℂ)) = -(5398240620830529 : ℂ) by
      simp only [w0G]; push_cast; ring]
    rw [map_neg, map_ofNat]
  have e108 : XLM c u z 108 = W0of u z := rfl
  have e0 : XLM c u z 0 = 1 := rfl
  have e : Ex.eval (XLM c u z) (toEx trLMN_WdevF) =
      (2 ^ 59 : ℂ) • (W0of u z - algebraMap ℂ FA (w0G : ℂ)) := by
    simp only [trLMN_WdevF, toEx, Ex.eval, e108, e0, Int.cast_ofNat]
    rw [smul_sub, Algebra.smul_def, Algebra.smul_def, ← map_mul, hk, map_pow, map_ofNat]
    norm_num
    ring
  rw [e] at h
  have h2 := h.smul ((2 ^ 59 : ℂ))⁻¹
  rw [smul_smul, inv_mul_cancel₀ (by norm_num), one_smul] at h2
  refine h2.le (le_of_eq ?_)
  rw [norm_inv, norm_pow, Complex.norm_ofNat]; push_cast; ring

/-- `‖q D̃³ W₀² − 1‖ ≤ 1.337 × 10⁻⁵`. -/
theorem Bd_XtorM : Bd r (xLM c 174 * (PolyExprS.eval (xB u z) (gcDM (1 / 256) (lamF c)) ^ 3 * W0of
    u z ^ 2) -
    1) (6293 / 10 ^ 11) := by
  have h := normLM_XF hr hq hc hU hZ hA hB
  have e135 : XLM c u z 173 = PolyExprS.eval (xB u z) (gcDM (1 / 256) (lamF c)) ^ 3 * W0of u z ^ 2
      := rfl
  have e136 : XLM c u z 174 = xLM c 174 := rfl
  have e0 : XLM c u z 0 = 1 := rfl
  have e : Ex.eval (XLM c u z) (toEx trLMN_XF) =
      xLM c 174 * (PolyExprS.eval (xB u z) (gcDM (1 / 256) (lamF c)) ^ 3 * W0of u z ^ 2) - 1 := by
    simp only [trLMN_XF, toEx, Ex.eval, e135, e136, e0]; ring
  rw [e] at h
  refine h.le (le_of_eq ?_); push_cast; ring

end Field

/-- The centre entry of the leading Chebyshev coefficient of the torsion centre. -/
theorem avgY0M : sliceG NLM MLM (if oddLM 175 then -1 else 1) (c0LM 175 : ℤ) 0 0
    ((famLM 175).headD SliceData.zero) NLM MLM = 510074363495143194 := by
  decide_cbv

/-- The centre entries of the other Chebyshev coefficients of the torsion centre. -/
theorem avgY1M : avgB NLM MLM (if oddLM 175 then -1 else 1) (c0LM 175 : ℤ) (famLM 175).tail =
    73023480963818 := by
  decide_cbv

/-- **The average of the torsion centre** at every parameter value. -/
theorem avg_xLM_Y {c : ℂ} (hc : ‖c‖ = 1) :
    ‖avg (xLM c 175) - ((510074363495143194 / 2 ^ 60 : ℝ) : ℂ)‖ ≤ 73023480963818 / 2 ^ 59 := by
  rw [xLM_fam (ne_zero_of_norm_one_mu hc) (i := 175) (by decide_cbv) (p := 0) rfl,
    show famLM 175 = (famLM 175).headD SliceData.zero :: (famLM 175).tail from rfl,
    avg_famCtr_cons, avgY0M]
  have h := norm_avg_famCtr_le SLM NLM MLM (if oddLM 175 then -1 else 1) (c0LM 175 : ℤ) hc 1
    (famLM 175).tail le_rfl
  rw [avgY1M] at h
  have e : (c ^ 0 + if (0 : ℕ) = 0 then 0 else (c ^ 0)⁻¹) * (((2 : ℂ) ^ SLM)⁻¹ *
      (((510074363495143194 : ℤ)) : ℂ)) = ((510074363495143194 / 2 ^ 60 : ℝ) : ℂ) := by
    simp only [pow_zero, ↓reduceIte, add_zero, one_mul, SLM]; push_cast; ring
  rw [e, add_sub_cancel_left]
  refine h.trans (le_of_eq ?_)
  simp only [SLM]; push_cast; ring

section Adm

variable {r : ℝ} (hr0 : 0 < r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1)
  {u z : FA} (hU : Bd r (u - xLM c 4) (ELM 4)) (hZ : Bd r (z - xLM c 5) (ELM 5))
  (hA : Bd r (dTh u - xLM c 6) (ELM 6)) (hB : Bd r (dTh z - xLM c 7) (ELM 7))
include hr0 hq hc hU hZ hA hB

/-- **`D̃` is invertible**, `‖D̃⁻¹‖ ≤ 1.6389`. -/
theorem adm_Di_M : IsUnit ((gcFlowMu (1 / 256) (lamF c)).Dof u z) ∧
    Bd r (Ring.inverse ((gcFlowMu (1 / 256) (lamF c)).Dof u z)) sDM := by
  have h := Bd_DdevM hr0.le hq hc hU hZ hA hB
  have hn : ‖((d0G : ℝ) : ℂ)‖ = d0G := by
    rw [Complex.norm_real, Real.norm_of_nonneg (by norm_num [d0G])]
  obtain ⟨hu, hb⟩ := Bd.inverse hr0.le h (by rw [hn]; norm_num [d0G])
  exact ⟨hu, hb.le (by rw [hn]; norm_num [d0G, sDM])⟩

/-- **`W₀` is invertible**, `‖W₀⁻¹‖ ≤ 177.42`. -/
theorem adm_Wi_M : IsUnit (W0of u z) ∧ Bd r (Ring.inverse (W0of u z)) sWM := by
  have h := Bd_WdevM hr0.le hq hc hU hZ hA hB
  have hn : ‖((w0G : ℝ) : ℂ)‖ = -w0G := by
    rw [Complex.norm_real, Real.norm_of_nonpos (by norm_num [w0G])]
  obtain ⟨hu, hb⟩ := Bd.inverse hr0.le h (by rw [hn]; norm_num [w0G])
  exact ⟨hu, hb.le (by rw [hn]; norm_num [w0G, sWM])⟩

/-- **Torsion and twist**: `‖T₀‖ ≤ 37.99`, `|⟨T₀⟩| ≥ 0.411`. -/
theorem adm_T_M : Bd r ((gcFlowMu (1 / 256) (lamF c)).Talg u z) tTM ∧
    τM ≤ ‖avg ((gcFlowMu (1 / 256) (lamF c)).Talg u z)‖ := by
  have hr := hr0.le
  set F := (gcFlowMu (1 / 256) (lamF c)).Dof u z ^ 3 * W0of u z ^ 2 with hF
  set q := xLM c 174 with hq_def
  have hX : Bd r (q * F - algebraMap ℂ FA 1) ((6293 / 10 ^ 11 : ℚ) : ℝ) := by
    rw [map_one]
    have := Bd_XtorM hr hq hc hU hZ hA hB
    refine this.le (le_of_eq ?_); push_cast; ring
  obtain ⟨hUq, hInv⟩ := Bd.inverse hr hX (by rw [norm_one]; norm_num)
  rw [norm_one] at hInv
  have hY := valLM_le hr hq hc hU hZ hA hB 175 (by norm_num)
  have hYc := (ballLM_all hr hq hc hU hZ hA hB) 175 (by norm_num)
  have hXe : Bd r (q * F - 1) ((6293 / 10 ^ 11 : ℚ) : ℝ) := by rwa [map_one] at hX
  set Y := XLM c u z 175 with hY_def
  obtain ⟨hDu, -⟩ := adm_Di_M hr0 hq hc hU hZ hA hB
  obtain ⟨hWu, -⟩ := adm_Wi_M hr0 hq hc hU hZ hA hB
  have hYe : Y = (1 + u) ^ 3 * (gcFlowMu (1 / 256) (lamF c)).Pof u z * q := rfl
  have hrep : (gcFlowMu (1 / 256) (lamF c)).Talg u z = Y * Ring.inverse (q * F) := by
    refine ext_eval fun θ ψ => ?_
    have hD := eval_ne_zero_of_unit hDu θ ψ
    have hW := eval_ne_zero_of_unit hWu θ ψ
    have hQ := eval_ne_zero_of_unit hUq θ ψ
    rw [eval_mul, eval_inverse hUq, hYe]
    rw [hF] at hQ ⊢
    simp only [FlowFieldS.Talg, FlowFieldS.Di, Wi, eval_mul, eval_pow', eval_inverse hDu,
      eval_inverse hWu, eval_add', eval_one] at hQ ⊢
    have hq0 : eval q θ ψ ≠ 0 := left_ne_zero_of_mul hQ
    field_simp
  refine ⟨?_, ?_⟩
  · rw [hrep]
    refine (hY.mul hr hInv).le ?_
    have h1 := qle (show BLM 175 + ELM 175 ≤ 369001 / 10000 by decide_cbv)
    push_cast at h1 ⊢
    rw [tTM]
    calc ((BLM 175 : ℝ) + ELM 175) * (1 / (1 - 6293 / 10 ^ 11)) ≤
        (369001 / 10000) * (1 / (1 - 6293 / 10 ^ 11)) := by gcongr
      _ ≤ 36901 / 1000 := by norm_num
  · have hI : Ring.inverse (q * F) = 1 - (q * F - 1) * Ring.inverse (q * F) := by
      have := Ring.mul_inverse_cancel _ hUq
      linear_combination this
    have e : (gcFlowMu (1 / 256) (lamF c)).Talg u z = Y - Y * (q * F - 1) * Ring.inverse (q * F) :=
        by
      rw [hrep]; nth_rewrite 1 [hI]; ring
    rw [e, avg_sub]
    have h1 : ‖avg (Y * (q * F - 1) * Ring.inverse (q * F))‖ ≤
        ((BLM 175 + ELM 175 : ℚ) : ℝ) * ((6293 / 10 ^ 11 : ℚ) : ℝ) *
          (1 / (1 - ((6293 / 10 ^ 11 : ℚ) : ℝ))) :=
      ((hY.mul hr hXe).mul hr hInv).norm_avg_le hr
    have h2 : ‖avg (Y - xLM c 175)‖ ≤ ((ELM 175 : ℚ) : ℝ) := hYc.norm_avg_le hr
    rw [avg_sub] at h2
    have hav := avg_xLM_Y hc
    have h3 : (510074363495143194 / 2 ^ 60 : ℝ) - 73023480963818 / 2 ^ 59 - ((ELM 175 : ℚ) : ℝ) ≤
        ‖avg Y‖ := by
      have h4 := norm_sub_norm_le (((510074363495143194 / 2 ^ 60 : ℝ) : ℂ))
        (((510074363495143194 / 2 ^ 60 : ℝ) : ℂ) - avg Y)
      rw [sub_sub_cancel, Complex.norm_real, Real.norm_of_nonneg (by norm_num)] at h4
      have h5 : ‖((510074363495143194 / 2 ^ 60 : ℝ) : ℂ) - avg Y‖ ≤
          73023480963818 / 2 ^ 59 + ((ELM 175 : ℚ) : ℝ) := by
        have := norm_add_le (avg (xLM c 175) - ((510074363495143194 / 2 ^ 60 : ℝ) : ℂ))
          (avg Y - avg (xLM c 175))
        rw [show avg (xLM c 175) - ((510074363495143194 / 2 ^ 60 : ℝ) : ℂ) +
          (avg Y - avg (xLM c 175)) = -(((510074363495143194 / 2 ^ 60 : ℝ) : ℂ) - avg Y) by ring,
          norm_neg] at this
        linarith
      linarith
    have h5 := norm_sub_norm_le (avg Y) (avg (Y * (q * F - 1) * Ring.inverse (q * F)))
    have hB1 := qle (show BLM 175 + ELM 175 ≤ 369001 / 10000 by decide_cbv)
    have hE1 := qle (show ELM 175 ≤ 391 / 10000000 by decide_cbv)
    push_cast at h1 hB1 hE1 h3
    have h6 : ((BLM 175 : ℝ) + ELM 175) * (6293 / 10 ^ 11) * (1 / (1 - 6293 / 10 ^ 11)) ≤
        (369001 / 10000) * (6293 / 10 ^ 11) * (1 / (1 - 6293 / 10 ^ 11)) := by gcongr
    rw [τM]
    norm_num at h6 h3 ⊢
    linarith

end Adm

/-- The bounds `(‖u‖, ‖z‖, ‖cos 2φ‖, ‖sin 2φ‖, 0, 0)` of the torus variables. -/
def avM : Fin 6 → ℝ := ![auM, azM, acG, acG, 0, 0]

/-- The torus variable bounds are below the validity bounds of the family. -/
theorem avM_le : (∀ i, 0 ≤ avM i) ∧ ∀ i, avM i ≤ (RationalStellaratorGCMu5.aTQ i : ℝ) := by
  refine ⟨fun i => ?_, fun i => ?_⟩ <;> fin_cases i <;>
    norm_num [avM, RationalStellaratorGCMu5.aTQ, auM, azM, acG, μM]

/-- The inputs of the low-resolution family chain from `μ`-closeness to the family torus. -/
theorem inputs_LM {ρ : ℝ} (hρA : ρ ≤ KamTorusA.rA) {c : ℂ} (hc : ‖c‖ = 1) {u z : FA}
    (hC : Close ρ KamTorusA.iota u z (xHM c 4) (xHM c 5) μM) :
    Bd ρ (u - xLM c 4) (ELM 4) ∧ Bd ρ (z - xLM c 5) (ELM 5) ∧ Bd ρ (dTh u - xLM c 6) (ELM 6) ∧
      Bd ρ (dTh z - xLM c 7) (ELM 7) := by
  have hc0 := ne_zero_of_norm_one_mu hc
  have e1 := qle (show (1 / 10 ^ 11 + (781 / 2500000000000000 : ℚ)) ≤ ELM 4 by decide_cbv)
  have e2 := qle (show (1 / 10 ^ 11 + (1421 / 5000000000000000 : ℚ)) ≤ ELM 5 by decide_cbv)
  have e3 := qle (show (1 / 10 ^ 11 + (783 / 2000000000000000 : ℚ)) ≤ ELM 6 by decide_cbv)
  have e4 := qle (show (1 / 10 ^ 11 + (751 / 2000000000000000 : ℚ)) ≤ ELM 7 by decide_cbv)
  push_cast at e1 e2 e3 e4
  have hA6 : xLM c 6 = dTh (xLM c 4) := by rw [xLM_der_A hc0]; simp [dTh]
  have hB7 : xLM c 7 = dTh (xLM c 5) := by rw [xLM_der_B hc0]; simp [dTh]
  refine ⟨?_, ?_, ?_, ?_⟩
  · have := hC.du.add ((mdist_u hc).strip hρA)
    rw [sub_add_sub_cancel] at this; exact this.le (by rw [μM]; push_cast; linarith)
  · have := hC.dz.add ((mdist_z hc).strip hρA)
    rw [sub_add_sub_cancel] at this; exact this.le (by rw [μM]; push_cast; linarith)
  · have := hC.dut.add ((mdist_a hc).strip hρA)
    rw [sub_add_sub_cancel, ← hA6] at this; exact this.le (by rw [μM]; push_cast; linarith)
  · have := hC.dzt.add ((mdist_b hc).strip hρA)
    rw [sub_add_sub_cancel, ← hB7] at this; exact this.le (by rw [μM]; push_cast; linarith)

/-- **Admissibility of every torus `μ`-close to the family torus** on a strip `0 < ρ ≤ r_A`, for
every parameter `|c| = 1`, with the constants `cM` (uniform over the cell). -/
theorem muAdm {ρ : ℝ} (hρ : 0 < ρ) (hρA : ρ ≤ KamTorusA.rA) {c : ℂ} (hc : ‖c‖ = 1) {u z : FA}
    (hu : Ana u) (hz : Ana z) (hC : Close ρ KamTorusA.iota u z (xHM c 4) (xHM c 5) μM) :
    (gcFlowMu (1 / 256) (lamF c)).AdmBounds cM KamTorusA.iota ρ u z := by
  have hq : Real.exp ρ ≤ (74315 : ℕ) / 2 ^ 16 := (Real.exp_le_exp.2 hρA).trans exp_rA_le'
  obtain ⟨hU, hZ, hA, hB⟩ := inputs_LM hρA hc hC
  have hρ0 := hρ.le
  have tu : Bd ρ u auM := by
    have := hC.du.add ((Bd_uM hc).strip hρA); rw [sub_add_cancel] at this
    exact this.le (by rw [auM]; linarith)
  have tz : Bd ρ z azM := by
    have := hC.dz.add ((Bd_zM hc).strip hρA); rw [sub_add_cancel] at this
    exact this.le (by rw [azM]; linarith)
  have tRt : Bd ρ (dTh u) aRtM := by
    have := hC.dut.add ((Bd_dTh_uM hc).strip hρA); rw [sub_add_cancel] at this
    exact this.le (by rw [aRtM]; linarith)
  have tzt : Bd ρ (dTh z) aztM := by
    have := hC.dzt.add ((Bd_dTh_zM hc).strip hρA); rw [sub_add_cancel] at this
    exact this.le (by rw [aztM]; linarith)
  have tLR : Bd ρ (Lt KamTorusA.iota u) aLRM := by
    have := hC.duL.add ((Bd_Lt_uM hc).strip hρA); rw [sub_add_cancel] at this
    exact this.le (by rw [aLRM]; linarith)
  have tLz : Bd ρ (Lt KamTorusA.iota z) aLzM := by
    have := hC.dzL.add ((Bd_Lt_zM hc).strip hρA); rw [sub_add_cancel] at this
    exact this.le (by rw [aLzM]; linarith)
  obtain ⟨hDu, hDb⟩ := adm_Di_M hρ hq hc hU hZ hA hB
  obtain ⟨hWu, hWb⟩ := adm_Wi_M hρ hq hc hU hZ hA hB
  have hR1 : Bd ρ ((1 + u) - algebraMap ℂ FA 1) auM := by
    rw [map_one, add_sub_cancel_left]; exact tu
  obtain ⟨hRu, hRb⟩ := Bd.inverse hρ0 hR1 (by rw [norm_one]; norm_num [auM, μM])
  rw [norm_one] at hRb
  obtain ⟨hT, hτ⟩ := adm_T_M hρ hq hc hU hZ hA hB
  have hgood : (gcFlowMu (1 / 256) (lamF c)).Good u z := by
    refine ⟨ρ, hρ, avM, fun i => ?_,
      (RationalStellaratorGCMu5.mu_valid_cell avM_le.1 avM_le.2 (abs_lamF_le hc)).1⟩
    have hcq : Real.exp ρ ≤ acG := by
      have := hq; push_cast at this; rw [acG]; linarith
    fin_cases i
    · exact tu
    · exact tz
    · exact (Bd_cS ρ).le hcq
    · exact (Bd_sS ρ).le hcq
    · exact Bd_zero ρ
    · exact Bd_zero ρ
  have fb : ∀ {X : FA} {i : ℕ} {q : ℚ}, Bd ρ X ((BLM i + ELM i : ℚ) : ℝ) → BLM i + ELM i ≤ q →
      Bd ρ X (q : ℝ) := fun h hq => h.le (qle hq)
  have v := valLM_le hρ0 hq hc hU hZ hA hB
  exact
  { frame := ⟨hu, hz, hDu, hRu, hWu, ⟨ρ, _, hρ, hDb⟩, ⟨ρ, _, hρ, hRb⟩, ⟨ρ, _, hρ, hWb⟩, hgood⟩
    hu := tu
    hz := tz
    hRt := tRt
    hzt := tzt
    hLR := tLR
    hLz := tLz
    hbD := by
      have := fb (v 154 (by norm_num)) (q := 12771 / 10000) (by decide_cbv)
      push_cast at this; exact this
    hbDu := by
      have := fb (v 160 (by norm_num)) (q := 22371 / 10000) (by decide_cbv)
      push_cast at this; exact this
    hbDz := by
      have := fb (v 162 (by norm_num)) (q := 20401 / 100000) (by decide_cbv)
      push_cast at this; exact this
    hbnR := by
      have := fb (v 156 (by norm_num)) (q := 10151 / 100000) (by decide_cbv)
      push_cast at this; exact this
    hbnRu := by
      have := fb (v 164 (by norm_num)) (q := 94841 / 100000) (by decide_cbv)
      push_cast at this; exact this
    hbnRz := by
      have := fb (v 166 (by norm_num)) (q := 74591 / 100000) (by decide_cbv)
      push_cast at this; exact this
    hbnZ := by
      have := fb (v 158 (by norm_num)) (q := 10551 / 100000) (by decide_cbv)
      push_cast at this; exact this
    hbnZu := by
      have := fb (v 168 (by norm_num)) (q := 87101 / 100000) (by decide_cbv)
      push_cast at this; exact this
    hbnZz := by
      have := fb (v 170 (by norm_num)) (q := 81891 / 100000) (by decide_cbv)
      push_cast at this; exact this
    hsD := hDb
    hsR := hRb
    hsW := hWb
    hT := hT
    hτ := hτ }

end PlasmaLean.Design.RationalStellaratorGC.Mu5
