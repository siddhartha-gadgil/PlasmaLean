module

public import PlasmaLean.Design.RationalStellaratorGCEwCombEnv

/-!
# Kernel checks of the energy-window combinations (part 6)

Each theorem is one kernel evaluation (`decide +kernel`) of the weighted digit sum `norm3KN` of the
Kronecker image of an integer combination of node tori (`Design/RationalStellaratorGCEwCombEnv`).
Light module. Generated by `scripts/gc_kam/ew_comb.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C0Z`. -/
theorem kEw_C0Z : norm3KN WtEw KvEw 36 27 trEwC_C0Z (1, 0, 1) 129 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C0Z`. -/
theorem lEw_C0Z : ExN.majN LEw trEwC_C0Z < 2 ^ (129 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C3LRx`. -/
theorem kEw_C3LRx : norm3KN WtEw KvEw 36 27 trEwC_C3LRx (1, 0, 3) 227 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C3LRx`. -/
theorem lEw_C3LRx : ExN.majN LEw trEwC_C3LRx < 2 ^ (227 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C3thU`. -/
theorem kEw_C3thU : norm3KN WtEw KvEw 36 27 trEwC_C3thU (1, 0, 3) 132 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C3thU`. -/
theorem lEw_C3thU : ExN.majN LEw trEwC_C3thU < 2 ^ (132 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
