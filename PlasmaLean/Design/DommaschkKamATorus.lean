module

public import PlasmaLean.Design.DommaschkKamAData
public import PlasmaLean.Design.DommaschkKamCTorus

/-!
# Dommaschk torus A as elements of the strip algebra (nested certified region)

The approximate torus A of the Dommaschk target (`ι_A = −(19 + √5)/89 ≈ −0.2386075`, data
`Design/DommaschkKamAData`, generated by `scripts/dommaschk_kam/emit_torus.py`), the outer torus of
the nested certified region (inner torus: C, `Design/DommaschkKamCTorus`). Same conventions as for
torus C: the data are stored in the oracle angle `ψₒ = 2φ`; the Lean angle is `ψ = ψₒ − π/2`,
reached by the rotation `DommaschkKamC.rotψ` (`c_km ↦ iᵐ c_km`).

**The torus.** `Uo`, `Zo`: the grid centres of `U = R − R₀` (`R₀ = 29/32`) and `z` in the oracle
angle; `u₀A = rotψ Uo`, `z₀A = rotψ Zo` in the Lean angle; analytic and real.

**The field.** Torus A uses the moving frame centre of torus C (the same magnetic axis; on torus A
the winding form lies in `[−1.13e-3, −7.5e-4]`, generator float check), so both tori are tori of
the one `FlowFieldG` instance `DommaschkKamC.dkFieldTC`.

**Sanity.** `gZ_centre` (degenerate: `⟨z⟩ = 0`), `coeff_u₀A` (the coefficient formula),
`iotaqA_close` (the dyadic `ι_q` is `2^{−Qc}`-close to `ι_A`), `iotaqA_ne_iotaqC` (rejected: the
data of torus C do not describe torus A).
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Theory.KAM PlasmaLean.Certificates.KronBall PlasmaLean.Design.KamNewton
  PlasmaLean.Design.DommaschkKam PlasmaLean.Design.DommaschkKamC WEll1Z2 Complex

/-! ## The torus -/

/-- The grid of `U = R − R₀` of torus A (oracle angle; even). -/
def gU : ℕ → ℕ → ℤ := symGrid Nc Mc ((-1) ^ 0) (halfGridR Fc Nc datU)

/-- The grid of `z` of torus A (oracle angle; odd). -/
def gZ : ℕ → ℕ → ℤ := symGrid Nc Mc ((-1) ^ 1) (halfGridR Fc Nc datZ)

/-- `U = R − R₀` of torus A in the oracle angle `ψₒ = 2φ` (a grid centre of phase `0`). -/
def Uo : FA := ctr Sc Nc Mc (1, 0, 0) (gridPolyNM Nc Mc gU)

/-- `z` of torus A in the oracle angle (a grid centre of phase `1`). -/
def Zo : FA := ctr Sc Nc Mc (1, 0, 1) (gridPolyNM Nc Mc gZ)

/-- **`u₀ = R − R₀` of torus A** in the Lean angle `ψ = 2φ − π/2`. -/
def u₀A : FA := rotψ Uo

/-- **`z₀` of torus A** in the Lean angle. -/
def z₀A : FA := rotψ Zo

/-- `Uo` is analytic. -/
theorem ana_Uo : Ana Uo := ana_ctr_grid _ _ _ _ _
/-- `Zo` is analytic. -/
theorem ana_Zo : Ana Zo := ana_ctr_grid _ _ _ _ _
/-- `Uo` is real. -/
theorem isReal_Uo : IsReal Uo := isReal_ctr_sym _ _ _ 0 _
/-- `Zo` is real. -/
theorem isReal_Zo : IsReal Zo := isReal_ctr_sym _ _ _ 1 _

/-- `u₀A` is analytic. -/
theorem ana_u₀A : Ana u₀A := ana_rotψ ana_Uo
/-- `z₀A` is analytic. -/
theorem ana_z₀A : Ana z₀A := ana_rotψ ana_Zo
/-- `u₀A` is real. -/
theorem isReal_u₀A : IsReal u₀A := isReal_rotψ isReal_Uo
/-- `z₀A` is real. -/
theorem isReal_z₀A : IsReal z₀A := isReal_rotψ isReal_Zo

/-- **Sanity (degenerate)**: the odd grid of `z` vanishes at the centre (`⟨z⟩ = 0`). -/
theorem gZ_centre : gZ Nc Mc = 0 := symGrid_centre_odd _ _ _

/-- The function of `u₀A`: `U` at the oracle angle `ψₒ = ψ + π/2 = 2φ`. -/
theorem eval_u₀A (θ ψ : ℝ) : eval u₀A θ ψ = eval Uo θ (ψ + Real.pi / 2) := eval_rotψ _ _ _
/-- The function of `z₀A`. -/
theorem eval_z₀A (θ ψ : ℝ) : eval z₀A θ ψ = eval Zo θ (ψ + Real.pi / 2) := eval_rotψ _ _ _

/-- **The coefficient formula** of `u₀A`: `iᵐ g(k + N, m + M)/2^S` inside the box. -/
theorem coeff_u₀A (km : ℤ × ℤ) : coeff u₀A km = I ^ km.2 * (((2 : ℂ) ^ Sc * I ^ 0)⁻¹ *
    ((if |km.1| ≤ Nc ∧ |km.2| ≤ Mc then gU (km.1 + Nc).toNat (km.2 + Mc).toNat
      else 0 : ℤ) : ℂ)) := by
  rw [u₀A, coeff_rotψ, Uo, coeff_ctr_grid]

/-- The coefficient formula of `z₀A`. -/
theorem coeff_z₀A (km : ℤ × ℤ) : coeff z₀A km = I ^ km.2 * (((2 : ℂ) ^ Sc * I ^ 1)⁻¹ *
    ((if |km.1| ≤ Nc ∧ |km.2| ≤ Mc then gZ (km.1 + Nc).toNat (km.2 + Mc).toNat
      else 0 : ℤ) : ℂ)) := by
  rw [z₀A, coeff_rotψ, Zo, coeff_ctr_grid]

/-! ## The rotational transform -/

/-- The dyadic rotational transform `ι_q = −Iqc/2^Qc ≈ ι_A`. -/
def iotaqA : ℝ := -((Iqc : ℝ) / 2 ^ Qc)

/-- **The dyadic rotational transform is `2^{−Qc}`-close to `ι_A = −(19 + √5)/89`**
(`t = 89 Iqc − 19·2^Qc` brackets `√5·2^Qc` within `89`, checked on integer squares). -/
theorem iotaqA_close : |iotaqA - DommaschkKamDio.dkIotaA| ≤ 1 / 2 ^ Qc := by
  have hQ : (0 : ℝ) < 2 ^ Qc := by positivity
  have hs : √5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  set t : ℝ := 89 * Iqc - 19 * 2 ^ Qc with ht
  have key : |√5 * 2 ^ Qc - t| ≤ 89 := by
    refine abs_sub_le_of_sq_bracket (by positivity) (by norm_num) ?_ ?_ ?_
    · rw [ht]; norm_num [Iqc, Qc]
    · rw [mul_pow, hs, ht]; norm_num [Iqc, Qc]
    · rw [mul_pow, hs, ht]; norm_num [Iqc, Qc]
  have e : iotaqA - DommaschkKamDio.dkIotaA = (√5 * 2 ^ Qc - t) / (89 * 2 ^ Qc) := by
    rw [ht, iotaqA, DommaschkKamDio.dkIotaA]; field_simp; ring
  rw [e, abs_div, abs_of_pos (show (0 : ℝ) < 89 * 2 ^ Qc by positivity),
    div_le_div_iff₀ (by positivity) hQ]
  nlinarith

/-- **Sanity (rejected fixture)**: the dyadic transforms of tori A and C differ. -/
theorem iotaqA_ne_iotaqC : iotaqA ≠ DommaschkKamC.iotaqC := by
  rw [iotaqA, DommaschkKamC.iotaqC, Ne, neg_inj]
  norm_num [Iqc, Qc, DommaschkKamC.Iqc, DommaschkKamC.Qc]

end PlasmaLean.Design.DommaschkKamA
