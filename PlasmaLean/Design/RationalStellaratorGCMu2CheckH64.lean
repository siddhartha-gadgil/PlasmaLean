module

public import PlasmaLean.Design.RationalStellaratorGCMu2TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu2KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMu2TreesH
meta import PlasmaLean.Design.RationalStellaratorGCMu2KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu2CheckH64`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `qR`. -/
theorem cHMS_qR : center3KS KvSHM NHM MHM 47 125 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `qR`. -/
theorem clHM_qR : LHM 47 < 2 ^ (125 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `r`. -/
theorem cHMS_r : center3KS KvSHM NHM MHM 71 129 37 28 14 9 8 5 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `r`. -/
theorem clHM_r : LHM 71 < 2 ^ (129 - 1) := by
  kron_lt

/-- Proof-term check of the node `Dp`: truncation norm. -/
theorem kHMS_Dp : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_Dp (8 : Int) 0 1 29 127 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `Dp`: a priori `ℓ¹` bound. -/
theorem lHM_Dp : nodeL1N SHM LHM trHMN_Dp (8 : Int) 0 1 29 < 2 ^ (127 - 1) := by
  kron_lt

/-- Proof-term check of the node `nRphP`: truncation norm. -/
theorem kHMS_nRphP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nRphP (4 : Int) 0 1 37 124 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `nRphP`: a priori `ℓ¹` bound. -/
theorem lHM_nRphP : nodeL1N SHM LHM trHMN_nRphP (4 : Int) 0 1 37 < 2 ^ (124 - 1) := by
  kron_lt

/-- Proof-term check of the node `nZphP`: truncation norm. -/
theorem kHMS_nZphP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nZphP (8 : Int) 0 1 40 125 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `nZphP`: a priori `ℓ¹` bound. -/
theorem lHM_nZphP : nodeL1N SHM LHM trHMN_nZphP (8 : Int) 0 1 40 < 2 ^ (125 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu2
