/-- Low-memory kernel check of the norm node `Vm1`. -/
theorem kHE1S_Vm1 : norm3KS WtHE1 KvSHE1 NHE1 MHE1 trHE1N_Vm1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
