public import PlasmaLean.Design.RationalStellaratorGCMu3TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu3KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu3CheckH15`)

The checks of `Design/RationalStellaratorGCMu3CheckH15` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `Ue`. -/
theorem cHMS_Ue : center3KS KvSHM NHM MHM 10 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Ue`. -/
theorem clHM_Ue : LHM 10 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `V0`. -/
theorem cHMS_V0 : center3KS KvSHM NHM MHM 52 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `V0`. -/
theorem clHM_V0 : LHM 52 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m12`: truncation norm. -/
theorem kHMS_m12 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m12 (1 : Int) 1 0 18 232 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m12`: a priori `ℓ¹` bound. -/
theorem lHM_m12 : nodeL1N SHM LHM trHMN_m12 (1 : Int) 1 0 18 < 2 ^ (232 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu3
