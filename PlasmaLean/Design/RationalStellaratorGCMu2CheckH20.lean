public import PlasmaLean.Design.RationalStellaratorGCMu2TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu2KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH20`)

The checks of `Design/RationalStellaratorGCMu2CheckH20` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m11`. -/
theorem cHMS_m11 : center3KS KvSHM NHM MHM 15 115 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m11`. -/
theorem clHM_m11 : LHM 15 < 2 ^ (115 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `W3`. -/
theorem cHMS_W3 : center3KS KvSHM NHM MHM 57 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `W3`. -/
theorem clHM_W3 : LHM 57 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m31`: truncation norm. -/
theorem kHMS_m31 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m31 (1 : Int) 1 0 23 228 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m31`: a priori `ℓ¹` bound. -/
theorem lHM_m31 : nodeL1N SHM LHM trHMN_m31 (1 : Int) 1 0 23 < 2 ^ (228 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
