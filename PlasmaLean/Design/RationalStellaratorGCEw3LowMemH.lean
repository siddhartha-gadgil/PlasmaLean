/-!
# The low-memory kernel checks prove the original checks (`Design/RationalStellaratorGCEw3CheckH*`)

* `KvSHE3_toInt`: the signed images `KvSHE3` are the Kronecker images `KvHE3` (`famS_toInt`);
* every check theorem of `Design/RationalStellaratorGCEw3CheckH*`, with its original name and
  statement, proved from its low-memory version by `node3KN_le_of_S`, `norm3KN_le_of_S` or
  `center3KN_le_of_S`.

No heavy kernel evaluation (only degree conditions). Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed images are the Kronecker images.** -/
theorem KvSHE3_toInt (b W R i : ℕ) : (KvSHE3 b W R i).toInt = KvHE3 b W R i := by
  unfold KvSHE3
  split_ifs with h
  · obtain ⟨hk, hb, hw⟩ := h
    have hi := lt_of_kindHE3 hk
    rw [KvHE3_k6 hk, ite_eq_left ⟨hb, hw⟩,
      famS_toInt (staticHE3 i hi hk) ((dynHE3 i hi hk).mono hb hw)]
  · exact SInt.toInt_ofInt _

