  WEll1Z2 Complex

/-- The surrogate grids of torus C (`i = 4, 5`) embedded in the layout `32 × 32`. -/
def embC (k : ℕ) : ℕ → ℕ → ℤ :=
  embedGrid DommaschkKamC.NA DommaschkKamC.MA 8 4 0 (DommaschkKamC.gA k)

/-- Entry bound of the embedded `U` grid of torus C. -/
theorem abs_embC4 (i j : ℕ) : |embC 4 i j| ≤ ((2 ^ 60 : ℕ) : ℤ) := by
  have := abs_embedGridN_le DommaschkKamC.NA DommaschkKamC.MA 8 4 0
    (fun i j => abs_dataGrid_le DommaschkKamC.NA DommaschkKamC.MA 60 DommaschkKamC.datA_U 0
      (by norm_num) i j) i j
  exact this.trans (le_of_eq (by norm_num))

/-- Entry bound of the embedded `z` grid of torus C. -/
theorem abs_embC5 (i j : ℕ) : |embC 5 i j| ≤ ((2 ^ 60 : ℕ) : ℤ) := by
  have := abs_embedGridN_le DommaschkKamC.NA DommaschkKamC.MA 8 4 0
    (fun i j => abs_dataGrid_le DommaschkKamC.NA DommaschkKamC.MA 60 DommaschkKamC.datA_Z 1
      (by norm_num) i j) i j
  exact this.trans (le_of_eq (by norm_num))

/-- Grid of the centre `XC`. -/
def gN_XC : ℕ → ℕ → ℤ :=
  fun i j => if i = NA then 0 else embC 4 i j

/-- Grid of the centre `YC`. -/
def gN_YC : ℕ → ℕ → ℤ :=
  fun i j => if i = NA then 0 else embC 5 i j

/-- Grid of the centre `XA`. -/
def gN_XA : ℕ → ℕ → ℤ :=
  fun i j => gA 4 i j - (if i = NA then embC 4 i j else 0)

/-- Grid of the centre `YA`. -/
def gN_YA : ℕ → ℕ → ℤ :=
  fun i j => gA 5 i j - (if i = NA then embC 5 i j else 0)

/-- Grid of the centre `ct`. -/
def gN_ct : ℕ → ℕ → ℤ :=
  fun i j => if (i = NA + 1 ∨ i = NA - 1) ∧ j = MA then 2 ^ 63 else 0

/-- Grid of the centre `st`. -/
def gN_st : ℕ → ℕ → ℤ :=
  fun i j => if i = NA + 1 ∧ j = MA then 2 ^ 63 else if i = NA - 1 ∧ j = MA then -2 ^ 63 else 0

/-- Grid of the centre `ga`. -/
def gN_ga : ℕ → ℕ → ℤ :=
  symGrid NA MA ((-1) ^ 0) (halfGridR 76 NA datN_ga)

