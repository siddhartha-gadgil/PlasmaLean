  PlasmaLean.Certificates.Kron2 WEll1Z2 Complex

/-- The full chain. -/
theorem ballHE1_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) :
    ∀ i, i < 99 → Bd r (XHE1 c i - xHE1 c i) (EHE1 i) :=
  ballHE1_99 hr hq hc

/-- A value is bounded by its centre norm plus its radius. -/
theorem valHE1_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1)
    (i : ℕ) (hi : i < 99) :
    Bd r (XHE1 c i) ((BHE1 i + EHE1 i : ℚ) : ℝ) := by
  have := (normHE1 hq hc i hi).add (ballHE1_all hr hq hc i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

