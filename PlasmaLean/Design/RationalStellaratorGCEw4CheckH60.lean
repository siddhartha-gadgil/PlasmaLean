/-- Proof-term check of the node `R2`: truncation norm. -/
theorem kHE4S_R2 : node3KS SHE4 NHE4 MHE4 DHE4 WtHE4 KvSHE4 trHE4N_R2 (1 : Int) 1 0 58 236 145 109 49 13 8 19 72 54 ≤
