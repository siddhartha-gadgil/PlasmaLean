module

public import PlasmaLean.Design.RationalStellaratorGCEwCombEnv

/-!
# Kernel checks of the energy-window combinations (part 5)

Each theorem is one kernel evaluation (`decide +kernel`) of the weighted digit sum `norm3KN` of the
Kronecker image of an integer combination of node tori (`Design/RationalStellaratorGCEwCombEnv`).
Light module. Generated by `scripts/gc_kam/ew_comb.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `D0U`. -/
theorem kEw_D0U : norm3KN WtEw KvEw 36 27 trEwC_D0U (1, 0, 0) 129 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `D0U`. -/
theorem lEw_D0U : ExN.majN LEw trEwC_D0U < 2 ^ (129 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C2LRx`. -/
theorem kEw_C2LRx : norm3KN WtEw KvEw 36 27 trEwC_C2LRx (1, 0, 3) 223 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C2LRx`. -/
theorem lEw_C2LRx : ExN.majN LEw trEwC_C2LRx < 2 ^ (223 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C2thU`. -/
theorem kEw_C2thU : norm3KN WtEw KvEw 36 27 trEwC_C2thU (1, 0, 3) 128 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C2thU`. -/
theorem lEw_C2thU : ExN.majN LEw trEwC_C2thU < 2 ^ (128 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
