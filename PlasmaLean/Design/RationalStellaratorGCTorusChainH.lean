/-- The embedded low-resolution centre `Ue`. -/
theorem embed_xH_Ue : xH 10 = uSG :=
  ctr_embedGrid SL NL ML 0 (NH - NL) (MH - ML) (SH - SL) gL_U

/-- The embedded low-resolution centre `Ze`. -/
theorem embed_xH_Ze : xH 11 = zSG :=
  ctr_embedGrid SL NL ML 1 (NH - NL) (MH - ML) (SH - SL) gL_Z

/-- The centre `thU` is `∂_θ` of the centre `U`. -/
theorem dTh_xH_thU : xH 8 = dTh (u₀G) := by
  rw [show dTh (u₀G) = dS (((1 : ℕ) : ℤ) : ℂ) (((0 : ℕ) : ℤ) : ℂ) (u₀G) by simp [dTh]]
  exact (dS_ctr_grid SH NH MH 0 gH_U _ _).symm

/-- The centre `thZ` is `∂_θ` of the centre `Z`. -/
theorem dTh_xH_thZ : xH 9 = dTh (z₀G) := by
  rw [show dTh (z₀G) = dS (((1 : ℕ) : ℤ) : ℂ) (((0 : ℕ) : ℤ) : ℂ) (z₀G) by simp [dTh]]
  exact (dS_ctr_grid SH NH MH 1 gH_Z _ _).symm

/-- The centre `thUe` is `∂_θ` of the centre `Ue`. -/
theorem dTh_xH_thUe : xH 12 = dTh (uSG) := by
  rw [← embed_xH_Ue]
  rw [show dTh (xH 10) = dS (((1 : ℕ) : ℤ) : ℂ) (((0 : ℕ) : ℤ) : ℂ) (xH 10) by simp [dTh]]
  exact (dS_ctr_grid SH NH MH 0 gH_Ue _ _).symm

/-- The centre `thZe` is `∂_θ` of the centre `Ze`. -/
theorem dTh_xH_thZe : xH 13 = dTh (zSG) := by
  rw [← embed_xH_Ze]
  rw [show dTh (xH 11) = dS (((1 : ℕ) : ℤ) : ℂ) (((0 : ℕ) : ℤ) : ℂ) (xH 11) by simp [dTh]]
  exact (dS_ctr_grid SH NH MH 1 gH_Ze _ _).symm

/-- The transport input `LRx`. -/
theorem stepH_LRx {r : ℝ} (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) :
    Bd r (XH 6 - xH 6) (EH 6) :=
  step_Linput (ana_ctr_grid SH NH MH _ _) (dS_ctr_grid SH NH MH 0 gH_U _ _).symm
    (dTh_xH_thU ▸ normH hq 8 (by norm_num))
    (by kernel_fact)

/-- The transport input `LZx`. -/
theorem stepH_LZx {r : ℝ} (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) :
    Bd r (XH 7 - xH 7) (EH 7) :=
  step_Linput (ana_ctr_grid SH NH MH _ _) (dS_ctr_grid SH NH MH 1 gH_Z _ _).symm
    (dTh_xH_thZ ▸ normH hq 9 (by norm_num))
    (by kernel_fact)

set_option linter.unusedVariables false in
set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- The node step: the ball of `(1 + E)^{−1/2}`. -/
theorem vnodeH {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16)
    (hE : ∀ i, i < 53 → Bd r (XH i - xH i) (EH i)) :
    Bd r (XH 53 - xH 53) (EH 53) := by
  have hn : ∀ i, i < 53 → Bd r (xH i) (BH i) := fun i hi => normH hq i (by omega)
  have h1 := norm_full hr hq hWH boxH l1H kronH (fun _ => rfl) hn hE trH_Vm1 (1, 0, 0) 80 60 127 81 7 6 40 30 
      (1833 / 10 ^ 5 : ℚ) (by kernel_fact) (by kernel_fact) (by kernel_fact) lH_Vm1 kH_Vm1 (by kernel_fact)
  have h2 := norm_full hr hq hWH boxH l1H kronH (fun _ => rfl) hn hE trH_V2m1 (2, 0, 0) 160 120 251 161 8 7 80 60 
      (3693 / 10 ^ 5 : ℚ) (by kernel_fact) (by kernel_fact) (by kernel_fact) lH_V2m1 kH_V2m1 (by kernel_fact)
  have h3 := norm_full hr hq hWH boxH l1H kronH (fun _ => rfl) hn hE trH_eta (3, 0, 0) 240 180 375 241 8 8 120 90 
      (847 / 10 ^ 26 : ℚ) (by kernel_fact) (by kernel_fact) (by kernel_fact) lH_eta kH_eta (by kernel_fact)
  have e1 : Ex.eval XH trH_Vm1 = xH 52 - 1 := by
    unfold trH_Vm1; simp only [Ex.eval, XH]
  have e2 : Ex.eval XH trH_V2m1 = xH 52 ^ 2 - 1 := by
    unfold trH_V2m1; simp only [Ex.eval, XH]; ring
  have e3 : Ex.eval XH trH_eta = xH 52 ^ 2 * (1 + XH 51) - 1 := by
    unfold trH_eta; simp only [Ex.eval, XH]; ring
  rw [e1] at h1
  rw [e2] at h2
  rw [e3] at h3
  have hEb : Bd r (XH 51) ((BH 51 + EH 51 : ℚ) : ℝ) := by
    have := (hn 51 (by norm_num)).add (hE 51 (by norm_num))
    rw [add_sub_cancel] at this; push_cast; exact this
  have hv := vstep (a := (((1833 / 10 ^ 5 : ℚ) : ℚ) : ℝ)) (n2 := (((3693 / 10 ^ 5 : ℚ) : ℚ) : ℝ)) (η := (((847 / 10 ^ 26 : ℚ) : ℚ) : ℝ))
    (b := (((25467 / 25000 : ℚ) : ℚ) : ℝ)) (m := (((3833 / 10 ^ 5 : ℚ) : ℚ) : ℝ)) (g := (((50987 / 50000 : ℚ) : ℚ) : ℝ)) (ε := ((EH 53 : ℚ) : ℝ))
    hr h1 h2 h3 hEb
    (by exact_mod_cast (show (1833 / 10 ^ 5 : ℚ) < 1 by kernel_fact))
    (by exact_mod_cast (show 1 / (1 - (1833 / 10 ^ 5 : ℚ)) ≤ (25467 / 25000 : ℚ) by kernel_fact))
    (by exact_mod_cast (show (25467 / 25000 : ℚ) ^ 2 * (3693 / 10 ^ 5 : ℚ) ≤ (3833 / 10 ^ 5 : ℚ) by kernel_fact))
    (by exact_mod_cast (show BH 51 + EH 51 ≤ (3833 / 10 ^ 5 : ℚ) by kernel_fact))
    (by exact_mod_cast (show (3833 / 10 ^ 5 : ℚ) < 1 by kernel_fact))
    (by exact_mod_cast (show (0 : ℚ) ≤ (50987 / 50000 : ℚ) by kernel_fact))
    (by exact_mod_cast (show 1 ≤ (50987 / 50000 : ℚ) ^ 2 * (1 - (3833 / 10 ^ 5 : ℚ)) by kernel_fact))
    (by exact_mod_cast (show (50987 / 50000 : ℚ) ^ 3 / 2 * (3833 / 10 ^ 5 : ℚ) + (1833 / 10 ^ 5 : ℚ) < 2 by kernel_fact))
    (by exact_mod_cast (show (50987 / 50000 : ℚ) ^ 3 / 2 * ((25467 / 25000 : ℚ) ^ 2 * (847 / 10 ^ 26 : ℚ)) ≤ EH 53 by kernel_fact))
  have eX : XH 53 = invSqrt ℂ 1 (algebraMap ℂ FA ((1 : ℝ) : ℂ) + XH 51) := by
    simp only [XH, eV, PolyExprS.eval, PolyExprS.eval_ofPoly]
    rfl
  rw [eX, show xH 53 = xH 52 from rfl]
  exact hv

