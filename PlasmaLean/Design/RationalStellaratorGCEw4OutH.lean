  PlasmaLean.Certificates.Kron2 WEll1Z2 Complex

/-- The full chain. -/
theorem ballHE4_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) :
    ∀ i, i < 99 → Bd r (XHE4 c i - xHE4 c i) (EHE4 i) :=
  ballHE4_99 hr hq hc

/-- A value is bounded by its centre norm plus its radius. -/
theorem valHE4_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1)
    (i : ℕ) (hi : i < 99) :
    Bd r (XHE4 c i) ((BHE4 i + EHE4 i : ℚ) : ℝ) := by
  have := (normHE4 hq hc i hi).add (ballHE4_all hr hq hc i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

