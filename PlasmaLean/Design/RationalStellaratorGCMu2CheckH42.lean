/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH42`)

The checks of `Design/RationalStellaratorGCMu2CheckH42` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nRphP`. -/
theorem cHMS_nRphP : center3KS KvSHM NHM MHM 37 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRphP`. -/
theorem clHM_nRphP : LHM 37 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `Bm`. -/
theorem cHMS_Bm : center3KS KvSHM NHM MHM 83 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Bm`. -/
theorem clHM_Bm : LHM 83 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `QPP4P`: truncation norm. -/
theorem kHMS_QPP4P : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_QPP4P (1 : Int) 1 0 78 243 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `QPP4P`: a priori `ℓ¹` bound. -/
theorem lHM_QPP4P : nodeL1N SHM LHM trHMN_QPP4P (1 : Int) 1 0 78 < 2 ^ (243 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
