module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH
public import PlasmaLean.Design.RationalStellaratorGCMuKvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMuCheckH47`)

The checks of `Design/RationalStellaratorGCMuCheckH47` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMuLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `RD`. -/
theorem cHMS_RD : center3KS KvSHM NHM MHM 42 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `RD`. -/
theorem clHM_RD : LHM 42 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `Nn`. -/
theorem cHMS_Nn : center3KS KvSHM NHM MHM 88 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Nn`. -/
theorem clHM_Nn : LHM 88 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `etaN`. -/
theorem kHMS_etaN : norm3KS WtHM KvSHM NHM MHM trHMN_etaN (2, 0, 0) 240 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `etaN`: a priori `ℓ¹` bound. -/
theorem lHM_etaN : ExN.majN LHM trHMN_etaN < 2 ^ (240 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
