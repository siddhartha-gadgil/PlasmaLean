/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMuCheckH63`)

The checks of `Design/RationalStellaratorGCMuCheckH63` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMuLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZtF`. -/
theorem cHMS_nZtF : center3KS KvSHM NHM MHM 95 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZtF`. -/
theorem clHM_nZtF : LHM 95 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `nRp`: truncation norm. -/
theorem kHMS_nRp : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nRp (8 : Int) 0 1 30 124 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nRp`: a priori `ℓ¹` bound. -/
theorem lHM_nRp : nodeL1N SHM LHM trHMN_nRp (8 : Int) 0 1 30 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `nZp`: truncation norm. -/
theorem kHMS_nZp : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nZp (16 : Int) 0 1 31 125 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nZp`: a priori `ℓ¹` bound. -/
theorem lHM_nZp : nodeL1N SHM LHM trHMN_nZp (16 : Int) 0 1 31 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `nRuP`: truncation norm. -/
theorem kHMS_nRuP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nRuP (8 : Int) 0 1 35 126 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nRuP`: a priori `ℓ¹` bound. -/
theorem lHM_nRuP : nodeL1N SHM LHM trHMN_nRuP (8 : Int) 0 1 35 < 2 ^ (126 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
