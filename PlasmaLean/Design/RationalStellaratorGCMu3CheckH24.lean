/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu3CheckH24`)

The checks of `Design/RationalStellaratorGCMu3CheckH24` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m21`. -/
theorem cHMS_m21 : center3KS KvSHM NHM MHM 19 111 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m21`. -/
theorem clHM_m21 : LHM 19 < 2 ^ (111 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `A2`. -/
theorem cHMS_A2 : center3KS KvSHM NHM MHM 61 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `A2`. -/
theorem clHM_A2 : LHM 61 < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m51`: truncation norm. -/
theorem kHMS_m51 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m51 (1 : Int) 1 0 27 222 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m51`: a priori `ℓ¹` bound. -/
theorem lHM_m51 : nodeL1N SHM LHM trHMN_m51 (1 : Int) 1 0 27 < 2 ^ (222 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu3
