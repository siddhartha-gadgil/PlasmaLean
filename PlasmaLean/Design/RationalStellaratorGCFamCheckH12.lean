set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `Vm1`. -/
theorem kHF_Vm1 : norm3KN WtHF KvHF NHF MHF trHFN_Vm1 (1, 0, 0) 123 73 55 21 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `Vm1`: a priori `ℓ¹` bound. -/
theorem lHF_Vm1 : ExN.majN LHF trHFN_Vm1 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `DtF`: truncation norm. -/
