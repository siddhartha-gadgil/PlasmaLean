module

public import PlasmaLean.Design.RationalStellaratorGCFamTreesH
public import PlasmaLean.Design.RationalStellaratorGCFamKvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCFamCheckH7`)

The checks of `Design/RationalStellaratorGCFamCheckH7` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHF`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCFamLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `K3`: truncation norm. -/
theorem kHFS_K3 : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_K3 (1 : Int) 1 0 64 246 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `K3`: a priori `ℓ¹` bound. -/
theorem lHF_K3 : nodeL1N SHF LHF trHFN_K3 (1 : Int) 1 0 64 < 2 ^ (246 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `YnZt`: truncation norm. -/
theorem kHFS_YnZt : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_YnZt (1 : Int) 1 0 76 245 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `YnZt`: a priori `ℓ¹` bound. -/
theorem lHF_YnZt : nodeL1N SHF LHF trHFN_YnZt (1 : Int) 1 0 76 < 2 ^ (245 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
