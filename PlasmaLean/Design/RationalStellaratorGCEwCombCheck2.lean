module

public import PlasmaLean.Design.RationalStellaratorGCEwCombEnv

/-!
# Kernel checks of the energy-window combinations (part 2)

Each theorem is one kernel evaluation (`decide +kernel`) of the weighted digit sum `norm3KN` of the
Kronecker image of an integer combination of node tori (`Design/RationalStellaratorGCEwCombEnv`).
Light module. Generated by `scripts/gc_kam/ew_comb.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C1U`. -/
theorem kEw_C1U : norm3KN WtEw KvEw 36 27 trEwC_C1U (1, 0, 0) 133 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C1U`. -/
theorem lEw_C1U : ExN.majN LEw trEwC_C1U < 2 ^ (133 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `D0Z`. -/
theorem kEw_D0Z : norm3KN WtEw KvEw 36 27 trEwC_D0Z (1, 0, 1) 129 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `D0Z`. -/
theorem lEw_D0Z : ExN.majN LEw trEwC_D0Z < 2 ^ (129 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C3LZx`. -/
theorem kEw_C3LZx : norm3KN WtEw KvEw 36 27 trEwC_C3LZx (1, 0, 0) 227 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C3LZx`. -/
theorem lEw_C3LZx : ExN.majN LEw trEwC_C3LZx < 2 ^ (227 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C2thZ`. -/
theorem kEw_C2thZ : norm3KN WtEw KvEw 36 27 trEwC_C2thZ (1, 0, 0) 128 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C2thZ`. -/
theorem lEw_C2thZ : ExN.majN LEw trEwC_C2thZ < 2 ^ (128 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
