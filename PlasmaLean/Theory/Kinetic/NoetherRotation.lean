module

public import PlasmaLean.Theory.Kinetic.NoetherLagrangian
public import PlasmaLean.Theory.Kinetic.CanonicalMomentum

/-!
# Canonical angular momentum of a charged particle from TauCeti's Noether theorem

`Theory/Kinetic/NoetherLagrangian` derives the canonical momentum along a translation symmetry
from TauCeti's Noether theorem (`TauCeti.noetherCharge_eq_of_eulerLagrange`). This file does the
same for a linear symmetry `ξ(t, y) = K y` generated by a skew continuous linear map `K`
(`⟪K v, v⟫ = 0`), for the Lagrangian `L(x, v) = (m/2)‖v‖² + q⟪A(x), v⟫` of
`lorentzLagrangian`.

* `lagrangianVariation_lorentzLagrangian_linear`: the infinitesimal variation of `L` under
  `K` is `q⟪DA(y)(K y) − K(A y), u⟫` at `(y, u)`.
* `noetherMomentum_linear_gauge_conserved`: if `DA(y)(K y) = K(A y) + ∇χ(y)` (the potential
  is equivariant under `K` up to a gradient), then `m⟪K x, v⟫ + q(⟪A(x), K x⟫ − χ(x))` is
  constant along every Lorentz orbit. It is TauCeti's Noether charge with gauge term `qχ`.
* `noetherMomentum_linear_conserved`: the case `χ = 0`, `DA(y)(K y) = K(A y)`: the momentum
  `m⟪K x, v⟫ + q⟪A(x), K x⟫` is constant.
* `rotGenZ`: the generator `y ↦ e_z × y` of the rotations about the `z`-axis, and
  `canonicalMomentum_rotGenZ_conserved`, `canonicalMomentum_rotGenZ_gauge_conserved`: the same laws
  as conservation of the existing `canonicalMomentum` `m (x × v)_z + qψ`, with
  `ψ = ⟪A, e_z × x⟫` (minus `χ` in the gauge case).

Scope: no electric field, time-independent `A` defined and differentiable on all of space,
`B = ∇ × A` everywhere. The symmetry hypothesis is the infinitesimal one; it is not derived
here from invariance of `A` under the rotation group. That `ψ = ⟪A, K x⟫` satisfies
`AxisymmetricFlux` / `SymmetricFlux` (the hypothesis of the direct proofs) is not proved here.
-/

@[expose] public section

namespace PlasmaLean.Kinetic

open PlasmaLean.Fields PlasmaLean.Vacuum PlasmaLean.Forms WithLp
open TauCeti Topology
open scoped RealInnerProductSpace

/-- A skew linear map is antisymmetric: `⟪K a, b⟫ + ⟪K b, a⟫ = 0`. -/
theorem inner_add_inner_eq_zero_of_skew {K : Space →L[ℝ] Space} (hK : ∀ v, ⟪K v, v⟫ = 0)
    (a b : Space) : ⟪K a, b⟫ + ⟪K b, a⟫ = 0 := by
  have h := hK (a + b)
  rw [map_add, inner_add_left, inner_add_right, inner_add_right, hK a, hK b] at h
  linarith

/-- `lorentzLagrangian` is differentiable in `(x, v)` where `A` is differentiable. -/
theorem differentiableAt_lorentzLagrangian (m q : ℝ) {A : Space → Space} (t : ℝ)
    {p : Space × Space} (hA : DifferentiableAt ℝ A p.1) :
    DifferentiableAt ℝ (lorentzLagrangian m q A t) p := by
  unfold lorentzLagrangian
  have hA1 : DifferentiableAt ℝ (fun p : Space × Space => A p.1) p :=
    hA.comp p differentiableAt_fst
  exact ((differentiableAt_snd.norm_sq ℝ).const_mul _).add
    ((hA1.inner ℝ differentiableAt_snd).const_mul _)

/-- The infinitesimal variation of `lorentzLagrangian` under a skew linear generator `K`
is `q⟪DA(y)(K y) − K(A y), u⟫`: the kinetic term is invariant, and what is left measures the
failure of `A` to be equivariant. -/
theorem lagrangianVariation_lorentzLagrangian_linear (m q : ℝ) {A : Space → Space}
    {K : Space →L[ℝ] Space} (hK : ∀ v, ⟪K v, v⟫ = 0) (t : ℝ) {y : Space} (u : Space)
    (hA : DifferentiableAt ℝ A y) :
    lagrangianVariation (lorentzLagrangian m q A) (K ∘ Prod.snd) t (y, u)
      = q * ⟪fderiv ℝ A y (K y) - K (A y), u⟫ := by
  have hξ : fderiv ℝ (K ∘ Prod.snd : ℝ × Space → Space) (t, y) (1, u) = K u := by
    rw [(K.hasFDerivAt.comp (t, y) (hasFDerivAt_snd (𝕜 := ℝ) (E := ℝ) (F := Space))).fderiv]
    rfl
  rw [lagrangianVariation_eq_add (differentiableAt_lorentzLagrangian m q t hA)]
  change fderiv ℝ (fun z => lorentzLagrangian m q A t (z, u)) y (K y)
    + fderiv ℝ (fun w => lorentzLagrangian m q A t (y, w)) u
      (fderiv ℝ (K ∘ Prod.snd : ℝ × Space → Space) (t, y) (1, u)) = _
  rw [hξ, (hasFDerivAt_lorentzLagrangian_position m q t u hA).fderiv,
    (hasFDerivAt_lorentzLagrangian_velocity m q A t y u).fderiv]
  simp only [add_apply, smul_apply, innerSL_apply_apply, ContinuousLinearMap.comp_apply,
    smul_eq_mul]
  have h1 := inner_add_inner_eq_zero_of_skew hK (A y) u
  rw [inner_sub_left, real_inner_comm (K u) u, hK u, real_inner_comm (fderiv ℝ A y (K y)) u,
    real_inner_comm (K u) (A y)]
  linear_combination q * h1

/-- **Canonical momentum along a linear symmetry with a gauge term, from TauCeti's Noether
theorem.** Let `K` be skew, `B = ∇ × A` with `A` differentiable, and let `A` be equivariant
under `K` up to the gradient `G = ∇χ`: `DA(y)(K y) = K(A y) + G(y)`. Then
`m⟪K x, v⟫ + q(⟪A(x), K x⟫ − χ(x))` is constant along every Lorentz orbit. -/
theorem noetherMomentum_linear_gauge_conserved {m q : ℝ} {A B G : Space → Space}
    {χ : Space → ℝ} {x v : ℝ → Space} {K : Space →L[ℝ] Space}
    (h : LorentzOrbit m q (fun _ => 0) B x v) (hK : ∀ w, ⟪K w, w⟫ = 0)
    (hA : Differentiable ℝ A) (hcurl : ∀ y, B y = fieldCurl A y)
    (hχ : ∀ y, HasFDerivAt χ (innerSL ℝ (G y)) y)
    (hequiv : ∀ y, fderiv ℝ A y (K y) = K (A y) + G y) (s t : ℝ) :
    noetherMomentum m q (fun y => K y) (fun y => ⟪A y, K y⟫ - χ y) x v s
      = noetherMomentum m q (fun y => K y) (fun y => ⟪A y, K y⟫ - χ y) x v t := by
  have hBd : ∀ r, HasFDerivAt (fun z : ℝ × Space => q * χ z.2)
      (q • (innerSL ℝ (G (x r))).comp (ContinuousLinearMap.snd ℝ ℝ Space)) (r, x r) :=
    fun r => ((hχ (x r)).comp (r, x r) hasFDerivAt_snd).const_mul q
  have key := noetherCharge_eq_of_eulerLagrange (L := lorentzLagrangian m q A)
    (ξ := K ∘ Prod.snd) (B := fun z => q * χ z.2) (q := x) (v := v)
    isOpen_univ isPreconnected_univ
    (fun r _ => h.position r) (fun r _ => lorentzOrbit_eulerLagrange h hA hcurl r)
    (fun r _ => differentiableAt_lorentzLagrangian m q r (hA (x r)))
    (fun r _ => K.differentiableAt.comp (r, x r) differentiableAt_snd)
    (fun r _ => (hBd r).differentiableAt)
    (fun r _ => by
      rw [lagrangianVariation_lorentzLagrangian_linear m q hK r (v r) (hA (x r)),
        (hBd r).fderiv, hequiv]
      simp)
    (Set.mem_univ s) (Set.mem_univ t)
  have hch : ∀ r, noetherCharge (lorentzLagrangian m q A) (K ∘ Prod.snd)
      (fun z => q * χ z.2) r (x r, v r)
      = noetherMomentum m q (fun y => K y) (fun y => ⟪A y, K y⟫ - χ y) x v r := fun r => by
    rw [noetherCharge_apply,
      (hasFDerivAt_lorentzLagrangian_velocity m q A r (x r) (v r)).fderiv, noetherMomentum]
    simp only [Function.comp_apply, add_apply, smul_apply, innerSL_apply_apply, smul_eq_mul]
    rw [real_inner_comm (K (x r)) (v r)]
    ring
  rw [← hch s, ← hch t]
  exact key

/-- **Canonical momentum along a linear symmetry, from TauCeti's Noether theorem.** Let `K` be
skew, `B = ∇ × A` with `A` differentiable, and let `A` be infinitesimally equivariant under
`K`: `DA(y)(K y) = K(A y)`. Then `m⟪K x, v⟫ + q⟪A(x), K x⟫` is constant along every Lorentz
orbit. It is TauCeti's Noether charge for the symmetry `ξ(t, y) = K y` with zero gauge
term. -/
theorem noetherMomentum_linear_conserved {m q : ℝ} {A B : Space → Space}
    {x v : ℝ → Space} {K : Space →L[ℝ] Space}
    (h : LorentzOrbit m q (fun _ => 0) B x v) (hK : ∀ w, ⟪K w, w⟫ = 0)
    (hA : Differentiable ℝ A) (hcurl : ∀ y, B y = fieldCurl A y)
    (hequiv : ∀ y, fderiv ℝ A y (K y) = K (A y)) (s t : ℝ) :
    noetherMomentum m q (fun y => K y) (fun y => ⟪A y, K y⟫) x v s
      = noetherMomentum m q (fun y => K y) (fun y => ⟪A y, K y⟫) x v t := by
  have key := noetherMomentum_linear_gauge_conserved (G := fun _ => 0) (χ := fun _ => 0)
    h hK hA hcurl (fun y => by simpa using hasFDerivAt_const (0 : ℝ) y)
    (fun y => by simpa using hequiv y) s t
  simpa using key

/-! ### Rotation about the `z`-axis -/

/-- The generator of the rotations about the `z`-axis, `y ↦ e_z × y = (−y₁, y₀, 0)`. -/
noncomputable def rotGenZ : Space →L[ℝ] Space :=
  (EuclideanSpace.proj 0 : Space →L[ℝ] ℝ).smulRight (coordVec 1)
    - (EuclideanSpace.proj 1 : Space →L[ℝ] ℝ).smulRight (coordVec 0)

/-- Components of `rotGenZ`. -/
theorem rotGenZ_coords (y : Space) :
    rotGenZ y 0 = -y 1 ∧ rotGenZ y 1 = y 0 ∧ rotGenZ y 2 = 0 := by
  simp [rotGenZ]

/-- `rotGenZ y = e_z × y`. -/
theorem rotGenZ_eq_cross (y : Space) : rotGenZ y = cross (coordVec 2) y := by
  obtain ⟨h0, h1, h2⟩ := rotGenZ_coords y
  obtain ⟨c0, c1, c2⟩ := cross_coords (coordVec 2) y
  ext i
  fin_cases i
  · simp [h0, c0]
  · simp [h1, c1]
  · simp [h2, c2]

/-- `⟪e_z × x, v⟫ = (x × v)_z`. -/
theorem inner_rotGenZ (x v : Space) : ⟪rotGenZ x, v⟫ = angularZ x v := by
  obtain ⟨h0, h1, h2⟩ := rotGenZ_coords x
  rw [inner_coords3, h0, h1, h2, angularZ]
  ring

/-- `rotGenZ` is skew. -/
theorem inner_rotGenZ_self (v : Space) : ⟪rotGenZ v, v⟫ = 0 := by
  rw [inner_rotGenZ, angularZ]
  ring

/-- The Noether momentum of `rotGenZ` is the canonical angular momentum. -/
theorem noetherMomentum_rotGenZ (m q : ℝ) (ψ : Space → ℝ) (x v : ℝ → Space) (t : ℝ) :
    noetherMomentum m q (fun y => rotGenZ y) ψ x v t = canonicalMomentum m q ψ x v t := by
  rw [noetherMomentum, canonicalMomentum, inner_rotGenZ]

/-- **Canonical angular momentum from Noether's theorem.** If `B = ∇ × A` with `A`
differentiable and infinitesimally equivariant under the rotations about the `z`-axis,
`DA(y)(e_z × y) = e_z × A(y)`, then `canonicalMomentum` `m (x × v)_z + qψ` with
`ψ(y) = ⟪A(y), e_z × y⟫` is constant along every Lorentz orbit. -/
theorem canonicalMomentum_rotGenZ_conserved {m q : ℝ} {A B : Space → Space}
    {x v : ℝ → Space}
    (h : LorentzOrbit m q (fun _ => 0) B x v) (hA : Differentiable ℝ A)
    (hcurl : ∀ y, B y = fieldCurl A y)
    (hequiv : ∀ y, fderiv ℝ A y (rotGenZ y) = rotGenZ (A y)) (s t : ℝ) :
    canonicalMomentum m q (fun y => ⟪A y, rotGenZ y⟫) x v s
      = canonicalMomentum m q (fun y => ⟪A y, rotGenZ y⟫) x v t := by
  rw [← noetherMomentum_rotGenZ, ← noetherMomentum_rotGenZ]
  exact noetherMomentum_linear_conserved h inner_rotGenZ_self hA hcurl hequiv s t

/-- **Canonical angular momentum with a gauge term.** If `A` is equivariant under the
rotations about the `z`-axis only up to the gradient `G = ∇χ`,
`DA(y)(e_z × y) = e_z × A(y) + G(y)`, then `canonicalMomentum` with
`ψ(y) = ⟪A(y), e_z × y⟫ − χ(y)` is constant along every Lorentz orbit. -/
theorem canonicalMomentum_rotGenZ_gauge_conserved {m q : ℝ} {A B G : Space → Space}
    {χ : Space → ℝ} {x v : ℝ → Space} (h : LorentzOrbit m q (fun _ => 0) B x v)
    (hA : Differentiable ℝ A) (hcurl : ∀ y, B y = fieldCurl A y)
    (hχ : ∀ y, HasFDerivAt χ (innerSL ℝ (G y)) y)
    (hequiv : ∀ y, fderiv ℝ A y (rotGenZ y) = rotGenZ (A y) + G y) (s t : ℝ) :
    canonicalMomentum m q (fun y => ⟪A y, rotGenZ y⟫ - χ y) x v s
      = canonicalMomentum m q (fun y => ⟪A y, rotGenZ y⟫ - χ y) x v t := by
  rw [← noetherMomentum_rotGenZ, ← noetherMomentum_rotGenZ]
  exact noetherMomentum_linear_gauge_conserved h inner_rotGenZ_self hA hcurl hχ hequiv s t

end PlasmaLean.Kinetic
