meta import PlasmaLean.Design.RationalStellaratorGCEw4KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw4CheckH30`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `RD`. -/
theorem cHE4S_RD : center3KS KvSHE4 NHE4 MHE4 42 122 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `RD`. -/
theorem clHE4_RD : LHE4 42 < 2 ^ (122 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `r`. -/
theorem cHE4S_r : center3KS KvSHE4 NHE4 MHE4 71 129 37 28 14 9 8 5 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `r`. -/
theorem clHE4_r : LHE4 71 < 2 ^ (129 - 1) := by
  kron_lt

/-- Proof-term check of the node `RDu`: truncation norm. -/
theorem kHE4S_RDu : node3KS SHE4 NHE4 MHE4 DHE4 WtHE4 KvSHE4 trHE4N_RDu (1 : Int) 1 0 43 240 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `RDu`: a priori `ℓ¹` bound. -/
theorem lHE4_RDu : nodeL1N SHE4 LHE4 trHE4N_RDu (1 : Int) 1 0 43 < 2 ^ (240 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
