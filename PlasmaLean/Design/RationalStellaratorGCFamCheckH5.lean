module

public import PlasmaLean.Design.RationalStellaratorGCFamTreesH
public import PlasmaLean.Design.RationalStellaratorGCFamKvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCFamCheckH5`)

The checks of `Design/RationalStellaratorGCFamCheckH5` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHF`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCFamLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `r`. -/
theorem cHFS_r : center3KS KvSHF NHF MHF 71 129 37 28 12 9 8 5 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `r`. -/
theorem clHF_r : LHF 71 < 2 ^ (129 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m20`: truncation norm. -/
theorem kHFS_m20 : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_m20 (1 : Int) 1 0 16 236 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m20`: a priori `ℓ¹` bound. -/
theorem lHF_m20 : nodeL1N SHF LHF trHFN_m20 (1 : Int) 1 0 16 < 2 ^ (236 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `resZ`. -/
theorem kHFS_resZ : norm3KS WtHF KvSHF NHF MHF trHFN_resZ (2, 0, 0) 341 145 109 41 13 4 37 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `resZ`: a priori `ℓ¹` bound. -/
theorem lHF_resZ : ExN.majN LHF trHFN_resZ < 2 ^ (341 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
