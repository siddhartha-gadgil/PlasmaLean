module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 35)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMuDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nRp`. -/
theorem cHM_nRp : center3KN KvHM NHM MHM 30 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRp`. -/
theorem clHM_nRp : LHM 30 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `E4P`. -/
theorem cHM_E4P : center3KN KvHM NHM MHM 76 108 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `E4P`. -/
theorem clHM_E4P : LHM 76 < 2 ^ (108 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `A1`: truncation norm. -/
theorem kHM_A1 : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_A1 (1 : Int) 1 0 60 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `A1`: a priori `ℓ¹` bound. -/
theorem lHM_A1 : nodeL1N SHM LHM trHMN_A1 (1 : Int) 1 0 60 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
