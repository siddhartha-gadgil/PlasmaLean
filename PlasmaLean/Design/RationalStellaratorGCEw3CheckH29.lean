/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw3CheckH29`)

The checks of `Design/RationalStellaratorGCEw3CheckH29` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE3`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `PuP`. -/
theorem cHE3S_PuP : center3KS KvSHE3 NHE3 MHE3 41 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `PuP`. -/
theorem clHE3_PuP : LHE3 41 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZtJ`. -/
theorem cHE3S_nZtJ : center3KS KvSHE3 NHE3 MHE3 98 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZtJ`. -/
theorem clHE3_nZtJ : LHE3 98 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `RD`: truncation norm. -/
theorem kHE3S_RD : node3KS SHE3 NHE3 MHE3 DHE3 WtHE3 KvSHE3 trHE3N_RD (1 : Int) 1 0 42 239 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `RD`: a priori `ℓ¹` bound. -/
theorem lHE3_RD : nodeL1N SHE3 LHE3 trHE3N_RD (1 : Int) 1 0 42 < 2 ^ (239 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
