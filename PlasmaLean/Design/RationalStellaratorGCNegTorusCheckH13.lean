meta import PlasmaLean.Design.RationalStellaratorGCNegTorusTreesH

/-!
# Proof-term checks of the guiding-centre torus certificate (`v∥ < 0`) (high resolution, part 13)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`: block sums
of the digit reading as kernel facts; `kron_lt` for the `ℓ¹` bounds) on the data of
`Design/RationalStellaratorGCNegTorusDataH*`: the weighted digit sums (`nodeK`, `normK`,
`centerK` of `Certificates/KronBallGrid`) of the Kronecker images of the truncation polynomials
of the ball pipeline, and their a priori `ℓ¹` bounds. Generated by
`scripts/gc_kam/neg_emit_lean.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGCNeg

open PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `m20`. -/
theorem cH_m20 : centerK NH MH KvH 16 127 81 7 6 40 30 ≤  := by
  kron2_proof

/-- A priori `ℓ¹` bound of the centre `m20`. -/
theorem clH_m20 : LH 16 < 2 ^ (127 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `DuP`. -/
theorem cH_DuP : centerK NH MH KvH 32 127 81 7 6 40 30 ≤  := by
