/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu3CheckH13`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the node `m11`: truncation norm. -/
theorem kHMS_m11 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m11 (1 : Int) 1 0 15 236 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m11`: a priori `ℓ¹` bound. -/
theorem lHM_m11 : nodeL1N SHM LHM trHMN_m11 (1 : Int) 1 0 15 < 2 ^ (236 - 1) := by
  kron_lt

/-- Proof-term check of the node `lamv`: truncation norm. -/
theorem kHMS_lamv : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_lamv (32 : Int) 0 0 84 130 73 55 25 11 8 10 36 27 ≤
    0 := by
  kron_proof

/-- Proof-term check of the node `lamv`: a priori `ℓ¹` bound. -/
theorem lHM_lamv : nodeL1N SHM LHM trHMN_lamv (32 : Int) 0 0 84 < 2 ^ (130 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu3
