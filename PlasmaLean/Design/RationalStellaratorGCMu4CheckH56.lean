meta import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu4CheckH56`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `nRtF`. -/
theorem cHMS_nRtF : center3KS KvSHM NHM MHM 93 118 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nRtF`. -/
theorem clHM_nRtF : LHM 93 < 2 ^ (118 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `dA`. -/
theorem kHMS_dA : norm3KS WtHM KvSHM NHM MHM trHMN_dA (1, 0, 3) 126 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `dA`: a priori `ℓ¹` bound. -/
theorem lHM_dA : ExN.majN LHM trHMN_dA < 2 ^ (126 - 1) := by
  kron_lt

/-- Proof-term check of the node `PuP`: truncation norm. -/
theorem kHMS_PuP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_PuP (1 : Int) 0 0 41 124 73 55 25 11 8 10 36 27 ≤
    0 := by
  kron_proof

/-- Proof-term check of the node `PuP`: a priori `ℓ¹` bound. -/
theorem lHM_PuP : nodeL1N SHM LHM trHMN_PuP (1 : Int) 0 0 41 < 2 ^ (124 - 1) := by
  kron_lt

/-- Proof-term check of the node `W2`: truncation norm. -/
theorem kHMS_W2 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_W2 (1 : Int) 1 0 56 244 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `W2`: a priori `ℓ¹` bound. -/
theorem lHM_W2 : nodeL1N SHM LHM trHMN_W2 (1 : Int) 1 0 56 < 2 ^ (244 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu4
