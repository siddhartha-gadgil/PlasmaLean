/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu5CheckH36`)

The checks of `Design/RationalStellaratorGCMu5CheckH36` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu5LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZp`. -/
theorem cHMS_nZp : center3KS KvSHM NHM MHM 31 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZp`. -/
theorem clHM_nZp : LHM 31 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `PP4`. -/
theorem cHMS_PP4 : center3KS KvSHM NHM MHM 77 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `PP4`. -/
theorem clHM_PP4 : LHM 77 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `A2`: truncation norm. -/
theorem kHMS_A2 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_A2 (1 : Int) 1 0 61 237 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `A2`: a priori `ℓ¹` bound. -/
theorem lHM_A2 : nodeL1N SHM LHM trHMN_A2 (1 : Int) 1 0 61 < 2 ^ (237 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu5
