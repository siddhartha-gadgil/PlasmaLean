  decide +kernel

/-- Kernel check of the node `P2`: a priori `ℓ¹` bound. -/
theorem lHE3_P2 : nodeL1N SHE3 LHE3 trHE3N_P2 (1 : Int) 1 0 50 < 2 ^ (244 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `P4P`: truncation norm. -/
theorem kHE3_P4P : node3KN SHE3 NHE3 MHE3 DHE3 WtHE3 KvHE3 trHE3N_P4P (1 : Int) 0 0 72 124 73 55 25 11 8 10 36 27 ≤
    0 := by
  decide +kernel

/-- Kernel check of the node `P4P`: a priori `ℓ¹` bound. -/
theorem lHE3_P4P : nodeL1N SHE3 LHE3 trHE3N_P4P (1 : Int) 0 0 72 < 2 ^ (124 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
