module

public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH17`)

The checks of `Design/RationalStellaratorGCMu4CheckH17` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `thUe`. -/
theorem cHMS_thUe : center3KS KvSHM NHM MHM 12 125 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thUe`. -/
theorem clHM_thUe : LHM 12 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `Vn`. -/
theorem cHMS_Vn : center3KS KvSHM NHM MHM 54 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Vn`. -/
theorem clHM_Vn : LHM 54 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m30`: truncation norm. -/
theorem kHMS_m30 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m30 (1 : Int) 1 0 20 232 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m30`: a priori `ℓ¹` bound. -/
theorem lHM_m30 : nodeL1N SHM LHM trHMN_m30 (1 : Int) 1 0 20 < 2 ^ (232 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
