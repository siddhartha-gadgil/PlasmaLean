/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw3CheckH61`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `Z`. -/
theorem cHE3S_Z : center3KS KvSHE3 NHE3 MHE3 5 119 73 55 25 11 1 73 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `Z`. -/
theorem clHE3_Z : LHE3 5 < 2 ^ (119 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `m41`. -/
theorem cHE3S_m41 : center3KS KvSHE3 NHE3 MHE3 25 105 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `m41`. -/
theorem clHE3_m41 : LHE3 25 < 2 ^ (105 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `VV4`. -/
theorem cHE3S_VV4 : center3KS KvSHE3 NHE3 MHE3 82 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `VV4`. -/
theorem clHE3_VV4 : LHE3 82 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `dZ`. -/
theorem kHE3S_dZ : norm3KS WtHE3 KvSHE3 NHE3 MHE3 trHE3N_dZ (1, 0, 1) 120 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `dZ`: a priori `ℓ¹` bound. -/
theorem lHE3_dZ : ExN.majN LHE3 trHE3N_dZ < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the node `R4`: truncation norm. -/
theorem kHE3S_R4 : node3KS SHE3 NHE3 MHE3 DHE3 WtHE3 KvSHE3 trHE3N_R4 (1 : Int) 1 0 73 242 145 109 49 13 8 19 72 54 ≤
