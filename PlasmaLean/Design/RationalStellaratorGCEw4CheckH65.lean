module

public import PlasmaLean.Design.RationalStellaratorGCEw4TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 65)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw4DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 4: gyro-length `ρ_4 = 1/256 + 2⁻³²`, its own family torus `K_4(λ)`; the
fields at `ρ_4` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `thZ`. -/
theorem cHE4_thZ : center3KN KvHE4 NHE4 MHE4 9 125 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thZ`. -/
theorem clHE4_thZ : LHE4 9 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m30`. -/
theorem cHE4_m30 : center3KN KvHE4 NHE4 MHE4 20 113 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m30`. -/
theorem clHE4_m30 : LHE4 20 < 2 ^ (113 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `E4P`. -/
theorem cHE4_E4P : center3KN KvHE4 NHE4 MHE4 76 108 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `E4P`. -/
theorem clHE4_E4P : LHE4 76 < 2 ^ (108 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `V2m1`. -/
theorem kHE4_V2m1 : norm3KN WtHE4 KvHE4 NHE4 MHE4 trHE4N_V2m1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
