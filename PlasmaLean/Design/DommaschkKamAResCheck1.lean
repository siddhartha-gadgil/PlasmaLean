module

public import PlasmaLean.Design.DommaschkKamAResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAResTrees

/-!
# Proof-term checks of the torus-A residual chain (part 1)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamAResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`cH_U`, `cH_Z`, `cH_LUx`, `cH_LZx`, `c1H_U`, `c1H_Z`, `kH_R`, `kH_s`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `U`. -/
theorem cH_U : centerKw 68553 16 NH MH KvH 4 135 193 8 8 96 80 ≤  := by
  kron2_proof

/-- A priori `ℓ¹` bound of the centre `U`. -/
theorem clH_U : LH 4 < 2 ^ (135 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `Z`. -/
theorem cH_Z : centerKw 68553 16 NH MH KvH 5 135 193 8 8 96 80 ≤  := by
  kron2_proof

/-- A priori `ℓ¹` bound of the centre `Z`. -/
theorem clH_Z : LH 5 < 2 ^ (135 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `LUx`. -/
theorem cH_LUx : centerKw 68553 16 NH MH KvH 6 264 193 8 8 96 80 ≤  := by
  kron2_proof

/-- A priori `ℓ¹` bound of the centre `LUx`. -/
theorem clH_LUx : LH 6 < 2 ^ (264 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `LZx`. -/
theorem cH_LZx : centerKw 68553 16 NH MH KvH 7 264 193 8 8 96 80 ≤  := by
  kron2_proof

/-- A priori `ℓ¹` bound of the centre `LZx`. -/
theorem clH_LZx : LH 7 < 2 ^ (264 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `U` on the strip `e^r ≤ 68897/2^16`. -/
theorem c1H_U : centerKw 68897 16 NH MH KvH 4 135 193 8 8 96 80 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `Z` on the strip `e^r ≤ 68897/2^16`. -/
theorem c1H_Z : centerKw 68897 16 NH MH KvH 5 135 193 8 8 96 80 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `R`: truncation norm. -/
theorem kH_R : nodeKw 68553 16 SH NH MH WtH KvH trH_R (32 : ℤ) 0 0 8 143 193 8 8 160 96 80 ≤ 0 := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `R`: a priori `ℓ¹` bound. -/
theorem lH_R : nodeL1 SH LH trH_R (32 : ℤ) 0 0 8 < 2 ^ (143 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `s`: truncation norm. -/
theorem kH_s : nodeKw 68553 16 SH NH MH WtH KvH trH_s (1 : ℤ) 1 0 9 274 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `s`: a priori `ℓ¹` bound. -/
theorem lH_s : nodeL1 SH LH trH_s (1 : ℤ) 1 0 9 < 2 ^ (274 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamA
