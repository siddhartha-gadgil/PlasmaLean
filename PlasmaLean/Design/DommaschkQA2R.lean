/-!
# The Dommaschk QA certification target (NFP 2, purely rational) is an exact vacuum field

Certification step 1 for the certification target of research note N-31
(`notes/theory/dommaschk-qa.md`, §24, refining the field of §22):
`scripts/dommaschk_qa/results/20261031T092522Z/candidate.json`
(NFP 2, nmax 3, lmax 5, 42 Dommaschk basis potentials, the 9 potentials containing `ln R` held at
exactly 0, so the field is purely rational). In cylindrical coordinates, with `R₀ = 1`,
`B = ∇φ + Σ_k a_k ∇V_k`, `V_k = trig(m_k φ) Σ c R^p (ln R)^q z^j` (exact rational data). The
pattern is that of `Design/DommaschkQA3` (the earlier NFP-3 candidate).

Lean model.
* `P k : CylPoly` (`DommaschkQA2RData`, generated by `scripts/dommaschk_qa/emit_lean.py` with the
  kernel checks split into `DommaschkQA2RDataCheck0`–`2` and done slice by slice in the
  `z`-degree, `CylAlgebra.sliceCheck`, to stay within the laptop memory budget) is the Cartesian
  form of `D_k V_k` with integer coefficients, `scale k = 1 / D_k`, `V k = scale k · eval (P k)`.
  The agreement with the cylindrical formula of `basis.py` is checked exactly by the generator
  (sympy), not in Lean.
* `field a = toroidal + Σ_k (a_k · scale k) • gradField (P k)` is `∇φ + Σ a_k ∇V_k`
  (`hasFDerivAt_V`); the target is `field candidate`.

Results.
* `basis_lapZero k`: the formal Laplacian of every basis potential evaluates to zero off the axis
  (sliced normal-form check, kernel-evaluated, `slice_P*`); hence `basis_vacuum k`, `V_harmonic`.
* **`field_vacuum a : VacuumField domain (field a)`** for every coefficient vector `a`, and
  **`candidate_vacuum`**.
* C1 current clause: `field_poloidalCirculation_eq_zero`, `candidate_loopCurrent_eq_zero` (zero
  circulation around every closed `C¹` poloidal loop at constant toroidal angle with `R > 0`),
  `candidate_currentFreeTransform` (C1 with `I_max = 0` reduces to certified tori with
  `|ι| ≥ ι_min`; their poloidal angle may be measured about a moving reference curve that follows
  the non-planar magnetic axis, as `IotaOnTorus` allows since the AR-L4 fix).
* Section flux (auxiliary): `candidate_netToroidalCurrent_eq_zero`, `candidate_currentFree`.
* `field_stellSym a`: stellarator symmetry `(x, y, z) ↦ (x, −y, −z)`, for every `a`.
* `candidate_log_free`: the coefficients of the 9 `ln R` potentials are exactly 0.

Sanity: `field_zero`, `eval_P0` (`V₀ = z`). Numerical cross-check (informal): at
`(x, y, z) = (21/20, 1/10, 1/50)` the emitted data give
`field candidate ≈ (−0.0996001333794, 0.972211286636, −0.0768064907229)`, agreeing with
`scripts/dommaschk_qa/fieldeval.py` to `10⁻¹⁴` (printed by `emit_lean.py`).

Not proved here: the two-field-period symmetry (rotation by `π`), field-line properties (axis,
rotational transform, flux surfaces) and the quasi-axisymmetry of `|B|`; the fit itself is
untrusted numerics.
-/

open scoped RealInnerProductSpace

public section
noncomputable section
namespace PlasmaLean.Design.DommaschkQA2R
open PlasmaLean.Fields PlasmaLean.Vacuum PlasmaLean.Fields.CylAlgebra PlasmaLean.Contract
open Set Real

/-- The region of the theorems, `{x² + y² > 0}`; equal to `RationalStellarator.domain`. -/
theorem domain_eq : CylAlgebra.domain = RationalStellarator.domain := rfl

/-- The Dommaschk basis potential `V_k = scale k · eval (P k)`. -/
@[expose] def V (k : Fin 42) (y : Space) : ℝ := (scale k : ℝ) * eval (P k) y

/-- **The candidate field family** `B_a = ∇φ + Σ_k a_k ∇V_k`. -/
@[expose] def field (a : Fin 42 → ℚ) (y : Space) : Space :=
  RationalStellarator.toroidal y + ∑ k, ((a k * scale k : ℚ) : ℝ) • gradField (P k) y

/-- `∇V_k = scale k • gradField (P k)` off the axis (actual Fréchet derivative). -/
theorem hasFDerivAt_V (k : Fin 42) {x : Space} (hx : x ∈ CylAlgebra.domain) :
    HasFDerivAt (V k) (innerSL ℝ ((scale k : ℝ) • gradField (P k) x)) x := by
  have := (hasFDerivAt_eval_inner (P k) (ne_of_gt hx)).const_mul (scale k : ℝ)
  refine this.congr_fderiv ?_
  ext v
  simp

/-- **Each basis potential is harmonic**: its formal Laplacian evaluates to zero off the axis
(sliced normal-form check, kernel-evaluated). -/
theorem basis_lapZero (k : Fin 42) : ∀ x : Space, r2 x ≠ 0 → eval (lap (P k)) x = 0 := by
  fin_cases k
  exacts [fun _ hx => eval_eq_zero_of_sliceCheck slice_P0 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P1 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P2 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P3 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P4 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P5 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P6 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P7 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P8 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P9 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P10 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P11 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P12 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P13 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P14 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P15 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P16 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P17 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P18 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P19 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P20 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P21 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P22 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P23 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P24 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P25 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P26 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P27 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P28 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P29 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P30 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P31 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P32 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P33 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P34 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P35 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P36 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P37 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P38 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P39 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P40 hx,
    fun _ hx => eval_eq_zero_of_sliceCheck slice_P41 hx]

/-- Every basis potential is odd under the stellarator symmetry. -/
theorem basis_parity (k : Fin 42) : parityCheck 1 (P k) = true := by
  fin_cases k
  exacts [parity_P0, parity_P1, parity_P2, parity_P3, parity_P4, parity_P5, parity_P6,
    parity_P7, parity_P8, parity_P9, parity_P10, parity_P11, parity_P12, parity_P13,
    parity_P14, parity_P15, parity_P16, parity_P17, parity_P18, parity_P19, parity_P20,
    parity_P21, parity_P22, parity_P23, parity_P24, parity_P25, parity_P26, parity_P27,
    parity_P28, parity_P29, parity_P30, parity_P31, parity_P32, parity_P33, parity_P34,
    parity_P35, parity_P36, parity_P37, parity_P38, parity_P39, parity_P40, parity_P41]

/-- `∂ₓ² + ∂_y² + ∂_z²` of each basis potential vanishes off the axis. -/
theorem V_harmonic (k : Fin 42) {x : Space} (hx : x ∈ CylAlgebra.domain) :
    eval (lap (P k)) x = 0 :=
  basis_lapZero k x (ne_of_gt hx)

/-- Each `∇V_k` (up to the factor `scale k`) is a vacuum field off the axis. -/
theorem basis_vacuum (k : Fin 42) : VacuumField CylAlgebra.domain (gradField (P k)) :=
  gradField_vacuum_of_eval (basis_lapZero k)

/-- **The candidate family is an exact vacuum field** off the `z`-axis, for every coefficient
vector `a`: open region, `C²`, `∇ · B = 0`, `∇ × B = 0`. -/
theorem field_vacuum (a : Fin 42 → ℚ) : VacuumField CylAlgebra.domain (field a) := by
  have hT : VacuumField CylAlgebra.domain RationalStellarator.toroidal :=
    RationalStellarator.toroidal_vacuum
  have hS := VacuumField.sum Finset.univ isOpen_domain
    (F := fun k => ((a k * scale k : ℚ) : ℝ) • gradField (P k)) fun k _ => (basis_vacuum k).smul _
  convert hT.add hS using 1
  funext y
  simp only [field, Pi.add_apply, Pi.smul_apply]

/-- **The Dommaschk QA certification target is an exact vacuum field** off the `z`-axis. -/
theorem candidate_vacuum : VacuumField CylAlgebra.domain (field candidate) :=
  field_vacuum candidate

/-- **Section flux**: every field of the family has zero flux of the Ampère current through any
section lying off the `z`-axis (a section-flux statement, not the C1 current). -/
theorem field_netToroidalCurrent_eq_zero (a : Fin 42 → ℚ) (μ₀ : ℝ) {X : Space → Space}
    {ζ₀ k₀ : ℝ} (hk₀ : 0 ≤ k₀)
    (hX : ∀ k ∈ Icc 0 k₀, ∀ χ ∈ Icc (-π) π, X (coordPt k χ ζ₀) ∈ CylAlgebra.domain) :
    netToroidalCurrent μ₀ (field a) X ζ₀ k₀ = 0 :=
  netToroidalCurrent_eq_zero_of_vacuum (field_vacuum a) hk₀ hX

/-- **Section flux for the candidate**: zero flux of the Ampère current through every section
lying off the `z`-axis (not the C1 current; see `candidate_loopCurrent_eq_zero`). -/
theorem candidate_netToroidalCurrent_eq_zero (μ₀ : ℝ) {X : Space → Space} {ζ₀ k₀ : ℝ}
    (hk₀ : 0 ≤ k₀)
    (hX : ∀ k ∈ Icc 0 k₀, ∀ χ ∈ Icc (-π) π, X (coordPt k χ ζ₀) ∈ CylAlgebra.domain) :
    netToroidalCurrent μ₀ (field candidate) X ζ₀ k₀ = 0 :=
  field_netToroidalCurrent_eq_zero candidate μ₀ hk₀ hX

/-- The candidate is section-current-free (`CurrentFree`, a section-flux notion) on every family
of sections lying off the `z`-axis. -/
theorem candidate_currentFree (μ₀ : ℝ) {X : Space → Space} {ζ₀ : ℝ} {K : Set ℝ}
    (hX : ∀ k₀ ∈ K, 0 ≤ k₀ ∧
      ∀ k ∈ Icc 0 k₀, ∀ χ ∈ Icc (-π) π, X (coordPt k χ ζ₀) ∈ CylAlgebra.domain) :
    CurrentFree μ₀ (field candidate) X ζ₀ K :=
  currentFree_of_vacuum candidate_vacuum hX

/-! ## Clause C1: zero circulation around poloidal loops -/

/-- The single-valued potential `Φ_a = Σ_k a_k V_k` of the non-toroidal part of `B_a`. -/
@[expose] def potential (a : Fin 42 → ℚ) (y : Space) : ℝ := ∑ k, (a k : ℝ) * V k y

/-- The non-toroidal part `g_a = Σ_k a_k ∇V_k` of `B_a`. -/
@[expose] def gradPart (a : Fin 42 → ℚ) (y : Space) : Space :=
  ∑ k, ((a k * scale k : ℚ) : ℝ) • gradField (P k) y

/-- `B_a = ∇φ + g_a`. -/
theorem field_split (a : Fin 42 → ℚ) (y : Space) :
    field a y = RationalStellarator.toroidal y + gradPart a y := rfl

/-- `g_a = ∇Φ_a` off the axis (actual Fréchet derivative). -/
theorem hasFDerivAt_potential (a : Fin 42 → ℚ) {x : Space} (hx : x ∈ CylAlgebra.domain) :
    HasFDerivAt (potential a) (innerSL ℝ (gradPart a x)) x := by
  have h := HasFDerivAt.sum (u := Finset.univ) (A := fun k y => (a k : ℝ) * V k y)
    (fun k _ => (hasFDerivAt_V k hx).const_mul (a k : ℝ))
  have he : (∑ k ∈ Finset.univ, fun y => (a k : ℝ) * V k y) = potential a := by
    funext y; simp [potential]
  rw [he] at h
  refine h.congr_fderiv ?_
  ext v
  simp [gradPart, mul_assoc]

/-- The fields of the family are continuous off the axis. -/
theorem continuousAt_field (a : Fin 42 → ℚ) {x : Space} (hx : x ∈ CylAlgebra.domain) :
    ContinuousAt (field a) x :=
  (field_vacuum a).contDiffOn.continuousOn.continuousAt ((field_vacuum a).isOpen.mem_nhds hx)

/-- A poloidal loop with `R > 0` lies off the axis. -/
theorem poloidalLoop_mem_domain {R z : ℝ → ℝ → ℝ} {φ₀ θ : ℝ} (hR : 0 < R θ φ₀) :
    poloidalLoop R z φ₀ θ ∈ CylAlgebra.domain := by
  change 0 < CylAlgebra.r2 _
  simp only [CylAlgebra.r2, poloidalLoop, cylPoint, PiLp.toLp_apply, Matrix.cons_val_zero,
    Matrix.cons_val_one]
  have : (R θ φ₀ * cos φ₀) ^ 2 + (R θ φ₀ * sin φ₀) ^ 2 = R θ φ₀ ^ 2 := by
    linear_combination R θ φ₀ ^ 2 * cos_sq_add_sin_sq φ₀
  rw [this]
  positivity

/-- `∇φ` is purely toroidal. -/
theorem toroidal_purelyToroidal : PurelyToroidal RationalStellarator.toroidal := fun x => by
  simp only [RationalStellarator.toroidal]
  refine ⟨by simp, ?_⟩
  simp
  ring

/-- **C1 current clause for the family**: every field `B_a` has zero circulation `∮ B · dl`
around every closed `C¹` poloidal loop of constant toroidal angle `φ₀` with `R > 0`. -/
theorem field_poloidalCirculation_eq_zero (a : Fin 42 → ℚ) {R z : ℝ → ℝ → ℝ} {φ₀ : ℝ}
    (hR : ContDiff ℝ 1 fun t => R t φ₀) (hz : ContDiff ℝ 1 fun t => z t φ₀)
    (hRpos : ∀ θ, 0 < R θ φ₀) (hRper : R π φ₀ = R (-π) φ₀) (hzper : z π φ₀ = z (-π) φ₀) :
    poloidalCirculation (field a) R z φ₀ = 0 :=
  poloidalCirculation_eq_zero_of_potential hR hz hRpos hRper hzper
    (fun θ => continuousAt_field a (poloidalLoop_mem_domain (hRpos θ)))
    (fun _ => field_split a _) toroidal_purelyToroidal
    (fun θ => hasFDerivAt_potential a (poloidalLoop_mem_domain (hRpos θ)))

/-- **C1 current clause for the candidate**: the net toroidal current `μ₀⁻¹ ∮ B · dl` enclosed by
every closed `C¹` poloidal loop of constant toroidal angle with `R > 0` is zero. -/
theorem candidate_loopCurrent_eq_zero (μ₀ : ℝ) {R z : ℝ → ℝ → ℝ} {φ₀ : ℝ}
    (hR : ContDiff ℝ 1 fun t => R t φ₀) (hz : ContDiff ℝ 1 fun t => z t φ₀)
    (hRpos : ∀ θ, 0 < R θ φ₀) (hRper : R π φ₀ = R (-π) φ₀) (hzper : z π φ₀ = z (-π) φ₀) :
    loopCurrent μ₀ (field candidate) R z φ₀ = 0 := by
  rw [loopCurrent, field_poloidalCirculation_eq_zero candidate hR hz hRpos hRper hzper, zero_div]

/-- **C1 for the candidate reduces to the transform clause**: for any nonempty family of invariant
tori of the candidate with `C¹` poloidal loops and `|ι| ≥ ι_min > 0`, clause C1 holds with
`I_max = 0`. (No such torus is certified yet.) -/
theorem candidate_currentFreeTransform {μ₀ ιmin : ℝ} {S : Set SurfaceData} (hμ : 0 < μ₀)
    (hS : S.Nonempty) (hι : 0 < ιmin)
    (hTor : ∀ s ∈ S, IotaOnTorus (field candidate) s.R s.z s.iota)
    (hR : ∀ s ∈ S, ContDiff ℝ 1 fun θ => s.R θ s.φ₀)
    (hz : ∀ s ∈ S, ContDiff ℝ 1 fun θ => s.z θ s.φ₀) (hge : ∀ s ∈ S, ιmin ≤ |s.iota|) :
    CurrentFreeTransform μ₀ (field candidate) S 0 ιmin :=
  currentFreeTransform_of_potential (T := RationalStellarator.toroidal) (g := gradPart candidate)
    (Φ := potential candidate) hμ hS hι hTor hR hz
    (fun s hs θ => continuousAt_field candidate
      (poloidalLoop_mem_domain ((hTor s hs).1.R_pos θ s.φ₀)))
    (fun _ _ _ => field_split candidate _) toroidal_purelyToroidal
    (fun s hs θ => hasFDerivAt_potential candidate
      (poloidalLoop_mem_domain ((hTor s hs).1.R_pos θ s.φ₀))) hge

/-! ## Stellarator symmetry -/

/-- `∇φ` is reversed by the stellarator symmetry: `∇φ(σ y) = −σ ∇φ(y)`. -/
theorem toroidal_stellRefl (y : Space) :
    RationalStellarator.toroidal (stellRefl y) = -stellRefl (RationalStellarator.toroidal y) := by
  have hw : RationalStellarator.winv (stellRefl y) = RationalStellarator.winv y := by
    simp [RationalStellarator.winv, RationalStellarator.r2, stellRefl]
  ext k
  fin_cases k <;> simp [RationalStellarator.toroidal, hw] <;> simp [stellRefl]

/-- **Stellarator symmetry** of every field of the family: `B(σ y) = −σ B(y)` with
`σ(x, y, z) = (x, −y, −z)`. -/
theorem field_stellSym (a : Fin 42 → ℚ) (y : Space) :
    field a (stellRefl y) = -stellRefl (field a y) := by
  simp only [field, toroidal_stellRefl, gradField_stellRefl (basis_parity _), stellRefl_add,
    stellRefl_sum, stellRefl_smul, smul_neg, Finset.sum_neg_distrib, neg_add]

/-! ## Sanity checks -/

/-- Degenerate case: with all coefficients zero the field is `∇φ`. -/
theorem field_zero : field 0 = RationalStellarator.toroidal := by
  funext y; simp [field]

/-- Concrete instance: the first basis potential is `V₀ = D_{0,1} = z`. -/
theorem eval_P0 (y : Space) : V 0 y = y 2 := by
  simp [V, P, P0, scale, eval, Mono.eval]

/-- The target is purely rational: the coefficients of the 9 potentials containing `ln R`
(`N_{0,1}`, `D_{0,3}`, `N_{0,3}`, `D_{0,5}`, `N_{0,5}`, `D_{2,4}`, `N_{2,4}`, `D_{2,5}`,
`N_{2,5}`) are exactly 0. -/
theorem candidate_log_free :
    candidate 1 = 0 ∧ candidate 2 = 0 ∧ candidate 3 = 0 ∧ candidate 4 = 0 ∧ candidate 5 = 0 ∧
      candidate 14 = 0 ∧ candidate 15 = 0 ∧ candidate 16 = 0 ∧ candidate 17 = 0 := by
  simp [candidate]

end PlasmaLean.Design.DommaschkQA2R
