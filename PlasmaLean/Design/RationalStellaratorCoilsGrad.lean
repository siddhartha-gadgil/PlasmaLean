/-- Exponent lists of the partial derivatives have length `≤ 4` (evaluation certificate). -/
theorem len4_all : ((pderivZ Pz 0).all (fun u => decide (u.2.length ≤ 4)) &&
    (pderivZ Pz 1).all (fun u => decide (u.2.length ≤ 4)) &&
    (pderivZ Pz 2).all (fun u => decide (u.2.length ≤ 4)) &&
    (pderivZ Pz 3).all (fun u => decide (u.2.length ≤ 4))) = true := by
  eval_cert

/-- Bound for one partial derivative from its two circle parts. -/
theorem pderivZ_bound_of {p : FPoly} (hp : ∀ u ∈ p, u.2.length ≤ 4) {c0 c1 : ℝ}
    (h0 : ∀ s z C : ℝ, |s| ≤ 1 / 10 → |z| ≤ 1 / 10 → |C| ≤ 1 → |ev3 (circD 0 p) s z C| ≤ c0)
    (h1 : ∀ s z C : ℝ, |s| ≤ 1 / 10 → |z| ≤ 1 / 10 → |C| ≤ 1 → |ev3 (circD 1 p) s z C| ≤ c1)
    {s z C S : ℝ} (hs : |s| ≤ 1 / 10) (hz : |z| ≤ 1 / 10) (hCS : C ^ 2 + S ^ 2 = 1) :
    |eval (toQ p) (vars4 s z C S)| ≤ c0 + c1 := by
  have hC : |C| ≤ 1 := by
    rw [abs_le]; constructor <;> nlinarith [sq_nonneg S, sq_nonneg (C + 1), sq_nonneg (C - 1)]
  have hS : |S| ≤ 1 := by
    rw [abs_le]; constructor <;> nlinarith [sq_nonneg C, sq_nonneg (S + 1), sq_nonneg (S - 1)]
  rw [ev_circ p hp hCS]
  have a0 := h0 s z C hs hz hC
  have a1 := h1 s z C hs hz hC
  calc _ ≤ |ev3 (circD 0 p) s z C| + |S * ev3 (circD 1 p) s z C| := abs_add_le _ _
    _ ≤ c0 + 1 * c1 := by
        rw [abs_mul]
        gcongr
    _ = c0 + c1 := by ring

/-- **Bounds on the partial derivatives of `P`** on `|s|, |z| ≤ 1/10`, `C² + S² = 1` (scaled
by `2⁴⁰`). -/
theorem pderivZ_bounds {s z C S : ℝ} (hs : |s| ≤ 1 / 10) (hz : |z| ≤ 1 / 10)
    (hCS : C ^ 2 + S ^ 2 = 1) :
    |eval (toQ (pderivZ Pz 0)) (vars4 s z C S)| ≤ 318858372055 + 126443837194 ∧
    |eval (toQ (pderivZ Pz 1)) (vars4 s z C S)| ≤ 241892558110 + 131941395333 ∧
    |eval (toQ (pderivZ Pz 2)) (vars4 s z C S)| ≤ 11544872091 + 1099511627 ∧
    |eval (toQ (pderivZ Pz 3)) (vars4 s z C S)| ≤ 6597069766 + 1099511627 := by
  have hl := len4_all
  simp only [Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at hl
  obtain ⟨⟨⟨l0, l1⟩, l2⟩, l3⟩ := hl
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact_mod_cast pderivZ_bound_of l0
      (fun s z C hs hz hC => circ_bound_of gA00_eq gA00_check hs hz hC)
      (fun s z C hs hz hC => circ_bound_of gA01_eq gA01_check hs hz hC) hs hz hCS
  · exact_mod_cast pderivZ_bound_of l1
      (fun s z C hs hz hC => circ_bound_of gA10_eq gA10_check hs hz hC)
      (fun s z C hs hz hC => circ_bound_of gA11_eq gA11_check hs hz hC) hs hz hCS
  · exact_mod_cast pderivZ_bound_of l2
      (fun s z C hs hz hC => circ_bound_of gA20_eq gA20_check hs hz hC)
      (fun s z C hs hz hC => circ_bound_of gA21_eq gA21_check hs hz hC) hs hz hCS
  · exact_mod_cast pderivZ_bound_of l3
      (fun s z C hs hz hC => circ_bound_of gA30_eq gA30_check hs hz hC)
      (fun s z C hs hz hC => circ_bound_of gA31_eq gA31_check hs hz hC) hs hz hCS

