/-- Kernel check of the node `P42`: a priori `ℓ¹` bound. -/
theorem lHE3_P42 : nodeL1N SHE3 LHE3 trHE3N_P42 (1 : Int) 1 0 75 < 2 ^ (244 - 1) := by
