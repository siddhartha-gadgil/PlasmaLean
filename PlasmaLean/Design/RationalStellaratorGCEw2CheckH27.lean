/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw2CheckH27`)

The checks of `Design/RationalStellaratorGCEw2CheckH27` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE2`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZzP`. -/
theorem cHE2S_nZzP : center3KS KvSHE2 NHE2 MHE2 39 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZzP`. -/
theorem clHE2_nZzP : LHE2 39 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `DtJ`. -/
theorem cHE2S_DtJ : center3KS KvSHE2 NHE2 MHE2 96 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DtJ`. -/
theorem clHE2_DtJ : LHE2 96 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m51`: truncation norm. -/
theorem kHE2S_m51 : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_m51 (1 : Int) 1 0 27 222 145 109 49 13 8 19 72 54 ≤
     := by
