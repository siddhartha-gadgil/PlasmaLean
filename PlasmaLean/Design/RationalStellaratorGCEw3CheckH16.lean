/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw3CheckH16`)

The checks of `Design/RationalStellaratorGCEw3CheckH16` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE3`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m60`. -/
theorem cHE3S_m60 : center3KS KvSHE3 NHE3 MHE3 28 104 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m60`. -/
theorem clHE3_m60 : LHE3 28 < 2 ^ (104 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `EN`. -/
theorem cHE3S_EN : center3KS KvSHE3 NHE3 MHE3 85 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `EN`. -/
theorem clHE3_EN : LHE3 85 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m11`: truncation norm. -/
theorem kHE3S_m11 : node3KS SHE3 NHE3 MHE3 DHE3 WtHE3 KvSHE3 trHE3N_m11 (1 : Int) 1 0 15 236 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m11`: a priori `ℓ¹` bound. -/
theorem lHE3_m11 : nodeL1N SHE3 LHE3 trHE3N_m11 (1 : Int) 1 0 15 < 2 ^ (236 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
