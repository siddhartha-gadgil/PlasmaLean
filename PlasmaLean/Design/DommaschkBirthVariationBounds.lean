/-! # Exact spatial jet bounds at the physical QA2R pilot birth

Generated by `scripts/dommaschk_kam/emit_birth_variation.py`. Each interval operation
is checked against explicit integer endpoints. The nine Taylor models descend from the
first physical field and Jacobian certificates.
-/

@[expose] public section
noncomputable section
namespace PlasmaLean.Design.DommaschkBirthVariation
open Certificates Certificates.NativeActionInterval Certificates.TrajectoryTaylorModel
open DommaschkKam DkPoly DommaschkBounceField DommaschkBounceTaylor DommaschkBounceTaylorFirst
open DommaschkJacobian

private abbrev IBox := NativeActionInterval.Box

private theorem subtract {a b : IBox} {x y : ℝ} (h : a.Mem x) (k : b.Mem y) :
    (⟨a.lo-b.hi, a.hi-b.lo⟩ : IBox).Mem (x-y) := by
  simp only [NativeActionInterval.Box.Mem, Int.cast_sub, mul_sub] at *
  exact ⟨sub_le_sub h.1 k.2, sub_le_sub h.2 k.1⟩

set_option maxRecDepth 8000 in
theorem pilot_numerators {R z vr vz : ℝ}
    (hr : R ∈ Set.Icc (99548672 / 10 ^ 8) (99548675 / 10 ^ 8))
    (hz : |z| ≤ 1 / 10 ^ 12)
    (hvr : vr ∈ Set.Icc (1045982 / 10 ^ 8) (1045983 / 10 ^ 8))
    (hvz : |vz| ≤ 2 / 10 ^ 12) : NumeratorBounds R 0 z vr vz := by
  have h : trial.Mem (-1) (R-dkR0) z 1 0 := by
    refine ⟨?_, ?_, ?_, ?_⟩ <;>
      norm_num [trial, Model.Mem, ofDyadic, QPoly.eval_cons, QPoly.eval_nil, dkR0, abs_le]
    · exact ⟨by linarith only [hr.1], by linarith only [hr.2]⟩
    · exact ⟨by linarith only [(abs_le.mp hz).1], by linarith only [(abs_le.mp hz).2]⟩
  have ht : |(-1 : ℝ)| ≤ 1 := by norm_num
  have rad : (⟨4483273621244277, 4483273756352267⟩ : IBox).Mem (R) := by
    constructor <;> norm_num <;> linarith only [hr.1, hr.2]
  have vR : (⟨47106841454362, 47106886490359⟩ : IBox).Mem (vr) := by
    constructor <;> norm_num <;> linarith only [hvr.1, hvr.2]
  have vZ : (⟨-9008, 9008⟩ : IBox).Mem (vz) := by
    constructor <;> norm_num <;> linarith only [(abs_le.mp hvz).1, (abs_le.mp hvz).2]
  let Dv := atPoint (dD) R 0 z
  have D : (⟨4542347381903728, 4542500685661496⟩ : IBox).Mem (Dv) := by
    have raw : dD0.Mem (-1) Dv := by
      simpa only [Dv, atPoint, mul_zero, Real.cos_zero, Real.sin_zero] using
        dD_checked.mem ht h
    rw [dD0, mem_ofDyadic_iff] at raw
    norm_num [QPoly.eval_cons, QPoly.eval_nil, abs_le] at raw
    constructor <;> norm_num <;> linarith only [raw.1, raw.2]
  let Nv := atPoint (dnR) R 0 z
  have N : (⟨-46277071375, 46277071373⟩ : IBox).Mem (Nv) := by
    have raw : dnR0.Mem (-1) Nv := by
      simpa only [Nv, atPoint, mul_zero, Real.cos_zero, Real.sin_zero] using
        dnR_checked.mem ht h
    rw [dnR0, mem_ofDyadic_iff] at raw
    norm_num [QPoly.eval_cons, QPoly.eval_nil, abs_le] at raw
    constructor <;> norm_num <;> linarith only [raw.1, raw.2]
  let Zv := atPoint (dnZ) R 0 z
  have Z : (⟨-344151445060604, -344081266678610⟩ : IBox).Mem (Zv) := by
    have raw : dnZ0.Mem (-1) Zv := by
      simpa only [Zv, atPoint, mul_zero, Real.cos_zero, Real.sin_zero] using
        dnZ_checked.mem ht h
    rw [dnZ0, mem_ofDyadic_iff] at raw
    norm_num [QPoly.eval_cons, QPoly.eval_nil, abs_le] at raw
    constructor <;> norm_num <;> linarith only [raw.1, raw.2]
  let Duv := atPoint (dU dD) R 0 z
  have Du : (⟨27068984148745588, 27069903192319564⟩ : IBox).Mem (Duv) := by
    have raw : gradDU0.Mem (-1) Duv := by
      simpa only [Duv, atPoint, mul_zero, Real.cos_zero, Real.sin_zero] using
        gradDU_checked.mem ht h
    rw [gradDU0, mem_ofDyadic_iff] at raw
    norm_num [QPoly.eval_cons, QPoly.eval_nil, abs_le] at raw
    constructor <;> norm_num <;> linarith only [raw.1, raw.2]
  let Dzv := atPoint (dZ dD) R 0 z
  have Dz : (⟨-250475381071, 250475381073⟩ : IBox).Mem (Dzv) := by
    have raw : gradDZ0.Mem (-1) Dzv := by
      simpa only [Dzv, atPoint, mul_zero, Real.cos_zero, Real.sin_zero] using
        gradDZ_checked.mem ht h
    rw [gradDZ0, mem_ofDyadic_iff] at raw
    norm_num [QPoly.eval_cons, QPoly.eval_nil, abs_le] at raw
    constructor <;> norm_num <;> linarith only [raw.1, raw.2]
  let Nuv := atPoint (dU dnR) R 0 z
  have Nu : (⟨-444982622043, 444982621985⟩ : IBox).Mem (Nuv) := by
    have raw : gradRU0.Mem (-1) Nuv := by
      simpa only [Nuv, atPoint, mul_zero, Real.cos_zero, Real.sin_zero] using
        gradRU_checked.mem ht h
    rw [gradRU0, mem_ofDyadic_iff] at raw
    norm_num [QPoly.eval_cons, QPoly.eval_nil, abs_le] at raw
    constructor <;> norm_num <;> linarith only [raw.1, raw.2]
  let Nzv := atPoint (dZ dnR) R 0 z
  have Nz : (⟨-428322886738135, -427383047946305⟩ : IBox).Mem (Nzv) := by
    have raw : gradRZ0.Mem (-1) Nzv := by
      simpa only [Nzv, atPoint, mul_zero, Real.cos_zero, Real.sin_zero] using
        gradRZ_checked.mem ht h
    rw [gradRZ0, mem_ofDyadic_iff] at raw
    norm_num [QPoly.eval_cons, QPoly.eval_nil, abs_le] at raw
    constructor <;> norm_num <;> linarith only [raw.1, raw.2]
  let Zuv := atPoint (dU dnZ) R 0 z
  have Zu : (⟨-3193625481365290, -3192904232569294⟩ : IBox).Mem (Zuv) := by
    have raw : gradZU0.Mem (-1) Zuv := by
      simpa only [Zuv, atPoint, mul_zero, Real.cos_zero, Real.sin_zero] using
        gradZU_checked.mem ht h
    rw [gradZU0, mem_ofDyadic_iff] at raw
    norm_num [QPoly.eval_cons, QPoly.eval_nil, abs_le] at raw
    constructor <;> norm_num <;> linarith only [raw.1, raw.2]
  let Zzv := atPoint (dZ dnZ) R 0 z
  have Zz : (⟨-638955411631, 638955411675⟩ : IBox).Mem (Zzv) := by
    have raw : gradZZ0.Mem (-1) Zzv := by
      simpa only [Zzv, atPoint, mul_zero, Real.cos_zero, Real.sin_zero] using
        gradZZ_checked.mem ht h
    rw [gradZZ0, mem_ofDyadic_iff] at raw
    norm_num [QPoly.eval_cons, QPoly.eval_nil, abs_le] at raw
    constructor <;> norm_num <;> linarith only [raw.1, raw.2]
  have two : (⟨9007199254740992, 9007199254740992⟩ : IBox).Mem (2) := by
    norm_num [NativeActionInterval.Box.Mem]
  have seven : (⟨31525197391593472, 31525197391593472⟩ : IBox).Mem (7) := by
    norm_num [NativeActionInterval.Box.Mem]
  have sixteen : (⟨72057594037927936, 72057594037927936⟩ : IBox).Mem (16) := by
    norm_num [NativeActionInterval.Box.Mem]
  have height : (⟨6755399441055744, 6755399441055744⟩ : IBox).Mem (3/2) := by
    norm_num [NativeActionInterval.Box.Mem]
  let rdv := R * Dv
  have rd : (⟨4521846496311929, 4521999244441936⟩ : IBox).Mem (rdv) := mem_mul rad D
  let r2v := R * R
  have r2 : (⟨4463039352074987, 4463039621071412⟩ : IBox).Mem (r2v) := mem_mul rad rad
  let r3v := r2v * R
  have r3 : (⟨4442896405828053, 4442896807501613⟩ : IBox).Mem (r3v) := mem_mul r2 rad
  let r4v := r2v * r2v
  have r4 : (⟨4422844370337557, 4422844903485158⟩ : IBox).Mem (r4v) := mem_mul r2 r2
  let r8v := r4v * r4v
  have r8 : (⟨4343537157553228, 4343538204728467⟩ : IBox).Mem (r8v) := mem_mul r4 r4
  let rhv := 3/2 * r8v
  have rh : (⟨6515305736329842, 6515307307092701⟩ : IBox).Mem (rhv) := mem_mul height r8
  let nnv := Nv * Nv
  have nn : (⟨-475524, 475524⟩ : IBox).Mem (nnv) := mem_mul N N
  let zzv := Zv * Zv
  have zz : (⟨26288286676203, 26299011221488⟩ : IBox).Mem (zzv) := mem_mul Z Z
  let qv := nnv + zzv
  have q : (⟨26288286200679, 26299011697012⟩ : IBox).Mem (qv) := mem_add nn zz
  let minusv := rdv - rhv
  have minus : (⟨-1993460810780772, -1993306491887906⟩ : IBox).Mem (minusv) := subtract rd rh
  let plusv := rdv + rhv
  have plus : (⟨11037152232641771, 11037306551534637⟩ : IBox).Mem (plusv) := mem_add rd rh
  let crossv := minusv * plusv
  have cross : (⟨-4885522667987400, -4885076165201937⟩ : IBox).Mem (crossv) := mem_mul minus plus
  let gapv := crossv + qv
  have gap : (⟨-4859234381786721, -4858777153504925⟩ : IBox).Mem (gapv) := mem_add cross q
  let qrNv := Nv * Nuv
  have qrN : (⟨-4572452, 4572452⟩ : IBox).Mem (qrNv) := mem_mul N Nu
  let qrZv := Zv * Zuv
  have qrZ : (⟨243942318062448, 244047187879345⟩ : IBox).Mem (qrZv) := mem_mul Z Zu
  let qrSv := qrNv + qrZv
  have qrS : (⟨243942313489996, 244047192451797⟩ : IBox).Mem (qrSv) := mem_add qrN qrZ
  let qrv := 2 * qrSv
  have qr : (⟨487884626979992, 488094384903594⟩ : IBox).Mem (qrv) := mem_mul two qrS
  let qzNv := Nv * Nzv
  have qzN : (⟨-4401263532, 4401263532⟩ : IBox).Mem (qzNv) := mem_mul N Nz
  let qzZv := Zv * Zzv
  have qzZ : (⟨-48827037582, 48827037579⟩ : IBox).Mem (qzZv) := mem_mul Z Zz
  let qzSv := qzNv + qzZv
  have qzS : (⟨-53228301114, 53228301111⟩ : IBox).Mem (qzSv) := mem_add qzN qzZ
  let qzv := 2 * qzSv
  have qz : (⟨-106456602228, 106456602222⟩ : IBox).Mem (qzv) := mem_mul two qzS
  let twoRDv := 2 * rdv
  have twoRD : (⟨9043692992623858, 9043998488883872⟩ : IBox).Mem (twoRDv) := mem_mul two rd
  let Av := twoRDv * R
  have A : (⟨9002876273914108, 9003180662703919⟩ : IBox).Mem (Av) := mem_mul twoRD rad
  let rduv := R * Duv
  have rdu : (⟨26946814243966735, 26947729951736834⟩ : IBox).Mem (rduv) := mem_mul rad Du
  let d7v := 7 * Dv
  have d7 : (⟨31796431673326096, 31797504799630472⟩ : IBox).Mem (d7v) := mem_mul seven D
  let compv := rduv - d7v
  have comp : (⟨-4850690555663737, -4848701721589262⟩ : IBox).Mem (compv) := subtract rdu d7
  let rs1v := Av * compv
  have rs1 : (⟨-9697052807736092, -9692749200725371⟩ : IBox).Mem (rs1v) := mem_mul A comp
  let rqrv := R * qrv
  have rqr : (⟨485682667050735, 485891492920928⟩ : IBox).Mem (rqrv) := mem_mul rad qr
  let rs2v := rs1v + rqrv
  have rs2 : (⟨-9211370140685357, -9206857707804443⟩ : IBox).Mem (rs2v) := mem_add rs1 rqr
  let sq16v := 16 * qv
  have sq16 : (⟨420612579210864, 420784187152192⟩ : IBox).Mem (sq16v) := mem_mul sixteen q
  let rsv := rs2v - sq16v
  have rs : (⟨-9632154327837549, -9627470287015307⟩ : IBox).Mem (rsv) := subtract rs2 sq16
  let AAv := twoRDv * r2v
  have AA : (⟨8962243772484575, 8962547057577974⟩ : IBox).Mem (AAv) := mem_mul twoRD r2
  let zs1v := AAv * Dzv
  have zs1 : (⟨-498467353974, 498467353978⟩ : IBox).Mem (zs1v) := mem_mul AA Dz
  let rqzv := R * qzv
  have rqz : (⟨-105976136968, 105976136963⟩ : IBox).Mem (rqzv) := mem_mul rad qz
  let zsv := zs1v + rqzv
  have zs : (⟨-604443490942, 604443490941⟩ : IBox).Mem (zsv) := mem_add zs1 rqz
  let rsumv := rsv * vr
  have rsum : (⟨-100750696802946, -100701606257527⟩ : IBox).Mem (rsumv) := mem_mul rs vR
  let zsumv := zsv * vz
  have zsum : (⟨-2, 2⟩ : IBox).Mem (zsumv) := mem_mul zs vZ
  let sfv := rsumv + zsumv
  have sf : (⟨-100750696802948, -100701606257525⟩ : IBox).Mem (sfv) := mem_add rsum zsum
  let q2v := 2 * qv
  have q2 : (⟨52576572401358, 52598023394024⟩ : IBox).Mem (q2v) := mem_mul two q
  let dsqv := Dv * Dv
  have dsq : (⟨4581428511649144, 4581737762351415⟩ : IBox).Mem (dsqv) := mem_mul D D
  let basev := twoRDv * dsqv
  have base : (⟨9199981427123419, 9200913231126234⟩ : IBox).Mem (basev) := mem_mul twoRD dsq
  let dqrv := Dv * qrv
  have dqr : (⟨492082254507063, 492310431996957⟩ : IBox).Mem (dqrv) := mem_mul D qr
  let dwRav := basev + dqrv
  have dwRa : (⟨9692063681630482, 9693223663123191⟩ : IBox).Mem (dwRav) := mem_add base dqr
  let dqRv := q2v * Duv
  have dqR : (⟨316012639373693, 316152304643234⟩ : IBox).Mem (dqRv) := mem_mul q2 Du
  let dwRv := dwRav - dqRv
