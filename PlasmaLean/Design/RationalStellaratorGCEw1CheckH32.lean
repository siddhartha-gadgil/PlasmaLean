public import PlasmaLean.Design.RationalStellaratorGCEw1TreesH
public import PlasmaLean.Design.RationalStellaratorGCEw1KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw1CheckH32`)

The checks of `Design/RationalStellaratorGCEw1CheckH32` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE1`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw1LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `RDz`. -/
theorem cHE1S_RDz : center3KS KvSHE1 NHE1 MHE1 44 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `RDz`. -/
theorem clHE1_RDz : LHE1 44 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `RDph`: truncation norm. -/
theorem kHE1S_RDph : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_RDph (1 : Int) 1 0 45 233 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `RDph`: a priori `ℓ¹` bound. -/
theorem lHE1_RDph : nodeL1N SHE1 LHE1 trHE1N_RDph (1 : Int) 1 0 45 < 2 ^ (233 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
