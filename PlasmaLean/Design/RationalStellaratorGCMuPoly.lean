/-- Unfolding set for the polynomials of this file, `Design/RationalStellaratorGCPoly` and
`Design/KamNewtonField`. -/
macro "mu_poly_simp" : tactic =>
  `(tactic| simp only [phiD, pd, PolyExpr.deriv, PolyExpr.eval, KamNewton.Dp, KamNewton.nRp,
    KamNewton.nZp, DuP, DzP, DphP, nRuP, nRzP, nRphP, nZuP, nZzP, nZphP, PuP, EpP,
    P4P, P4uP, E4P, E4uP, QPP4P, QPP4uP, QPP4zP,
    sumE, monoE, npow, Pi.single_apply, Algebra.algebraMap_self, RingHom.id_apply,
    Fin.isValue, eval_npow])

/-- Close a polynomial identity of this file pointwise. -/
macro "mu_close" : tactic =>
  `(tactic| (refine ext_eval fun θ ψ => ?_
             simp only [eval_add', eval_sub', eval_mul, eval_neg', eval_pow', eval_pd, eval_phiD,
               eval_polyExpr, eval_one, eval_ofNat', eval_zero']
             mu_poly_simp
             all_goals (try simp)
             all_goals ring))

set_option maxRecDepth 40000 in
/-- `E₄ = R⁸ P₄² − 1`. -/
theorem E4_val (x : Fin 6 → FA) :
    PolyExpr.eval x E4P = (1 + x 0) ^ 8 * PolyExpr.eval x P4P ^ 2 - 1 := by
  mu_close

set_option maxRecDepth 40000 in
/-- Derivative of `E₄ = R⁸ P₄² − 1`. -/
theorem E4_d0 (x : Fin 6 → FA) :
    pd x 0 E4P = 8 * (1 + x 0) ^ 7 * PolyExpr.eval x P4P ^ 2 + 2 * (1 + x 0) ^ 8 * PolyExpr.eval x
      P4P * pd x 0 P4P := by
  mu_close

set_option maxRecDepth 40000 in
/-- `∂_u E₄` is the leaf `E4uP`. -/
theorem E4_d0u (x : Fin 6 → FA) :
    pd x 0 E4P = PolyExpr.eval x E4uP := by
  mu_close

set_option maxRecDepth 40000 in
/-- `E₄` does not depend on `z`. -/
theorem E4_d1 (x : Fin 6 → FA) :
    pd x 1 E4P = 0 := by
  mu_close

set_option maxRecDepth 40000 in
/-- `E₄` does not depend on `φ`. -/
theorem E4_dph (x : Fin 6 → FA) :
    phiD x E4P = 0 := by
  mu_close

set_option maxRecDepth 40000 in
/-- `P₄` does not depend on `z`. -/
theorem P4_d1 (x : Fin 6 → FA) :
    pd x 1 P4P = 0 := by
  mu_close

set_option maxRecDepth 40000 in
/-- `∂_u P₄` is the leaf `P4uP`. -/
theorem P4_d0u (x : Fin 6 → FA) :
    pd x 0 P4P = PolyExpr.eval x P4uP := by
  mu_close

set_option maxRecDepth 40000 in
/-- `P₄` does not depend on `φ`. -/
theorem P4_dph (x : Fin 6 → FA) :
    phiD x P4P = 0 := by
  mu_close

set_option maxRecDepth 40000 in
/-- `Q P P₄ = q P P₄`. -/
theorem QPP4_val (x : Fin 6 → FA) :
    PolyExpr.eval x QPP4P = (PolyExpr.eval x KamNewton.nRp ^ 2 + (1 + x 0) ^ 2 * PolyExpr.eval x
      KamNewton.Dp ^ 2 + PolyExpr.eval x KamNewton.nZp ^ 2) * PolyExpr.eval x PuP * PolyExpr.eval
      x P4P := by
  mu_close

set_option maxRecDepth 40000 in
/-- Derivative of `Q P P₄ = q P P₄`. -/
theorem QPP4_d0 (x : Fin 6 → FA) :
    pd x 0 QPP4P = (2 * PolyExpr.eval x KamNewton.nRp * pd x 0 KamNewton.nRp + 2 * (1 + x 0) ^ 2 *
      PolyExpr.eval x KamNewton.Dp * pd x 0 KamNewton.Dp + 2 * PolyExpr.eval x KamNewton.nZp * pd
      x 0 KamNewton.nZp + 2 * (1 + x 0) * PolyExpr.eval x KamNewton.Dp ^ 2) * PolyExpr.eval x PuP
      * PolyExpr.eval x P4P + (PolyExpr.eval x KamNewton.nRp ^ 2 + (1 + x 0) ^ 2 * PolyExpr.eval x
      KamNewton.Dp ^ 2 + PolyExpr.eval x KamNewton.nZp ^ 2) * pd x 0 PuP * PolyExpr.eval x P4P +
      (PolyExpr.eval x KamNewton.nRp ^ 2 + (1 + x 0) ^ 2 * PolyExpr.eval x KamNewton.Dp ^ 2 +
      PolyExpr.eval x KamNewton.nZp ^ 2) * PolyExpr.eval x PuP * pd x 0 P4P := by
  mu_close

set_option maxRecDepth 40000 in
/-- Derivative of `Q P P₄ = q P P₄`. -/
theorem QPP4_d1 (x : Fin 6 → FA) :
    pd x 1 QPP4P = (2 * PolyExpr.eval x KamNewton.nRp * pd x 1 KamNewton.nRp + 2 * (1 + x 0) ^ 2 *
      PolyExpr.eval x KamNewton.Dp * pd x 1 KamNewton.Dp + 2 * PolyExpr.eval x KamNewton.nZp * pd
      x 1 KamNewton.nZp) * PolyExpr.eval x PuP * PolyExpr.eval x P4P + (PolyExpr.eval x
      KamNewton.nRp ^ 2 + (1 + x 0) ^ 2 * PolyExpr.eval x KamNewton.Dp ^ 2 + PolyExpr.eval x
      KamNewton.nZp ^ 2) * pd x 1 PuP * PolyExpr.eval x P4P + (PolyExpr.eval x KamNewton.nRp ^ 2 +
      (1 + x 0) ^ 2 * PolyExpr.eval x KamNewton.Dp ^ 2 + PolyExpr.eval x KamNewton.nZp ^ 2) *
      PolyExpr.eval x PuP * pd x 1 P4P := by
  mu_close

set_option maxRecDepth 40000 in
/-- Derivative of `Q P P₄ = q P P₄`. -/
theorem QPP4_dph (x : Fin 6 → FA) :
    phiD x QPP4P = (2 * PolyExpr.eval x KamNewton.nRp * phiD x KamNewton.nRp + 2 * (1 + x 0) ^ 2 *
      PolyExpr.eval x KamNewton.Dp * phiD x KamNewton.Dp + 2 * PolyExpr.eval x KamNewton.nZp *
      phiD x KamNewton.nZp) * PolyExpr.eval x PuP * PolyExpr.eval x P4P + (PolyExpr.eval x
      KamNewton.nRp ^ 2 + (1 + x 0) ^ 2 * PolyExpr.eval x KamNewton.Dp ^ 2 + PolyExpr.eval x
      KamNewton.nZp ^ 2) * phiD x PuP * PolyExpr.eval x P4P + (PolyExpr.eval x KamNewton.nRp ^ 2 +
      (1 + x 0) ^ 2 * PolyExpr.eval x KamNewton.Dp ^ 2 + PolyExpr.eval x KamNewton.nZp ^ 2) *
      PolyExpr.eval x PuP * phiD x P4P := by
  mu_close

set_option maxRecDepth 40000 in
/-- `∂_u (q P P₄)` is the leaf `QPP4uP`. -/
theorem QPP4_d0u (x : Fin 6 → FA) :
    pd x 0 QPP4P = PolyExpr.eval x QPP4uP := by
  mu_close

set_option maxRecDepth 40000 in
/-- `∂_z (q P P₄)` is the leaf `QPP4zP`. -/
theorem QPP4_d1z (x : Fin 6 → FA) :
    pd x 1 QPP4P = PolyExpr.eval x QPP4zP := by
  mu_close

/-- **Sanity**: `P₄(0) = 1`. -/
theorem P4P_zero : PolyExpr.eval (A := ℂ) (fun _ => 0) P4P = 1 := by
  mu_poly_simp; norm_num

/-- **Sanity**: `E₄(0) = 0`. -/
theorem E4P_zero : PolyExpr.eval (A := ℂ) (fun _ => 0) E4P = 0 := by
  mu_poly_simp; norm_num

set_option maxRecDepth 40000 in
/-- The new polynomials do not involve the velocities. -/
theorem noW_mu : NoW P4P ∧ NoW E4P ∧ NoW E4uP ∧ NoW QPP4P ∧ NoW QPP4uP ∧ NoW QPP4zP ∧
    NoW P4uP := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  simp [NoW, P4P, E4P, E4uP, QPP4P, QPP4uP, QPP4zP, P4uP, sumE, monoE, npow]

set_option maxRecDepth 40000 in
/-- The new polynomials have real (rational) coefficients. -/
theorem realConsts_mu : P4P.RealConsts ∧ E4P.RealConsts ∧ E4uP.RealConsts ∧ QPP4P.RealConsts ∧
    QPP4uP.RealConsts ∧ QPP4zP.RealConsts ∧ P4uP.RealConsts := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  simp [PolyExpr.RealConsts, P4P, E4P, E4uP, QPP4P, QPP4uP, QPP4zP, P4uP, sumE, monoE,
    PolyExpr.npow, map_neg, map_ofNat]

