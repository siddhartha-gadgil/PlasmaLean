/-- Uniform lower bound at every true physical angle, including both signed branches. -/
theorem regular {R z : ℝ} (φ : ℝ) (radial : 7 / 8 ≤ R ∧ R ≤ 1) (height : |z| ≤ 5 / 64) :
    1 / 64 < atPoint dD R φ z := by
  let u := R - dkR0
  have low : -2 / 64 ≤ u := by dsimp [u, dkR0]; linarith [radial.1]
  have high : u ≤ 6 / 64 := by dsimp [u, dkR0]; linarith [radial.2]
  have hz := abs_le.mp height
  change 1 / 64 < evR u z (Real.cos (2 * φ)) (Real.sin (2 * φ)) dD
  by_cases cut0 : u ≤ 0 / 64
  · by_cases neg : z ≤ 0
    · apply positive_of_check check0 (by norm_num [fxVal, fxScale]) rfl
      apply input <;> norm_num <;> linarith [hz.1, hz.2]
    · apply positive_of_check check1 (by norm_num [fxVal, fxScale]) rfl
      apply input <;> norm_num <;> linarith [hz.1, hz.2]
  · by_cases cut1 : u ≤ 2 / 64
    · by_cases neg : z ≤ 0
      · apply positive_of_check check2 (by norm_num [fxVal, fxScale]) rfl
        apply input <;> norm_num <;> linarith [hz.1, hz.2]
      · apply positive_of_check check3 (by norm_num [fxVal, fxScale]) rfl
        apply input <;> norm_num <;> linarith [hz.1, hz.2]
    · by_cases cut2 : u ≤ 4 / 64
      · by_cases neg : z ≤ 0
        · apply positive_of_check check4 (by norm_num [fxVal, fxScale]) rfl
          apply input <;> norm_num <;> linarith [hz.1, hz.2]
        · apply positive_of_check check5 (by norm_num [fxVal, fxScale]) rfl
          apply input <;> norm_num <;> linarith [hz.1, hz.2]
      · by_cases neg : z ≤ 0
        · apply positive_of_check check6 (by norm_num [fxVal, fxScale]) rfl
          apply input <;> norm_num <;> linarith [hz.1, hz.2]
        · apply positive_of_check check7 (by norm_num [fxVal, fxScale]) rfl
          apply input <;> norm_num <;> linarith [hz.1, hz.2]

end PlasmaLean.Design.DommaschkSignedTraceDenominator
