module

public import PlasmaLean.Design.RationalStellaratorGCEw1TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 24)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw1DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 1: gyro-length `ρ_1 = 1/256 − 2⁻³²`, its own family torus `K_1(λ)`; the
fields at `ρ_1` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nRzP`. -/
theorem cHE1_nRzP : center3KN KvHE1 NHE1 MHE1 36 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRzP`. -/
theorem clHE1_nRzP : LHE1 36 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nRtF`. -/
theorem cHE1_nRtF : center3KN KvHE1 NHE1 MHE1 93 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRtF`. -/
theorem clHE1_nRtF : LHE1 93 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `m40`: truncation norm. -/
theorem kHE1_m40 : node3KN SHE1 NHE1 MHE1 DHE1 WtHE1 KvHE1 trHE1N_m40 (1 : Int) 1 0 24 230 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m40`: a priori `ℓ¹` bound. -/
theorem lHE1_m40 : nodeL1N SHE1 LHE1 trHE1N_m40 (1 : Int) 1 0 24 < 2 ^ (230 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
