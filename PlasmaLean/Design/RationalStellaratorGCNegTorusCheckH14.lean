module

public import PlasmaLean.Design.RationalStellaratorGCNegTorusTreesH

/-!
# Kernel checks of the guiding-centre torus certificate (`v∥ < 0`) (high resolution, part 14)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the data of
`Design/RationalStellaratorGCNegTorusDataH*`: the weighted digit sums (`nodeK`, `normK`,
`centerK` of `Certificates/KronBallGrid`) of the Kronecker images of the truncation polynomials
of the ball pipeline, and their a priori `ℓ¹` bounds. Generated by
`scripts/gc_kam/neg_emit_lean.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGCNeg

open PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m03`. -/
theorem cH_m03 : centerK NH MH KvH 17 127 81 7 6 40 30 ≤  := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m03`. -/
theorem clH_m03 : LH 17 < 2 ^ (127 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `DzP`. -/
theorem cH_DzP : centerK NH MH KvH 33 127 81 7 6 40 30 ≤  := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DzP`. -/
theorem clH_DzP : LH 33 < 2 ^ (127 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
