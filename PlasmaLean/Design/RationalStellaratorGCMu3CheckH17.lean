meta import PlasmaLean.Design.RationalStellaratorGCMu3KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu3CheckH17`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `thUe`. -/
theorem cHMS_thUe : center3KS KvSHM NHM MHM 12 125 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `thUe`. -/
theorem clHM_thUe : LHM 12 < 2 ^ (125 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `Vn`. -/
theorem cHMS_Vn : center3KS KvSHM NHM MHM 54 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `Vn`. -/
theorem clHM_Vn : LHM 54 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the node `m30`: truncation norm. -/
theorem kHMS_m30 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m30 (1 : Int) 1 0 20 232 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m30`: a priori `ℓ¹` bound. -/
theorem lHM_m30 : nodeL1N SHM LHM trHMN_m30 (1 : Int) 1 0 20 < 2 ^ (232 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu3
