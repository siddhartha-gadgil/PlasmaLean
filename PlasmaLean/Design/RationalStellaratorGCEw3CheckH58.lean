module

public import PlasmaLean.Design.RationalStellaratorGCEw3TreesH
public import PlasmaLean.Design.RationalStellaratorGCEw3KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCEw3TreesH
meta import PlasmaLean.Design.RationalStellaratorGCEw3KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw3CheckH58`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `m22`. -/
theorem cHE3S_m22 : center3KS KvSHE3 NHE3 MHE3 22 107 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `m22`. -/
theorem clHE3_m22 : LHE3 22 < 2 ^ (107 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `V40`. -/
theorem cHE3S_V40 : center3KS KvSHE3 NHE3 MHE3 79 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `V40`. -/
theorem clHE3_V40 : LHE3 79 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the node `DzP`: truncation norm. -/
theorem kHE3S_DzP : node3KS SHE3 NHE3 MHE3 DHE3 WtHE3 KvSHE3 trHE3N_DzP (8 : Int) 0 1 33 125 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `DzP`: a priori `ℓ¹` bound. -/
theorem lHE3_DzP : nodeL1N SHE3 LHE3 trHE3N_DzP (8 : Int) 0 1 33 < 2 ^ (125 - 1) := by
  kron_lt

/-- Proof-term check of the node `V2`: truncation norm. -/
theorem kHE3S_V2 : node3KS SHE3 NHE3 MHE3 DHE3 WtHE3 KvSHE3 trHE3N_V2 (1 : Int) 1 0 53 244 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `V2`: a priori `ℓ¹` bound. -/
theorem lHE3_V2 : nodeL1N SHE3 LHE3 trHE3N_V2 (1 : Int) 1 0 53 < 2 ^ (244 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `V4m1`. -/
theorem kHE3S_V4m1 : norm3KS WtHE3 KvSHE3 NHE3 MHE3 trHE3N_V4m1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `V4m1`: a priori `ℓ¹` bound. -/
theorem lHE3_V4m1 : ExN.majN LHE3 trHE3N_V4m1 < 2 ^ (123 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
