  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m50`. -/
theorem clHE2_m50 : LHE2 26 < 2 ^ (107 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `Bm`. -/
theorem cHE2_Bm : center3KN KvHE2 NHE2 MHE2 83 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Bm`. -/
theorem clHE2_Bm : LHE2 83 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `dA`. -/
theorem kHE2_dA : norm3KN WtHE2 KvHE2 NHE2 MHE2 trHE2N_dA (1, 0, 3) 126 73 55 25 11 8 10 36 27 ≤
