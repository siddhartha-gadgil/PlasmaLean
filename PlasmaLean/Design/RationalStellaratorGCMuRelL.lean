/-- **The true values of the low-resolution family pipeline** at the parameter `w = c` and the
torus `(u, z)`. -/
def XLM (c : ℂ) (u z : FA) (j : ℕ) : FA := if spLM j = true then XLMnew c u z j else XL u z j

/-- The values of the `ρ`-independent variables. -/
theorem XLM_old (c : ℂ) (u z : FA) {j : ℕ} (h : spLM j = false) : XLM c u z j = XL u z j := by
  simp [XLM, h]

/-- The values of the new variables. -/
theorem XLM_new (c : ℂ) (u z : FA) {j : ℕ} (h : spLM j = true) : XLM c u z j = XLMnew c u z j := by
  simp [XLM, h]

/-- Congruence with the `ρ = 1/256` values. -/
theorem XLM_congr (c : ℂ) (u z : FA) : ∀ j, (!spLM j) = true → XLM c u z j = XL u z j :=
  fun _ h => XLM_old c u z (by simpa using h)

