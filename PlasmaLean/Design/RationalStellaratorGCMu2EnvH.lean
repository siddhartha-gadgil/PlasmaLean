/-- **The variable polynomials** of the family pipeline (by kind, `kindHM`). -/
def PHM (i : ℕ) : P3 :=
  match kindHM i with
  | 0 => T3 SHM NHM MHM DHM
  | 1 => V3
  | 2 => C cPoly
  | 3 => C sPoly
  | 4 => Pr3 SHM NHM MHM DHM
  | 5 => 0
  | _ => famPoly NHM MHM DHM (if oddHM i then -1 else 1) (c0HM i : ℤ) 0 0 0 (famHM i)

/-- The kinds are at most `6`. -/
theorem kindHM_le (i : ℕ) : kindHM i ≤ 6 :=
  getD_prop (Pr := fun k : ℕ => k ≤ 6) (by kernel_fact) (by kernel_fact) i

set_option maxRecDepth 100000 in
/-- The variables beyond the last have kind `5` (zero). -/
theorem kindHM_ge {i : ℕ} (h : 96 ≤ i) : kindHM i = 5 := by
  unfold kindHM
  rw [List.getD_eq_getElem?_getD,
    List.getElem?_eq_none ((by kernel_fact : kindHMl.length = 96).trans_le h)]
  rfl

/-- Stored families are below the last variable. -/
theorem lt_of_kindHM {i : ℕ} (h : kindHM i = 6) : i < 96 := by
  by_contra h'
  rw [kindHM_ge (by omega)] at h
  exact absurd h (by kernel_fact)

set_option maxRecDepth 100000 in
/-- The static conditions of the stored families. -/
theorem staticHM : ∀ i, i < 96 → kindHM i = 6 →
    FamStatic NHM MHM DHM ddHM drHM dwHM (famHM i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The minimal widths of the fast images. -/
theorem dynHM : ∀ i, i < 96 → kindHM i = 6 →
    FamDyn (bMinHM i) (wMinHM i) (c0HM i) (famHM i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The static `ℓ¹` bounds of the stored families. -/
theorem l1famHM : ∀ i, i < 96 → kindHM i = 6 →
    famL1 NHM MHM (c0HM i : ℤ) 0 0 0 (famHM i) ≤ LHM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree boxes of the stored families. -/
theorem bx6HM : ∀ i, i < 96 → kindHM i = 6 → BxHM i = (2 * NHM, 2 * MHM, 2 * DHM) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `t`. -/
theorem bx0HM : ∀ i, i < 96 → kindHM i = 0 → BxHM i = (NHM, MHM, DHM) ∧ 2 ^ SHM ≤ LHM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `V`. -/
theorem bx1HM : ∀ i, i < 96 → kindHM i = 1 → BxHM i = (0, 1, 0) ∧ 2 ≤ LHM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `cos 2φ`. -/
theorem bx2HM : ∀ i, i < 96 → kindHM i = 2 → BxHM i = (0, 2, 0) ∧ 2 ≤ LHM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `sin 2φ`. -/
theorem bx3HM : ∀ i, i < 96 → kindHM i = 3 → BxHM i = (0, 2, 0) ∧ 2 ≤ LHM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of the parameter. -/
theorem bx4HM : ∀ i, i < 96 → kindHM i = 4 →
    BxHM i = (NHM, MHM, DHM + 1) ∧ 2 ^ (SHM + 6) + 2 * 2 ^ (SHM - 1) ≤ LHM i := by
  kernel_fact

/-- The polynomial of `t`. -/
theorem PHM_k0 {i : ℕ} (h : kindHM i = 0) : PHM i = T3 SHM NHM MHM DHM := by
  unfold PHM; rw [h]; rfl
/-- The polynomial of `V`. -/
theorem PHM_k1 {i : ℕ} (h : kindHM i = 1) : PHM i = V3 := by unfold PHM; rw [h]; rfl
/-- The polynomial of `cos 2φ`. -/
theorem PHM_k2 {i : ℕ} (h : kindHM i = 2) : PHM i = C cPoly := by unfold PHM; rw [h]; rfl
/-- The polynomial of `sin 2φ`. -/
theorem PHM_k3 {i : ℕ} (h : kindHM i = 3) : PHM i = C sPoly := by unfold PHM; rw [h]; rfl
/-- The polynomial of the parameter. -/
theorem PHM_k4 {i : ℕ} (h : kindHM i = 4) : PHM i = Pr3 SHM NHM MHM DHM := by
  unfold PHM; rw [h]; rfl
/-- The polynomial of a dummy variable. -/
theorem PHM_k5 {i : ℕ} (h : kindHM i = 5) : PHM i = 0 := by unfold PHM; rw [h]; rfl

/-- The polynomial of a stored family. -/
theorem PHM_fam {i : ℕ} (h : kindHM i = 6) :
    PHM i = famPoly NHM MHM DHM (if oddHM i then -1 else 1) (c0HM i : ℤ) 0 0 0 (famHM i) := by
  unfold PHM; rw [h]; rfl

/-- The image of `t`. -/
theorem KvHM_k0 {b W R i : ℕ} (h : kindHM i = 0) : KvHM b W R i =
    ((1 <<< SHM : ℕ) : ℤ) * ((1 <<< (b * (NHM + W * (MHM + R * DHM))) : ℕ) : ℤ) := by
  unfold KvHM; rw [h]; rfl
/-- The image of `V`. -/
theorem KvHM_k1 {b W R i : ℕ} (h : kindHM i = 1) :
    KvHM b W R i = 2 * ((1 <<< (b * W) : ℕ) : ℤ) := by
  unfold KvHM; rw [h]; rfl
/-- The image of `cos 2φ`. -/
theorem KvHM_k2 {b W R i : ℕ} (h : kindHM i = 2) :
    KvHM b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) - 1 := by
  unfold KvHM; rw [h]; rfl
/-- The image of `sin 2φ`. -/
theorem KvHM_k3 {b W R i : ℕ} (h : kindHM i = 3) :
    KvHM b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) + 1 := by
  unfold KvHM; rw [h]; rfl
/-- The image of the parameter. -/
theorem KvHM_k4 {b W R i : ℕ} (h : kindHM i = 4) : KvHM b W R i =
    ((1 <<< (SHM + 6) : ℕ) : ℤ) * ((1 <<< (b * (NHM + W * (MHM + R * DHM))) : ℕ) : ℤ) +
      ((1 <<< (SHM - 1) : ℕ) : ℤ) * (((1 <<< (b * (NHM + W * (MHM + R * (DHM + 1)))) : ℕ) : ℤ) +
        ((1 <<< (b * (NHM + W * (MHM + R * (DHM - 1)))) : ℕ) : ℤ)) := by
  unfold KvHM; rw [h]; rfl
/-- The image of a dummy variable. -/
theorem KvHM_k5 {b W R i : ℕ} (h : kindHM i = 5) : KvHM b W R i = 0 := by unfold KvHM; rw [h]; rfl
/-- The image of a stored family (fast or generic). -/
theorem KvHM_k6 {b W R i : ℕ} (h : kindHM i = 6) : KvHM b W R i =
    if bMinHM i ≤ b ∧ wMinHM i ≤ W then
      ((famTB b W R NHM MHM DHM (c0HM i) (oddHM i) drHM dwHM (famHM i) : ℕ) : ℤ) -
        ((famO b W R NHM MHM DHM dwHM (famHM i) : ℕ) : ℤ)
    else famPack b W R NHM MHM DHM (if oddHM i then -1 else 1) (c0HM i : ℤ) 0 0 ddHM drHM 0
      (famHM i) := by
  unfold KvHM; rw [h]; rfl

/-- The kinds of a variable. -/
theorem kindsHM (i : ℕ) : kindHM i = 0 ∨ kindHM i = 1 ∨ kindHM i = 2 ∨ kindHM i = 3 ∨
    kindHM i = 4 ∨ kindHM i = 5 ∨ kindHM i = 6 := by
  have := kindHM_le i; omega

/-- **The Kronecker images of the variable polynomials.** -/
theorem kronHM (b W R i : ℕ) : kron b W (flat R (PHM i)) = KvHM b W R i := by
  rcases kindsHM i with h | h | h | h | h | h | h
  · rw [PHM_k0 h, KvHM_k0 h, kron_flat_T3, two_pow_eq_shift]
  · rw [PHM_k1 h, KvHM_k1 h]; exact kron_flat_V3 b W R
  · rw [PHM_k2 h, KvHM_k2 h, flat_C]; exact kron_cPoly b W
  · rw [PHM_k3 h, KvHM_k3 h, flat_C]; exact kron_sPoly b W
  · rw [PHM_k4 h, KvHM_k4 h]; exact kron_flat_Pr3 SHM NHM MHM DHM b W R
  · rw [PHM_k5 h, KvHM_k5 h]; simp
  · have hi := lt_of_kindHM h
    rw [PHM_fam h, KvHM_k6 h]
    by_cases hw : bMinHM i ≤ b ∧ wMinHM i ≤ W
    · rw [ite_eq_left hw]
      exact kron_famTB (staticHM i hi h) ((dynHM i hi h).mono hw.1 hw.2) (oddHM i) R
    · rw [ite_eq_right hw]
      exact (famPack_eq b W R NHM MHM DHM _ _ 0 0 0 (famHM i)
        fun sd hsd => ((staticHM i hi h).2.2.2 sd hsd).1).symm

/-- **Degree boxes** of the variable polynomials. -/
theorem boxHM (i : ℕ) : InBox3 (PHM i) (BxHM i).1 (BxHM i).2.1 (BxHM i).2.2 := by
  by_cases hi : i < 96
  · rcases kindsHM i with h | h | h | h | h | h | h
    · rw [PHM_k0 h, (bx0HM i hi h).1]; exact inBox3_T3 SHM NHM MHM DHM
    · rw [PHM_k1 h, (bx1HM i hi h).1]; exact inBox3_V3
    · rw [PHM_k2 h, (bx2HM i hi h).1]; exact InBox3.C box_cPoly
    · rw [PHM_k3 h, (bx3HM i hi h).1]; exact InBox3.C box_sPoly
    · rw [PHM_k4 h, (bx4HM i hi h).1]; exact inBox3_Pr3 SHM NHM MHM DHM
    · rw [PHM_k5 h]; exact inBox3_zero _ _ _
    · rw [PHM_fam h, bx6HM i hi h]
      exact inBox3_famPoly _ _ _ _ _ _ _ 0 _ (by have := (staticHM i hi h).2.1; omega)
  · rw [PHM_k5 (kindHM_ge (by omega))]
    exact inBox3_zero _ _ _

/-- **Static `ℓ¹` bounds** of the flattened variable polynomials. -/
theorem l1HM (R i : ℕ) : l1 (flat R (PHM i)) ≤ LHM i := by
  by_cases hi : i < 96
  · rcases kindsHM i with h | h | h | h | h | h | h
    · rw [PHM_k0 h]; exact (l1_flat_T3 SHM NHM MHM DHM R).trans (bx0HM i hi h).2
    · rw [PHM_k1 h]; exact (l1_flat_V3 R).trans (bx1HM i hi h).2
    · rw [PHM_k2 h, flat_C]; exact l1_cPoly.trans (bx2HM i hi h).2
    · rw [PHM_k3 h, flat_C]; exact l1_sPoly.trans (bx3HM i hi h).2
    · rw [PHM_k4 h]; exact (l1_flat_Pr3 SHM NHM MHM DHM R).trans (bx4HM i hi h).2
    · rw [PHM_k5 h]; simp [l1, liftN]
    · rw [PHM_fam h]
      refine (l1_flat_famPoly_le R NHM MHM DHM (by split_ifs <;> simp) _ 0 0 0 (famHM i)
        fun sd hsd => ((staticHM i hi h).2.2.2 sd hsd).1.2.2.2.2).trans (l1famHM i hi h)
  · rw [PHM_k5 (kindHM_ge (by omega))]
    simp [l1, liftN]

/-- The phases are below `4`. -/
theorem hWHM : ∀ i, (WtHM i).2.2 < 4 :=
  getD_prop (Pr := fun w : ℕ × ℕ × ℕ => w.2.2 < 4) (by kernel_fact) (by kernel_fact)

/-- **The family centres** at the parameter `w = c`. -/
def xHM (c : ℂ) (i : ℕ) : FA := ctr3 SHM NHM MHM DHM c (WtHM i) (PHM i)

/-- The centre of a stored family. -/
theorem xHM_fam {c : ℂ} (hc : c ≠ 0) {i : ℕ} (h : kindHM i = 6) {p : ℕ}
    (hp : WtHM i = (1, 0, p)) :
    xHM c i = famCtr SHM NHM MHM p (if oddHM i then -1 else 1) (c0HM i : ℤ) 0 0 c 0
      (famHM i) := by
  have hi := lt_of_kindHM h
  rw [xHM, hp, PHM_fam h]
  exact ctr3_famPoly _ _ _ _ _ _ _ _ _ hc 0 _ (by have := (staticHM i hi h).2.1; omega)

/-- The centre of `t` is `1`. -/
theorem xHM_t {c : ℂ} (hc : c ≠ 0) : xHM c 0 = 1 := by
  rw [xHM, show WtHM 0 = (1, 0, 0) from rfl, show PHM 0 = T3 SHM NHM MHM DHM from rfl]
  exact ctr3_T3 _ _ _ _ hc

/-- The centre of `V` is `1`. -/
theorem xHM_V (c : ℂ) : xHM c 1 = 1 := by
  rw [xHM, show WtHM 1 = (0, 1, 0) from rfl, show PHM 1 = V3 from rfl]
  exact ctr3_V3 _ _ _ _ c

/-- The centre of `cos 2φ`. -/
theorem xHM_c (c : ℂ) : xHM c 2 = ctr SHM NHM MHM (0, 1, 3) cPoly := by
  rw [xHM, show WtHM 2 = (0, 1, 3) from rfl, show PHM 2 = C cPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 3 cPoly

/-- The centre of `sin 2φ`. -/
theorem xHM_s (c : ℂ) : xHM c 3 = ctr SHM NHM MHM (0, 1, 0) sPoly := by
  rw [xHM, show WtHM 3 = (0, 1, 0) from rfl, show PHM 3 = C sPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 0 sPoly

/-- The centre of the parameter `r` is `64 + (c + c⁻¹)/2`. -/
theorem xHM_r {c : ℂ} (hc : c ≠ 0) : xHM c 71 = algebraMap ℂ FA (64 + (c + c⁻¹) / 2) := by
  rw [xHM, show WtHM 71 = (1, 0, 0) from rfl, show PHM 71 = Pr3 SHM NHM MHM DHM from rfl]
  exact ctr3_Pr3 _ _ _ _ (by kernel_fact) (by kernel_fact) hc

/-- The centres of the variables of kind `5` (dummies) vanish. -/
theorem xHM_zero (c : ℂ) {i : ℕ} (h : kindHM i = 5) : xHM c i = 0 := by
  rw [xHM, PHM_k5 h]
  simp [ctr3]

