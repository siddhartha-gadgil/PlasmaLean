module

public import PlasmaLean.Design.RationalStellaratorGCEw3TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 61)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw3DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 3: gyro-length `ρ_3 = 1/256 + 5 · 2⁻³⁶`, its own family torus `K_3(λ)`; the
fields at `ρ_3` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `Z`. -/
theorem cHE3_Z : center3KN KvHE3 NHE3 MHE3 5 119 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Z`. -/
theorem clHE3_Z : LHE3 5 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m41`. -/
theorem cHE3_m41 : center3KN KvHE3 NHE3 MHE3 25 105 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m41`. -/
theorem clHE3_m41 : LHE3 25 < 2 ^ (105 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `VV4`. -/
theorem cHE3_VV4 : center3KN KvHE3 NHE3 MHE3 82 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `VV4`. -/
theorem clHE3_VV4 : LHE3 82 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `dZ`. -/
theorem kHE3_dZ : norm3KN WtHE3 KvHE3 NHE3 MHE3 trHE3N_dZ (1, 0, 1) 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `dZ`: a priori `ℓ¹` bound. -/
theorem lHE3_dZ : ExN.majN LHE3 trHE3N_dZ < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `R4`: truncation norm. -/
theorem kHE3_R4 : node3KN SHE3 NHE3 MHE3 DHE3 WtHE3 KvHE3 trHE3N_R4 (1 : Int) 1 0 73 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R4`: a priori `ℓ¹` bound. -/
theorem lHE3_R4 : nodeL1N SHE3 LHE3 trHE3N_R4 (1 : Int) 1 0 73 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
