/-!
# Admissibility, residual and constants of the guiding-centre torus family

For every parameter `|c| = 1` (`ρ = ρF c = (64 + Re c)/2^14 ∈ [63/16384, 65/16384]`), from the
two family ball chains (`Design/RationalStellaratorGCFamOut{H,L}`):

* the bounds of the family torus `K(c) = (1 + xHM c 4, xHM c 5)` on the strip `r_A`
  (`Bd_uM`, …): `‖u‖ ≤ 0.1947`, `‖z‖ ≤ 0.1636`, `‖∂_θu‖ ≤ 0.1647`, `‖∂_θz‖ ≤ 0.1629`,
  `‖𝓛u‖ ≤ 0.1105`, `‖𝓛z‖ ≤ 0.1048`;
* **the residual** (`muResR`, `muResZ`): `‖D̃ 𝓛K − ñ‖_{r_A} ≤ e₀ = 2.7 × 10⁻²¹` for the
  guiding-centre field `gcFlowMu (1 / 256) (lamF c)`;
* the distances to the low-resolution family and to the `ρ = 1/256` low-resolution torus;
* **admissibility** (`muAdm`): every analytic torus `μ = 10⁻¹¹`-close to `K(c)` satisfies the
  bounds of the Newton step with the constants `cM` (uniform over the cell).

**Sanity.** `lamF_mem`: `ρF c ∈ [63/16384, 65/16384]` for `|c| = 1`.

Pitch cell `λ ∈ [7/32, 1/4]`: modules `RationalStellaratorGCMu5*`,
namespace `PlasmaLean.Design.RationalStellaratorGC.Mu5`; generated by
`scripts/gc_kam/lamcell` from the pipeline of the cell `[0, 1/16]`.
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall PlasmaLean.Certificates.KronBallCheb
  PlasmaLean.Certificates.Kron2 WEll1Z2 Complex

/-! ## The parameter -/

/-- **Sanity**: the pitch parameter of the family lies in the cell `[7 / 32, 1 / 4]`. -/
theorem lamF_mem {c : ℂ} (hc : ‖c‖ = 1) : 7 / 32 ≤ lamF c ∧ lamF c ≤ 1 / 4 := by
  have h := Complex.abs_re_le_norm c
  rw [hc] at h
  have h' := abs_le.mp h
  constructor <;> rw [lamF] <;> linarith [h'.1, h'.2]

/-- `|lamF c| ≤ λ₁`. -/
theorem abs_lamF_le {c : ℂ} (hc : ‖c‖ = 1) : |lamF c| ≤ RationalStellaratorGCMu5.lam1 := by
  obtain ⟨h1, h2⟩ := lamF_mem hc
  rw [abs_of_nonneg (le_trans (by norm_num) h1), RationalStellaratorGCMu5.lam1]; linarith

/-! ## Constants -/

/-- The displacement budget `μ = 10⁻¹¹`. -/
def μM : ℝ := 1 / 10 ^ 11

/-- The initial error `e₀ = 2.7 × 10⁻²¹`. -/
def e0M : ℝ := 3 / 1000000000000000000000

/-- `‖u‖ + μ`. -/
def auM : ℝ := 973 / 5000 + μM
/-- `‖z‖ + μ`. -/
def azM : ℝ := 409 / 2500 + μM
/-- `‖∂_θ u‖ + μ`. -/
def aRtM : ℝ := 1649 / 10000 + μM
/-- `‖∂_θ z‖ + μ`. -/
def aztM : ℝ := 163 / 1000 + μM
/-- `‖𝓛u‖ + μ`. -/
def aLRM : ℝ := 69 / 625 + μM
/-- `‖𝓛z‖ + μ`. -/
def aLzM : ℝ := 523 / 5000 + μM
/-- `‖D̃⁻¹‖`. -/
def sDM : ℝ := 2047 / 1250
/-- `‖R⁻¹‖`. -/
def sRM : ℝ := 1 / (1 - auM)
/-- `‖W₀⁻¹‖`. -/
def sWM : ℝ := 3567 / 20
/-- The torsion bound. -/
def tTM : ℝ := 36901 / 1000
/-- The twist bound. -/
def τM : ℝ := 221 / 500

/-- **The step constants for the guiding-centre torus family** (uniform over the cell). -/
def cM : SC where
  ρ := KamTorusA.rA
  δ0 := δ0G
  γ := 687 / 10000
  θ := e0M / δ0G ^ 4
  au := auM
  az := azM
  aRt := aRtM
  azt := aztM
  aLR := aLRM
  aLz := aLzM
  ac := acG
  bD := 12771 / 10000
  bDu := 22371 / 10000
  bDz := 20401 / 100000
  bnR := 10151 / 100000
  bnRu := 94841 / 100000
  bnRz := 74591 / 100000
  bnZ := 10551 / 100000
  bnZu := 87101 / 100000
  bnZz := 81891 / 100000
  sD := sDM
  sR := sRM
  sW := sWM
  tT := tTM
  τ := τM
  C2 := (RationalStellaratorGCMu5.C2Q : ℝ)
  E1 := 2718 / 1000
  cKb := 5440
  cLb := 18800

/-- **Sanity**: the torus bound of `cM` is `‖u‖ + μ`. -/
theorem cM_au : cM.au = 973 / 5000 + 1 / 10 ^ 11 := rfl

/-! ## The family torus -/

/-- The values of the high-resolution chain at `r_A`. -/
theorem valHM_rA {c : ℂ} (hc : ‖c‖ = 1) (i : ℕ) (hi : i < 96) :
    Bd KamTorusA.rA (XHM c i) ((BHM i + EHM i : ℚ) : ℝ) :=
  valHM_le rA_nonneg' exp_rA_le' hc i hi

/-- `‖u‖_{r_A} ≤ 0.1947`. -/
theorem Bd_uM {c : ℂ} (hc : ‖c‖ = 1) : Bd KamTorusA.rA (xHM c 4) (973 / 5000) := by
  have h := valHM_rA hc 4 (by norm_num)
  rw [XHM_eq_U hc] at h
  refine h.le ?_
  have := qle (show BHM 4 + EHM 4 ≤ 973 / 5000 by decide_cbv)
  push_cast at this ⊢; exact this

/-- `‖z‖_{r_A} ≤ 0.1636`. -/
theorem Bd_zM {c : ℂ} (hc : ‖c‖ = 1) : Bd KamTorusA.rA (xHM c 5) (409 / 2500) := by
  have h := valHM_rA hc 5 (by norm_num)
  rw [XHM_eq_Z hc] at h
  refine h.le ?_
  have := qle (show BHM 5 + EHM 5 ≤ 409 / 2500 by decide_cbv)
  push_cast at this ⊢; exact this

/-- `∂_θ` of the family torus. -/
theorem dTh_xHM_U {c : ℂ} (hc : ‖c‖ = 1) : xHM c 8 = dTh (xHM c 4) := by
  rw [xHM_der_thU (ne_zero_of_norm_one_mu hc)]; simp [dTh]

/-- `∂_θ` of the family torus. -/
theorem dTh_xHM_Z {c : ℂ} (hc : ‖c‖ = 1) : xHM c 9 = dTh (xHM c 5) := by
  rw [xHM_der_thZ (ne_zero_of_norm_one_mu hc)]; simp [dTh]

/-- `‖∂_θ u‖_{r_A} ≤ 0.1647`. -/
theorem Bd_dTh_uM {c : ℂ} (hc : ‖c‖ = 1) : Bd KamTorusA.rA (dTh (xHM c 4)) (1649 / 10000) := by
  rw [← dTh_xHM_U hc]
  refine (normHM exp_rA_le' hc 8 (by norm_num)).le ?_
  have := qle (show BHM 8 ≤ 1649 / 10000 by decide_cbv); push_cast at this ⊢; exact this

/-- `‖∂_θ z‖_{r_A} ≤ 0.1629`. -/
theorem Bd_dTh_zM {c : ℂ} (hc : ‖c‖ = 1) : Bd KamTorusA.rA (dTh (xHM c 5)) (163 / 1000) := by
  rw [← dTh_xHM_Z hc]
  refine (normHM exp_rA_le' hc 9 (by norm_num)).le ?_
  have := qle (show BHM 9 ≤ 163 / 1000 by decide_cbv); push_cast at this ⊢; exact this

/-- `‖𝓛 u‖_{r_A} ≤ 0.1105`. -/
theorem Bd_Lt_uM {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA (Lt KamTorusA.iota (xHM c 4)) (69 / 625) := by
  have h := valHM_rA hc 6 (by norm_num)
  rw [XHM_spec c (i := 6) (by decide_cbv)] at h
  refine (Bd_inv_pow96 h).le ?_
  have := qle (show (BHM 6 + EHM 6) / 2 ^ 96 ≤ 69 / 625 by decide_cbv)
  push_cast at this ⊢; exact this

/-- `‖𝓛 z‖_{r_A} ≤ 0.1048`. -/
theorem Bd_Lt_zM {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA (Lt KamTorusA.iota (xHM c 5)) (523 / 5000) := by
  have h := valHM_rA hc 7 (by norm_num)
  rw [XHM_spec c (i := 7) (by decide_cbv)] at h
  refine (Bd_inv_pow96 h).le ?_
  have := qle (show (BHM 7 + EHM 7) / 2 ^ 96 ≤ 523 / 5000 by decide_cbv)
  push_cast at this ⊢; exact this

/-- The family torus is analytic. -/
theorem ana_uM {c : ℂ} (hc : ‖c‖ = 1) : Ana (xHM c 4) := by
  rw [xHM_fam (ne_zero_of_norm_one_mu hc) (i := 4) (by decide_cbv) (p := 0) rfl]
