/-- The full chain. -/
theorem ballHF_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) :
    ∀ i, i < 78 → Bd r (XHF c i - xHF c i) (EHF i) :=
  ballHF_78 hr hq hc

/-- A value is bounded by its centre norm plus its radius. -/
theorem valHF_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1)
    (i : ℕ) (hi : i < 78) :
    Bd r (XHF c i) ((BHF i + EHF i : ℚ) : ℝ) := by
  have := (normHF hq hc i hi).add (ballHF_all hr hq hc i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

