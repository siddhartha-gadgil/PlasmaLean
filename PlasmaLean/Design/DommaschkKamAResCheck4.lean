module

public import PlasmaLean.Design.DommaschkKamAResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAResTrees

/-!
# Proof-term checks of the torus-A residual chain (part 4)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamAResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_D7`, `kH_Dc6`, `kH_D6`, `kH_Dc5`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `D7`: truncation norm. -/
theorem kH_D7 : nodeKw 68553 16 SH NH MH WtH KvH trH_D7 (1 : ℤ) 1 0 18 275 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `D7`: a priori `ℓ¹` bound. -/
theorem lH_D7 : nodeL1 SH LH trH_D7 (1 : ℤ) 1 0 18 < 2 ^ (275 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc6`: truncation norm. -/
theorem kH_Dc6 : nodeKw 68553 16 SH NH MH WtH KvH trH_Dc6 (38400000000000 : ℤ) 0 3 19 191 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc6`: a priori `ℓ¹` bound. -/
theorem lH_Dc6 : nodeL1 SH LH trH_Dc6 (38400000000000 : ℤ) 0 3 19 < 2 ^ (191 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `D6`: truncation norm. -/
theorem kH_D6 : nodeKw 68553 16 SH NH MH WtH KvH trH_D6 (1 : ℤ) 1 0 20 277 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `D6`: a priori `ℓ¹` bound. -/
theorem lH_D6 : nodeL1 SH LH trH_D6 (1 : ℤ) 1 0 20 < 2 ^ (277 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc5`: truncation norm. -/
theorem kH_Dc5 : nodeKw 68553 16 SH NH MH WtH KvH trH_Dc5 (5760000000000 : ℤ) 0 3 21 188 193 8 8 165 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc5`: a priori `ℓ¹` bound. -/
theorem lH_Dc5 : nodeL1 SH LH trH_Dc5 (5760000000000 : ℤ) 0 3 21 < 2 ^ (188 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamA
