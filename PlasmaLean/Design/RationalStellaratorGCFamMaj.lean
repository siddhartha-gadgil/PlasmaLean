module

public import PlasmaLean.Design.RationalStellaratorGCTorusMaj
public import PlasmaLean.Certificates.KernelFact
public import PlasmaLean.Certificates.EvalCert

/-!
# Majorants of the guiding-centre field family: node validity and the Taylor constant

The computable mirrors (`Theory/KAM/PolyExprSMajQ`, `PQS`) of the expression trees of the
guiding-centre field `gcFlow (65/16384)` (`ρ_s = 65/16384`), built from the leaf mirrors of
`Design/RationalStellaratorGCTorusMaj` (which do not depend on `ρ`), with their embeddings
(`*_toS`), and the two numerical facts of the KAM theorem that need majorants, at the bounds of the
family tori (cell `ρ ∈ [63/16384, 65/16384]`); the majorants are monotone in `|ρ|`
(`majD2_resRp_mono`), so the constant at `ρ = 65/16384` is uniform over the cell (`gc_C2R_cell`):

* **node validity** (`gc_maj_E_*`): the majorant of the deviation `E` under the node is below `1`
  at the bounds used by the KAM step (`gcFlow_valid`);
* **the Taylor constant** (`gc_C2R`, `gc_C2Z`): `½ majD2(resR) ≤ C₂ = 88300000000.0` at the
  Taylor segment bounds `avec + T_q mvec`.

The evaluations of the rational majorants (`mQ`, `mD2Q`, `allNodes`) are evaluation
certificates (`eval_decide`, `eval_cert`: one kernel leaf per rational operation, shared
subtrees evaluated once); the remaining closed comparisons are `kernel_fact` proof terms.
Generated by `scripts/gc_kam/fam_maj.py`.

**Sanity.** `gcDQ_toS`: the mirror embeds to the field expression `gcD (65/16384)`.
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.RationalStellaratorGCFamily

open PlasmaLean.Design.RationalStellaratorGC
open PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Theory.KAM.PQS

/-- The mirror of `gcD (65/16384)`. -/
def gcDQ : PQS (Fin 6) :=
  .add (DpQ) (.mul (.const (65 / 16384)) (.mul (.const (1 / 2)) (.mul (eW3Q) (eKDQ))))

set_option linter.unusedSimpArgs false in
set_option maxRecDepth 100000 in
/-- The mirror of `gcD (65/16384)` embeds to it. -/
theorem gcDQ_toS : gcDQ.toS = gcD (65 / 16384) := by
  simp only [gcDQ, toS, DpQ_toS, nRpQ_toS, nZpQ_toS, DuPQ_toS, DzPQ_toS, DphPQ_toS,
              nRuPQ_toS, nRzPQ_toS, nRphPQ_toS, nZuPQ_toS, nZzPQ_toS, nZphPQ_toS,
              PuPQ_toS, EpPQ_toS, eVQ_toS, eWQ_toS, eW3Q_toS, eRQ_toS, eqRQ_toS,
              eqQ_toS, eqzQ_toS, eKDQ_toS, eqphQ_toS, eKRQ_toS, eKZQ_toS, gcD]
  norm_num

/-- The mirror of `gcNR (65/16384)`. -/
def gcNRQ : PQS (Fin 6) :=
  .add (nRpQ) (.mul (.const (65 / 16384)) (.mul (.const (1 / 2)) (.mul (eW3Q) (eKRQ))))

set_option linter.unusedSimpArgs false in
set_option maxRecDepth 100000 in
/-- The mirror of `gcNR (65/16384)` embeds to it. -/
theorem gcNRQ_toS : gcNRQ.toS = gcNR (65 / 16384) := by
  simp only [gcNRQ, toS, DpQ_toS, nRpQ_toS, nZpQ_toS, DuPQ_toS, DzPQ_toS, DphPQ_toS,
              nRuPQ_toS, nRzPQ_toS, nRphPQ_toS, nZuPQ_toS, nZzPQ_toS, nZphPQ_toS,
              PuPQ_toS, EpPQ_toS, eVQ_toS, eWQ_toS, eW3Q_toS, eRQ_toS, eqRQ_toS,
              eqQ_toS, eqzQ_toS, eKDQ_toS, eqphQ_toS, eKRQ_toS, eKZQ_toS, gcNR]
  norm_num

/-- The mirror of `gcNZ (65/16384)`. -/
def gcNZQ : PQS (Fin 6) :=
  .add (nZpQ) (.mul (.const (65 / 16384)) (.mul (.const (1 / 2)) (.mul (eW3Q) (eKZQ))))

set_option linter.unusedSimpArgs false in
set_option maxRecDepth 100000 in
/-- The mirror of `gcNZ (65/16384)` embeds to it. -/
theorem gcNZQ_toS : gcNZQ.toS = gcNZ (65 / 16384) := by
  simp only [gcNZQ, toS, DpQ_toS, nRpQ_toS, nZpQ_toS, DuPQ_toS, DzPQ_toS, DphPQ_toS,
              nRuPQ_toS, nRzPQ_toS, nRphPQ_toS, nZuPQ_toS, nZzPQ_toS, nZphPQ_toS,
              PuPQ_toS, EpPQ_toS, eVQ_toS, eWQ_toS, eW3Q_toS, eRQ_toS, eqRQ_toS,
              eqQ_toS, eqzQ_toS, eKDQ_toS, eqphQ_toS, eKRQ_toS, eKZQ_toS, gcNZ]
  norm_num

/-- The mirror of the `R`-residual expression. -/
def resRQ : PQS (Fin 6) := .sub (.mul gcDQ (.var 4)) gcNRQ

/-- The mirror of the `z`-residual expression. -/
def resZQ : PQS (Fin 6) := .sub (.mul gcDQ (.var 5)) gcNZQ

/-- The mirror of the `R`-residual embeds to it. -/
theorem resRQ_toS : resRQ.toS = (gcFlow (65 / 16384)).resRp := by
  simp only [resRQ, toS, gcDQ_toS, gcNRQ_toS]; rfl

/-- The mirror of the `z`-residual embeds to it. -/
theorem resZQ_toS : resZQ.toS = (gcFlow (65 / 16384)).resZp := by
  simp only [resZQ, toS, gcDQ_toS, gcNZQ_toS]; rfl

/-- Rational upper bounds of the torus variables on the Taylor segments (`avec + T_q mvec`, and the
admissible tori). -/
def aTQ : Fin 6 → ℚ := 
  ![(973500001 / 5000000000 : ℚ),
    (818000001 / 5000000000 : ℚ),
    (74315 / 2 ^ 16 : ℚ),
    (74315 / 2 ^ 16 : ℚ),
    (552500001 / 5000000000 : ℚ),
    (524000001 / 5000000000 : ℚ)]

/-- The perturbation profile `(c_K, c_K, 0, 0, c_L, c_L)`. -/
def mvQ : Fin 6 → ℚ := 
  ![(6170 : ℚ),
    (6170 : ℚ),
    (0 : ℚ),
    (0 : ℚ),
    (21400 : ℚ),
    (21400 : ℚ)]

/-- The bound of the node majorant. -/
def mEQ : ℚ := (2927 / 10 ^ 4 : ℚ)

/-- The bound of `(1 − m)^{−1/2}`. -/
def gQ : ℚ := (23781 / 20000 : ℚ)

/-- The Taylor constant. -/
def C2Q : ℚ := (88300000000 : ℚ)

set_option maxRecDepth 100000 in
/-- **The node majorant at `aTQ`**: `maj E ≤ 0.2927`. -/
theorem gc_maj_E_aTQ : PolyExpr.maj (fun i => (aTQ i : ℝ)) EpP ≤ (mEQ : ℝ) := by
  rw [← PolyExprS.maj_ofPoly, ← EpPQ_toS]
  refine (maj_le (a := aTQ) (g := 0) (by kernel_fact) le_rfl EpPQ (nodesOK_EpPQ _ _)).trans ?_
  exact_mod_cast (show mQ aTQ 0 EpPQ ≤ mEQ by eval_decide)

/-- **Node validity** at every bound below `aTQ`. -/
theorem gc_maj_E_lt {a : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (haa : ∀ i, a i ≤ aTQ i) :
    PolyExpr.maj a EpP < 1 := by
  refine ((PolyExpr.maj_mono ha haa EpP).trans gc_maj_E_aTQ).trans_lt ?_
  exact_mod_cast (show mEQ < 1 by kernel_fact)

set_option maxRecDepth 100000 in
/-- All nodes of the residual trees are the node `(1 + E)^{−1/2}`. -/
theorem allNodes_res : allNodes EpPQ resRQ = true ∧ allNodes EpPQ resZQ = true := by
  constructor <;> eval_cert

/-- The node condition on the residual trees at `aTQ`. -/
theorem nodesOK_res {e : PQS (Fin 6)} (he : allNodes EpPQ e = true) :
    NodesOK (fun i => (aTQ i : ℝ)) (gQ : ℝ) e.toS := by
  have hm := gc_maj_E_aTQ
  rw [← PolyExprS.maj_ofPoly, ← EpPQ_toS] at hm
  refine nodesOK_of_all (nodesOK_EpPQ _ _) (hm.trans_lt ?_) ?_ e he
  · exact_mod_cast (show mEQ < 1 by kernel_fact)
  · refine isqG_le_q hm (by exact_mod_cast (show mEQ < 1 by kernel_fact))
      (by exact_mod_cast (show (0 : ℚ) ≤ gQ by kernel_fact))
      (by exact_mod_cast (show 1 ≤ gQ ^ 2 * (1 - mEQ) by kernel_fact))

set_option maxRecDepth 100000 in
/-- **The Taylor constant of the `R`-residual** at every bound below `aTQ`. -/
theorem gc_C2R {a : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (haa : ∀ i, a i ≤ aTQ i) :
    PolyExprS.majD2 a (fun i => (mvQ i : ℝ)) (gcFlow (65 / 16384)).resRp / 2 ≤ (C2Q : ℝ) := by
  rw [← resRQ_toS]
  have hN := nodesOK_res allNodes_res.1
  have hb : ∀ i, (0 : ℝ) ≤ (mvQ i : ℝ) := fun i => by
    have := (show ∀ i, (0 : ℚ) ≤ mvQ i by kernel_fact) i
    exact_mod_cast this
  have h1 := PolyExprS.majD2_mono (b := fun i => (mvQ i : ℝ)) (b' := fun i => (mvQ i : ℝ)) ha hb
    haa (fun _ => le_rfl) (valid_of_nodesOK hN)
  have h2 := majD2_le (a := aTQ) (b := mvQ) (g := gQ) (by kernel_fact) (by kernel_fact)
    (by kernel_fact) resRQ hN
  have h3 : (mD2Q aTQ mvQ gQ resRQ : ℝ) / 2 ≤ C2Q := by
    exact_mod_cast (show mD2Q aTQ mvQ gQ resRQ / 2 ≤ C2Q by eval_decide)
  linarith

set_option maxRecDepth 100000 in
/-- **The Taylor constant of the `z`-residual** at every bound below `aTQ`. -/
theorem gc_C2Z {a : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (haa : ∀ i, a i ≤ aTQ i) :
    PolyExprS.majD2 a (fun i => (mvQ i : ℝ)) (gcFlow (65 / 16384)).resZp / 2 ≤ (C2Q : ℝ) := by
  rw [← resZQ_toS]
  have hN := nodesOK_res allNodes_res.2
  have hb : ∀ i, (0 : ℝ) ≤ (mvQ i : ℝ) := fun i => by
    have := (show ∀ i, (0 : ℚ) ≤ mvQ i by kernel_fact) i
    exact_mod_cast this
  have h1 := PolyExprS.majD2_mono (b := fun i => (mvQ i : ℝ)) (b' := fun i => (mvQ i : ℝ)) ha hb
    haa (fun _ => le_rfl) (valid_of_nodesOK hN)
  have h2 := majD2_le (a := aTQ) (b := mvQ) (g := gQ) (by kernel_fact) (by kernel_fact)
    (by kernel_fact) resZQ hN
  have h3 : (mD2Q aTQ mvQ gQ resZQ : ℝ) / 2 ≤ C2Q := by
    exact_mod_cast (show mD2Q aTQ mvQ gQ resZQ / 2 ≤ C2Q by eval_decide)
  linarith

/-- The residual expressions are valid at every bound below `aTQ`. -/
theorem gc_valid_res {a : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (haa : ∀ i, a i ≤ aTQ i) :
    PolyExprS.Valid a (gcFlow (65 / 16384)).resRp ∧ PolyExprS.Valid a (gcFlow (65 / 16384)).resZp :=
  ⟨(gcFlow_valid _ a (gc_maj_E_lt ha haa)).2.1, (gcFlow_valid _ a (gc_maj_E_lt ha haa)).2.2⟩


/-! ## Monotonicity in `ρ` -/

/-- `‖ρ‖ ≤ ρ'` for `|ρ| ≤ ρ'`. -/
theorem norm_ofReal_le {ρ ρ' : ℝ} (h : |ρ| ≤ ρ') : ‖(ρ : ℂ)‖ ≤ ‖(ρ' : ℂ)‖ := by
  rw [Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs]
  exact h.trans (le_abs_self _)

/-- **The second-derivative majorant of the `R`-residual is monotone in `|ρ|`.** -/
theorem majD2_resRp_mono {a b : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (hb : ∀ i, 0 ≤ b i) {ρ ρ' : ℝ}
    (h : |ρ| ≤ ρ') :
    PolyExprS.majD2 a b (gcFlow ρ).resRp ≤ PolyExprS.majD2 a b (gcFlow ρ').resRp := by
  have hρ := norm_ofReal_le h
  simp only [FlowFieldS.resRp, gcFlow, gcD, gcNR, PolyExprS.majD2, PolyExprS.majD, PolyExprS.maj]
  have m1 := PolyExprS.maj_nonneg ha (.mul (.const (1 / 2 : ℂ)) (.mul eW3 eKD))
  have m2 := PolyExprS.majD_nonneg ha hb (.mul (.const (1 / 2 : ℂ)) (.mul eW3 eKD))
  have m3 := PolyExprS.majD2_nonneg ha hb (.mul (.const (1 / 2 : ℂ)) (.mul eW3 eKD))
  have m4 := PolyExprS.majD2_nonneg ha hb (.mul (.const (1 / 2 : ℂ)) (.mul eW3 eKR))
  simp only [PolyExprS.majD2, PolyExprS.majD, PolyExprS.maj] at m1 m2 m3 m4
  have a4 := ha 4
  have b4 := hb 4
  gcongr

/-- **The second-derivative majorant of the `z`-residual is monotone in `|ρ|`.** -/
theorem majD2_resZp_mono {a b : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (hb : ∀ i, 0 ≤ b i) {ρ ρ' : ℝ}
    (h : |ρ| ≤ ρ') :
    PolyExprS.majD2 a b (gcFlow ρ).resZp ≤ PolyExprS.majD2 a b (gcFlow ρ').resZp := by
  have hρ := norm_ofReal_le h
  simp only [FlowFieldS.resZp, gcFlow, gcD, gcNZ, PolyExprS.majD2, PolyExprS.majD, PolyExprS.maj]
  have m1 := PolyExprS.maj_nonneg ha (.mul (.const (1 / 2 : ℂ)) (.mul eW3 eKD))
  have m2 := PolyExprS.majD_nonneg ha hb (.mul (.const (1 / 2 : ℂ)) (.mul eW3 eKD))
  have m3 := PolyExprS.majD2_nonneg ha hb (.mul (.const (1 / 2 : ℂ)) (.mul eW3 eKD))
  have m4 := PolyExprS.majD2_nonneg ha hb (.mul (.const (1 / 2 : ℂ)) (.mul eW3 eKZ))
  simp only [PolyExprS.majD2, PolyExprS.majD, PolyExprS.maj] at m1 m2 m3 m4
  have a5 := ha 5
  have b5 := hb 5
  gcongr

/-- **The Taylor constant of the `R`-residual, uniform over the cell** `|ρ| ≤ 65/16384`. -/
theorem gc_C2R_cell {a : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (haa : ∀ i, a i ≤ aTQ i) {ρ : ℝ}
    (hρ : |ρ| ≤ 65 / 16384) :
    PolyExprS.majD2 a (fun i => (mvQ i : ℝ)) (gcFlow ρ).resRp / 2 ≤ (C2Q : ℝ) := by
  have hb : ∀ i, (0 : ℝ) ≤ (mvQ i : ℝ) := fun i => by
    have := (show ∀ i, (0 : ℚ) ≤ mvQ i by kernel_fact) i
    exact_mod_cast this
  have := majD2_resRp_mono ha hb hρ
  linarith [gc_C2R ha haa]

/-- **The Taylor constant of the `z`-residual, uniform over the cell** `|ρ| ≤ 65/16384`. -/
theorem gc_C2Z_cell {a : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (haa : ∀ i, a i ≤ aTQ i) {ρ : ℝ}
    (hρ : |ρ| ≤ 65 / 16384) :
    PolyExprS.majD2 a (fun i => (mvQ i : ℝ)) (gcFlow ρ).resZp / 2 ≤ (C2Q : ℝ) := by
  have hb : ∀ i, (0 : ℝ) ≤ (mvQ i : ℝ) := fun i => by
    have := (show ∀ i, (0 : ℚ) ≤ mvQ i by kernel_fact) i
    exact_mod_cast this
  have := majD2_resZp_mono ha hb hρ
  linarith [gc_C2Z ha haa]

/-- The residual expressions are valid at every bound below `aTQ`, for every `ρ`. -/
theorem gc_valid_res_cell {a : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (haa : ∀ i, a i ≤ aTQ i) (ρ : ℝ) :
    PolyExprS.Valid a (gcFlow ρ).resRp ∧ PolyExprS.Valid a (gcFlow ρ).resZp :=
  ⟨(gcFlow_valid _ a (gc_maj_E_lt ha haa)).2.1, (gcFlow_valid _ a (gc_maj_E_lt ha haa)).2.2⟩

end PlasmaLean.Design.RationalStellaratorGCFamily
