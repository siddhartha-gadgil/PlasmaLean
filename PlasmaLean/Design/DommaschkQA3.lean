module

public import PlasmaLean.Design.DommaschkQA3Data
public import PlasmaLean.Design.RationalStellarator
public import PlasmaLean.Theory.Contract.StellaratorContract

/-!
# The Dommaschk QA candidate (NFP 3) is an exact vacuum field

Certification step 1 for the lead quasi-axisymmetric candidate of research note N-31
(`notes/theory/dommaschk-qa.md`, §15 and "Path to certification"):
`scripts/dommaschk_qa/results/20261031T044845Z/candidate.json` (NFP 3, nmax 2, lmax 4, 24
Dommaschk basis potentials). In cylindrical coordinates, with `R₀ = 1`,
`B = ∇φ + Σ_k a_k ∇V_k`, `V_k = trig(m_k φ) Σ c R^p (ln R)^q z^j` (exact rational data).

Lean model.
* `P k : CylPoly` (`DommaschkQA3Data`, generated by `scripts/dommaschk_qa/emit_lean.py`) is the
  Cartesian form of `D_k V_k` with integer coefficients, and `scale k = 1 / D_k`, so
  `V k = scale k · eval (P k)`. The agreement of `P k / D_k` with the cylindrical formula of
  `basis.py` is checked exactly by the generator (sympy), not in Lean.
* `field a = toroidal + Σ_k (a_k · scale k) • gradField (P k)` is `∇φ + Σ a_k ∇V_k`
  (`hasFDerivAt_V`: `gradField` is the actual gradient); `toroidal` is `∇φ` of
  `Design/RationalStellarator`. The candidate is `field candidate` with the exact fitted
  coefficients.

Results.
* `basis_harmonic k`: the formal Laplacian of every basis potential normalises to zero
  (kernel-checked, `DommaschkQA3Data.nf_lap_P*`); hence `basis_vacuum k` and `V_harmonic`.
* **`field_vacuum a : VacuumField domain (field a)`** for every coefficient vector `a`, and
  **`candidate_vacuum`** (open region `r₂ > 0`, `C²`, `∇ · B = 0`, `∇ × B = 0`).
* C1 current clause: `candidate_netToroidalCurrent_eq_zero` (zero net toroidal current through
  every section lying off the `z`-axis) and `candidate_currentFree`.
* `field_stellSym a`: stellarator symmetry `B(σ y) = −σ B(y)`,
  `σ = stellRefl : (x, y, z) ↦ (x, −y, −z)` (`(R, φ, z) ↦ (R, −φ, −z)`), for every `a`.

Sanity: `field_zero` (`a = 0` gives `∇φ`), `eval_P0` (`V₀ = z`), the rejected fixture
`CylAlgebra.nf_lap_x2_ne`. Numerical cross-check (informal): at `(x, y, z) = (21/20, 1/10, 1/50)`
the emitted data give `field candidate ≈ (−0.0913727069975, 0.940450963505, 0.0131603198225)`,
agreeing with `scripts/dommaschk_qa/fieldeval.py` to `3·10⁻¹⁵` (printed by `emit_lean.py`).

Not proved here: the three-field-period symmetry (rotation by `2π/3`), field-line properties
(axis, rotational transform, flux surfaces), and the quasi-axisymmetry of `|B|`; the fit itself is
untrusted numerics.
-/

open scoped RealInnerProductSpace

public section
noncomputable section
namespace PlasmaLean.Design.DommaschkQA3
open PlasmaLean.Fields PlasmaLean.Vacuum PlasmaLean.Fields.CylAlgebra PlasmaLean.Contract
open Set Real

/-- The region of the theorems, `{x² + y² > 0}`; equal to `RationalStellarator.domain`. -/
theorem domain_eq : CylAlgebra.domain = RationalStellarator.domain := rfl

/-- The Dommaschk basis potential `V_k = scale k · eval (P k)`. -/
@[expose] def V (k : Fin 24) (y : Space) : ℝ := (scale k : ℝ) * eval (P k) y

/-- **The candidate field family** `B_a = ∇φ + Σ_k a_k ∇V_k`. -/
@[expose] def field (a : Fin 24 → ℚ) (y : Space) : Space :=
  RationalStellarator.toroidal y + ∑ k, ((a k * scale k : ℚ) : ℝ) • gradField (P k) y

/-- `∇V_k = scale k • gradField (P k)` off the axis (actual Fréchet derivative). -/
theorem hasFDerivAt_V (k : Fin 24) {x : Space} (hx : x ∈ CylAlgebra.domain) :
    HasFDerivAt (V k) (innerSL ℝ ((scale k : ℝ) • gradField (P k) x)) x := by
  have := (hasFDerivAt_eval_inner (P k) (ne_of_gt hx)).const_mul (scale k : ℝ)
  refine this.congr_fderiv ?_
  ext v
  simp

/-- **Each basis potential is harmonic** (formal check, kernel-evaluated). -/
theorem basis_harmonic (k : Fin 24) : nf (lap (P k)) = [] := by
  fin_cases k
  exacts [nf_lap_P0, nf_lap_P1, nf_lap_P2, nf_lap_P3, nf_lap_P4, nf_lap_P5, nf_lap_P6,
    nf_lap_P7, nf_lap_P8, nf_lap_P9, nf_lap_P10, nf_lap_P11, nf_lap_P12, nf_lap_P13,
    nf_lap_P14, nf_lap_P15, nf_lap_P16, nf_lap_P17, nf_lap_P18, nf_lap_P19, nf_lap_P20,
    nf_lap_P21, nf_lap_P22, nf_lap_P23]

/-- Every basis potential is odd under the stellarator symmetry. -/
theorem basis_parity (k : Fin 24) : parityCheck 1 (P k) = true := by
  fin_cases k
  exacts [parity_P0, parity_P1, parity_P2, parity_P3, parity_P4, parity_P5, parity_P6,
    parity_P7, parity_P8, parity_P9, parity_P10, parity_P11, parity_P12, parity_P13,
    parity_P14, parity_P15, parity_P16, parity_P17, parity_P18, parity_P19, parity_P20,
    parity_P21, parity_P22, parity_P23]

/-- `∂ₓ² + ∂_y² + ∂_z²` of each basis potential vanishes off the axis. -/
theorem V_harmonic (k : Fin 24) {x : Space} (hx : x ∈ CylAlgebra.domain) :
    eval (lap (P k)) x = 0 :=
  eval_lap_eq_zero (basis_harmonic k) hx

/-- Each `∇V_k` (up to the factor `scale k`) is a vacuum field off the axis. -/
theorem basis_vacuum (k : Fin 24) : VacuumField CylAlgebra.domain (gradField (P k)) :=
  gradField_vacuum (basis_harmonic k)

/-- **The candidate family is an exact vacuum field** off the `z`-axis, for every coefficient
vector `a`: open region, `C²`, `∇ · B = 0`, `∇ × B = 0`. -/
theorem field_vacuum (a : Fin 24 → ℚ) : VacuumField CylAlgebra.domain (field a) := by
  have hT : VacuumField CylAlgebra.domain RationalStellarator.toroidal :=
    RationalStellarator.toroidal_vacuum
  have hS := VacuumField.sum Finset.univ isOpen_domain
    (F := fun k => ((a k * scale k : ℚ) : ℝ) • gradField (P k)) fun k _ => (basis_vacuum k).smul _
  convert hT.add hS using 1
  funext y
  rfl

/-- **The lead Dommaschk QA candidate is an exact vacuum field** off the `z`-axis. -/
theorem candidate_vacuum : VacuumField CylAlgebra.domain (field candidate) :=
  field_vacuum candidate

/-- **C1 current clause**: every field of the family carries zero net toroidal current through
any section lying off the `z`-axis. -/
theorem field_netToroidalCurrent_eq_zero (a : Fin 24 → ℚ) (μ₀ : ℝ) {X : Space → Space}
    {ζ₀ k₀ : ℝ} (hk₀ : 0 ≤ k₀)
    (hX : ∀ k ∈ Icc 0 k₀, ∀ χ ∈ Icc (-π) π, X (coordPt k χ ζ₀) ∈ CylAlgebra.domain) :
    netToroidalCurrent μ₀ (field a) X ζ₀ k₀ = 0 :=
  netToroidalCurrent_eq_zero_of_vacuum (field_vacuum a) hk₀ hX

/-- **C1 current clause for the candidate**: zero net toroidal current through every section
lying off the `z`-axis. -/
theorem candidate_netToroidalCurrent_eq_zero (μ₀ : ℝ) {X : Space → Space} {ζ₀ k₀ : ℝ}
    (hk₀ : 0 ≤ k₀)
    (hX : ∀ k ∈ Icc 0 k₀, ∀ χ ∈ Icc (-π) π, X (coordPt k χ ζ₀) ∈ CylAlgebra.domain) :
    netToroidalCurrent μ₀ (field candidate) X ζ₀ k₀ = 0 :=
  field_netToroidalCurrent_eq_zero candidate μ₀ hk₀ hX

/-- The candidate is current-free (`CurrentFree`, `I_max = 0`) on every family of sections lying
off the `z`-axis. -/
theorem candidate_currentFree (μ₀ : ℝ) {X : Space → Space} {ζ₀ : ℝ} {K : Set ℝ}
    (hX : ∀ k₀ ∈ K, 0 ≤ k₀ ∧
      ∀ k ∈ Icc 0 k₀, ∀ χ ∈ Icc (-π) π, X (coordPt k χ ζ₀) ∈ CylAlgebra.domain) :
    CurrentFree μ₀ (field candidate) X ζ₀ K :=
  currentFree_of_vacuum candidate_vacuum hX

/-! ## Stellarator symmetry -/

/-- `∇φ` is reversed by the stellarator symmetry: `∇φ(σ y) = −σ ∇φ(y)`. -/
theorem toroidal_stellRefl (y : Space) :
    RationalStellarator.toroidal (stellRefl y) = -stellRefl (RationalStellarator.toroidal y) := by
  have hw : RationalStellarator.winv (stellRefl y) = RationalStellarator.winv y := by
    simp [RationalStellarator.winv, RationalStellarator.r2, stellRefl]
  ext k
  fin_cases k <;> simp [RationalStellarator.toroidal, hw] <;> simp [stellRefl]

/-- **Stellarator symmetry** of every field of the family: `B(σ y) = −σ B(y)` with
`σ(x, y, z) = (x, −y, −z)`. -/
theorem field_stellSym (a : Fin 24 → ℚ) (y : Space) :
    field a (stellRefl y) = -stellRefl (field a y) := by
  simp only [field, toroidal_stellRefl, gradField_stellRefl (basis_parity _), stellRefl_add,
    stellRefl_sum, stellRefl_smul, smul_neg, Finset.sum_neg_distrib, neg_add]

/-! ## Sanity checks -/

/-- Degenerate case: with all coefficients zero the field is `∇φ`. -/
theorem field_zero : field 0 = RationalStellarator.toroidal := by
  funext y; simp [field]

/-- Concrete instance: the first basis potential is `V₀ = D_{0,1} = z`. -/
theorem eval_P0 (y : Space) : V 0 y = y 2 := by
  simp [V, P, P0, scale, eval, Mono.eval]

end PlasmaLean.Design.DommaschkQA3
