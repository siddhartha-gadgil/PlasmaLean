/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH60`)

The checks of `Design/RationalStellaratorGCMu4CheckH60` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `U`. -/
theorem cHMS_U : center3KS KvSHM NHM MHM 4 119 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `U`. -/
theorem clHM_U : LHM 4 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `LZx`. -/
theorem cHMS_LZx : center3KS KvSHM NHM MHM 7 221 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `LZx`. -/
theorem clHM_LZx : LHM 7 < 2 ^ (221 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `P42`: truncation norm. -/
theorem kHMS_P42 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_P42 (1 : Int) 1 0 75 244 145 109 49 13 8 19 72 54 ≤
     := by
