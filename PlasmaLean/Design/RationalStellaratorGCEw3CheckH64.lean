module

public import PlasmaLean.Design.RationalStellaratorGCEw3TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 64)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw3DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 3: gyro-length `ρ_3 = 1/256 + 5 · 2⁻³⁶`, its own family torus `K_3(λ)`; the
fields at `ρ_3` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `thU`. -/
theorem cHE3_thU : center3KN KvHE3 NHE3 MHE3 8 125 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thU`. -/
theorem clHE3_thU : LHE3 8 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m21`. -/
theorem cHE3_m21 : center3KN KvHE3 NHE3 MHE3 19 111 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m21`. -/
theorem clHE3_m21 : LHE3 19 < 2 ^ (111 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `P42`. -/
theorem cHE3_P42 : center3KN KvHE3 NHE3 MHE3 75 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `P42`. -/
theorem clHE3_P42 : LHE3 75 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `Vm1`. -/
theorem kHE3_Vm1 : norm3KN WtHE3 KvHE3 NHE3 MHE3 trHE3N_Vm1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `Vm1`: a priori `ℓ¹` bound. -/
theorem lHE3_Vm1 : ExN.majN LHE3 trHE3N_Vm1 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `V42`: truncation norm. -/
theorem kHE3_V42 : node3KN SHE3 NHE3 MHE3 DHE3 WtHE3 KvHE3 trHE3N_V42 (1 : Int) 1 0 80 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `V42`: a priori `ℓ¹` bound. -/
theorem lHE3_V42 : nodeL1N SHE3 LHE3 trHE3N_V42 (1 : Int) 1 0 80 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
