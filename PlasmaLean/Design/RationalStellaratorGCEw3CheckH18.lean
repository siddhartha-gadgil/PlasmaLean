module

public import PlasmaLean.Design.RationalStellaratorGCEw3TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 18)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw3DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 3: gyro-length `ρ_3 = 1/256 + 5 · 2⁻³⁶`, its own family torus `K_3(λ)`; the
fields at `ρ_3` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nRp`. -/
theorem cHE3_nRp : center3KN KvHE3 NHE3 MHE3 30 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRp`. -/
theorem clHE3_nRp : LHE3 30 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `N2`. -/
theorem cHE3_N2 : center3KN KvHE3 NHE3 MHE3 87 124 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `N2`. -/
theorem clHE3_N2 : LHE3 87 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `m12`: truncation norm. -/
theorem kHE3_m12 : node3KN SHE3 NHE3 MHE3 DHE3 WtHE3 KvHE3 trHE3N_m12 (1 : Int) 1 0 18 232 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m12`: a priori `ℓ¹` bound. -/
theorem lHE3_m12 : nodeL1N SHE3 LHE3 trHE3N_m12 (1 : Int) 1 0 18 < 2 ^ (232 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
