set_option maxRecDepth 100000 in
/-- Kernel check of the node `K2`: truncation norm. -/
theorem kHF_K2 : node3KN SHF NHF MHF DHF WtHF KvHF trHFN_K2 (1 : Int) 1 0 63 240 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `K2`: a priori `ℓ¹` bound. -/
theorem lHF_K2 : nodeL1N SHF LHF trHFN_K2 (1 : Int) 1 0 63 < 2 ^ (240 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `YDt`: truncation norm. -/
