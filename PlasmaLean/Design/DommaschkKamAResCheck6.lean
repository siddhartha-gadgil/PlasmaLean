module

public import PlasmaLean.Design.DommaschkKamAResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAResTrees

/-!
# Proof-term checks of the torus-A residual chain (part 6)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamAResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_D3`, `kH_Dc2`, `kH_D2`, `kH_Dc1`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `D3`: truncation norm. -/
theorem kH_D3 : nodeKw 68553 16 SH NH MH WtH KvH trH_D3 (1 : ℤ) 1 0 26 277 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `D3`: a priori `ℓ¹` bound. -/
theorem lH_D3 : nodeL1 SH LH trH_D3 (1 : ℤ) 1 0 26 < 2 ^ (277 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc2`: truncation norm. -/
theorem kH_Dc2 : nodeKw 68553 16 SH NH MH WtH KvH trH_Dc2 (115200000000000 : ℤ) 0 3 27 193 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc2`: a priori `ℓ¹` bound. -/
theorem lH_Dc2 : nodeL1 SH LH trH_Dc2 (115200000000000 : ℤ) 0 3 27 < 2 ^ (193 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `D2`: truncation norm. -/
theorem kH_D2 : nodeKw 68553 16 SH NH MH WtH KvH trH_D2 (1 : ℤ) 1 0 28 277 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `D2`: a priori `ℓ¹` bound. -/
theorem lH_D2 : nodeL1 SH LH trH_D2 (1 : ℤ) 1 0 28 < 2 ^ (277 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc1`: truncation norm. -/
theorem kH_Dc1 : nodeKw 68553 16 SH NH MH WtH KvH trH_Dc1 (67200000000000 : ℤ) 0 3 29 192 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc1`: a priori `ℓ¹` bound. -/
theorem lH_Dc1 : nodeL1 SH LH trH_Dc1 (67200000000000 : ℤ) 0 3 29 < 2 ^ (192 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamA
