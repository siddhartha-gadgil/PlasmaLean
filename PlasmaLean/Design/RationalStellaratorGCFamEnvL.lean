/-!
# The low-resolution environment of the guiding-centre torus family certificate

The variable polynomials `PLF i` (three variables: `θ`-, `ψ`-modes and the Chebyshev variable
`w`), their degree boxes (`boxLF`), static `ℓ¹` bounds (`l1LF`) and Kronecker images (`kronLF`);
the family centres `xLF c i` at the parameter `w = c`; the norm bounds `BLF i` of the centres and
the radii `ELF i` of the balls (supplied by the oracle, checked in
`Design/RationalStellaratorGCFamCheckL*`).
Generated by `scripts/gc_kam/fam_emit_lean.py`.
-/

@[expose] public section
noncomputable section

set_option linter.style.longLine false

namespace PlasmaLean.Design.RationalStellaratorGC

open Polynomial PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall PlasmaLean.Certificates.KronBallCheb PlasmaLean.Theory.KAM

/-- **The variable polynomials** of the family pipeline (by kind, `kindLF`). -/
def PLF (i : ℕ) : P3 :=
  match kindLF i with
  | 0 => T3 SLF NLF MLF DLF
  | 1 => V3
  | 2 => C cPoly
  | 3 => C sPoly
  | 4 => Pr3 SLF NLF MLF DLF
  | 5 => 0
  | _ => famPoly NLF MLF DLF (if oddLF i then -1 else 1) (c0LF i : ℤ) 0 0 0 (famLF i)

/-- The kinds are at most `6`. -/
theorem kindLF_le (i : ℕ) : kindLF i ≤ 6 :=
  getD_prop (Pr := fun k : ℕ => k ≤ 6) (by kernel_fact) (by kernel_fact) i

/-- The variables beyond the last have kind `5` (zero). -/
theorem kindLF_ge {i : ℕ} (h : 142 ≤ i) : kindLF i = 5 := by
  unfold kindLF
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simp [kindLFl]; omega)]
  rfl

/-- Stored families are below the last variable. -/
theorem lt_of_kindLF {i : ℕ} (h : kindLF i = 6) : i < 142 := by
  by_contra h'
  rw [kindLF_ge (by omega)] at h
  exact absurd h (by kernel_fact)

set_option maxRecDepth 100000 in
/-- The static conditions of the stored families. -/
theorem staticLF : ∀ i, i < 142 → kindLF i = 6 →
    FamStatic NLF MLF DLF ddLF drLF dwLF (famLF i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The minimal widths of the fast images. -/
theorem dynLF : ∀ i, i < 142 → kindLF i = 6 →
    FamDyn (bMinLF i) (wMinLF i) (c0LF i) (famLF i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The static `ℓ¹` bounds of the stored families. -/
theorem l1famLF : ∀ i, i < 142 → kindLF i = 6 →
    famL1 NLF MLF (c0LF i : ℤ) 0 0 0 (famLF i) ≤ LLF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree boxes of the stored families. -/
theorem bx6LF : ∀ i, i < 142 → kindLF i = 6 → BxLF i = (2 * NLF, 2 * MLF, 2 * DLF) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `t`. -/
theorem bx0LF : ∀ i, i < 142 → kindLF i = 0 → BxLF i = (NLF, MLF, DLF) ∧ 2 ^ SLF ≤ LLF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `V`. -/
theorem bx1LF : ∀ i, i < 142 → kindLF i = 1 → BxLF i = (0, 1, 0) ∧ 2 ≤ LLF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `cos 2φ`. -/
theorem bx2LF : ∀ i, i < 142 → kindLF i = 2 → BxLF i = (0, 2, 0) ∧ 2 ≤ LLF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `sin 2φ`. -/
theorem bx3LF : ∀ i, i < 142 → kindLF i = 3 → BxLF i = (0, 2, 0) ∧ 2 ≤ LLF i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of the parameter. -/
theorem bx4LF : ∀ i, i < 142 → kindLF i = 4 →
    BxLF i = (NLF, MLF, DLF + 1) ∧ 2 ^ (SLF + 6) + 2 * 2 ^ (SLF - 1) ≤ LLF i := by
  kernel_fact

/-- The polynomial of `t`. -/
theorem PLF_k0 {i : ℕ} (h : kindLF i = 0) : PLF i = T3 SLF NLF MLF DLF := by
  unfold PLF; rw [h]; rfl
/-- The polynomial of `V`. -/
theorem PLF_k1 {i : ℕ} (h : kindLF i = 1) : PLF i = V3 := by unfold PLF; rw [h]; rfl
/-- The polynomial of `cos 2φ`. -/
theorem PLF_k2 {i : ℕ} (h : kindLF i = 2) : PLF i = C cPoly := by unfold PLF; rw [h]; rfl
/-- The polynomial of `sin 2φ`. -/
theorem PLF_k3 {i : ℕ} (h : kindLF i = 3) : PLF i = C sPoly := by unfold PLF; rw [h]; rfl
/-- The polynomial of the parameter. -/
theorem PLF_k4 {i : ℕ} (h : kindLF i = 4) : PLF i = Pr3 SLF NLF MLF DLF := by
  unfold PLF; rw [h]; rfl
/-- The polynomial of a dummy variable. -/
theorem PLF_k5 {i : ℕ} (h : kindLF i = 5) : PLF i = 0 := by unfold PLF; rw [h]; rfl

/-- The polynomial of a stored family. -/
theorem PLF_fam {i : ℕ} (h : kindLF i = 6) :
    PLF i = famPoly NLF MLF DLF (if oddLF i then -1 else 1) (c0LF i : ℤ) 0 0 0 (famLF i) := by
  unfold PLF; rw [h]; rfl

/-- The image of `t`. -/
theorem KvLF_k0 {b W R i : ℕ} (h : kindLF i = 0) : KvLF b W R i =
    ((1 <<< SLF : ℕ) : ℤ) * ((1 <<< (b * (NLF + W * (MLF + R * DLF))) : ℕ) : ℤ) := by
  unfold KvLF; rw [h]; rfl
/-- The image of `V`. -/
theorem KvLF_k1 {b W R i : ℕ} (h : kindLF i = 1) :
    KvLF b W R i = 2 * ((1 <<< (b * W) : ℕ) : ℤ) := by
  unfold KvLF; rw [h]; rfl
/-- The image of `cos 2φ`. -/
theorem KvLF_k2 {b W R i : ℕ} (h : kindLF i = 2) :
    KvLF b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) - 1 := by
  unfold KvLF; rw [h]; rfl
/-- The image of `sin 2φ`. -/
theorem KvLF_k3 {b W R i : ℕ} (h : kindLF i = 3) :
    KvLF b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) + 1 := by
  unfold KvLF; rw [h]; rfl
/-- The image of the parameter. -/
theorem KvLF_k4 {b W R i : ℕ} (h : kindLF i = 4) : KvLF b W R i =
    ((1 <<< (SLF + 6) : ℕ) : ℤ) * ((1 <<< (b * (NLF + W * (MLF + R * DLF))) : ℕ) : ℤ) +
      ((1 <<< (SLF - 1) : ℕ) : ℤ) * (((1 <<< (b * (NLF + W * (MLF + R * (DLF + 1)))) : ℕ) : ℤ) +
        ((1 <<< (b * (NLF + W * (MLF + R * (DLF - 1)))) : ℕ) : ℤ)) := by
  unfold KvLF; rw [h]; rfl
/-- The image of a dummy variable. -/
theorem KvLF_k5 {b W R i : ℕ} (h : kindLF i = 5) : KvLF b W R i = 0 := by unfold KvLF; rw [h]; rfl
/-- The image of a stored family (fast or generic). -/
theorem KvLF_k6 {b W R i : ℕ} (h : kindLF i = 6) : KvLF b W R i =
    if bMinLF i ≤ b ∧ wMinLF i ≤ W then
      ((famTB b W R NLF MLF DLF (c0LF i) (oddLF i) drLF dwLF (famLF i) : ℕ) : ℤ) -
        ((famO b W R NLF MLF DLF dwLF (famLF i) : ℕ) : ℤ)
    else famPack b W R NLF MLF DLF (if oddLF i then -1 else 1) (c0LF i : ℤ) 0 0 ddLF drLF 0
      (famLF i) := by
  unfold KvLF; rw [h]; rfl

/-- The kinds of a variable. -/
theorem kindsLF (i : ℕ) : kindLF i = 0 ∨ kindLF i = 1 ∨ kindLF i = 2 ∨ kindLF i = 3 ∨
    kindLF i = 4 ∨ kindLF i = 5 ∨ kindLF i = 6 := by
  have := kindLF_le i; omega

/-- **The Kronecker images of the variable polynomials.** -/
theorem kronLF (b W R i : ℕ) : kron b W (flat R (PLF i)) = KvLF b W R i := by
  rcases kindsLF i with h | h | h | h | h | h | h
  · rw [PLF_k0 h, KvLF_k0 h, kron_flat_T3, two_pow_eq_shift]
  · rw [PLF_k1 h, KvLF_k1 h]; exact kron_flat_V3 b W R
  · rw [PLF_k2 h, KvLF_k2 h, flat_C]; exact kron_cPoly b W
  · rw [PLF_k3 h, KvLF_k3 h, flat_C]; exact kron_sPoly b W
  · rw [PLF_k4 h, KvLF_k4 h]; exact kron_flat_Pr3 SLF NLF MLF DLF b W R
  · rw [PLF_k5 h, KvLF_k5 h]; simp
  · have hi := lt_of_kindLF h
    rw [PLF_fam h, KvLF_k6 h]
    by_cases hw : bMinLF i ≤ b ∧ wMinLF i ≤ W
    · rw [ite_eq_left hw]
      exact kron_famTB (staticLF i hi h) ((dynLF i hi h).mono hw.1 hw.2) (oddLF i) R
    · rw [ite_eq_right hw]
      exact (famPack_eq b W R NLF MLF DLF _ _ 0 0 0 (famLF i)
        fun sd hsd => ((staticLF i hi h).2.2.2 sd hsd).1).symm

/-- **Degree boxes** of the variable polynomials. -/
theorem boxLF (i : ℕ) : InBox3 (PLF i) (BxLF i).1 (BxLF i).2.1 (BxLF i).2.2 := by
  by_cases hi : i < 142
  · rcases kindsLF i with h | h | h | h | h | h | h
    · rw [PLF_k0 h, (bx0LF i hi h).1]; exact inBox3_T3 SLF NLF MLF DLF
    · rw [PLF_k1 h, (bx1LF i hi h).1]; exact inBox3_V3
    · rw [PLF_k2 h, (bx2LF i hi h).1]; exact InBox3.C box_cPoly
    · rw [PLF_k3 h, (bx3LF i hi h).1]; exact InBox3.C box_sPoly
    · rw [PLF_k4 h, (bx4LF i hi h).1]; exact inBox3_Pr3 SLF NLF MLF DLF
    · rw [PLF_k5 h]; exact inBox3_zero _ _ _
    · rw [PLF_fam h, bx6LF i hi h]
      exact inBox3_famPoly _ _ _ _ _ _ _ 0 _ (by have := (staticLF i hi h).2.1; omega)
  · rw [PLF_k5 (kindLF_ge (by omega))]
    exact inBox3_zero _ _ _

/-- **Static `ℓ¹` bounds** of the flattened variable polynomials. -/
theorem l1LF (R i : ℕ) : l1 (flat R (PLF i)) ≤ LLF i := by
  by_cases hi : i < 142
  · rcases kindsLF i with h | h | h | h | h | h | h
    · rw [PLF_k0 h]; exact (l1_flat_T3 SLF NLF MLF DLF R).trans (bx0LF i hi h).2
    · rw [PLF_k1 h]; exact (l1_flat_V3 R).trans (bx1LF i hi h).2
    · rw [PLF_k2 h, flat_C]; exact l1_cPoly.trans (bx2LF i hi h).2
    · rw [PLF_k3 h, flat_C]; exact l1_sPoly.trans (bx3LF i hi h).2
    · rw [PLF_k4 h]; exact (l1_flat_Pr3 SLF NLF MLF DLF R).trans (bx4LF i hi h).2
    · rw [PLF_k5 h]; simp [l1, liftN]
    · rw [PLF_fam h]
      refine (l1_flat_famPoly_le R NLF MLF DLF (by split_ifs <;> simp) _ 0 0 0 (famLF i)
        fun sd hsd => ((staticLF i hi h).2.2.2 sd hsd).1.2.2.2.2).trans (l1famLF i hi h)
  · rw [PLF_k5 (kindLF_ge (by omega))]
    simp [l1, liftN]

/-- The phases are below `4`. -/
theorem hWLF : ∀ i, (WtLF i).2.2 < 4 :=
  getD_prop (Pr := fun w : ℕ × ℕ × ℕ => w.2.2 < 4) (by kernel_fact) (by kernel_fact)

/-- **The family centres** at the parameter `w = c`. -/
def xLF (c : ℂ) (i : ℕ) : FA := ctr3 SLF NLF MLF DLF c (WtLF i) (PLF i)

/-- The centre of a stored family. -/
theorem xLF_fam {c : ℂ} (hc : c ≠ 0) {i : ℕ} (h : kindLF i = 6) {p : ℕ}
    (hp : WtLF i = (1, 0, p)) :
    xLF c i = famCtr SLF NLF MLF p (if oddLF i then -1 else 1) (c0LF i : ℤ) 0 0 c 0
      (famLF i) := by
  have hi := lt_of_kindLF h
  rw [xLF, hp, PLF_fam h]
  exact ctr3_famPoly _ _ _ _ _ _ _ _ _ hc 0 _ (by have := (staticLF i hi h).2.1; omega)

/-- The centre of `t` is `1`. -/
theorem xLF_t {c : ℂ} (hc : c ≠ 0) : xLF c 0 = 1 := by
  rw [xLF, show WtLF 0 = (1, 0, 0) from rfl, show PLF 0 = T3 SLF NLF MLF DLF from rfl]
  exact ctr3_T3 _ _ _ _ hc

/-- The centre of `V` is `1`. -/
theorem xLF_V (c : ℂ) : xLF c 1 = 1 := by
  rw [xLF, show WtLF 1 = (0, 1, 0) from rfl, show PLF 1 = V3 from rfl]
  exact ctr3_V3 _ _ _ _ c

/-- The centre of `cos 2φ`. -/
theorem xLF_c (c : ℂ) : xLF c 2 = ctr SLF NLF MLF (0, 1, 3) cPoly := by
  rw [xLF, show WtLF 2 = (0, 1, 3) from rfl, show PLF 2 = C cPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 3 cPoly

/-- The centre of `sin 2φ`. -/
theorem xLF_s (c : ℂ) : xLF c 3 = ctr SLF NLF MLF (0, 1, 0) sPoly := by
  rw [xLF, show WtLF 3 = (0, 1, 0) from rfl, show PLF 3 = C sPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 0 sPoly

/-- The centre of the parameter `r` is `64 + (c + c⁻¹)/2`. -/
theorem xLF_r {c : ℂ} (hc : c ≠ 0) : xLF c 114 = algebraMap ℂ FA (64 + (c + c⁻¹) / 2) := by
  rw [xLF, show WtLF 114 = (1, 0, 0) from rfl, show PLF 114 = Pr3 SLF NLF MLF DLF from rfl]
  exact ctr3_Pr3 _ _ _ _ (by kernel_fact) (by kernel_fact) hc

/-- The centres of the variables of kind `5` (dummies) vanish. -/
theorem xLF_zero (c : ℂ) {i : ℕ} (h : kindLF i = 5) : xLF c i = 0 := by
  rw [xLF, PLF_k5 h]
  simp [ctr3]

