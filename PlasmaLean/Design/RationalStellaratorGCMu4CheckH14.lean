/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH14`)

The checks of `Design/RationalStellaratorGCMu4CheckH14` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m03`: truncation norm. -/
theorem kHMS_m03 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m03 (1 : Int) 1 0 17 232 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m03`: a priori `ℓ¹` bound. -/
theorem lHM_m03 : nodeL1N SHM LHM trHMN_m03 (1 : Int) 1 0 17 < 2 ^ (232 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `Nm1`. -/
theorem kHMS_Nm1 : norm3KS WtHM KvSHM NHM MHM trHMN_Nm1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `Nm1`: a priori `ℓ¹` bound. -/
theorem lHM_Nm1 : ExN.majN LHM trHMN_Nm1 < 2 ^ (123 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
