module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH
public import PlasmaLean.Design.RationalStellaratorGCMuKvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMuTreesH
meta import PlasmaLean.Design.RationalStellaratorGCMuKvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMuCheckH58`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `qz`. -/
theorem cHMS_qz : center3KS KvSHM NHM MHM 48 120 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `qz`. -/
theorem clHM_qz : LHM 48 < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `dU`. -/
theorem kHMS_dU : norm3KS WtHM KvSHM NHM MHM trHMN_dU (1, 0, 0) 120 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `dU`: a priori `ℓ¹` bound. -/
theorem lHM_dU : ExN.majN LHM trHMN_dU < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the node `DzP`: truncation norm. -/
theorem kHMS_DzP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_DzP (8 : Int) 0 1 33 125 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `DzP`: a priori `ℓ¹` bound. -/
theorem lHM_DzP : nodeL1N SHM LHM trHMN_DzP (8 : Int) 0 1 33 < 2 ^ (125 - 1) := by
  kron_lt

/-- Proof-term check of the node `R4`: truncation norm. -/
theorem kHMS_R4 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_R4 (1 : Int) 1 0 73 242 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `R4`: a priori `ℓ¹` bound. -/
theorem lHM_R4 : nodeL1N SHM LHM trHMN_R4 (1 : Int) 1 0 73 < 2 ^ (242 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
