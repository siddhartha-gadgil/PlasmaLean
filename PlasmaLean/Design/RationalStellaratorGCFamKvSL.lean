module

public import PlasmaLean.Design.RationalStellaratorGCFamKvL
public import PlasmaLean.Certificates.KronLowMemCompute

/-!
# Low-memory Kronecker images (`Design/RationalStellaratorGCFamKvL`)

The signed images `KvSLF` of the variables of `Design/RationalStellaratorGCFamKvL` for the low-
memory kernel checks (`Certificates/KronLowMemCompute`). Their integer values are the images `KvLF`
(`KvSLF_toInt`, `Design/RationalStellaratorGCFamLowMemL`). Light module. Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed Kronecker images of the variable polynomials** (`w ↦ 2^{b W R}`): stored
families with fast widths by `famS`, every other variable by its integer image `KvLF`. -/
def KvSLF (b W R : Nat) (i : Nat) : SInt :=
  if kindLF i = 6 ∧ bMinLF i ≤ b ∧ wMinLF i ≤ W then
    famS b W R NLF MLF DLF (c0LF i) (oddLF i) ddLF drLF dwLF (famLF i)
  else SInt.ofInt (KvLF b W R i)

end PlasmaLean.Design.RationalStellaratorGC
