  PlasmaLean.Certificates.Kron2 WEll1Z2 Complex

/-- The full chain. -/
theorem ballHE2_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) :
    ∀ i, i < 99 → Bd r (XHE2 c i - xHE2 c i) (EHE2 i) :=
  ballHE2_99 hr hq hc

/-- A value is bounded by its centre norm plus its radius. -/
theorem valHE2_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1)
    (i : ℕ) (hi : i < 99) :
    Bd r (XHE2 c i) ((BHE2 i + EHE2 i : ℚ) : ℝ) := by
  have := (normHE2 hq hc i hi).add (ballHE2_all hr hq hc i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

