/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu2CheckH18`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `thZe`. -/
theorem cHMS_thZe : center3KS KvSHM NHM MHM 13 125 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `thZe`. -/
theorem clHM_thZe : LHM 13 < 2 ^ (125 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `W`. -/
theorem cHMS_W : center3KS KvSHM NHM MHM 55 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `W`. -/
theorem clHM_W : LHM 55 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the node `m13`: truncation norm. -/
theorem kHMS_m13 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m13 (1 : Int) 1 0 21 228 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m13`: a priori `ℓ¹` bound. -/
theorem lHM_m13 : nodeL1N SHM LHM trHMN_m13 (1 : Int) 1 0 21 < 2 ^ (228 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu2
