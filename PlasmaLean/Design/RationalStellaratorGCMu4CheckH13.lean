/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH13`)

The checks of `Design/RationalStellaratorGCMu4CheckH13` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m11`: truncation norm. -/
theorem kHMS_m11 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m11 (1 : Int) 1 0 15 236 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m11`: a priori `ℓ¹` bound. -/
theorem lHM_m11 : nodeL1N SHM LHM trHMN_m11 (1 : Int) 1 0 15 < 2 ^ (236 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `lamv`: truncation norm. -/
theorem kHMS_lamv : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_lamv (64 : Int) 0 0 84 130 73 55 25 11 8 10 36 27 ≤
    0 := by
  decide +kernel

/-- Kernel check of the node `lamv`: a priori `ℓ¹` bound. -/
theorem lHM_lamv : nodeL1N SHM LHM trHMN_lamv (64 : Int) 0 0 84 < 2 ^ (130 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
