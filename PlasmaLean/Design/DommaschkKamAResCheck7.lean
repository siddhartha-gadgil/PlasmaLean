module

public import PlasmaLean.Design.DommaschkKamAResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAResTrees

/-!
# Proof-term checks of the torus-A residual chain (part 7)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamAResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_D1`, `kH_Dc0`, `kH_D0`, `kH_Gc8`, `kH_Gc7`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `D1`: truncation norm. -/
theorem kH_D1 : nodeKw 68553 16 SH NH MH WtH KvH trH_D1 (1 : ℤ) 1 0 30 277 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `D1`: a priori `ℓ¹` bound. -/
theorem lH_D1 : nodeL1 SH LH trH_D1 (1 : ℤ) 1 0 30 < 2 ^ (277 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc0`: truncation norm. -/
theorem kH_Dc0 : nodeKw 68553 16 SH NH MH WtH KvH trH_Dc0 (537600000000000 : ℤ) 0 3 31 193 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc0`: a priori `ℓ¹` bound. -/
theorem lH_Dc0 : nodeL1 SH LH trH_Dc0 (537600000000000 : ℤ) 0 3 31 < 2 ^ (193 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `D0`: truncation norm. -/
theorem kH_D0 : nodeKw 68553 16 SH NH MH WtH KvH trH_D0 (1 : ℤ) 1 0 32 276 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `D0`: a priori `ℓ¹` bound. -/
theorem lH_D0 : nodeL1 SH LH trH_D0 (1 : ℤ) 1 0 32 < 2 ^ (276 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc8`: truncation norm. -/
theorem kH_Gc8 : nodeKw 68553 16 SH NH MH WtH KvH trH_Gc8 (21504000000000 : ℤ) 0 3 33 188 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc8`: a priori `ℓ¹` bound. -/
theorem lH_Gc8 : nodeL1 SH LH trH_Gc8 (21504000000000 : ℤ) 0 3 33 < 2 ^ (188 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc7`: truncation norm. -/
theorem kH_Gc7 : nodeKw 68553 16 SH NH MH WtH KvH trH_Gc7 (100800000000000 : ℤ) 0 3 34 193 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc7`: a priori `ℓ¹` bound. -/
theorem lH_Gc7 : nodeL1 SH LH trH_Gc7 (100800000000000 : ℤ) 0 3 34 < 2 ^ (193 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamA
