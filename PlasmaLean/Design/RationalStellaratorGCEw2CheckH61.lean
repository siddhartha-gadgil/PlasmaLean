/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw2CheckH61`)

The checks of `Design/RationalStellaratorGCEw2CheckH61` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE2`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `Z`. -/
theorem cHE2S_Z : center3KS KvSHE2 NHE2 MHE2 5 119 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Z`. -/
theorem clHE2_Z : LHE2 5 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m41`. -/
theorem cHE2S_m41 : center3KS KvSHE2 NHE2 MHE2 25 105 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m41`. -/
theorem clHE2_m41 : LHE2 25 < 2 ^ (105 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
