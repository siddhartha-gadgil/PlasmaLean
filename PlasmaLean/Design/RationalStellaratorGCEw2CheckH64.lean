/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw2CheckH64`)

The checks of `Design/RationalStellaratorGCEw2CheckH64` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE2`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `thU`. -/
theorem cHE2S_thU : center3KS KvSHE2 NHE2 MHE2 8 125 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thU`. -/
theorem clHE2_thU : LHE2 8 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m21`. -/
theorem cHE2S_m21 : center3KS KvSHE2 NHE2 MHE2 19 111 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m21`. -/
theorem clHE2_m21 : LHE2 19 < 2 ^ (111 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `P42`. -/
theorem cHE2S_P42 : center3KS KvSHE2 NHE2 MHE2 75 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `P42`. -/
theorem clHE2_P42 : LHE2 75 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `Vm1`. -/
theorem kHE2S_Vm1 : norm3KS WtHE2 KvSHE2 NHE2 MHE2 trHE2N_Vm1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `Vm1`: a priori `ℓ¹` bound. -/
theorem lHE2_Vm1 : ExN.majN LHE2 trHE2N_Vm1 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `V42`: truncation norm. -/
theorem kHE2S_V42 : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_V42 (1 : Int) 1 0 80 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `V42`: a priori `ℓ¹` bound. -/
theorem lHE2_V42 : nodeL1N SHE2 LHE2 trHE2N_V42 (1 : Int) 1 0 80 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
