    Bd r (Ex.eval (XHE4 c) (toEx trHE4N_dU)) (((531 / 50000000000 : ℚ) : ℚ) : ℝ) :=
  norm3_fullN hr hq hc hWHE4 boxHE4 (l1HE4 55) (fun _ => rfl) (fun i hi => normHE4 hq hc i (by omega)) (ballHE4_14 hr hq hc) trHE4N_dU (1, 0, 0)
      72 54 24 120 73 25 11 8 10 36 27 
      (531 / 50000000000 : ℚ) (kronHE4 120 73 55) (by decide +kernel)
      (by decide +kernel) (by decide +kernel) lHE4_dU kHE4_dU (by decide +kernel)

