module

public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH33`)

The checks of `Design/RationalStellaratorGCMu4CheckH33` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m60`. -/
theorem cHMS_m60 : center3KS KvSHM NHM MHM 28 104 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m60`. -/
theorem clHM_m60 : LHM 28 < 2 ^ (104 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `R8`. -/
theorem cHMS_R8 : center3KS KvSHM NHM MHM 74 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `R8`. -/
theorem clHM_R8 : LHM 74 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `W3`: truncation norm. -/
theorem kHMS_W3 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_W3 (1 : Int) 1 0 57 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `W3`: a priori `ℓ¹` bound. -/
theorem lHM_W3 : nodeL1N SHM LHM trHMN_W3 (1 : Int) 1 0 57 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
