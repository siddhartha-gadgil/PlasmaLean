/-- Joint bounds on the full first-forward trial tube. All matrix and field
factors use the same normalized time and the same physical point. -/
theorem symmetric_bounds {t u z c s : ℝ} (ht : |t| ≤ 1) (hin : trial.Mem t u z c s) :
    let m := frameEntries firstLeft firstRight t
    let denSq := evR u z c s dD * evR u z c s dD
    let A := transformedNumerator (spatialNumerator u z c s) m
      (velocityEntries firstLeft firstRight) denSq
    1017/1000 ≤ m.det * denSq ∧ A.a + A.d ≤ 943/1000000 ∧
      |A.a-A.d| ≤ 39764/1000000 ∧ |A.b+A.c| ≤ 2884/1000000 := by
  have hD := dD_checked.mem ht hin
  have hDU := gradDU_checked.mem ht hin
  have hDZ := gradDZ_checked.mem ht hin
  have hR := dnR_checked.mem ht hin
  have hRU := gradRU_checked.mem ht hin
  have hRZ := gradRZ_checked.mem ht hin
  have hZ := dnZ_checked.mem ht hin
  have hZU := gradZU_checked.mem ht hin
  have hZZ := gradZZ_checked.mem ht hin
  have hMa := leafMa t
  have hMb := leafMb t
  have hMc := leafMc t
  have hMd := leafMd t
  have hVa := leafVa t
  have hVb := leafVb t
  have hVc := leafVc t
  have hVd := leafVd t
  have hdenSq := (checkdenSq.eq ▸ format.mul_mem ht hD hD)
  have hN00 := (checkN00.eq ▸ format.mul_mem ht hRU hD)
  have hD00 := (checkD00.eq ▸ format.mul_mem ht hR hDU)
  have hJ00 := (checkJ00.eq ▸ format.sub_mem ht hN00 hD00)
  have hN01 := (checkN01.eq ▸ format.mul_mem ht hRZ hD)
  have hD01 := (checkD01.eq ▸ format.mul_mem ht hR hDZ)
  have hJ01 := (checkJ01.eq ▸ format.sub_mem ht hN01 hD01)
  have hN10 := (checkN10.eq ▸ format.mul_mem ht hZU hD)
  have hD10 := (checkD10.eq ▸ format.mul_mem ht hZ hDU)
  have hJ10 := (checkJ10.eq ▸ format.sub_mem ht hN10 hD10)
  have hN11 := (checkN11.eq ▸ format.mul_mem ht hZZ hD)
  have hD11 := (checkD11.eq ▸ format.mul_mem ht hZ hDZ)
  have hJ11 := (checkJ11.eq ▸ format.sub_mem ht hN11 hD11)
  have hjm00k0 := (checkjm00k0.eq ▸ format.mul_mem ht hJ00 hMa)
  have hjm00k1 := (checkjm00k1.eq ▸ format.mul_mem ht hJ01 hMc)
  have hjm00 := (checkjm00.eq ▸ format.add_mem ht hjm00k0 hjm00k1)
  have hjm01k0 := (checkjm01k0.eq ▸ format.mul_mem ht hJ00 hMb)
  have hjm01k1 := (checkjm01k1.eq ▸ format.mul_mem ht hJ01 hMd)
  have hjm01 := (checkjm01.eq ▸ format.add_mem ht hjm01k0 hjm01k1)
  have hjm10k0 := (checkjm10k0.eq ▸ format.mul_mem ht hJ10 hMa)
  have hjm10k1 := (checkjm10k1.eq ▸ format.mul_mem ht hJ11 hMc)
  have hjm10 := (checkjm10.eq ▸ format.add_mem ht hjm10k0 hjm10k1)
  have hjm11k0 := (checkjm11k0.eq ▸ format.mul_mem ht hJ10 hMb)
  have hjm11k1 := (checkjm11k1.eq ▸ format.mul_mem ht hJ11 hMd)
  have hjm11 := (checkjm11.eq ▸ format.add_mem ht hjm11k0 hjm11k1)
  have hrate00 := (checkrate00.eq ▸ format.mul_mem ht hdenSq hVa)
  have hcenter00 := (checkcenter00.eq ▸ format.sub_mem ht hjm00 hrate00)
  have hrate01 := (checkrate01.eq ▸ format.mul_mem ht hdenSq hVb)
  have hcenter01 := (checkcenter01.eq ▸ format.sub_mem ht hjm01 hrate01)
  have hrate10 := (checkrate10.eq ▸ format.mul_mem ht hdenSq hVc)
  have hcenter10 := (checkcenter10.eq ▸ format.sub_mem ht hjm10 hrate10)
  have hrate11 := (checkrate11.eq ▸ format.mul_mem ht hdenSq hVd)
  have hcenter11 := (checkcenter11.eq ▸ format.sub_mem ht hjm11 hrate11)
  have hnegB := (checknegB.eq ▸ format.neg_mem ht hMb)
  have hnegC := (checknegC.eq ▸ format.neg_mem ht hMc)
  have hnum00k0 := (checknum00k0.eq ▸ format.mul_mem ht hMd hcenter00)
  have hnum00k1 := (checknum00k1.eq ▸ format.mul_mem ht hnegB hcenter10)
  have hnum00 := (checknum00.eq ▸ format.add_mem ht hnum00k0 hnum00k1)
  have hnum01k0 := (checknum01k0.eq ▸ format.mul_mem ht hMd hcenter01)
  have hnum01k1 := (checknum01k1.eq ▸ format.mul_mem ht hnegB hcenter11)
  have hnum01 := (checknum01.eq ▸ format.add_mem ht hnum01k0 hnum01k1)
  have hnum10k0 := (checknum10k0.eq ▸ format.mul_mem ht hnegC hcenter00)
  have hnum10k1 := (checknum10k1.eq ▸ format.mul_mem ht hMa hcenter10)
  have hnum10 := (checknum10.eq ▸ format.add_mem ht hnum10k0 hnum10k1)
  have hnum11k0 := (checknum11k0.eq ▸ format.mul_mem ht hnegC hcenter01)
  have hnum11k1 := (checknum11k1.eq ▸ format.mul_mem ht hMa hcenter11)
  have hnum11 := (checknum11.eq ▸ format.add_mem ht hnum11k0 hnum11k1)
  have hdetAD := (checkdetAD.eq ▸ format.mul_mem ht hMa hMd)
  have hdetBC := (checkdetBC.eq ▸ format.mul_mem ht hMb hMc)
  have hdet := (checkdet.eq ▸ format.sub_mem ht hdetAD hdetBC)
  have hden := (checkden.eq ▸ format.mul_mem ht hdet hdenSq)
  have htr := (checktr.eq ▸ format.add_mem ht hnum00 hnum11)
  have hdif := (checkdif.eq ▸ format.sub_mem ht hnum00 hnum11)
  have hoff := (checkoff.eq ▸ format.add_mem ht hnum01 hnum10)
  have boundden := rangeden ht hden
  have boundtr := rangetr ht htr
  have bounddif := rangedif ht hdif
  have boundoff := rangeoff ht hoff
  have lower (v : ℝ) (h : |v - 10173/10000| ≤ 3/10000) : 1017/1000 ≤ v := by
    linarith only [(abs_le.mp h).1]
  dsimp only [transformedNumerator, spatialNumerator, quotientNumerator,
    Entries.product, Entries.adj, Entries.sub, Entries.scale, Entries.det]
  refine ⟨lower _ boundden, ?_, ?_, ?_⟩
  · exact (le_abs_self _).trans (by simpa only [sub_zero] using boundtr)
  · exact (by simpa only [sub_zero] using bounddif)
  · exact (by simpa only [sub_zero] using boundoff)

