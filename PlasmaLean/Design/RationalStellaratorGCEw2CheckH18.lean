module

public import PlasmaLean.Design.RationalStellaratorGCEw2TreesH
public import PlasmaLean.Design.RationalStellaratorGCEw2KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw2CheckH18`)

The checks of `Design/RationalStellaratorGCEw2CheckH18` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE2`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nRp`. -/
theorem cHE2S_nRp : center3KS KvSHE2 NHE2 MHE2 30 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRp`. -/
theorem clHE2_nRp : LHE2 30 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `N2`. -/
theorem cHE2S_N2 : center3KS KvSHE2 NHE2 MHE2 87 124 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `N2`. -/
theorem clHE2_N2 : LHE2 87 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m12`: truncation norm. -/
theorem kHE2S_m12 : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_m12 (1 : Int) 1 0 18 232 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m12`: a priori `ℓ¹` bound. -/
theorem lHE2_m12 : nodeL1N SHE2 LHE2 trHE2N_m12 (1 : Int) 1 0 18 < 2 ^ (232 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
