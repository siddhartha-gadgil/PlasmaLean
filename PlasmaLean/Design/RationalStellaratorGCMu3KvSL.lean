module

public import PlasmaLean.Design.RationalStellaratorGCMu3KvL
public import PlasmaLean.Certificates.KronLowMemCompute

/-!
# Low-memory Kronecker images (`Design/RationalStellaratorGCMu3KvL`)

The signed images `KvSLM` of the variables of `Design/RationalStellaratorGCMu3KvL` for the low-
memory kernel checks (`Certificates/KronLowMemCompute`). Their integer values are the images `KvLM`
(`KvSLM_toInt`, `Design/RationalStellaratorGCMu3LowMemL`). Light module. Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed Kronecker images of the variable polynomials** (`w ↦ 2^{b W R}`): stored
families with fast widths by `famS`, every other variable by its integer image `KvLM`. -/
def KvSLM (b W R : Nat) (i : Nat) : SInt :=
  if kindLM i = 6 ∧ bMinLM i ≤ b ∧ wMinLM i ≤ W then
    famS b W R NLM MLM DLM (c0LM i) (oddLM i) ddLM drLM dwLM (famLM i)
  else SInt.ofInt (KvLM b W R i)

end PlasmaLean.Design.RationalStellaratorGC.Mu3
