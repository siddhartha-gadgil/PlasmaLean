/-- A priori `ℓ¹` bound of the centre `m40`. -/
theorem clHE3_m40 : LHE3 24 < 2 ^ (109 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `V4n`. -/
theorem cHE3S_V4n : center3KS KvSHE3 NHE3 MHE3 81 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `V4n`. -/
theorem clHE3_V4n : LHE3 81 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `dU`. -/
theorem kHE3S_dU : norm3KS WtHE3 KvSHE3 NHE3 MHE3 trHE3N_dU (1, 0, 0) 120 73 55 25 11 8 10 36 27 ≤
