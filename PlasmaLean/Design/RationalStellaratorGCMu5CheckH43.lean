module

public import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu5KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
meta import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu5CheckH43`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `nZuP`. -/
theorem cHMS_nZuP : center3KS KvSHM NHM MHM 38 121 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nZuP`. -/
theorem clHM_nZuP : LHM 38 < 2 ^ (121 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `lamv`. -/
theorem cHMS_lamv : center3KS KvSHM NHM MHM 84 121 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `lamv`. -/
theorem clHM_lamv : LHM 84 < 2 ^ (121 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `etaV4`. -/
theorem kHMS_etaV4 : norm3KS WtHM KvSHM NHM MHM trHMN_etaV4 (2, 0, 0) 231 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `etaV4`: a priori `ℓ¹` bound. -/
theorem lHM_etaV4 : ExN.majN LHM trHMN_etaV4 < 2 ^ (231 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu5
