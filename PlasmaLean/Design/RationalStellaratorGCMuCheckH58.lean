module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 58)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMuDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `qz`. -/
theorem cHM_qz : center3KN KvHM NHM MHM 48 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `qz`. -/
theorem clHM_qz : LHM 48 < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `dU`. -/
theorem kHM_dU : norm3KN WtHM KvHM NHM MHM trHMN_dU (1, 0, 0) 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `dU`: a priori `ℓ¹` bound. -/
theorem lHM_dU : ExN.majN LHM trHMN_dU < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `DzP`: truncation norm. -/
theorem kHM_DzP : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_DzP (8 : Int) 0 1 33 125 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `DzP`: a priori `ℓ¹` bound. -/
theorem lHM_DzP : nodeL1N SHM LHM trHMN_DzP (8 : Int) 0 1 33 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `R4`: truncation norm. -/
theorem kHM_R4 : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_R4 (1 : Int) 1 0 73 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R4`: a priori `ℓ¹` bound. -/
theorem lHM_R4 : nodeL1N SHM LHM trHMN_R4 (1 : Int) 1 0 73 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
