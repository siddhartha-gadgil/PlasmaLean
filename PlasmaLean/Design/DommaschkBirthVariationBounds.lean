  let dqzv := Dv * qzv
  have dqz : (⟨-107376149886, 107376149880⟩ : IBox).Mem (dqzv) := mem_mul D qz
  let dqZv := q2v * Dzv
  have dqZ : (⟨-2925328858, 2925328858⟩ : IBox).Mem (dqZv) := mem_mul q2 Dz
  let dwZv := dqzv - dqZv
  have dwZ : (⟨-110301478744, 110301478738⟩ : IBox).Mem (dwZv) := subtract dqz dqZ
  let rwv := dwRv * vr
  have rw : (⟨98070345339237, 98084033182547⟩ : IBox).Mem (rwv) := mem_mul dwR vR
  let zwv := dwZv * vz
  have zw : (⟨-1, 1⟩ : IBox).Mem (zwv) := mem_mul dwZ vZ
  let swv := rwv + zwv
  have sw : (⟨98070345339236, 98084033182548⟩ : IBox).Mem (swv) := mem_add rw zw
  refine ⟨pos_of_mem (by norm_num) D, ?_, ?_, ?_⟩
  · have bound : gapv < 0 := by
      have k := gap.2
      norm_num at k
      linarith only [k]
    convert bound using 1
    dsimp [DommaschkMirrorEndpointSign.gap]
    ring
  · have bound : sfv ≤ -(1/48) := by
      have k := sf.2
      norm_num at k
      linarith only [k]
    convert bound using 1
    dsimp [RadialSlabs.strengthNumerator]
    ring
  · have bound : 0 < swv := by
      have k := sw.1
      norm_num at k
      linarith only [k]
