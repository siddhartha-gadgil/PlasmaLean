module

public import PlasmaLean.Design.RationalStellaratorGCMu3TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu3KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu3CheckH27`)

The checks of `Design/RationalStellaratorGCMu3CheckH27` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m22`. -/
theorem cHMS_m22 : center3KS KvSHM NHM MHM 22 107 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m22`. -/
theorem clHM_m22 : LHM 22 < 2 ^ (107 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `K3`. -/
theorem cHMS_K3 : center3KS KvSHM NHM MHM 64 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `K3`. -/
theorem clHM_K3 : LHM 64 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `RDu`: truncation norm. -/
theorem kHMS_RDu : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_RDu (1 : Int) 1 0 43 240 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `RDu`: a priori `ℓ¹` bound. -/
theorem lHM_RDu : nodeL1N SHM LHM trHMN_RDu (1 : Int) 1 0 43 < 2 ^ (240 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu3
