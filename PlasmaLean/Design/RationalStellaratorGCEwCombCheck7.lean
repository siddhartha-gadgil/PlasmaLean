module

public import PlasmaLean.Design.RationalStellaratorGCEwCombEnv

/-!
# Kernel checks of the energy-window combinations (part 7)

Each theorem is one kernel evaluation (`decide +kernel`) of the weighted digit sum `norm3KN` of the
Kronecker image of an integer combination of node tori (`Design/RationalStellaratorGCEwCombEnv`).
Light module. Generated by `scripts/gc_kam/ew_comb.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C1Z`. -/
theorem kEw_C1Z : norm3KN WtEw KvEw 36 27 trEwC_C1Z (1, 0, 1) 133 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C1Z`. -/
theorem lEw_C1Z : ExN.majN LEw trEwC_C1Z < 2 ^ (133 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C0LZx`. -/
theorem kEw_C0LZx : norm3KN WtEw KvEw 36 27 trEwC_C0LZx (1, 0, 0) 224 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C0LZx`. -/
theorem lEw_C0LZx : ExN.majN LEw trEwC_C0LZx < 2 ^ (224 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `D0thU`. -/
theorem kEw_D0thU : norm3KN WtEw KvEw 36 27 trEwC_D0thU (1, 0, 3) 129 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `D0thU`. -/
theorem lEw_D0thU : ExN.majN LEw trEwC_D0thU < 2 ^ (129 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
