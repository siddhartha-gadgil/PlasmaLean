  kron2_proof

/-- Proof-term check of the node `m30`: a priori `ℓ¹` bound. -/
theorem lH_m30 : nodeL1 SH LH trH_m30 (1 : ℤ) 1 0 20 < 2 ^ (251 - 1) := by
