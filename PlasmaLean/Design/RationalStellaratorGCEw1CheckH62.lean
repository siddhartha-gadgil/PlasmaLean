/-- A priori `ℓ¹` bound of the centre `m50`. -/
theorem clHE1_m50 : LHE1 26 < 2 ^ (107 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `Bm`. -/
theorem cHE1S_Bm : center3KS KvSHE1 NHE1 MHE1 83 123 73 55 25 11 8 10 36 27 ≤
     := by
