/-!
# The low-memory kernel checks prove the original checks (`Design/RationalStellaratorGCFamCheckL*`)

* `KvSLF_toInt`: the signed images `KvSLF` are the Kronecker images `KvLF` (`famS_toInt`);
* every check theorem of `Design/RationalStellaratorGCFamCheckL*`, with its original name and
  statement, proved from its low-memory version by `node3KN_le_of_S`, `norm3KN_le_of_S` or
  `center3KN_le_of_S`.

No heavy kernel evaluation (only degree conditions). Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed images are the Kronecker images.** -/
theorem KvSLF_toInt (b W R i : ℕ) : (KvSLF b W R i).toInt = KvLF b W R i := by
  unfold KvSLF
  split_ifs with h
  · obtain ⟨hk, hb, hw⟩ := h
    have hi := lt_of_kindLF hk
    rw [KvLF_k6 hk, ite_eq_left ⟨hb, hw⟩,
      famS_toInt (staticLF i hi hk) ((dynLF i hi hk).mono hb hw)]
  · exact SInt.toInt_ofInt _

