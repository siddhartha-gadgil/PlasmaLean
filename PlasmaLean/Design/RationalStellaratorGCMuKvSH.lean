module

public import PlasmaLean.Design.RationalStellaratorGCMuKvH
public import PlasmaLean.Certificates.KronLowMemCompute

/-!
# Low-memory Kronecker images (`Design/RationalStellaratorGCMuKvH`)

The signed images `KvSHM` of the variables of `Design/RationalStellaratorGCMuKvH` for the low-memory
kernel checks (`Certificates/KronLowMemCompute`). Their integer values are the images `KvHM`
(`KvSHM_toInt`, `Design/RationalStellaratorGCMuLowMemH`). Light module. Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed Kronecker images of the variable polynomials** (`w ↦ 2^{b W R}`): stored
families with fast widths by `famS`, every other variable by its integer image `KvHM`. -/
def KvSHM (b W R : Nat) (i : Nat) : SInt :=
  if kindHM i = 6 ∧ bMinHM i ≤ b ∧ wMinHM i ≤ W then
    famS b W R NHM MHM DHM (c0HM i) (oddHM i) ddHM drHM dwHM (famHM i)
  else SInt.ofInt (KvHM b W R i)

end PlasmaLean.Design.RationalStellaratorGC
