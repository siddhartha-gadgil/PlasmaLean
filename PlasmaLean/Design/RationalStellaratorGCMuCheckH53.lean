/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMuCheckH53`)

The checks of `Design/RationalStellaratorGCMuCheckH53` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMuLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m20`: truncation norm. -/
theorem kHMS_m20 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m20 (1 : Int) 1 0 16 236 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m20`: a priori `ℓ¹` bound. -/
theorem lHM_m20 : nodeL1N SHM LHM trHMN_m20 (1 : Int) 1 0 16 < 2 ^ (236 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
