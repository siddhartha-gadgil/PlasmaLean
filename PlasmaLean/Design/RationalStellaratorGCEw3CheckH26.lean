meta import PlasmaLean.Design.RationalStellaratorGCEw3KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw3CheckH26`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `nZuP`. -/
theorem cHE3S_nZuP : center3KS KvSHE3 NHE3 MHE3 38 121 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nZuP`. -/
theorem clHE3_nZuP : LHE3 38 < 2 ^ (121 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `nZtF`. -/
theorem cHE3S_nZtF : center3KS KvSHE3 NHE3 MHE3 95 118 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nZtF`. -/
theorem clHE3_nZtF : LHE3 95 < 2 ^ (118 - 1) := by
  kron_lt

/-- Proof-term check of the node `m50`: truncation norm. -/
theorem kHE3S_m50 : node3KS SHE3 NHE3 MHE3 DHE3 WtHE3 KvSHE3 trHE3N_m50 (1 : Int) 1 0 26 226 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m50`: a priori `ℓ¹` bound. -/
theorem lHE3_m50 : nodeL1N SHE3 LHE3 trHE3N_m50 (1 : Int) 1 0 26 < 2 ^ (226 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
