module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 42)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMuDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nRphP`. -/
theorem cHM_nRphP : center3KN KvHM NHM MHM 37 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRphP`. -/
theorem clHM_nRphP : LHM 37 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `Bm`. -/
theorem cHM_Bm : center3KN KvHM NHM MHM 83 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Bm`. -/
theorem clHM_Bm : LHM 83 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `QPP4P`: truncation norm. -/
theorem kHM_QPP4P : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_QPP4P (1 : Int) 1 0 78 243 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `QPP4P`: a priori `ℓ¹` bound. -/
theorem lHM_QPP4P : nodeL1N SHM LHM trHMN_QPP4P (1 : Int) 1 0 78 < 2 ^ (243 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
