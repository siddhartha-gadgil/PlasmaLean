set_option maxRecDepth 100000 in
set_option exponentiation.threshold 4096 in
/-- The norm node `dU`. -/
theorem normHE2_dU {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) :
    Bd r (Ex.eval (XHE2 c) (toEx trHE2N_dU)) (((1659 / 500000000000 : ℚ) : ℚ) : ℝ) :=
  norm3_fullN hr hq hc hWHE2 boxHE2 (l1HE2 55) (fun _ => rfl) (fun i hi => normHE2 hq hc i (by omega)) (ballHE2_14 hr hq hc) trHE2N_dU (1, 0, 0)
      72 54 24 120 73 25 11 8 10 36 27 
      (1659 / 500000000000 : ℚ) (kronHE2 120 73 55) (by kernel_fact)
      (by kernel_fact) (by kernel_fact) lHE2_dU kHE2_dU (by kernel_fact)

