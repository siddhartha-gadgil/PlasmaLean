  kron_proof

/-- A priori `ℓ¹` bound of the centre `nZtJ`. -/
theorem clHE4_nZtJ : LHE4 98 < 2 ^ (118 - 1) := by
  kron_lt

/-- Proof-term check of the node `RD`: truncation norm. -/
theorem kHE4S_RD : node3KS SHE4 NHE4 MHE4 DHE4 WtHE4 KvSHE4 trHE4N_RD (1 : Int) 1 0 42 239 145 109 49 13 8 19 72 54 ≤
     := by
