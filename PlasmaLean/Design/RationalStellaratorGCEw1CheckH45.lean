/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw1CheckH45`)

The checks of `Design/RationalStellaratorGCEw1CheckH45` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE1`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw1LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `W3`. -/
theorem cHE1S_W3 : center3KS KvSHE1 NHE1 MHE1 57 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `W3`. -/
theorem clHE1_W3 : LHE1 57 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `QPP4P`: truncation norm. -/
theorem kHE1S_QPP4P : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_QPP4P (1 : Int) 1 0 78 243 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `QPP4P`: a priori `ℓ¹` bound. -/
theorem lHE1_QPP4P : nodeL1N SHE1 LHE1 trHE1N_QPP4P (1 : Int) 1 0 78 < 2 ^ (243 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
