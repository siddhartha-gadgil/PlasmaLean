set_option maxRecDepth 100000 in
/-- Kernel check of the node `m12`: truncation norm. -/
theorem kHF_m12 : node3KN SHF NHF MHF DHF WtHF KvHF trHFN_m12 (1 : Int) 1 0 18 232 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m12`: a priori `ℓ¹` bound. -/
theorem lHF_m12 : nodeL1N SHF LHF trHFN_m12 (1 : Int) 1 0 18 < 2 ^ (232 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `RDz`: truncation norm. -/
