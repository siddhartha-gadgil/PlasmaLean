/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH8`)

The checks of `Design/RationalStellaratorGCMu2CheckH8` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `K2`: truncation norm. -/
theorem kHMS_K2 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_K2 (1 : Int) 1 0 63 240 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `K2`: a priori `ℓ¹` bound. -/
theorem lHM_K2 : nodeL1N SHM LHM trHMN_K2 (1 : Int) 1 0 63 < 2 ^ (240 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
