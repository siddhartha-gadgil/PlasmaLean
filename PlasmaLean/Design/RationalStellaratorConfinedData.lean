@[expose] def G4_1 : FPoly :=
  fpoly% "-2 0 1 1 0; 3 0 2 0 1; 2 1 0 0 1; -4 1 1 1 0; 6 1 2 0 1; 3 2 0 0 1; -2 3 0 0 1"

/-- `4 r₂²` times the rate of change of variable `2` along the field (exponents
`[s, z, C, S]`). -/
@[expose] def G4_2 : FPoly :=
  fpoly% "-8 0 0 0 1; -4 0 2 0 2; -4 0 3 1 1; -16 1 0 0 1; -8 1 1 1 1; 4 2 0 0 2; 4 2 1 1 1"

/-- `4 r₂²` times the rate of change of variable `3` along the field (exponents
`[s, z, C, S]`). -/
@[expose] def G4_3 : FPoly :=
  fpoly% "8 0 0 1 0; 4 0 2 1 1; 4 0 3 2 0; 16 1 0 1 0; 8 1 1 2 0; -4 2 0 1 1; -4 2 1 2 0"

/-- The rate polynomials. -/
@[expose] def G4 : List FPoly := [G4_0, G4_1, G4_2, G4_3]

/-- Twice `J = s² + z² + (z² - s²) S/2 + s z C` (S-procedure multiplier; motivated as the
unverified linearised quadratic invariant). -/
@[expose] def J2 : FPoly :=
  fpoly% "2 2 0 0 0; 2 0 2 0 0; 1 0 2 0 1; -1 2 0 0 1; 2 1 1 1 0"

/-- Chart of the defect polynomial `∑ᵢ ∂ᵢP · G4ᵢ` (`C ≥ 0` chart, weight `(1 + t²)⁶`). -/
@[expose] def Qroot : D3 :=
  add3 (add3 (mul3 (chartD 5 1 (pderivZ Pz 0)) (chartD 1 1 G4_0))
      (mul3 (chartD 5 1 (pderivZ Pz 1)) (chartD 1 1 G4_1)))
    (add3 (mul3 (chartD 4 1 (pderivZ Pz 2)) (chartD 2 1 G4_2))
      (mul3 (chartD 4 1 (pderivZ Pz 3)) (chartD 2 1 G4_3)))

