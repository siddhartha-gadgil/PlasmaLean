module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 45)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMuDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nZphP`. -/
theorem cHM_nZphP : center3KN KvHM NHM MHM 40 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZphP`. -/
theorem clHM_nZphP : LHM 40 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `N0`. -/
theorem cHM_N0 : center3KN KvHM NHM MHM 86 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `N0`. -/
theorem clHM_N0 : LHM 86 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `Bm`: truncation norm. -/
theorem kHM_Bm : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_Bm (1 : Int) 1 0 83 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `Bm`: a priori `ℓ¹` bound. -/
theorem lHM_Bm : nodeL1N SHM LHM trHMN_Bm (1 : Int) 1 0 83 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
