module

public import PlasmaLean.Design.RationalStellaratorGCEwCombEnv

/-!
# Kernel checks of the energy-window combinations (part 4)

Each theorem is one kernel evaluation (`decide +kernel`) of the weighted digit sum `norm3KN` of the
Kronecker image of an integer combination of node tori (`Design/RationalStellaratorGCEwCombEnv`).
Light module. Generated by `scripts/gc_kam/ew_comb.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C3U`. -/
theorem kEw_C3U : norm3KN WtEw KvEw 36 27 trEwC_C3U (1, 0, 0) 132 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C3U`. -/
theorem lEw_C3U : ExN.majN LEw trEwC_C3U < 2 ^ (132 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C1LRx`. -/
theorem kEw_C1LRx : norm3KN WtEw KvEw 36 27 trEwC_C1LRx (1, 0, 3) 228 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C1LRx`. -/
theorem lEw_C1LRx : ExN.majN LEw trEwC_C1LRx < 2 ^ (228 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C1thU`. -/
theorem kEw_C1thU : norm3KN WtEw KvEw 36 27 trEwC_C1thU (1, 0, 3) 133 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C1thU`. -/
theorem lEw_C1thU : ExN.majN LEw trEwC_C1thU < 2 ^ (133 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `D0thZ`. -/
theorem kEw_D0thZ : norm3KN WtEw KvEw 36 27 trEwC_D0thZ (1, 0, 0) 129 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `D0thZ`. -/
theorem lEw_D0thZ : ExN.majN LEw trEwC_D0thZ < 2 ^ (129 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
