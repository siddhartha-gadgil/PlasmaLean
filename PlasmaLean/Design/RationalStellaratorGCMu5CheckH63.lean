module

public import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu5KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
meta import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu5CheckH63`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `nZtF`. -/
theorem cHMS_nZtF : center3KS KvSHM NHM MHM 95 118 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nZtF`. -/
theorem clHM_nZtF : LHM 95 < 2 ^ (118 - 1) := by
  kron_lt

/-- Proof-term check of the node `nRp`: truncation norm. -/
theorem kHMS_nRp : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nRp (8 : Int) 0 1 30 124 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `nRp`: a priori `ℓ¹` bound. -/
theorem lHM_nRp : nodeL1N SHM LHM trHMN_nRp (8 : Int) 0 1 30 < 2 ^ (124 - 1) := by
  kron_lt

/-- Proof-term check of the node `nZp`: truncation norm. -/
theorem kHMS_nZp : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nZp (16 : Int) 0 1 31 125 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `nZp`: a priori `ℓ¹` bound. -/
theorem lHM_nZp : nodeL1N SHM LHM trHMN_nZp (16 : Int) 0 1 31 < 2 ^ (125 - 1) := by
  kron_lt

/-- Proof-term check of the node `nRuP`: truncation norm. -/
theorem kHMS_nRuP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nRuP (8 : Int) 0 1 35 126 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `nRuP`: a priori `ℓ¹` bound. -/
theorem lHM_nRuP : nodeL1N SHM LHM trHMN_nRuP (8 : Int) 0 1 35 < 2 ^ (126 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu5
