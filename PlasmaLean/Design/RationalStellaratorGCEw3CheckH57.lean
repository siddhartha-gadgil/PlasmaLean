  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m12`. -/
theorem clHE3_m12 : LHE3 18 < 2 ^ (111 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `R8`. -/
theorem cHE3_R8 : center3KN KvHE3 NHE3 MHE3 74 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `R8`. -/
theorem clHE3_R8 : LHE3 74 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `P2`: truncation norm. -/
theorem kHE3_P2 : node3KN SHE3 NHE3 MHE3 DHE3 WtHE3 KvHE3 trHE3N_P2 (1 : Int) 1 0 50 244 145 109 49 13 8 19 72 54 ≤
