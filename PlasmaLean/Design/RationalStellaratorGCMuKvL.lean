/-- **The Kronecker images of the variable polynomials** (`w ↦ 2^{b W R}`). -/
def KvLM (b W R : Nat) (i : Nat) : Int :=
  match kindLM i with
  | 0 => ((1 <<< SLM : Nat) : Int) * ((1 <<< (b * (NLM + W * (MLM + R * DLM))) : Nat) : Int)
  | 1 => 2 * ((1 <<< (b * W) : Nat) : Int)
  | 2 => ((1 <<< (b * (0 + W * 2)) : Nat) : Int) - 1
  | 3 => ((1 <<< (b * (0 + W * 2)) : Nat) : Int) + 1
  | 4 =>
    ((1 <<< (SLM + 6) : Nat) : Int) * ((1 <<< (b * (NLM + W * (MLM + R * DLM))) : Nat) : Int) +
      ((1 <<< (SLM - 1) : Nat) : Int) * (((1 <<< (b * (NLM + W * (MLM + R * (DLM + 1)))) : Nat) : Int) +
        ((1 <<< (b * (NLM + W * (MLM + R * (DLM - 1)))) : Nat) : Int))
  | 5 => 0
  | _ =>
    if bMinLM i ≤ b ∧ wMinLM i ≤ W then
      ((famTB b W R NLM MLM DLM (c0LM i) (oddLM i) drLM dwLM (famLM i) : Nat) : Int) -
        ((famO b W R NLM MLM DLM dwLM (famLM i) : Nat) : Int)
    else famPack b W R NLM MLM DLM (if oddLM i then -1 else 1) (c0LM i : Int) 0 0 ddLM drLM 0
      (famLM i)

