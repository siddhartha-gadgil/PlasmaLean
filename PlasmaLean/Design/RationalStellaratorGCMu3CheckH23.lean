module

public import PlasmaLean.Design.RationalStellaratorGCMu3TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu3KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMu3TreesH
meta import PlasmaLean.Design.RationalStellaratorGCMu3KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu3CheckH23`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `m12`. -/
theorem cHMS_m12 : center3KS KvSHM NHM MHM 18 111 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `m12`. -/
theorem clHM_m12 : LHM 18 < 2 ^ (111 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `A1`. -/
theorem cHMS_A1 : center3KS KvSHM NHM MHM 60 125 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `A1`. -/
theorem clHM_A1 : LHM 60 < 2 ^ (125 - 1) := by
  kron_lt

/-- Proof-term check of the node `m50`: truncation norm. -/
theorem kHMS_m50 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m50 (1 : Int) 1 0 26 226 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m50`: a priori `ℓ¹` bound. -/
theorem lHM_m50 : nodeL1N SHM LHM trHMN_m50 (1 : Int) 1 0 26 < 2 ^ (226 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu3
