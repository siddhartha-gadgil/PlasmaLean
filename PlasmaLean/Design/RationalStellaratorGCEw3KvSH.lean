module

public import PlasmaLean.Design.RationalStellaratorGCEw3KvH
public import PlasmaLean.Certificates.KronLowMemCompute

/-!
# Low-memory Kronecker images (`Design/RationalStellaratorGCEw3KvH`)

The signed images `KvSHE3` of the variables of `Design/RationalStellaratorGCEw3KvH` for the low-
memory kernel checks (`Certificates/KronLowMemCompute`). Their integer values are the images `KvHE3`
(`KvSHE3_toInt`, `Design/RationalStellaratorGCEw3LowMemH`). Light module. Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed Kronecker images of the variable polynomials** (`w ↦ 2^{b W R}`): stored
families with fast widths by `famS`, every other variable by its integer image `KvHE3`. -/
def KvSHE3 (b W R : Nat) (i : Nat) : SInt :=
  if kindHE3 i = 6 ∧ bMinHE3 i ≤ b ∧ wMinHE3 i ≤ W then
    famS b W R NHE3 MHE3 DHE3 (c0HE3 i) (oddHE3 i) ddHE3 drHE3 dwHE3 (famHE3 i)
  else SInt.ofInt (KvHE3 b W R i)

end PlasmaLean.Design.RationalStellaratorGC
