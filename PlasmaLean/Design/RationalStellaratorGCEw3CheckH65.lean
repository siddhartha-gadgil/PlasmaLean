  decide +kernel

/-- Kernel check of the norm node `V2m1`: a priori `ℓ¹` bound. -/
theorem lHE3_V2m1 : ExN.majN LHE3 trHE3N_V2m1 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `N2`: truncation norm. -/
theorem kHE3_N2 : node3KN SHE3 NHE3 MHE3 DHE3 WtHE3 KvHE3 trHE3N_N2 (1 : Int) 1 0 87 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `N2`: a priori `ℓ¹` bound. -/
theorem lHE3_N2 : nodeL1N SHE3 LHE3 trHE3N_N2 (1 : Int) 1 0 87 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
