/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw4CheckH46`)

The checks of `Design/RationalStellaratorGCEw4CheckH46` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE4`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `R2`. -/
theorem cHE4S_R2 : center3KS KvSHE4 NHE4 MHE4 58 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `R2`. -/
theorem clHE4_R2 : LHE4 58 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `etaV4`. -/
theorem kHE4S_etaV4 : norm3KS WtHE4 KvSHE4 NHE4 MHE4 trHE4N_etaV4 (2, 0, 0) 231 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `etaV4`: a priori `ℓ¹` bound. -/
theorem lHE4_etaV4 : ExN.majN LHE4 trHE4N_etaV4 < 2 ^ (231 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
