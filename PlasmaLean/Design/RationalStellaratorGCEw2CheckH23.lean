/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw2CheckH23`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `nRuP`. -/
theorem cHE2S_nRuP : center3KS KvSHE2 NHE2 MHE2 35 121 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nRuP`. -/
theorem clHE2_nRuP : LHE2 35 < 2 ^ (121 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `YnRt`. -/
theorem cHE2S_YnRt : center3KS KvSHE2 NHE2 MHE2 92 120 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `YnRt`. -/
theorem clHE2_YnRt : LHE2 92 < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the node `m31`: truncation norm. -/
theorem kHE2S_m31 : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_m31 (1 : Int) 1 0 23 228 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m31`: a priori `ℓ¹` bound. -/
theorem lHE2_m31 : nodeL1N SHE2 LHE2 trHE2N_m31 (1 : Int) 1 0 23 < 2 ^ (228 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
