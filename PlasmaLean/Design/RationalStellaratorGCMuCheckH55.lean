module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH
public import PlasmaLean.Design.RationalStellaratorGCMuKvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMuCheckH55`)

The checks of `Design/RationalStellaratorGCMuCheckH55` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMuLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `P2`. -/
theorem cHMS_P2 : center3KS KvSHM NHM MHM 50 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `P2`. -/
theorem clHM_P2 : LHM 50 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `DuP`: truncation norm. -/
theorem kHMS_DuP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_DuP (2 : Int) 0 1 32 126 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `DuP`: a priori `ℓ¹` bound. -/
theorem lHM_DuP : nodeL1N SHM LHM trHMN_DuP (2 : Int) 0 1 32 < 2 ^ (126 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `V2`: truncation norm. -/
theorem kHMS_V2 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_V2 (1 : Int) 1 0 53 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `V2`: a priori `ℓ¹` bound. -/
theorem lHM_V2 : nodeL1N SHM LHM trHMN_V2 (1 : Int) 1 0 53 < 2 ^ (244 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `Vm1`. -/
theorem kHMS_Vm1 : norm3KS WtHM KvSHM NHM MHM trHMN_Vm1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `Vm1`: a priori `ℓ¹` bound. -/
theorem lHM_Vm1 : ExN.majN LHM trHMN_Vm1 < 2 ^ (123 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
