module

public import PlasmaLean.Design.RationalStellaratorGCEwCombEnv

/-!
# Kernel checks of the energy-window combinations (part 8)

Each theorem is one kernel evaluation (`decide +kernel`) of the weighted digit sum `norm3KN` of the
Kronecker image of an integer combination of node tori (`Design/RationalStellaratorGCEwCombEnv`).
Light module. Generated by `scripts/gc_kam/ew_comb.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C2Z`. -/
theorem kEw_C2Z : norm3KN WtEw KvEw 36 27 trEwC_C2Z (1, 0, 1) 128 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C2Z`. -/
theorem lEw_C2Z : ExN.majN LEw trEwC_C2Z < 2 ^ (128 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C1LZx`. -/
theorem kEw_C1LZx : norm3KN WtEw KvEw 36 27 trEwC_C1LZx (1, 0, 0) 228 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C1LZx`. -/
theorem lEw_C1LZx : ExN.majN LEw trEwC_C1LZx < 2 ^ (228 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C0thZ`. -/
theorem kEw_C0thZ : norm3KN WtEw KvEw 36 27 trEwC_C0thZ (1, 0, 0) 129 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C0thZ`. -/
theorem lEw_C0thZ : ExN.majN LEw trEwC_C0thZ < 2 ^ (129 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
