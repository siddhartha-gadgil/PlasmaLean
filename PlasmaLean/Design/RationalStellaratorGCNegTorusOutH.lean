/-- The full chain. -/
theorem ballH_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) :
    ∀ i, i < 70 → Bd r (XH i - xH i) (EH i) :=
  ballH_70 hr hq

/-- A value is bounded by its centre norm plus its radius. -/
theorem valH_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16)
    (i : ℕ) (hi : i < 70) :
    Bd r (XH i) ((BH i + EH i : ℚ) : ℝ) := by
  have := (normH hq i hi).add (ballH_all hr hq i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

