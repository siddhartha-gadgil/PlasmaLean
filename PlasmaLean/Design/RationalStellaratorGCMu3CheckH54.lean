module

public import PlasmaLean.Design.RationalStellaratorGCMu3TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu3KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMu3TreesH
meta import PlasmaLean.Design.RationalStellaratorGCMu3KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu3CheckH54`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the node `nRzP`: truncation norm. -/
theorem kHMS_nRzP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nRzP (8 : Int) 0 1 36 126 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `nRzP`: a priori `ℓ¹` bound. -/
theorem lHM_nRzP : nodeL1N SHM LHM trHMN_nRzP (8 : Int) 0 1 36 < 2 ^ (126 - 1) := by
  kron_lt

/-- Proof-term check of the node `P2`: truncation norm. -/
theorem kHMS_P2 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_P2 (1 : Int) 1 0 50 244 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `P2`: a priori `ℓ¹` bound. -/
theorem lHM_P2 : nodeL1N SHM LHM trHMN_P2 (1 : Int) 1 0 50 < 2 ^ (244 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `V4m1`. -/
theorem kHMS_V4m1 : norm3KS WtHM KvSHM NHM MHM trHMN_V4m1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `V4m1`: a priori `ℓ¹` bound. -/
theorem lHM_V4m1 : ExN.majN LHM trHMN_V4m1 < 2 ^ (123 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu3
