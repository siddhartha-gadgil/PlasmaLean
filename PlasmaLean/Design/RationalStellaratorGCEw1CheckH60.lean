/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw1CheckH60`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `U`. -/
theorem cHE1S_U : center3KS KvSHE1 NHE1 MHE1 4 119 73 55 25 11 1 73 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `U`. -/
theorem clHE1_U : LHE1 4 < 2 ^ (119 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `m40`. -/
theorem cHE1S_m40 : center3KS KvSHE1 NHE1 MHE1 24 109 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `m40`. -/
theorem clHE1_m40 : LHE1 24 < 2 ^ (109 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `V4n`. -/
theorem cHE1S_V4n : center3KS KvSHE1 NHE1 MHE1 81 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `V4n`. -/
theorem clHE1_V4n : LHE1 81 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `dU`. -/
theorem kHE1S_dU : norm3KS WtHE1 KvSHE1 NHE1 MHE1 trHE1N_dU (1, 0, 0) 120 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `dU`: a priori `ℓ¹` bound. -/
theorem lHE1_dU : ExN.majN LHE1 trHE1N_dU < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the node `R2`: truncation norm. -/
theorem kHE1S_R2 : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_R2 (1 : Int) 1 0 58 236 145 109 49 13 8 19 72 54 ≤
