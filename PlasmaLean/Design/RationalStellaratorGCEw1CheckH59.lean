/-- Kernel check of the node `W2`: a priori `ℓ¹` bound. -/
theorem lHE1_W2 : nodeL1N SHE1 LHE1 trHE1N_W2 (1 : Int) 1 0 56 < 2 ^ (244 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `lamv`: truncation norm. -/
theorem kHE1_lamv : node3KN SHE1 NHE1 MHE1 DHE1 WtHE1 KvHE1 trHE1N_lamv (32 : Int) 0 0 84 130 73 55 25 11 8 10 36 27 ≤
