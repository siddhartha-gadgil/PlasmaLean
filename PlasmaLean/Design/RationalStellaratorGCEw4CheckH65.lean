  decide +kernel

/-- Kernel check of the norm node `V2m1`: a priori `ℓ¹` bound. -/
theorem lHE4_V2m1 : ExN.majN LHE4 trHE4N_V2m1 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `N2`: truncation norm. -/
theorem kHE4_N2 : node3KN SHE4 NHE4 MHE4 DHE4 WtHE4 KvHE4 trHE4N_N2 (1 : Int) 1 0 87 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `N2`: a priori `ℓ¹` bound. -/
theorem lHE4_N2 : nodeL1N SHE4 LHE4 trHE4N_N2 (1 : Int) 1 0 87 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
