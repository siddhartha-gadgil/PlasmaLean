module

public import PlasmaLean.Design.RationalStellaratorGCMu3TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu3KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu3CheckH32`)

The checks of `Design/RationalStellaratorGCMu3CheckH32` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m51`. -/
theorem cHMS_m51 : center3KS KvSHM NHM MHM 27 102 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m51`. -/
theorem clHM_m51 : LHM 27 < 2 ^ (102 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `R4`. -/
theorem cHMS_R4 : center3KS KvSHM NHM MHM 73 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `R4`. -/
theorem clHM_R4 : LHM 73 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `W`: truncation norm. -/
theorem kHMS_W : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_W (1 : Int) 1 0 55 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `W`: a priori `ℓ¹` bound. -/
theorem lHM_W : nodeL1N SHM LHM trHMN_W (1 : Int) 1 0 55 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu3
