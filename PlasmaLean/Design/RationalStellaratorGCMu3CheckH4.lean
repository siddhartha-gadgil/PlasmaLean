public import PlasmaLean.Design.RationalStellaratorGCMu3TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu3KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu3CheckH4`)

The checks of `Design/RationalStellaratorGCMu3CheckH4` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `resR`. -/
theorem kHMS_resR : norm3KS WtHM KvSHM NHM MHM trHMN_resR (2, 0, 3) 341 145 109 49 13 4 37 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `resR`: a priori `ℓ¹` bound. -/
theorem lHM_resR : ExN.majN LHM trHMN_resR < 2 ^ (341 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu3
