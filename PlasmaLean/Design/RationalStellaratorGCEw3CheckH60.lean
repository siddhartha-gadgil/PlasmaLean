/-- Proof-term check of the node `R2`: truncation norm. -/
theorem kHE3S_R2 : node3KS SHE3 NHE3 MHE3 DHE3 WtHE3 KvSHE3 trHE3N_R2 (1 : Int) 1 0 58 236 145 109 49 13 8 19 72 54 ≤
