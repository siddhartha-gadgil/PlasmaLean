    Bd r (Ex.eval (XHF c) (toEx trHFN_dU)) (((1163 / 10 ^ 11 : ℚ) : ℚ) : ℝ) :=
  norm3_fullN hr hq hc hWHF boxHF (l1HF 55) (fun _ => rfl) (fun i hi => normHF hq hc i (by omega)) (ballHF_14 hr hq hc) trHFN_dU (1, 0, 0)
      72 54 20 120 73 21 11 8 10 36 27 
      (1163 / 10 ^ 11 : ℚ) (kronHF 120 73 55) (by kernel_fact)
      (by kernel_fact) (by kernel_fact) lHF_dU kHF_dU (by kernel_fact)

