/-- Kernel check of the node `R8`: a priori `ℓ¹` bound. -/
theorem lHE2_R8 : nodeL1N SHE2 LHE2 trHE2N_R8 (1 : Int) 1 0 74 < 2 ^ (242 - 1) := by
