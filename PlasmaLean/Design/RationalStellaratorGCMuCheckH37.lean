module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH
public import PlasmaLean.Design.RationalStellaratorGCMuKvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMuCheckH37`)

The checks of `Design/RationalStellaratorGCMuCheckH37` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMuLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `DuP`. -/
theorem cHMS_DuP : center3KS KvSHM NHM MHM 32 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DuP`. -/
theorem clHM_DuP : LHM 32 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `QPP4P`. -/
theorem cHMS_QPP4P : center3KS KvSHM NHM MHM 78 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `QPP4P`. -/
theorem clHM_QPP4P : LHM 78 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `KD`: truncation norm. -/
theorem kHMS_KD : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_KD (1 : Int) 1 0 65 239 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `KD`: a priori `ℓ¹` bound. -/
theorem lHM_KD : nodeL1N SHM LHM trHMN_KD (1 : Int) 1 0 65 < 2 ^ (239 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
