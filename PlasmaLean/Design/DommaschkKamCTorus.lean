/-!
# Dommaschk torus C as elements of the strip algebra (N-33 plan item 6)

The approximate torus C of the Dommaschk target (data `Design/DommaschkKamCData`, generated by
`scripts/dommaschk_kam/emit_torus.py`) in the form the generalised KAM interface consumes
(`FlowFieldG.KamHG … u₀ z₀ …`, `Design/KamFlowIterationG`).

**Two angles.** The oracle writes the torus in `ψₒ = 2φ` (stellarator symmetric about `φ = 0`,
so `R` is a pure cosine and `z` a pure sine series in `kθ + mψₒ`). The strip algebra fixes
`cS = cos 2φ = −sin ψ`, `sS = sin 2φ = cos ψ` (`KamNewton.eval_cS`), i.e. the Lean angle is
`ψ = 2φ − π/2 = ψₒ − π/2`. The two are related by the **rotation** `rotψ` (`c_km ↦ iᵐ c_km`,
`eval_rotψ`: `rotψ x` at `(θ, ψ)` is `x` at `(θ, ψ + π/2)`). `rotψ` is an isometric `ℂ`-algebra
automorphism (`rotψHom`, `Bd_rotψ`, `isReal_rotψ`, `ana_rotψ`) commuting with every derivative
`dS a b` (`dS_rotψ`) and taking the oracle-angle `cos ψₒ`, `sin ψₒ` (`cSo`, `sSo`) to `cS`, `sS`
(`rotψ_cSo`, `rotψ_sSo`). Hence any polynomial identity or bound computed in the oracle angle
(a KronBall chain on the grids as stored) transfers to the Lean angle (`rotψ_eval`, `Bd_rotψ`).

**The torus.** `Uo`, `Zo`: the grid centres (`Certificates/KronBallGrid`, `ctr` with phases
`0`, `1`) of `U = R − R₀` (`R₀ = 29/32`) and `z` in the oracle angle; `u₀C = rotψ Uo`,
`z₀C = rotψ Zo` in the Lean angle; analytic (`ana_u₀C`, `ana_z₀C`) and real (`isReal_u₀C`,
`isReal_z₀C`).

**The field with the moving centre.** `dkFieldTC = dkFieldC cenR cenZ`: the Dommaschk
`FlowFieldG` with the moving frame centre `A = (R₀ + a_R, a_z)` of the data module (the first
three harmonics of the magnetic axis).

**Sanity.** `rotψ_one`, `rotψ_zero` (degenerate), `coeff_u₀C` (the coefficient formula),
`rotψ_mode` (concrete), `gZ_centre`, `rotψ_ne_id` (rejected fixture: `rotψ` is not the
identity), `cenR_ne`; `iotaqC_close` (the dyadic `ι_q` is `2^{−Qc}`-close to `ι_C`).
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.DommaschkKamC

open PlasmaLean.Theory.KAM PlasmaLean.Certificates.KronBall PlasmaLean.Design.KamNewton
  PlasmaLean.Design.DommaschkKam WEll1Z2 Complex

/-! ## The rotation `ψ ↦ ψ + π/2` -/

/-- The rotated coefficient function `n ↦ i^{n.2} f n`. -/
def rotSym (f : ℤ × ℤ → ℂ) (n : ℤ × ℤ) : ℂ := I ^ n.2 * f n

/-- The rotation does not change the moduli of the coefficients. -/
theorem norm_rotSym (f : ℤ × ℤ → ℂ) (n : ℤ × ℤ) : ‖rotSym f n‖ = ‖f n‖ := by
  simp [rotSym, norm_zpow]

/-- Weighted summability is preserved. -/
theorem inWeighted_rotSym {r : ℝ} {f : ℤ × ℤ → ℂ} (hf : InWeighted r f) :
    InWeighted r (rotSym f) := by
  unfold InWeighted at *
  simpa only [norm_rotSym] using hf

/-- The weighted norm is preserved. -/
theorem wnorm_rotSym (r : ℝ) (f : ℤ × ℤ → ℂ) : wnorm r (rotSym f) = wnorm r f := by
  simp only [wnorm, norm_rotSym]

/-- **The rotation `rotψ`**: `c_km ↦ iᵐ c_km`. -/
def rotψ (x : FA) : FA := ofCoeff (rotSym (coeff x)) (inWeighted_rotSym (inWeighted_coeff x))

/-- Coefficients of `rotψ x`. -/
@[simp] theorem coeff_rotψ (x : FA) (n : ℤ × ℤ) : coeff (rotψ x) n = I ^ n.2 * coeff x n := by
  simp [rotψ, rotSym]

/-- Coefficients of `rotψ x`, as functions. -/
theorem coeff_rotψ' (x : FA) : coeff (rotψ x) = rotSym (coeff x) := by
  funext n; simp [rotSym]

/-- `rotψ` preserves strip bounds. -/
theorem Bd_rotψ {ρ B : ℝ} {x : FA} (h : Bd ρ x B) : Bd ρ (rotψ x) B := by
  refine ⟨?_, ?_⟩
  · rw [coeff_rotψ']; exact inWeighted_rotSym h.1
  · rw [coeff_rotψ', wnorm_rotSym]; exact h.2

/-- `rotψ` preserves analyticity. -/
theorem ana_rotψ {x : FA} (h : Ana x) : Ana (rotψ x) := by
  obtain ⟨ρ, B, hρ, hB⟩ := h
  exact ⟨ρ, B, hρ, Bd_rotψ hB⟩

/-- `conj (iᵐ) = i^{−m}`. -/
theorem conj_I_zpow (m : ℤ) : (starRingEnd ℂ) (I ^ m) = I ^ (-m) := by
  rw [map_zpow₀, Complex.conj_I, ← Complex.inv_I, inv_zpow, zpow_neg]

/-- `rotψ` preserves reality. -/
theorem isReal_rotψ {x : FA} (h : IsReal x) : IsReal (rotψ x) := by
  refine IsReal.of_coeff fun n => ?_
  rw [coeff_rotψ, coeff_rotψ, h.coeff_neg, map_mul, conj_I_zpow]
  rfl

/-- `exp(m · π/2 · i) = iᵐ`. -/
theorem exp_quarter (m : ℤ) : Complex.exp (((m * (Real.pi / 2) : ℝ) : ℂ) * I) = I ^ m := by
  have h1 : Complex.exp (((Real.pi / 2 : ℝ) : ℂ) * I) = I := by
    rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_pi_div_two,
      Real.sin_pi_div_two]
    simp
  have h2 : (((m * (Real.pi / 2) : ℝ) : ℂ) * I) = (m : ℂ) * (((Real.pi / 2 : ℝ) : ℂ) * I) := by
    push_cast; ring
  rw [h2, Complex.exp_int_mul, h1]

/-- **The function of `rotψ x`**: the rotation by a quarter turn in `ψ`. -/
theorem eval_rotψ (x : FA) (θ ψ : ℝ) : eval (rotψ x) θ ψ = eval x θ (ψ + Real.pi / 2) := by
  simp only [eval, fourierSum, coeff_rotψ]
  refine tsum_congr fun n => ?_
  rw [fourierMode, fourierMode, ← exp_quarter, mul_comm (Complex.exp _) (coeff x n), mul_assoc,
    ← Complex.exp_add]
  congr 2
  push_cast; ring

/-- `rotψ` commutes with every derivative `dS a b`. -/
theorem dS_rotψ (a b : ℂ) {x : FA} (hx : Ana x) : dS a b (rotψ x) = rotψ (dS a b x) := by
  refine ext_coeff fun n => ?_
  rw [(ana_rotψ hx).coeff_dS, coeff_rotψ, hx.coeff_dS, dsym, dsym, coeff_rotψ]
  ring

/-- `rotψ` is additive. -/
theorem rotψ_add (x y : FA) : rotψ (x + y) = rotψ x + rotψ y :=
  ext_coeff fun n => by simp [mul_add]

/-- `rotψ` is `ℂ`-linear. -/
theorem rotψ_smul (c : ℂ) (x : FA) : rotψ (c • x) = c • rotψ x :=
  ext_coeff fun n => by simp [mul_left_comm]

/-- `rotψ 0 = 0`. -/
theorem rotψ_zero : rotψ 0 = 0 := ext_coeff fun n => by simp

/-- **Sanity (degenerate)**: `rotψ 1 = 1`. -/
theorem rotψ_one : rotψ 1 = 1 := by
  refine ext_coeff fun n => ?_
  rw [coeff_rotψ, coeff_one, delta2]
  split_ifs with h
  · subst h; simp
  · simp

/-- `rotψ` is multiplicative: `iᵐ` is a character of `ℤ²`. -/
theorem rotψ_mul (x y : FA) : rotψ (x * y) = rotψ x * rotψ y := by
  refine ext_coeff fun n => ?_
  rw [coeff_rotψ, coeff_mul, coeff_mul, cconv, cconv, ← tsum_mul_left]
  refine tsum_congr fun a => ?_
  rw [coeff_rotψ, coeff_rotψ, Prod.snd_sub]
  have h : I ^ n.2 = I ^ a.2 * I ^ (n.2 - a.2) := by
    rw [← zpow_add₀ I_ne_zero]; ring_nf
  rw [h]; ring

/-- **`rotψ` as a `ℂ`-algebra homomorphism.** -/
def rotψHom : FA →ₐ[ℂ] FA where
  toFun := rotψ
  map_one' := rotψ_one
  map_mul' := rotψ_mul
  map_zero' := rotψ_zero
  map_add' := rotψ_add
  commutes' c := by
    rw [Algebra.algebraMap_eq_smul_one, rotψ_smul, rotψ_one]

/-- Polynomial expressions commute with `rotψ`. -/
theorem rotψ_eval {σ : Type*} (x : σ → FA) (e : PolyExpr ℂ σ) :
    rotψ (PolyExpr.eval x e) = PolyExpr.eval (fun i => rotψ (x i)) e :=
  PolyExpr.eval_algHom rotψHom x e

/-- **Sanity (concrete)**: a Fourier mode is multiplied by `iᵐ`. -/
theorem rotψ_mode (k m : ℤ) : rotψ (mode 0 (k, m)) = I ^ m • mode 0 (k, m) := by
  refine ext_coeff fun n => ?_
  rw [coeff_rotψ, coeff_smul, coeff_mode]
  by_cases h : n = (k, m)
  · subst h; simp
  · simp [h]

/-- `cos ψₒ` in the oracle angle. -/
def cSo : FA := (1 / 2 : ℂ) • (mode 0 (0, 1) + mode 0 (0, -1))

/-- `sin ψₒ` in the oracle angle. -/
def sSo : FA := (-I / 2) • (mode 0 (0, 1) - mode 0 (0, -1))

/-- `rotψ` of the mode `e^{iψ}`. -/
theorem rotψ_mode_one : rotψ (mode 0 (0, 1)) = I • mode 0 (0, 1) := by rw [rotψ_mode, zpow_one]

/-- `rotψ` of the mode `e^{−iψ}`. -/
theorem rotψ_mode_neg_one : rotψ (mode 0 (0, -1)) = (-I) • mode 0 (0, -1) := by
  rw [rotψ_mode, zpow_neg_one, Complex.inv_I]

/-- `rotψ` is subtractive. -/
theorem rotψ_sub (x y : FA) : rotψ (x - y) = rotψ x - rotψ y :=
  ext_coeff fun n => by simp [mul_sub]

/-- The rotation takes `cos ψₒ` to `cS = cos 2φ`. -/
theorem rotψ_cSo : rotψ cSo = cS := by
  rw [cSo, cS, rotψ_smul, rotψ_add, rotψ_mode_one, rotψ_mode_neg_one]
  module

/-- The rotation takes `sin ψₒ` to `sS = sin 2φ`. -/
theorem rotψ_sSo : rotψ sSo = sS := by
  have e1 : -I / 2 * I = 1 / 2 := by rw [show -I / 2 * I = -(I * I) / 2 by ring, I_mul_I]; ring
  have e2 : -I / 2 * -I = -(1 / 2) := by rw [show -I / 2 * -I = I * I / 2 by ring, I_mul_I]; ring
  rw [sSo, sS, rotψ_smul, rotψ_sub, rotψ_mode_one, rotψ_mode_neg_one, smul_sub, smul_smul,
    smul_smul, e1, e2, neg_smul, sub_neg_eq_add, smul_add]

/-- **Rejected fixture**: `rotψ` is not the identity (`rotψ (e^{iψ}) = i e^{iψ}`). -/
theorem rotψ_ne_id : rotψ (mode 0 (0, 1)) ≠ mode 0 (0, 1) := by
  intro h
  have := congrArg (fun x => coeff x (0, 1)) h
  simp only [coeff_rotψ, coeff_mode, Pi.single_eq_same, mul_one, zpow_one] at this
  simpa using congrArg Complex.im this

/-! ## The torus -/

/-- The grid of `U = R − R₀` (oracle angle; even). -/
def gU : ℕ → ℕ → ℤ := symGrid Nc Mc ((-1) ^ 0) (halfGridR Fc Nc datU)

/-- The grid of `z` (oracle angle; odd). -/
def gZ : ℕ → ℕ → ℤ := symGrid Nc Mc ((-1) ^ 1) (halfGridR Fc Nc datZ)

/-- `U = R − R₀` of torus C in the oracle angle `ψₒ = 2φ` (a grid centre of phase `0`). -/
def Uo : FA := ctr Sc Nc Mc (1, 0, 0) (gridPolyNM Nc Mc gU)

/-- `z` of torus C in the oracle angle (a grid centre of phase `1`). -/
def Zo : FA := ctr Sc Nc Mc (1, 0, 1) (gridPolyNM Nc Mc gZ)

/-- **`u₀ = R − R₀` of torus C** in the Lean angle `ψ = 2φ − π/2`. -/
def u₀C : FA := rotψ Uo

/-- **`z₀` of torus C** in the Lean angle. -/
def z₀C : FA := rotψ Zo

/-- `Uo` is analytic. -/
theorem ana_Uo : Ana Uo := ana_ctr_grid _ _ _ _ _
/-- `Zo` is analytic. -/
theorem ana_Zo : Ana Zo := ana_ctr_grid _ _ _ _ _
/-- `Uo` is real. -/
theorem isReal_Uo : IsReal Uo := isReal_ctr_sym _ _ _ 0 _
/-- `Zo` is real. -/
theorem isReal_Zo : IsReal Zo := isReal_ctr_sym _ _ _ 1 _

/-- `u₀C` is analytic. -/
theorem ana_u₀C : Ana u₀C := ana_rotψ ana_Uo
/-- `z₀C` is analytic. -/
theorem ana_z₀C : Ana z₀C := ana_rotψ ana_Zo
/-- `u₀C` is real. -/
theorem isReal_u₀C : IsReal u₀C := isReal_rotψ isReal_Uo
/-- `z₀C` is real. -/
theorem isReal_z₀C : IsReal z₀C := isReal_rotψ isReal_Zo

/-- **Sanity (degenerate)**: the odd grid of `z` vanishes at the centre (`⟨z⟩ = 0`). -/
theorem gZ_centre : gZ Nc Mc = 0 := symGrid_centre_odd _ _ _

/-- The function of `u₀C`: `U` at the oracle angle `ψₒ = ψ + π/2 = 2φ`. -/
theorem eval_u₀C (θ ψ : ℝ) : eval u₀C θ ψ = eval Uo θ (ψ + Real.pi / 2) := eval_rotψ _ _ _
/-- The function of `z₀C`. -/
theorem eval_z₀C (θ ψ : ℝ) : eval z₀C θ ψ = eval Zo θ (ψ + Real.pi / 2) := eval_rotψ _ _ _

/-- **The coefficient formula** of `u₀C`: `iᵐ g(k + N, m + M)/2^S` inside the box. -/
theorem coeff_u₀C (km : ℤ × ℤ) : coeff u₀C km = I ^ km.2 * (((2 : ℂ) ^ Sc * I ^ 0)⁻¹ *
    ((if |km.1| ≤ Nc ∧ |km.2| ≤ Mc then gU (km.1 + Nc).toNat (km.2 + Mc).toNat
      else 0 : ℤ) : ℂ)) := by
  rw [u₀C, coeff_rotψ, Uo, coeff_ctr_grid]

/-- The coefficient formula of `z₀C`. -/
theorem coeff_z₀C (km : ℤ × ℤ) : coeff z₀C km = I ^ km.2 * (((2 : ℂ) ^ Sc * I ^ 1)⁻¹ *
    ((if |km.1| ≤ Nc ∧ |km.2| ≤ Mc then gZ (km.1 + Nc).toNat (km.2 + Mc).toNat
      else 0 : ℤ) : ℂ)) := by
  rw [z₀C, coeff_rotψ, Zo, coeff_ctr_grid]

/-! ## The rotational transform and the field with the moving centre -/

/-- The dyadic rotational transform `ι_q = −Iqc/2^Qc ≈ ι_C`. -/
def iotaqC : ℝ := -((Iqc : ℝ) / 2 ^ Qc)

/-- `|X − t| ≤ c` from the square bracket `(t − c)² ≤ X² ≤ (t + c)²`, `c ≤ t`, `0 ≤ X`. -/
theorem abs_sub_le_of_sq_bracket {X t c : ℝ} (hX : 0 ≤ X) (hc : 0 ≤ c) (ht : c ≤ t)
    (h1 : (t - c) ^ 2 ≤ X ^ 2) (h2 : X ^ 2 ≤ (t + c) ^ 2) : |X - t| ≤ c := by
  have a1 : t - c ≤ X := (pow_le_pow_iff_left₀ (by linarith) hX two_ne_zero).1 h1
  have a2 : X ≤ t + c := (pow_le_pow_iff_left₀ hX (by linarith) two_ne_zero).1 h2
  rw [abs_le]; constructor <;> linarith

/-- **The dyadic rotational transform is `2^{−Qc}`-close to `ι_C = −(85 + √5)/361`**
(`t = 361 Iqc − 85·2^Qc` brackets `√5·2^Qc` within `361`, checked on integer squares). -/
theorem iotaqC_close : |iotaqC - DommaschkKamDio.dkIotaC| ≤ 1 / 2 ^ Qc := by
  have hQ : (0 : ℝ) < 2 ^ Qc := by positivity
  have hs : √5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  set t : ℝ := 361 * Iqc - 85 * 2 ^ Qc with ht
  have key : |√5 * 2 ^ Qc - t| ≤ 361 := by
    refine abs_sub_le_of_sq_bracket (by positivity) (by norm_num) ?_ ?_ ?_
    · rw [ht]; norm_num [Iqc, Qc]
    · rw [mul_pow, hs, ht]; norm_num [Iqc, Qc]
    · rw [mul_pow, hs, ht]; norm_num [Iqc, Qc]
  have e : iotaqC - DommaschkKamDio.dkIotaC = (√5 * 2 ^ Qc - t) / (361 * 2 ^ Qc) := by
    rw [ht, iotaqC, DommaschkKamDio.dkIotaC]; field_simp; ring
  rw [e, abs_div, abs_of_pos (show (0 : ℝ) < 361 * 2 ^ Qc by positivity),
    div_le_div_iff₀ (by positivity) hQ]
  nlinarith

/-- The radial centre polynomial is angle only. -/
theorem cenR_AO : DkPoly.AO cenR = true := rfl

/-- The vertical centre polynomial is angle only. -/
theorem cenZ_AO : DkPoly.AO cenZ = true := rfl

/-- **The Dommaschk target with the moving frame centre of torus C** (`R₀ = 29/32`, `p = 7`). -/
def dkFieldTC : PlasmaLean.Design.KamNewton.FlowFieldG := dkFieldC cenR cenZ cenR_AO cenZ_AO

/-- The centre polynomials of `dkFieldTC`. -/
theorem dkFieldTC_cen : dkFieldTC.aRp = DkPoly.toPE cenR ∧ dkFieldTC.aZp = DkPoly.toPE cenZ :=
  ⟨rfl, rfl⟩

/-- **Sanity**: the centre is not the fixed circle (`a_R ≠ 0`). -/
theorem cenR_ne : cenR ≠ [] := by simp [cenR]

end PlasmaLean.Design.DommaschkKamC
