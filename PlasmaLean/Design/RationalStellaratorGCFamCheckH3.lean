module

public import PlasmaLean.Design.RationalStellaratorGCFamTreesH
public import PlasmaLean.Design.RationalStellaratorGCFamKvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCFamCheckH3`)

The checks of `Design/RationalStellaratorGCFamCheckH3` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHF`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCFamLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `qph`: truncation norm. -/
theorem kHFS_qph : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_qph (1 : Int) 1 0 49 238 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `qph`: a priori `ℓ¹` bound. -/
theorem lHF_qph : nodeL1N SHF LHF trHFN_qph (1 : Int) 1 0 49 < 2 ^ (238 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `V2`: truncation norm. -/
theorem kHFS_V2 : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_V2 (1 : Int) 1 0 53 244 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `V2`: a priori `ℓ¹` bound. -/
theorem lHF_V2 : nodeL1N SHF LHF trHFN_V2 (1 : Int) 1 0 53 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
