module

public import PlasmaLean.Design.RationalStellaratorGCEw4TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 58)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw4DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 4: gyro-length `ρ_4 = 1/256 + 2⁻³²`, its own family torus `K_4(λ)`; the
fields at `ρ_4` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m22`. -/
theorem cHE4_m22 : center3KN KvHE4 NHE4 MHE4 22 107 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m22`. -/
theorem clHE4_m22 : LHE4 22 < 2 ^ (107 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `V40`. -/
theorem cHE4_V40 : center3KN KvHE4 NHE4 MHE4 79 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `V40`. -/
theorem clHE4_V40 : LHE4 79 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `DzP`: truncation norm. -/
theorem kHE4_DzP : node3KN SHE4 NHE4 MHE4 DHE4 WtHE4 KvHE4 trHE4N_DzP (8 : Int) 0 1 33 125 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `DzP`: a priori `ℓ¹` bound. -/
theorem lHE4_DzP : nodeL1N SHE4 LHE4 trHE4N_DzP (8 : Int) 0 1 33 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `V2`: truncation norm. -/
theorem kHE4_V2 : node3KN SHE4 NHE4 MHE4 DHE4 WtHE4 KvHE4 trHE4N_V2 (1 : Int) 1 0 53 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `V2`: a priori `ℓ¹` bound. -/
theorem lHE4_V2 : nodeL1N SHE4 LHE4 trHE4N_V2 (1 : Int) 1 0 53 < 2 ^ (244 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `V4m1`. -/
theorem kHE4_V4m1 : norm3KN WtHE4 KvHE4 NHE4 MHE4 trHE4N_V4m1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `V4m1`: a priori `ℓ¹` bound. -/
theorem lHE4_V4m1 : ExN.majN LHE4 trHE4N_V4m1 < 2 ^ (123 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
