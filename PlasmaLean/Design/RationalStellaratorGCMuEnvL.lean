/-!
# The low-resolution environment of the `μ > 0` passing guiding-centre torus family certificate

The variable polynomials `PLM i` (three variables: `θ`-, `ψ`-modes and the Chebyshev variable
`w`), their degree boxes (`boxLM`), static `ℓ¹` bounds (`l1LM`) and Kronecker images (`kronLM`);
the family centres `xLM c i` at the parameter `w = c`; the norm bounds `BLM i` of the centres and
the radii `ELM i` of the balls (supplied by the oracle, checked in
`Design/RationalStellaratorGCMuCheckL*`).
Generated by `scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section
noncomputable section

set_option linter.style.longLine false

namespace PlasmaLean.Design.RationalStellaratorGC

open Polynomial PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall PlasmaLean.Certificates.KronBallCheb PlasmaLean.Theory.KAM

/-- **The variable polynomials** of the family pipeline (by kind, `kindLM`). -/
def PLM (i : ℕ) : P3 :=
  match kindLM i with
  | 0 => T3 SLM NLM MLM DLM
  | 1 => V3
  | 2 => C cPoly
  | 3 => C sPoly
  | 4 => Pr3 SLM NLM MLM DLM
  | 5 => 0
  | _ => famPoly NLM MLM DLM (if oddLM i then -1 else 1) (c0LM i : ℤ) 0 0 0 (famLM i)

/-- The kinds are at most `6`. -/
theorem kindLM_le (i : ℕ) : kindLM i ≤ 6 :=
  getD_prop (Pr := fun k : ℕ => k ≤ 6) (by kernel_fact) (by kernel_fact) i

set_option maxRecDepth 100000 in
/-- The variables beyond the last have kind `5` (zero). -/
theorem kindLM_ge {i : ℕ} (h : 180 ≤ i) : kindLM i = 5 := by
  unfold kindLM
  rw [List.getD_eq_getElem?_getD,
    List.getElem?_eq_none ((by kernel_fact : kindLMl.length = 180).trans_le h)]
  rfl

/-- Stored families are below the last variable. -/
theorem lt_of_kindLM {i : ℕ} (h : kindLM i = 6) : i < 180 := by
  by_contra h'
  rw [kindLM_ge (by omega)] at h
  exact absurd h (by kernel_fact)

set_option maxRecDepth 100000 in
/-- The static conditions of the stored families. -/
theorem staticLM : ∀ i, i < 180 → kindLM i = 6 →
    FamStatic NLM MLM DLM ddLM drLM dwLM (famLM i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The minimal widths of the fast images. -/
theorem dynLM : ∀ i, i < 180 → kindLM i = 6 →
    FamDyn (bMinLM i) (wMinLM i) (c0LM i) (famLM i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The static `ℓ¹` bounds of the stored families. -/
theorem l1famLM : ∀ i, i < 180 → kindLM i = 6 →
    famL1 NLM MLM (c0LM i : ℤ) 0 0 0 (famLM i) ≤ LLM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree boxes of the stored families. -/
theorem bx6LM : ∀ i, i < 180 → kindLM i = 6 → BxLM i = (2 * NLM, 2 * MLM, 2 * DLM) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `t`. -/
theorem bx0LM : ∀ i, i < 180 → kindLM i = 0 → BxLM i = (NLM, MLM, DLM) ∧ 2 ^ SLM ≤ LLM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `V`. -/
theorem bx1LM : ∀ i, i < 180 → kindLM i = 1 → BxLM i = (0, 1, 0) ∧ 2 ≤ LLM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `cos 2φ`. -/
theorem bx2LM : ∀ i, i < 180 → kindLM i = 2 → BxLM i = (0, 2, 0) ∧ 2 ≤ LLM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `sin 2φ`. -/
theorem bx3LM : ∀ i, i < 180 → kindLM i = 3 → BxLM i = (0, 2, 0) ∧ 2 ≤ LLM i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of the parameter. -/
theorem bx4LM : ∀ i, i < 180 → kindLM i = 4 →
    BxLM i = (NLM, MLM, DLM + 1) ∧ 2 ^ (SLM + 6) + 2 * 2 ^ (SLM - 1) ≤ LLM i := by
  kernel_fact

/-- The polynomial of `t`. -/
theorem PLM_k0 {i : ℕ} (h : kindLM i = 0) : PLM i = T3 SLM NLM MLM DLM := by
  unfold PLM; rw [h]; rfl
/-- The polynomial of `V`. -/
theorem PLM_k1 {i : ℕ} (h : kindLM i = 1) : PLM i = V3 := by unfold PLM; rw [h]; rfl
/-- The polynomial of `cos 2φ`. -/
theorem PLM_k2 {i : ℕ} (h : kindLM i = 2) : PLM i = C cPoly := by unfold PLM; rw [h]; rfl
/-- The polynomial of `sin 2φ`. -/
theorem PLM_k3 {i : ℕ} (h : kindLM i = 3) : PLM i = C sPoly := by unfold PLM; rw [h]; rfl
/-- The polynomial of the parameter. -/
theorem PLM_k4 {i : ℕ} (h : kindLM i = 4) : PLM i = Pr3 SLM NLM MLM DLM := by
  unfold PLM; rw [h]; rfl
/-- The polynomial of a dummy variable. -/
theorem PLM_k5 {i : ℕ} (h : kindLM i = 5) : PLM i = 0 := by unfold PLM; rw [h]; rfl

/-- The polynomial of a stored family. -/
theorem PLM_fam {i : ℕ} (h : kindLM i = 6) :
    PLM i = famPoly NLM MLM DLM (if oddLM i then -1 else 1) (c0LM i : ℤ) 0 0 0 (famLM i) := by
  unfold PLM; rw [h]; rfl

/-- The image of `t`. -/
theorem KvLM_k0 {b W R i : ℕ} (h : kindLM i = 0) : KvLM b W R i =
    ((1 <<< SLM : ℕ) : ℤ) * ((1 <<< (b * (NLM + W * (MLM + R * DLM))) : ℕ) : ℤ) := by
  unfold KvLM; rw [h]; rfl
/-- The image of `V`. -/
theorem KvLM_k1 {b W R i : ℕ} (h : kindLM i = 1) :
    KvLM b W R i = 2 * ((1 <<< (b * W) : ℕ) : ℤ) := by
  unfold KvLM; rw [h]; rfl
/-- The image of `cos 2φ`. -/
theorem KvLM_k2 {b W R i : ℕ} (h : kindLM i = 2) :
    KvLM b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) - 1 := by
  unfold KvLM; rw [h]; rfl
/-- The image of `sin 2φ`. -/
theorem KvLM_k3 {b W R i : ℕ} (h : kindLM i = 3) :
    KvLM b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) + 1 := by
  unfold KvLM; rw [h]; rfl
/-- The image of the parameter. -/
theorem KvLM_k4 {b W R i : ℕ} (h : kindLM i = 4) : KvLM b W R i =
    ((1 <<< (SLM + 6) : ℕ) : ℤ) * ((1 <<< (b * (NLM + W * (MLM + R * DLM))) : ℕ) : ℤ) +
      ((1 <<< (SLM - 1) : ℕ) : ℤ) * (((1 <<< (b * (NLM + W * (MLM + R * (DLM + 1)))) : ℕ) : ℤ) +
        ((1 <<< (b * (NLM + W * (MLM + R * (DLM - 1)))) : ℕ) : ℤ)) := by
  unfold KvLM; rw [h]; rfl
/-- The image of a dummy variable. -/
theorem KvLM_k5 {b W R i : ℕ} (h : kindLM i = 5) : KvLM b W R i = 0 := by unfold KvLM; rw [h]; rfl
/-- The image of a stored family (fast or generic). -/
theorem KvLM_k6 {b W R i : ℕ} (h : kindLM i = 6) : KvLM b W R i =
    if bMinLM i ≤ b ∧ wMinLM i ≤ W then
      ((famTB b W R NLM MLM DLM (c0LM i) (oddLM i) drLM dwLM (famLM i) : ℕ) : ℤ) -
        ((famO b W R NLM MLM DLM dwLM (famLM i) : ℕ) : ℤ)
    else famPack b W R NLM MLM DLM (if oddLM i then -1 else 1) (c0LM i : ℤ) 0 0 ddLM drLM 0
      (famLM i) := by
  unfold KvLM; rw [h]; rfl

/-- The kinds of a variable. -/
theorem kindsLM (i : ℕ) : kindLM i = 0 ∨ kindLM i = 1 ∨ kindLM i = 2 ∨ kindLM i = 3 ∨
    kindLM i = 4 ∨ kindLM i = 5 ∨ kindLM i = 6 := by
  have := kindLM_le i; omega

/-- **The Kronecker images of the variable polynomials.** -/
theorem kronLM (b W R i : ℕ) : kron b W (flat R (PLM i)) = KvLM b W R i := by
  rcases kindsLM i with h | h | h | h | h | h | h
  · rw [PLM_k0 h, KvLM_k0 h, kron_flat_T3, two_pow_eq_shift]
  · rw [PLM_k1 h, KvLM_k1 h]; exact kron_flat_V3 b W R
  · rw [PLM_k2 h, KvLM_k2 h, flat_C]; exact kron_cPoly b W
  · rw [PLM_k3 h, KvLM_k3 h, flat_C]; exact kron_sPoly b W
  · rw [PLM_k4 h, KvLM_k4 h]; exact kron_flat_Pr3 SLM NLM MLM DLM b W R
  · rw [PLM_k5 h, KvLM_k5 h]; simp
  · have hi := lt_of_kindLM h
    rw [PLM_fam h, KvLM_k6 h]
    by_cases hw : bMinLM i ≤ b ∧ wMinLM i ≤ W
    · rw [ite_eq_left hw]
      exact kron_famTB (staticLM i hi h) ((dynLM i hi h).mono hw.1 hw.2) (oddLM i) R
    · rw [ite_eq_right hw]
      exact (famPack_eq b W R NLM MLM DLM _ _ 0 0 0 (famLM i)
        fun sd hsd => ((staticLM i hi h).2.2.2 sd hsd).1).symm

/-- **Degree boxes** of the variable polynomials. -/
theorem boxLM (i : ℕ) : InBox3 (PLM i) (BxLM i).1 (BxLM i).2.1 (BxLM i).2.2 := by
  by_cases hi : i < 180
  · rcases kindsLM i with h | h | h | h | h | h | h
    · rw [PLM_k0 h, (bx0LM i hi h).1]; exact inBox3_T3 SLM NLM MLM DLM
    · rw [PLM_k1 h, (bx1LM i hi h).1]; exact inBox3_V3
    · rw [PLM_k2 h, (bx2LM i hi h).1]; exact InBox3.C box_cPoly
    · rw [PLM_k3 h, (bx3LM i hi h).1]; exact InBox3.C box_sPoly
    · rw [PLM_k4 h, (bx4LM i hi h).1]; exact inBox3_Pr3 SLM NLM MLM DLM
    · rw [PLM_k5 h]; exact inBox3_zero _ _ _
    · rw [PLM_fam h, bx6LM i hi h]
      exact inBox3_famPoly _ _ _ _ _ _ _ 0 _ (by have := (staticLM i hi h).2.1; omega)
  · rw [PLM_k5 (kindLM_ge (by omega))]
    exact inBox3_zero _ _ _

/-- **Static `ℓ¹` bounds** of the flattened variable polynomials. -/
theorem l1LM (R i : ℕ) : l1 (flat R (PLM i)) ≤ LLM i := by
  by_cases hi : i < 180
  · rcases kindsLM i with h | h | h | h | h | h | h
    · rw [PLM_k0 h]; exact (l1_flat_T3 SLM NLM MLM DLM R).trans (bx0LM i hi h).2
    · rw [PLM_k1 h]; exact (l1_flat_V3 R).trans (bx1LM i hi h).2
    · rw [PLM_k2 h, flat_C]; exact l1_cPoly.trans (bx2LM i hi h).2
    · rw [PLM_k3 h, flat_C]; exact l1_sPoly.trans (bx3LM i hi h).2
    · rw [PLM_k4 h]; exact (l1_flat_Pr3 SLM NLM MLM DLM R).trans (bx4LM i hi h).2
    · rw [PLM_k5 h]; simp [l1, liftN]
    · rw [PLM_fam h]
      refine (l1_flat_famPoly_le R NLM MLM DLM (by split_ifs <;> simp) _ 0 0 0 (famLM i)
        fun sd hsd => ((staticLM i hi h).2.2.2 sd hsd).1.2.2.2.2).trans (l1famLM i hi h)
  · rw [PLM_k5 (kindLM_ge (by omega))]
    simp [l1, liftN]

/-- The phases are below `4`. -/
theorem hWLM : ∀ i, (WtLM i).2.2 < 4 :=
  getD_prop (Pr := fun w : ℕ × ℕ × ℕ => w.2.2 < 4) (by kernel_fact) (by kernel_fact)

/-- **The family centres** at the parameter `w = c`. -/
def xLM (c : ℂ) (i : ℕ) : FA := ctr3 SLM NLM MLM DLM c (WtLM i) (PLM i)

/-- The centre of a stored family. -/
theorem xLM_fam {c : ℂ} (hc : c ≠ 0) {i : ℕ} (h : kindLM i = 6) {p : ℕ}
    (hp : WtLM i = (1, 0, p)) :
    xLM c i = famCtr SLM NLM MLM p (if oddLM i then -1 else 1) (c0LM i : ℤ) 0 0 c 0
      (famLM i) := by
  have hi := lt_of_kindLM h
  rw [xLM, hp, PLM_fam h]
  exact ctr3_famPoly _ _ _ _ _ _ _ _ _ hc 0 _ (by have := (staticLM i hi h).2.1; omega)

/-- The centre of `t` is `1`. -/
theorem xLM_t {c : ℂ} (hc : c ≠ 0) : xLM c 0 = 1 := by
  rw [xLM, show WtLM 0 = (1, 0, 0) from rfl, show PLM 0 = T3 SLM NLM MLM DLM from rfl]
  exact ctr3_T3 _ _ _ _ hc

/-- The centre of `V` is `1`. -/
theorem xLM_V (c : ℂ) : xLM c 1 = 1 := by
  rw [xLM, show WtLM 1 = (0, 1, 0) from rfl, show PLM 1 = V3 from rfl]
  exact ctr3_V3 _ _ _ _ c

/-- The centre of `cos 2φ`. -/
theorem xLM_c (c : ℂ) : xLM c 2 = ctr SLM NLM MLM (0, 1, 3) cPoly := by
  rw [xLM, show WtLM 2 = (0, 1, 3) from rfl, show PLM 2 = C cPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 3 cPoly

/-- The centre of `sin 2φ`. -/
theorem xLM_s (c : ℂ) : xLM c 3 = ctr SLM NLM MLM (0, 1, 0) sPoly := by
  rw [xLM, show WtLM 3 = (0, 1, 0) from rfl, show PLM 3 = C sPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 0 sPoly

/-- The centre of the parameter `r` is `64 + (c + c⁻¹)/2`. -/
theorem xLM_r {c : ℂ} (hc : c ≠ 0) : xLM c 114 = algebraMap ℂ FA (64 + (c + c⁻¹) / 2) := by
  rw [xLM, show WtLM 114 = (1, 0, 0) from rfl, show PLM 114 = Pr3 SLM NLM MLM DLM from rfl]
  exact ctr3_Pr3 _ _ _ _ (by kernel_fact) (by kernel_fact) hc

/-- The centres of the variables of kind `5` (dummies) vanish. -/
theorem xLM_zero (c : ℂ) {i : ℕ} (h : kindLM i = 5) : xLM c i = 0 := by
  rw [xLM, PLM_k5 h]
  simp [ctr3]

