/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH35`)

The checks of `Design/RationalStellaratorGCMu4CheckH35` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nRp`. -/
theorem cHMS_nRp : center3KS KvSHM NHM MHM 30 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRp`. -/
theorem clHM_nRp : LHM 30 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `E4P`. -/
theorem cHMS_E4P : center3KS KvSHM NHM MHM 76 108 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `E4P`. -/
theorem clHM_E4P : LHM 76 < 2 ^ (108 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `A1`: truncation norm. -/
theorem kHMS_A1 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_A1 (1 : Int) 1 0 60 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `A1`: a priori `ℓ¹` bound. -/
theorem lHM_A1 : nodeL1N SHM LHM trHMN_A1 (1 : Int) 1 0 60 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
