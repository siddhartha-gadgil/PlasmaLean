/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCFamCheckH11`)

The checks of `Design/RationalStellaratorGCFamCheckH11` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHF`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCFamLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m03`: truncation norm. -/
theorem kHFS_m03 : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_m03 (1 : Int) 1 0 17 232 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m03`: a priori `ℓ¹` bound. -/
theorem lHF_m03 : nodeL1N SHF LHF trHFN_m03 (1 : Int) 1 0 17 < 2 ^ (232 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `RDu`: truncation norm. -/
theorem kHFS_RDu : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_RDu (1 : Int) 1 0 43 240 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `RDu`: a priori `ℓ¹` bound. -/
theorem lHF_RDu : nodeL1N SHF LHF trHFN_RDu (1 : Int) 1 0 43 < 2 ^ (240 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `R2`: truncation norm. -/
theorem kHFS_R2 : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_R2 (1 : Int) 1 0 58 236 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R2`: a priori `ℓ¹` bound. -/
