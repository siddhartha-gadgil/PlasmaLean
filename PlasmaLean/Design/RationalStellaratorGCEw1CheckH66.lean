module

public import PlasmaLean.Design.RationalStellaratorGCEw1TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 66)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw1DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 1: gyro-length `ρ_1 = 1/256 − 2⁻³²`, its own family torus `K_1(λ)`; the
fields at `ρ_1` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `PP4`. -/
theorem cHE1_PP4 : center3KN KvHE1 NHE1 MHE1 77 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `PP4`. -/
theorem clHE1_PP4 : LHE1 77 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `nRp`: truncation norm. -/
theorem kHE1_nRp : node3KN SHE1 NHE1 MHE1 DHE1 WtHE1 KvHE1 trHE1N_nRp (8 : Int) 0 1 30 124 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nRp`: a priori `ℓ¹` bound. -/
theorem lHE1_nRp : nodeL1N SHE1 LHE1 trHE1N_nRp (8 : Int) 0 1 30 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `DphP`: truncation norm. -/
theorem kHE1_DphP : node3KN SHE1 NHE1 MHE1 DHE1 WtHE1 KvHE1 trHE1N_DphP (4 : Int) 0 1 34 121 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `DphP`: a priori `ℓ¹` bound. -/
theorem lHE1_DphP : nodeL1N SHE1 LHE1 trHE1N_DphP (4 : Int) 0 1 34 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `nRuP`: truncation norm. -/
theorem kHE1_nRuP : node3KN SHE1 NHE1 MHE1 DHE1 WtHE1 KvHE1 trHE1N_nRuP (8 : Int) 0 1 35 126 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nRuP`: a priori `ℓ¹` bound. -/
theorem lHE1_nRuP : nodeL1N SHE1 LHE1 trHE1N_nRuP (8 : Int) 0 1 35 < 2 ^ (126 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `Nm1`. -/
theorem kHE1_Nm1 : norm3KN WtHE1 KvHE1 NHE1 MHE1 trHE1N_Nm1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `Nm1`: a priori `ℓ¹` bound. -/
theorem lHE1_Nm1 : ExN.majN LHE1 trHE1N_Nm1 < 2 ^ (123 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
