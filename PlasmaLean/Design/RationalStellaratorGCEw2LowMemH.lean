/-!
# The low-memory kernel checks prove the original checks (`Design/RationalStellaratorGCEw2CheckH*`)

* `KvSHE2_toInt`: the signed images `KvSHE2` are the Kronecker images `KvHE2` (`famS_toInt`);
* every check theorem of `Design/RationalStellaratorGCEw2CheckH*`, with its original name and
  statement, proved from its low-memory version by `node3KN_le_of_S`, `norm3KN_le_of_S` or
  `center3KN_le_of_S`.

No heavy kernel evaluation (only degree conditions). Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed images are the Kronecker images.** -/
theorem KvSHE2_toInt (b W R i : ℕ) : (KvSHE2 b W R i).toInt = KvHE2 b W R i := by
  unfold KvSHE2
  split_ifs with h
  · obtain ⟨hk, hb, hw⟩ := h
    have hi := lt_of_kindHE2 hk
    rw [KvHE2_k6 hk, ite_eq_left ⟨hb, hw⟩,
      famS_toInt (staticHE2 i hi hk) ((dynHE2 i hi hk).mono hb hw)]
  · exact SInt.toInt_ofInt _

