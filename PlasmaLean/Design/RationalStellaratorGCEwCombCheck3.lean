module

public import PlasmaLean.Design.RationalStellaratorGCEwCombEnv

/-!
# Kernel checks of the energy-window combinations (part 3)

Each theorem is one kernel evaluation (`decide +kernel`) of the weighted digit sum `norm3KN` of the
Kronecker image of an integer combination of node tori (`Design/RationalStellaratorGCEwCombEnv`).
Light module. Generated by `scripts/gc_kam/ew_comb.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C2U`. -/
theorem kEw_C2U : norm3KN WtEw KvEw 36 27 trEwC_C2U (1, 0, 0) 128 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C2U`. -/
theorem lEw_C2U : ExN.majN LEw trEwC_C2U < 2 ^ (128 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C0LRx`. -/
theorem kEw_C0LRx : norm3KN WtEw KvEw 36 27 trEwC_C0LRx (1, 0, 3) 224 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C0LRx`. -/
theorem lEw_C0LRx : ExN.majN LEw trEwC_C0LRx < 2 ^ (224 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C0thU`. -/
theorem kEw_C0thU : norm3KN WtEw KvEw 36 27 trEwC_C0thU (1, 0, 3) 129 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C0thU`. -/
theorem lEw_C0thU : ExN.majN LEw trEwC_C0thU < 2 ^ (129 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C3thZ`. -/
theorem kEw_C3thZ : norm3KN WtEw KvEw 36 27 trEwC_C3thZ (1, 0, 0) 132 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C3thZ`. -/
theorem lEw_C3thZ : ExN.majN LEw trEwC_C3thZ < 2 ^ (132 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
