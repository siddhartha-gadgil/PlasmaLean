/-!
# Honest values of the nesting chain

The value `XN i` of each variable of the nesting chain at the surrogates: the Adm values `XA i` for
`i < 195` (`XN_lt`), the centres for the new data, and for every node exactly the evaluation of its
expression tree (`relN_*`: `X n = eval X e`). Generated by `scripts/dommaschk_kam/emit_nest.py`.
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- The honest value of the node `RC`. -/
def RCn : FA :=
  ((xN 195 * xN 199) + (xN 196 * xN 200))

set_option linter.style.longLine false in
/-- The honest value of the node `RA`. -/
def RAn : FA :=
  ((xN 197 * xN 199) + (xN 198 * xN 200))

set_option linter.style.longLine false in
/-- The honest value of the node `XXC`. -/
def XXCn : FA :=
  (xN 195 * xN 195)

set_option linter.style.longLine false in
/-- The honest value of the node `XYC`. -/
def XYCn : FA :=
  (xN 195 * xN 196)

set_option linter.style.longLine false in
/-- The honest value of the node `YYC`. -/
def YYCn : FA :=
  (xN 196 * xN 196)

set_option linter.style.longLine false in
/-- The honest value of the node `XXA`. -/
def XXAn : FA :=
  (xN 197 * xN 197)

set_option linter.style.longLine false in
/-- The honest value of the node `XYA`. -/
def XYAn : FA :=
  (xN 197 * xN 198)

set_option linter.style.longLine false in
/-- The honest value of the node `YYA`. -/
def YYAn : FA :=
  (xN 198 * xN 198)

set_option linter.style.longLine false in
/-- The honest value of the node `FC`. -/
def FCn : FA :=
  ((XA 0 * XA 0) - (((xN 201 * XXCn) + (((2 : ℤ) : FA) * (xN 202 * XYCn))) + (xN 203 * YYCn)))

set_option linter.style.longLine false in
/-- The honest value of the node `FA`. -/
def FAn : FA :=
  ((((xN 201 * XXAn) + (((2 : ℤ) : FA) * (xN 202 * XYAn))) + (xN 203 * YYAn)) - (XA 0 * XA 0))

set_option linter.style.longLine false in
/-- The honest value of the node `sRC`. -/
def sRCn : FA :=
  (xN 214 * xN 214)

set_option linter.style.longLine false in
/-- The honest value of the node `sRA`. -/
def sRAn : FA :=
  (xN 215 * xN 215)

set_option linter.style.longLine false in
/-- The honest value of the node `sFC`. -/
def sFCn : FA :=
  (xN 216 * xN 216)

set_option linter.style.longLine false in
/-- The honest value of the node `sFA`. -/
def sFAn : FA :=
  (xN 217 * xN 217)

/-- The honest values of the variables (list): the Adm values, then the new ones. -/
def XNl : List FA := XAl ++
  [xN 195, xN 196, xN 197, xN 198, xN 199, xN 200, xN 201, xN 202, xN 203, RCn, RAn, XXCn, XYCn,
    YYCn, XXAn, XYAn, YYAn, FCn, FAn, xN 214, xN 215, xN 216, xN 217, sRCn, sRAn, sFCn, sFAn]

/-- The honest values of the variables. -/
def XN (i : ℕ) : FA := XNl.getD i 0

/-- **The Adm values are kept.** -/
theorem XN_lt {i : ℕ} (h : i < 195) : XN i = XA i := by
  unfold XN XNl XA
  rw [List.getD_append _ _ _ _ (by rw [show XAl.length = 195 by rfl]; exact h)]

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- The identity of the node `RC`. -/
theorem relN_RC : ((1 : ℤ) : ℂ) • XN 204 = Ex.eval XN trN_RC := by
  rw [Int.cast_one, one_smul]
  rfl

