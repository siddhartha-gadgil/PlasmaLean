set_option maxRecDepth 100000 in
/-- Kernel check of the node `R8`: truncation norm. -/
theorem kHE2_R8 : node3KN SHE2 NHE2 MHE2 DHE2 WtHE2 KvHE2 trHE2N_R8 (1 : Int) 1 0 74 242 145 109 49 13 8 19 72 54 ≤
