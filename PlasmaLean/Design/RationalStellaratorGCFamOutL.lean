/-- The full chain. -/
theorem ballLF_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) {u z : FA}
    (hU : Bd r (u - xLF c 4) (ELF 4)) (hZ : Bd r (z - xLF c 5) (ELF 5))
    (hA : Bd r (dTh u - xLF c 6) (ELF 6)) (hB : Bd r (dTh z - xLF c 7) (ELF 7)) :
    ∀ i, i < 142 → Bd r (XLF c u z i - xLF c i) (ELF i) :=
  ballLF_142 hr hq hc hU hZ hA hB

/-- A value is bounded by its centre norm plus its radius. -/
theorem valLF_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) {u z : FA}
    (hU : Bd r (u - xLF c 4) (ELF 4)) (hZ : Bd r (z - xLF c 5) (ELF 5))
    (hA : Bd r (dTh u - xLF c 6) (ELF 6)) (hB : Bd r (dTh z - xLF c 7) (ELF 7))
    (i : ℕ) (hi : i < 142) :
    Bd r (XLF c u z i) ((BLF i + ELF i : ℚ) : ℝ) := by
  have := (normLF hq hc i hi).add (ballLF_all hr hq hc hU hZ hA hB i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

