/-- The empty chain. -/
theorem ballH_0 {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) :
    ∀ i, i < 0 → Bd r (XH i - xH i) (EH i) :=
