/-!
# The low-memory kernel checks prove the original checks (`Design/RationalStellaratorGCFamCheckH*`)

* `KvSHF_toInt`: the signed images `KvSHF` are the Kronecker images `KvHF` (`famS_toInt`);
* every check theorem of `Design/RationalStellaratorGCFamCheckH*`, with its original name and
  statement, proved from its low-memory version by `node3KN_le_of_S`, `norm3KN_le_of_S` or
  `center3KN_le_of_S`.

No heavy kernel evaluation (only degree conditions). Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

-- kernel_fact side conditions: elaboration budget for the proof terms

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed images are the Kronecker images.** -/
theorem KvSHF_toInt (b W R i : ℕ) : (KvSHF b W R i).toInt = KvHF b W R i := by
  unfold KvSHF
  split_ifs with h
  · obtain ⟨hk, hb, hw⟩ := h
    have hi := lt_of_kindHF hk
    rw [KvHF_k6 hk, ite_eq_left ⟨hb, hw⟩,
      famS_toInt (staticHF i hi hk) ((dynHF i hi hk).mono hb hw)]
  · exact SInt.toInt_ofInt _

