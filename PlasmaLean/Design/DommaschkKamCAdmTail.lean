    Bd r (ctr Sc Nc Mc (1, 0, 0) (gridPolyNM Nc Mc dGU)) (((117 / 125000000000000 : ℚ) : ℚ) : ℝ) := by
  have hl1 : l1 (gridPolyNM Nc Mc dGU) < 2 ^ (143 - 1) :=
    (l1_gridPolyNM_le_const Nc Mc (C := 2 ^ Fc + 2 ^ 64 * 2 ^ 60) fun i j _ _ => abs_dGU i j).trans_lt (by kernel_fact)
  have h := Bd_ctr_kronw (S := Sc) (N := Nc) (M := Mc) (w := (1, 0, 0)) (a := 2 * Nc) (J := 2 * Mc) (W := 193) (b := 143) (dc := 8) (dr := 8) (Ki := Nc) (Kj := Mc) (K := ) hq (by norm_num) (box_gridPolyNM Nc Mc _) (by norm_num [Nc]) (by norm_num) (by norm_num [Mc]) hl1 (kron_gridPolyNM _ _ _ _ _) tk_U
  exact h.le (by exact_mod_cast (show (( : ℕ) : ℚ) / 2 ^ (16 * (Nc + Mc)) / 2 ^ (Sc * 1 + 0) ≤ (117 / 125000000000000 : ℚ) by kernel_fact))

