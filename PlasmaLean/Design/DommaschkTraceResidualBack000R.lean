theorem dnR_range {t y : ℝ} (ht : |t| ≤ 1) (h : dnR0.Mem t y) :
    (-1448964269814081816 : ℝ) / 2^80 ≤ y ∧ y ≤ (1148960511318632161552 : ℝ) / 2^80 := by
  have hr := dyadic_range ht (show (ofDyadic 80 [573755773524409039868, 574238828533191891286, 724448688462416241, 241259864958892544, -167254390664831, -33431646117410, 9709773195, 1291199337] (10572166840)).Mem t y from h)
  have mass : (magnitude
      ([574238828533191891286, 724448688462416241, 241259864958892544, -167254390664831, -33431646117410, 9709773195, 1291199337].map fun (z : ℤ) => (z : ℚ))) = 575204737783650954844 :=
    eq_of_beq (by kernel_fact)
  rw [mass, abs_le] at hr
  norm_num at hr ⊢
  constructor <;> linarith

