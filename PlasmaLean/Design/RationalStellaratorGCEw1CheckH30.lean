/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw1CheckH30`)

The checks of `Design/RationalStellaratorGCEw1CheckH30` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE1`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw1LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `RD`. -/
theorem cHE1S_RD : center3KS KvSHE1 NHE1 MHE1 42 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `RD`. -/
theorem clHE1_RD : LHE1 42 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `r`. -/
theorem cHE1S_r : center3KS KvSHE1 NHE1 MHE1 71 129 37 28 14 9 8 5 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `r`. -/
theorem clHE1_r : LHE1 71 < 2 ^ (129 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `RDu`: truncation norm. -/
theorem kHE1S_RDu : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_RDu (1 : Int) 1 0 43 240 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `RDu`: a priori `ℓ¹` bound. -/
theorem lHE1_RDu : nodeL1N SHE1 LHE1 trHE1N_RDu (1 : Int) 1 0 43 < 2 ^ (240 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
