module

public import PlasmaLean.Design.DommaschkKamAResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAResTrees

/-!
# Proof-term checks of the torus-A residual chain (part 12)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamAResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_F7`, `kH_Fc6`, `kH_F6`, `kH_Fc5`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `F7`: truncation norm. -/
theorem kH_F7 : nodeKw 68553 16 SH NH MH WtH KvH trH_F7 (1 : ℤ) 1 0 51 271 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `F7`: a priori `ℓ¹` bound. -/
theorem lH_F7 : nodeL1 SH LH trH_F7 (1 : ℤ) 1 0 51 < 2 ^ (271 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc6`: truncation norm. -/
theorem kH_Fc6 : nodeKw 68553 16 SH NH MH WtH KvH trH_Fc6 (230400000000000 : ℤ) 0 3 52 194 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc6`: a priori `ℓ¹` bound. -/
theorem lH_Fc6 : nodeL1 SH LH trH_Fc6 (230400000000000 : ℤ) 0 3 52 < 2 ^ (194 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `F6`: truncation norm. -/
theorem kH_F6 : nodeKw 68553 16 SH NH MH WtH KvH trH_F6 (1 : ℤ) 1 0 53 277 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `F6`: a priori `ℓ¹` bound. -/
theorem lH_F6 : nodeL1 SH LH trH_F6 (1 : ℤ) 1 0 53 < 2 ^ (277 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc5`: truncation norm. -/
theorem kH_Fc5 : nodeKw 68553 16 SH NH MH WtH KvH trH_Fc5 (7680000000000 : ℤ) 0 3 54 188 193 8 8 165 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc5`: a priori `ℓ¹` bound. -/
theorem lH_Fc5 : nodeL1 SH LH trH_Fc5 (7680000000000 : ℤ) 0 3 54 < 2 ^ (188 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamA
