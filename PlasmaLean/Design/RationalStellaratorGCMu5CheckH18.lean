module

public import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu5CheckH18`)

The checks of `Design/RationalStellaratorGCMu5CheckH18` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu5LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `thZe`. -/
theorem cHMS_thZe : center3KS KvSHM NHM MHM 13 125 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thZe`. -/
theorem clHM_thZe : LHM 13 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `W`. -/
theorem cHMS_W : center3KS KvSHM NHM MHM 55 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `W`. -/
theorem clHM_W : LHM 55 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m13`: truncation norm. -/
theorem kHMS_m13 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m13 (1 : Int) 1 0 21 228 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m13`: a priori `ℓ¹` bound. -/
theorem lHM_m13 : nodeL1N SHM LHM trHMN_m13 (1 : Int) 1 0 21 < 2 ^ (228 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu5
