/-!
# The high-resolution environment of the `μ > 0` passing guiding-centre torus family certificate

The variable polynomials `PHE4 i` (three variables: `θ`-, `ψ`-modes and the Chebyshev variable
`w`), their degree boxes (`boxHE4`), static `ℓ¹` bounds (`l1HE4`) and Kronecker images (`kronHE4`);
the family centres `xHE4 c i` at the parameter `w = c`; the norm bounds `BHE4 i` of the centres and
the radii `EHE4 i` of the balls (supplied by the oracle, checked in
`Design/RationalStellaratorGCEw4CheckH*`).
Generated by `scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 4: gyro-length `ρ_4 = 1/256 + 2⁻³²`, its own family torus `K_4(λ)`; the
fields at `ρ_4` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section
noncomputable section

set_option linter.style.longLine false

namespace PlasmaLean.Design.RationalStellaratorGC

open Polynomial PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall PlasmaLean.Certificates.KronBallCheb PlasmaLean.Theory.KAM

/-- **The variable polynomials** of the family pipeline (by kind, `kindHE4`). -/
def PHE4 (i : ℕ) : P3 :=
  match kindHE4 i with
  | 0 => T3 SHE4 NHE4 MHE4 DHE4
  | 1 => V3
  | 2 => C cPoly
  | 3 => C sPoly
  | 4 => Pr3 SHE4 NHE4 MHE4 DHE4
  | 5 => 0
  | _ => famPoly NHE4 MHE4 DHE4 (if oddHE4 i then -1 else 1) (c0HE4 i : ℤ) 0 0 0 (famHE4 i)

/-- The kinds are at most `6`. -/
theorem kindHE4_le (i : ℕ) : kindHE4 i ≤ 6 :=
  getD_prop (Pr := fun k : ℕ => k ≤ 6) (by kernel_fact) (by kernel_fact) i

set_option maxRecDepth 100000 in
/-- The variables beyond the last have kind `5` (zero). -/
theorem kindHE4_ge {i : ℕ} (h : 99 ≤ i) : kindHE4 i = 5 := by
  unfold kindHE4
  rw [List.getD_eq_getElem?_getD,
    List.getElem?_eq_none ((by kernel_fact : kindHE4l.length = 99).trans_le h)]
  rfl

/-- Stored families are below the last variable. -/
theorem lt_of_kindHE4 {i : ℕ} (h : kindHE4 i = 6) : i < 99 := by
  by_contra h'
  rw [kindHE4_ge (by omega)] at h
  exact absurd h (by kernel_fact)

set_option maxRecDepth 100000 in
/-- The static conditions of the stored families. -/
theorem staticHE4 : ∀ i, i < 99 → kindHE4 i = 6 →
    FamStatic NHE4 MHE4 DHE4 ddHE4 drHE4 dwHE4 (famHE4 i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The minimal widths of the fast images. -/
theorem dynHE4 : ∀ i, i < 99 → kindHE4 i = 6 →
    FamDyn (bMinHE4 i) (wMinHE4 i) (c0HE4 i) (famHE4 i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The static `ℓ¹` bounds of the stored families. -/
theorem l1famHE4 : ∀ i, i < 99 → kindHE4 i = 6 →
    famL1 NHE4 MHE4 (c0HE4 i : ℤ) 0 0 0 (famHE4 i) ≤ LHE4 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree boxes of the stored families. -/
theorem bx6HE4 : ∀ i, i < 99 → kindHE4 i = 6 → BxHE4 i = (2 * NHE4, 2 * MHE4, 2 * DHE4) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `t`. -/
theorem bx0HE4 : ∀ i, i < 99 → kindHE4 i = 0 → BxHE4 i = (NHE4, MHE4, DHE4) ∧ 2 ^ SHE4 ≤ LHE4 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `V`. -/
theorem bx1HE4 : ∀ i, i < 99 → kindHE4 i = 1 → BxHE4 i = (0, 1, 0) ∧ 2 ≤ LHE4 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `cos 2φ`. -/
theorem bx2HE4 : ∀ i, i < 99 → kindHE4 i = 2 → BxHE4 i = (0, 2, 0) ∧ 2 ≤ LHE4 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `sin 2φ`. -/
theorem bx3HE4 : ∀ i, i < 99 → kindHE4 i = 3 → BxHE4 i = (0, 2, 0) ∧ 2 ≤ LHE4 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of the parameter. -/
theorem bx4HE4 : ∀ i, i < 99 → kindHE4 i = 4 →
    BxHE4 i = (NHE4, MHE4, DHE4 + 1) ∧ 2 ^ (SHE4 + 6) + 2 * 2 ^ (SHE4 - 1) ≤ LHE4 i := by
  kernel_fact

/-- The polynomial of `t`. -/
theorem PHE4_k0 {i : ℕ} (h : kindHE4 i = 0) : PHE4 i = T3 SHE4 NHE4 MHE4 DHE4 := by
  unfold PHE4; rw [h]; rfl
/-- The polynomial of `V`. -/
theorem PHE4_k1 {i : ℕ} (h : kindHE4 i = 1) : PHE4 i = V3 := by unfold PHE4; rw [h]; rfl
/-- The polynomial of `cos 2φ`. -/
theorem PHE4_k2 {i : ℕ} (h : kindHE4 i = 2) : PHE4 i = C cPoly := by unfold PHE4; rw [h]; rfl
/-- The polynomial of `sin 2φ`. -/
theorem PHE4_k3 {i : ℕ} (h : kindHE4 i = 3) : PHE4 i = C sPoly := by unfold PHE4; rw [h]; rfl
/-- The polynomial of the parameter. -/
theorem PHE4_k4 {i : ℕ} (h : kindHE4 i = 4) : PHE4 i = Pr3 SHE4 NHE4 MHE4 DHE4 := by
  unfold PHE4; rw [h]; rfl
/-- The polynomial of a dummy variable. -/
theorem PHE4_k5 {i : ℕ} (h : kindHE4 i = 5) : PHE4 i = 0 := by unfold PHE4; rw [h]; rfl

/-- The polynomial of a stored family. -/
theorem PHE4_fam {i : ℕ} (h : kindHE4 i = 6) :
    PHE4 i = famPoly NHE4 MHE4 DHE4 (if oddHE4 i then -1 else 1) (c0HE4 i : ℤ) 0 0 0 (famHE4 i) := by
  unfold PHE4; rw [h]; rfl

/-- The image of `t`. -/
theorem KvHE4_k0 {b W R i : ℕ} (h : kindHE4 i = 0) : KvHE4 b W R i =
    ((1 <<< SHE4 : ℕ) : ℤ) * ((1 <<< (b * (NHE4 + W * (MHE4 + R * DHE4))) : ℕ) : ℤ) := by
  unfold KvHE4; rw [h]; rfl
/-- The image of `V`. -/
theorem KvHE4_k1 {b W R i : ℕ} (h : kindHE4 i = 1) :
    KvHE4 b W R i = 2 * ((1 <<< (b * W) : ℕ) : ℤ) := by
  unfold KvHE4; rw [h]; rfl
/-- The image of `cos 2φ`. -/
theorem KvHE4_k2 {b W R i : ℕ} (h : kindHE4 i = 2) :
    KvHE4 b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) - 1 := by
  unfold KvHE4; rw [h]; rfl
/-- The image of `sin 2φ`. -/
theorem KvHE4_k3 {b W R i : ℕ} (h : kindHE4 i = 3) :
    KvHE4 b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) + 1 := by
  unfold KvHE4; rw [h]; rfl
/-- The image of the parameter. -/
theorem KvHE4_k4 {b W R i : ℕ} (h : kindHE4 i = 4) : KvHE4 b W R i =
    ((1 <<< (SHE4 + 6) : ℕ) : ℤ) * ((1 <<< (b * (NHE4 + W * (MHE4 + R * DHE4))) : ℕ) : ℤ) +
      ((1 <<< (SHE4 - 1) : ℕ) : ℤ) * (((1 <<< (b * (NHE4 + W * (MHE4 + R * (DHE4 + 1)))) : ℕ) : ℤ) +
        ((1 <<< (b * (NHE4 + W * (MHE4 + R * (DHE4 - 1)))) : ℕ) : ℤ)) := by
  unfold KvHE4; rw [h]; rfl
/-- The image of a dummy variable. -/
theorem KvHE4_k5 {b W R i : ℕ} (h : kindHE4 i = 5) : KvHE4 b W R i = 0 := by unfold KvHE4; rw [h]; rfl
/-- The image of a stored family (fast or generic). -/
theorem KvHE4_k6 {b W R i : ℕ} (h : kindHE4 i = 6) : KvHE4 b W R i =
    if bMinHE4 i ≤ b ∧ wMinHE4 i ≤ W then
      ((famTB b W R NHE4 MHE4 DHE4 (c0HE4 i) (oddHE4 i) drHE4 dwHE4 (famHE4 i) : ℕ) : ℤ) -
        ((famO b W R NHE4 MHE4 DHE4 dwHE4 (famHE4 i) : ℕ) : ℤ)
    else famPack b W R NHE4 MHE4 DHE4 (if oddHE4 i then -1 else 1) (c0HE4 i : ℤ) 0 0 ddHE4 drHE4 0
      (famHE4 i) := by
  unfold KvHE4; rw [h]; rfl

/-- The kinds of a variable. -/
theorem kindsHE4 (i : ℕ) : kindHE4 i = 0 ∨ kindHE4 i = 1 ∨ kindHE4 i = 2 ∨ kindHE4 i = 3 ∨
    kindHE4 i = 4 ∨ kindHE4 i = 5 ∨ kindHE4 i = 6 := by
  have := kindHE4_le i; omega

/-- **The Kronecker images of the variable polynomials.** -/
theorem kronHE4 (b W R i : ℕ) : kron b W (flat R (PHE4 i)) = KvHE4 b W R i := by
  rcases kindsHE4 i with h | h | h | h | h | h | h
  · rw [PHE4_k0 h, KvHE4_k0 h, kron_flat_T3, two_pow_eq_shift]
  · rw [PHE4_k1 h, KvHE4_k1 h]; exact kron_flat_V3 b W R
  · rw [PHE4_k2 h, KvHE4_k2 h, flat_C]; exact kron_cPoly b W
  · rw [PHE4_k3 h, KvHE4_k3 h, flat_C]; exact kron_sPoly b W
  · rw [PHE4_k4 h, KvHE4_k4 h]; exact kron_flat_Pr3 SHE4 NHE4 MHE4 DHE4 b W R
  · rw [PHE4_k5 h, KvHE4_k5 h]; simp
  · have hi := lt_of_kindHE4 h
    rw [PHE4_fam h, KvHE4_k6 h]
    by_cases hw : bMinHE4 i ≤ b ∧ wMinHE4 i ≤ W
    · rw [ite_eq_left hw]
      exact kron_famTB (staticHE4 i hi h) ((dynHE4 i hi h).mono hw.1 hw.2) (oddHE4 i) R
    · rw [ite_eq_right hw]
      exact (famPack_eq b W R NHE4 MHE4 DHE4 _ _ 0 0 0 (famHE4 i)
        fun sd hsd => ((staticHE4 i hi h).2.2.2 sd hsd).1).symm

/-- **Degree boxes** of the variable polynomials. -/
theorem boxHE4 (i : ℕ) : InBox3 (PHE4 i) (BxHE4 i).1 (BxHE4 i).2.1 (BxHE4 i).2.2 := by
  by_cases hi : i < 99
  · rcases kindsHE4 i with h | h | h | h | h | h | h
    · rw [PHE4_k0 h, (bx0HE4 i hi h).1]; exact inBox3_T3 SHE4 NHE4 MHE4 DHE4
    · rw [PHE4_k1 h, (bx1HE4 i hi h).1]; exact inBox3_V3
    · rw [PHE4_k2 h, (bx2HE4 i hi h).1]; exact InBox3.C box_cPoly
    · rw [PHE4_k3 h, (bx3HE4 i hi h).1]; exact InBox3.C box_sPoly
    · rw [PHE4_k4 h, (bx4HE4 i hi h).1]; exact inBox3_Pr3 SHE4 NHE4 MHE4 DHE4
    · rw [PHE4_k5 h]; exact inBox3_zero _ _ _
    · rw [PHE4_fam h, bx6HE4 i hi h]
      exact inBox3_famPoly _ _ _ _ _ _ _ 0 _ (by have := (staticHE4 i hi h).2.1; omega)
  · rw [PHE4_k5 (kindHE4_ge (by omega))]
    exact inBox3_zero _ _ _

/-- **Static `ℓ¹` bounds** of the flattened variable polynomials. -/
theorem l1HE4 (R i : ℕ) : l1 (flat R (PHE4 i)) ≤ LHE4 i := by
  by_cases hi : i < 99
  · rcases kindsHE4 i with h | h | h | h | h | h | h
    · rw [PHE4_k0 h]; exact (l1_flat_T3 SHE4 NHE4 MHE4 DHE4 R).trans (bx0HE4 i hi h).2
    · rw [PHE4_k1 h]; exact (l1_flat_V3 R).trans (bx1HE4 i hi h).2
    · rw [PHE4_k2 h, flat_C]; exact l1_cPoly.trans (bx2HE4 i hi h).2
    · rw [PHE4_k3 h, flat_C]; exact l1_sPoly.trans (bx3HE4 i hi h).2
    · rw [PHE4_k4 h]; exact (l1_flat_Pr3 SHE4 NHE4 MHE4 DHE4 R).trans (bx4HE4 i hi h).2
    · rw [PHE4_k5 h]; simp [l1, liftN]
    · rw [PHE4_fam h]
      refine (l1_flat_famPoly_le R NHE4 MHE4 DHE4 (by split_ifs <;> simp) _ 0 0 0 (famHE4 i)
        fun sd hsd => ((staticHE4 i hi h).2.2.2 sd hsd).1.2.2.2.2).trans (l1famHE4 i hi h)
  · rw [PHE4_k5 (kindHE4_ge (by omega))]
    simp [l1, liftN]

/-- The phases are below `4`. -/
theorem hWHE4 : ∀ i, (WtHE4 i).2.2 < 4 :=
  getD_prop (Pr := fun w : ℕ × ℕ × ℕ => w.2.2 < 4) (by kernel_fact) (by kernel_fact)

/-- **The family centres** at the parameter `w = c`. -/
def xHE4 (c : ℂ) (i : ℕ) : FA := ctr3 SHE4 NHE4 MHE4 DHE4 c (WtHE4 i) (PHE4 i)

/-- The centre of a stored family. -/
theorem xHE4_fam {c : ℂ} (hc : c ≠ 0) {i : ℕ} (h : kindHE4 i = 6) {p : ℕ}
    (hp : WtHE4 i = (1, 0, p)) :
    xHE4 c i = famCtr SHE4 NHE4 MHE4 p (if oddHE4 i then -1 else 1) (c0HE4 i : ℤ) 0 0 c 0
      (famHE4 i) := by
  have hi := lt_of_kindHE4 h
  rw [xHE4, hp, PHE4_fam h]
  exact ctr3_famPoly _ _ _ _ _ _ _ _ _ hc 0 _ (by have := (staticHE4 i hi h).2.1; omega)

/-- The centre of `t` is `1`. -/
theorem xHE4_t {c : ℂ} (hc : c ≠ 0) : xHE4 c 0 = 1 := by
  rw [xHE4, show WtHE4 0 = (1, 0, 0) from rfl, show PHE4 0 = T3 SHE4 NHE4 MHE4 DHE4 from rfl]
  exact ctr3_T3 _ _ _ _ hc

/-- The centre of `V` is `1`. -/
theorem xHE4_V (c : ℂ) : xHE4 c 1 = 1 := by
  rw [xHE4, show WtHE4 1 = (0, 1, 0) from rfl, show PHE4 1 = V3 from rfl]
  exact ctr3_V3 _ _ _ _ c

/-- The centre of `cos 2φ`. -/
theorem xHE4_c (c : ℂ) : xHE4 c 2 = ctr SHE4 NHE4 MHE4 (0, 1, 3) cPoly := by
  rw [xHE4, show WtHE4 2 = (0, 1, 3) from rfl, show PHE4 2 = C cPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 3 cPoly

/-- The centre of `sin 2φ`. -/
theorem xHE4_s (c : ℂ) : xHE4 c 3 = ctr SHE4 NHE4 MHE4 (0, 1, 0) sPoly := by
  rw [xHE4, show WtHE4 3 = (0, 1, 0) from rfl, show PHE4 3 = C sPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 0 sPoly

/-- The centre of the parameter `r` is `64 + (c + c⁻¹)/2`. -/
theorem xHE4_r {c : ℂ} (hc : c ≠ 0) : xHE4 c 71 = algebraMap ℂ FA (64 + (c + c⁻¹) / 2) := by
  rw [xHE4, show WtHE4 71 = (1, 0, 0) from rfl, show PHE4 71 = Pr3 SHE4 NHE4 MHE4 DHE4 from rfl]
  exact ctr3_Pr3 _ _ _ _ (by kernel_fact) (by kernel_fact) hc

/-- The centres of the variables of kind `5` (dummies) vanish. -/
theorem xHE4_zero (c : ℂ) {i : ℕ} (h : kindHE4 i = 5) : xHE4 c i = 0 := by
  rw [xHE4, PHE4_k5 h]
  simp [ctr3]

