/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw1CheckH21`)

The checks of `Design/RationalStellaratorGCEw1CheckH21` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE1`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw1LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `DzP`. -/
theorem cHE1S_DzP : center3KS KvSHE1 NHE1 MHE1 33 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DzP`. -/
theorem clHE1_DzP : LHE1 33 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `YDt`. -/
theorem cHE1S_YDt : center3KS KvSHE1 NHE1 MHE1 90 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `YDt`. -/
theorem clHE1_YDt : LHE1 90 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m13`: truncation norm. -/
theorem kHE1S_m13 : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_m13 (1 : Int) 1 0 21 228 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m13`: a priori `ℓ¹` bound. -/
theorem lHE1_m13 : nodeL1N SHE1 LHE1 trHE1N_m13 (1 : Int) 1 0 21 < 2 ^ (228 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
