set_option maxRecDepth 750000 in
set_option maxHeartbeats 2000000 in
-- The kernel reduces 31488 consecutive packed cell updates in this equality.
theorem scanned : scan DommaschkActionQ1R517.slabs histogram.clear = histogram := by rfl

set_option maxRecDepth 16384 in
set_option maxHeartbeats 1000000 in
-- The kernel compares all 329 represented cutoffs with the adaptive grid's cumulative widths.
theorem table_agrees : failures histogram false table = 0 := by rfl

/-- All adaptive node inequalities for an angular trace realizing the archived cell bounds. -/
theorem nodes {f w : ℝ → ℝ} (c : Covers false w f mirrorHeight left DommaschkActionQ1R517.slabs)
    (hf : Measurable f) (hw : Measurable w) (hn : ∀ t ∈ Icc left right, 0 ≤ w t)
    (hi : IntegrableOn w (Ioc left right)) :
    NodeBounds ((volume.restrict (Ioc left right)).withDensity (fun t => ENNReal.ofReal (w t)))
      f mirrorHeight table 1048576 3221225472 false := by
  have ends : left + DommaschkActionQ1R517.slabs.length / 64 = right := by
    rw [DommaschkActionQ1R517.checked.len]
    norm_num [left, right]
  exact nodeBounds scanned table_agrees (fun _ h => positive_widths h) ends c hf hw hn hi

/-- The certified finite sublevel sum implies the strict archived one-passage action target. -/
theorem endpoint {f w : ℝ → ℝ} (c : Covers false w f mirrorHeight left DommaschkActionQ1R517.slabs)
    (hf : Measurable f) (hw : Measurable w) (hn : ∀ t ∈ Icc left right, 0 ≤ w t)
    (hi : IntegrableOn w (Ioc left right)) (field : ∀ t ∈ Ioc left right, 0 ≤ f t) :
    (6799610938322487 / 5000000000000000 : ℝ) <
      Kinetic.MirrorHeightAction.action f w left right mirrorHeight := by
  apply trace_action checked (by norm_num [left, right]) hf hw
    (fun t ht => le_trans (by norm_num [mirrorHeight]) (field t ht))
    (fun t ht => hn t (Ioc_subset_Icc_self ht)) hi (nodes c hf hw hn hi)

end PlasmaLean.Design.DommaschkSpeedHistogramQ1R517
