set_option maxRecDepth 100000 in
/-- Kernel check of the node `P42`: truncation norm. -/
theorem kHE3_P42 : node3KN SHE3 NHE3 MHE3 DHE3 WtHE3 KvHE3 trHE3N_P42 (1 : Int) 1 0 75 244 145 109 49 13 8 19 72 54 ≤
