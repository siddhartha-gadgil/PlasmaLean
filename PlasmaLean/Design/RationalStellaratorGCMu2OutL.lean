/-- The full chain. -/
theorem ballLM_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) {u z : FA}
    (hU : Bd r (u - xLM c 4) (ELM 4)) (hZ : Bd r (z - xLM c 5) (ELM 5))
    (hA : Bd r (dTh u - xLM c 6) (ELM 6)) (hB : Bd r (dTh z - xLM c 7) (ELM 7)) :
    ∀ i, i < 180 → Bd r (XLM c u z i - xLM c i) (ELM i) :=
  ballLM_180 hr hq hc hU hZ hA hB

/-- A value is bounded by its centre norm plus its radius. -/
theorem valLM_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) {u z : FA}
    (hU : Bd r (u - xLM c 4) (ELM 4)) (hZ : Bd r (z - xLM c 5) (ELM 5))
    (hA : Bd r (dTh u - xLM c 6) (ELM 6)) (hB : Bd r (dTh z - xLM c 7) (ELM 7))
    (i : ℕ) (hi : i < 180) :
    Bd r (XLM c u z i) ((BLM i + ELM i : ℚ) : ℝ) := by
  have := (normLM hq hc i hi).add (ballLM_all hr hq hc hU hZ hA hB i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

