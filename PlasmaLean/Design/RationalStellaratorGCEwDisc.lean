module

public import PlasmaLean.Design.RationalStellaratorGCEwInterp
public import PlasmaLean.Design.RationalStellaratorGCMuMaj

/-!
# Validity and majorants on the complex disc of the scaled gyro-length

The energy-window torus family `K(s) = ∑_k s^k C_k` (`Design/RationalStellaratorGCEwInterp`)
extends to complex `s`. On the disc `|s| ≤ 2^20` its inputs `xK ι K(s)` are bounded by `aDQ`
(from the kernel-checked coefficient norms of `Design/RationalStellaratorGCEwComb`). This module
certifies, with the rational mirrors of `Design/RationalStellaratorGCMuMaj` evaluated by the kernel:

* node validity at `aDQ` with one node bound `g = gDQ` (`nodesOK_resD`, `nodesOK_corrD`);
* the majorants of the residual trees `T₀ = resR(1/256, λ₁)` and of the corrections
  `T₁ = F Y_D 𝓛u − F Y_R` (and the `z` versions) at `aDQ` (`ewD_maj`);
* uniformity in the pitch parameter `|λ| ≤ 1/16` (`ewD_valid_maj`, `ConstLe`).

These give the bound `M` of the analytic remainder of the interpolation in `s`.
Generated by `scripts/gc_kam/ew_glue.py`.

**Sanity.** `corrRQ_toS`: the mirror embeds to the correction expression at `λ₁`.
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.RationalStellaratorGCMu

open PlasmaLean.Design.RationalStellaratorGC
open PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Theory.KAM.PQS

/-- Rational bounds of the inputs `xK ι K(s)` on the disc `|s| ≤ 2^20`. -/
def aDQ : Fin 6 → ℚ := ![(200341 / 1000000 : ℚ),
    (4191 / 25000 : ℚ),
    (28349 / 25000 : ℚ),
    (28349 / 25000 : ℚ),
    (14233 / 125000 : ℚ),
    (54011 / 500000 : ℚ)]

/-- The bound of the majorant of `E` on the disc. -/
def mEDQ : ℚ := (627 / 2000 : ℚ)
/-- The bound of the majorant of `E₄` on the disc. -/
def mE4DQ : ℚ := (5059 / 1000000 : ℚ)
/-- The bound of the majorant of `Q P P₄` on the disc. -/
def mQDQ : ℚ := (1643 / 1000 : ℚ)
/-- The bound of the majorant under the node `(1 − λ₁|B|)^{−1/2}` on the disc. -/
def mNDQ : ℚ := (187 / 1250 : ℚ)
/-- The uniform node bound on the disc. -/
def gDQ : ℚ := (120693 / 100000 : ℚ)

/-- The bounds `aDQ` are nonnegative. -/
theorem aDQ_nonneg : ∀ i, (0 : ℝ) ≤ (aDQ i : ℝ) := fun i => by
  have := (show ∀ i, (0 : ℚ) ≤ aDQ i by decide +kernel) i
  exact_mod_cast this

set_option maxRecDepth 100000 in
/-- **The majorant of `E` at `aDQ`.** -/
theorem ewD_maj_E : PolyExpr.maj (fun i => (aDQ i : ℝ)) EpP ≤ (mEDQ : ℝ) := by
  rw [← PolyExprS.maj_ofPoly, ← EpPQ_toS]
  refine (maj_le (a := aDQ) (g := 0) (by decide +kernel) le_rfl EpPQ (nodesOK_EpPQ _ _)).trans ?_
  exact_mod_cast (show mQ aDQ 0 EpPQ ≤ mEDQ by decide +kernel)

set_option maxRecDepth 100000 in
/-- **The majorant of `E₄` at `aDQ`.** -/
theorem ewD_maj_E4 : PolyExpr.maj (fun i => (aDQ i : ℝ)) E4P ≤ (mE4DQ : ℝ) := by
  rw [← PolyExprS.maj_ofPoly, ← E4PQ_toS]
  refine (maj_le (a := aDQ) (g := 0) (by decide +kernel) le_rfl E4PQ
    (nodesOK_polyQ _ _ _)).trans ?_
  exact_mod_cast (show mQ aDQ 0 E4PQ ≤ mE4DQ by decide +kernel)

set_option maxRecDepth 100000 in
set_option maxRecDepth 100000 in
/-- **The majorant of `Q P P₄` at `aDQ`.** -/
theorem ewD_maj_Q : PolyExpr.maj (fun i => (aDQ i : ℝ)) QPP4P ≤ (mQDQ : ℝ) := by
  rw [← PolyExprS.maj_ofPoly, ← QPP4PQ_toS]
  refine (maj_le (a := aDQ) (g := 0) (by decide +kernel) le_rfl QPP4PQ
    ⟨trivial, nodesOK_polyQ _ _ _⟩).trans ?_
  exact_mod_cast (show mQ aDQ 0 QPP4PQ ≤ mQDQ by decide +kernel)

/-- The uniform node bound is nonnegative. -/
theorem gDQ_nonneg : (0 : ℝ) ≤ (gDQ : ℝ) := by exact_mod_cast (show (0 : ℚ) ≤ gDQ by decide +kernel)

/-- The node `(1 + E)^{−1/2}` at `aDQ`. -/
theorem nodesOK_eVD : NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) eV := by
  have hm := ewD_maj_E
  rw [← PolyExprS.maj_ofPoly] at hm
  have h1 : (mEDQ : ℝ) < 1 := by exact_mod_cast (show mEDQ < 1 by decide +kernel)
  exact ⟨hm.trans_lt h1, isqG_le_q hm h1 gDQ_nonneg
    (by exact_mod_cast (show 1 ≤ gDQ ^ 2 * (1 - mEDQ) by decide +kernel)),
    nodesOK_ofPoly _ _ _⟩

/-- The node `(1 + E₄)^{−1/2}` at `aDQ`. -/
theorem nodesOK_eV4D : NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) eV4 := by
  have hm := ewD_maj_E4
  rw [← PolyExprS.maj_ofPoly] at hm
  have h1 : (mE4DQ : ℝ) < 1 := by exact_mod_cast (show mE4DQ < 1 by decide +kernel)
  exact ⟨hm.trans_lt h1, isqG_le_q hm h1 gDQ_nonneg
    (by exact_mod_cast (show 1 ≤ gDQ ^ 2 * (1 - mE4DQ) by decide +kernel)),
    nodesOK_ofPoly _ _ _⟩

/-- The tree `|B|` at `aDQ`. -/
theorem nodesOK_eBmD : NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) eBm :=
  ⟨nodesOK_ofPoly _ _ _, nodesOK_eVD, nodesOK_eV4D⟩

set_option maxRecDepth 100000 in
/-- `maj |B| ≤ m_Q g²` at `aDQ`. -/
theorem maj_eBm_leD : PolyExprS.maj (fun i => (aDQ i : ℝ)) eBm ≤ (mQDQ : ℝ) * gDQ * gDQ := by
  rw [← eBmQ_toS]
  refine (maj_le (a := aDQ) (g := gDQ) (by decide +kernel) (by decide +kernel) eBmQ
    (by rw [eBmQ_toS]; exact nodesOK_eBmD)).trans ?_
  have : mQ aDQ gDQ eBmQ = mQ aDQ gDQ QPP4PQ * (gDQ * gDQ) := rfl
  have hq : mQ aDQ gDQ QPP4PQ = mQ aDQ 0 QPP4PQ := rfl
  rw [this, hq]
  have h := (show mQ aDQ 0 QPP4PQ ≤ mQDQ by decide +kernel)
  have hg : (0 : ℚ) ≤ gDQ * gDQ := by have := (show (0 : ℚ) ≤ gDQ by decide +kernel); positivity
  have := mul_le_mul_of_nonneg_right h hg
  have h' : ((mQ aDQ 0 QPP4PQ : ℚ) : ℝ) * ((gDQ : ℝ) * gDQ) ≤ (mQDQ : ℝ) * ((gDQ : ℝ) * gDQ) := by
    exact_mod_cast this
  push_cast
  linarith [h', show (mQDQ : ℝ) * gDQ * gDQ = mQDQ * (gDQ * gDQ) by ring]

/-- The node `(1 − λ₁|B|)^{−1/2}` at `aDQ`. -/
theorem nodesOK_eND :
    NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) (RationalStellaratorGC.eN lam1) := by
  have hB := maj_eBm_leD
  have hm : PolyExprS.maj (fun i => (aDQ i : ℝ)) (.mul (.const (-(lam1 : ℂ))) eBm) ≤
      (mNDQ : ℝ) := by
    simp only [PolyExprS.maj, norm_neg, Complex.norm_real, Real.norm_eq_abs, lam1]
    have h := (show (1 / 16 : ℚ) * (mQDQ * gDQ * gDQ) ≤ mNDQ by decide +kernel)
    have h' : (((1 / 16 : ℚ) * (mQDQ * gDQ * gDQ) : ℚ) : ℝ) ≤ (mNDQ : ℝ) := by exact_mod_cast h
    push_cast at h'
    rw [abs_of_pos (by norm_num)]
    nlinarith [PolyExprS.maj_nonneg (fun i => aDQ_nonneg i) eBm]
  have h1 : (mNDQ : ℝ) < 1 := by exact_mod_cast (show mNDQ < 1 by decide +kernel)
  exact ⟨hm.trans_lt h1, isqG_le_q hm h1 gDQ_nonneg
    (by exact_mod_cast (show 1 ≤ gDQ ^ 2 * (1 - mNDQ) by decide +kernel)), trivial, nodesOK_eBmD⟩

/-- The trees of `F` and the corrections at `aDQ`. -/
theorem nodesOK_eFD : NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) (eF lam1) :=
  ⟨⟨trivial, trivial, nodesOK_eBmD⟩, nodesOK_eND⟩

/-- The old corrections `½ W³ κ` at `aDQ` (only the node `(1 + E)^{−1/2}`). -/
theorem nodesOK_eYD : NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) eYD ∧
    NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) eYR ∧
      NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) eYZ := by
  have hm := ewD_maj_E
  rw [← PolyExprS.maj_ofPoly, ← EpPQ_toS] at hm
  have h1 : (mEDQ : ℝ) < 1 := by exact_mod_cast (show mEDQ < 1 by decide +kernel)
  have hall := fun e he => nodesOK_of_all (a := fun i => (aDQ i : ℝ)) (g := (gDQ : ℝ))
    (nodesOK_EpPQ _ _) (hm.trans_lt h1) (isqG_le_q hm h1 gDQ_nonneg
      (by exact_mod_cast (show 1 ≤ gDQ ^ 2 * (1 - mEDQ) by decide +kernel))) e he
  refine ⟨?_, ?_, ?_⟩
  · rw [← eYDQ_toS]; exact hall _ (by decide +kernel)
  · rw [← eYRQ_toS]; exact hall _ (by decide +kernel)
  · rw [← eYZQ_toS]; exact hall _ (by decide +kernel)

/-- **The node condition on the residual trees** at `aDQ`, `λ = λ₁`. -/
theorem nodesOK_resD : NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) (gcFlowMu (1 / 256) lam1).resRp ∧
    NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) (gcFlowMu (1 / 256) lam1).resZp := by
  obtain ⟨hD, hR, hZ⟩ := nodesOK_eYD
  have hF := nodesOK_eFD
  have p := nodesOK_ofPoly (fun i => (aDQ i : ℝ)) (gDQ : ℝ)
  exact ⟨⟨⟨⟨p _, trivial, hF, hD⟩, trivial⟩, p _, trivial, hF, hR⟩,
    ⟨⟨⟨p _, trivial, hF, hD⟩, trivial⟩, p _, trivial, hF, hZ⟩⟩

/-- The mirror of the correction of the `R`-residual, `F Y_D 𝓛u − F Y_R`. -/
def corrRQ : PQS (Fin 6) := .sub (.mul eYDFQ (.var 4)) eYRFQ

/-- The mirror of the correction of the `z`-residual, `F Y_D 𝓛z − F Y_z`. -/
def corrZQ : PQS (Fin 6) := .sub (.mul eYDFQ (.var 5)) eYZFQ

/-- **Sanity**: the mirror embeds to the correction expression at `λ₁`. -/
theorem corrRQ_toS : corrRQ.toS = corrR lam1 := by
  simp only [corrRQ, toS, eYDFQ, eYRFQ, eFQ_toS, eYDQ_toS, eYRQ_toS, corrR, eYDF, eYRF]

/-- The mirror of the `z`-correction embeds to it. -/
theorem corrZQ_toS : corrZQ.toS = corrZ lam1 := by
  simp only [corrZQ, toS, eYDFQ, eYZFQ, eFQ_toS, eYDQ_toS, eYZQ_toS, corrZ, eYDF, eYZF]

/-- The nodes of the correction mirrors at `aDQ`. -/
theorem nodesOK_corrD : NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) corrRQ.toS ∧
    NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) corrZQ.toS := by
  obtain ⟨hD, hR, hZ⟩ := nodesOK_eYD
  have hF := nodesOK_eFD
  rw [← eFQ_toS] at hF
  rw [← eYDQ_toS] at hD
  rw [← eYRQ_toS] at hR
  rw [← eYZQ_toS] at hZ
  exact ⟨⟨⟨⟨hF, hD⟩, trivial⟩, hF, hR⟩, ⟨⟨⟨hF, hD⟩, trivial⟩, hF, hZ⟩⟩

set_option maxRecDepth 100000 in
/-- **The kernel majorants on the disc.** -/
theorem ewD_maj : mQ aDQ gDQ resRQ ≤ (529 / 500 : ℚ) ∧ mQ aDQ gDQ resZQ ≤ (3093 / 500 : ℚ) ∧
    mQ aDQ gDQ corrRQ ≤ (732 / 5 : ℚ) ∧ mQ aDQ gDQ corrZQ ≤ (1456 : ℚ) := by
  decide +kernel

/-- **Validity and majorants on the disc, uniform in the pitch parameter**: at every bound
`0 ≤ a ≤ aDQ` and `|λ| ≤ 1/16`, the residual trees and the corrections are valid and
`T̂₀(a) + 2⁻³² 2^20 T̂₁(a) ≤ M`. -/
theorem ewD_valid_maj {a : Fin 6 → ℝ} (ha : ∀ i, 0 ≤ a i) (haa : ∀ i, a i ≤ aDQ i) {lm : ℝ}
    (hlm : |lm| ≤ lam1) :
    PolyExprS.Valid a (gcFlowMu (1 / 256) lm).resRp ∧ PolyExprS.Valid a (corrR lm) ∧
    PolyExprS.maj a (gcFlowMu (1 / 256) lm).resRp + hEw * (2 ^ 20 : ℝ) * PolyExprS.maj a (corrR lm)
      ≤ ((547 / 500 : ℚ) : ℝ) ∧
    PolyExprS.Valid a (gcFlowMu (1 / 256) lm).resZp ∧ PolyExprS.Valid a (corrZ lm) ∧
    PolyExprS.maj a (gcFlowMu (1 / 256) lm).resZp + hEw * (2 ^ 20 : ℝ) * PolyExprS.maj a (corrZ lm)
      ≤ ((3271 / 500 : ℚ) : ℝ) := by
  have hD0 : ∀ i, (0 : ℚ) ≤ aDQ i := by decide +kernel
  have hg0 : (0 : ℚ) ≤ gDQ := by decide +kernel
  obtain ⟨cR, cZ⟩ := constLe_res hlm
  obtain ⟨cD, cRc, cZc⟩ := constLe_corr hlm
  have kR : PolyExprS.ConstLe (corrR lm) corrRQ.toS := by
    simp only [corrR, corrRQ, toS]; exact .sub (.mul cD (PolyExprS.constLe_refl _)) cRc
  have kZ : PolyExprS.ConstLe (corrZ lm) corrZQ.toS := by
    simp only [corrZ, corrZQ, toS]; exact .sub (.mul cD (PolyExprS.constLe_refl _)) cZc
  obtain ⟨nR, nZ⟩ := nodesOK_resD
  obtain ⟨nCR, nCZ⟩ := nodesOK_corrD
  rw [← resRQ_toS] at nR cR
  rw [← resZQ_toS] at nZ cZ
  obtain ⟨m1, m2, m3, m4⟩ := ewD_maj
  have aD0 : ∀ i, (0 : ℝ) ≤ (aDQ i : ℝ) := fun i => by exact_mod_cast hD0 i
  have bnd : ∀ {e : PolyExprS ℂ (Fin 6)} {P : PQS (Fin 6)}, PolyExprS.ConstLe e P.toS →
      NodesOK (fun i => (aDQ i : ℝ)) (gDQ : ℝ) P.toS →
      PolyExprS.Valid a e ∧ PolyExprS.maj a e ≤ (mQ aDQ gDQ P : ℝ) := fun {e P} hc hn => by
    have hv' := valid_of_nodesOK hn
    have hva := hv'.mono ha haa
    refine ⟨hc.valid ha hva, ?_⟩
    calc PolyExprS.maj a e ≤ PolyExprS.maj a P.toS := hc.maj_le ha hva
      _ ≤ PolyExprS.maj (fun i => (aDQ i : ℝ)) P.toS := PolyExprS.maj_mono ha haa hv'
      _ ≤ (mQ aDQ gDQ P : ℝ) := PQS.maj_le hD0 hg0 P hn
  obtain ⟨v1, b1⟩ := bnd cR nR
  obtain ⟨v2, b2⟩ := bnd kR nCR
  obtain ⟨v3, b3⟩ := bnd cZ nZ
  obtain ⟨v4, b4⟩ := bnd kZ nCZ
  have q1 : (mQ aDQ gDQ resRQ : ℝ) ≤ (529 / 500 : ℚ) := by exact_mod_cast m1
  have q2 : (mQ aDQ gDQ resZQ : ℝ) ≤ (3093 / 500 : ℚ) := by exact_mod_cast m2
  have q3 : (mQ aDQ gDQ corrRQ : ℝ) ≤ (732 / 5 : ℚ) := by exact_mod_cast m3
  have q4 : (mQ aDQ gDQ corrZQ : ℝ) ≤ (1456 : ℚ) := by exact_mod_cast m4
  have h0 : (0 : ℝ) ≤ PolyExprS.maj a (corrR lm) := PolyExprS.maj_nonneg ha _
  have h0' : (0 : ℝ) ≤ PolyExprS.maj a (corrZ lm) := PolyExprS.maj_nonneg ha _
  refine ⟨v1, v2, ?_, v3, v4, ?_⟩
  · have : hEw * (2 ^ 20 : ℝ) * PolyExprS.maj a (corrR lm) ≤ hEw * 2 ^ 20 * (732 / 5 : ℚ) := by
      have := b2.trans q3; unfold hEw; gcongr
    norm_num [hEw] at this ⊢; push_cast at q1 ⊢; linarith
  · have : hEw * (2 ^ 20 : ℝ) * PolyExprS.maj a (corrZ lm) ≤ hEw * 2 ^ 20 * (1456 : ℚ) := by
      have := b4.trans q4; unfold hEw; gcongr
    norm_num [hEw] at this ⊢; push_cast at q2 ⊢; linarith

end PlasmaLean.Design.RationalStellaratorGCMu
