/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw1CheckH64`)

The checks of `Design/RationalStellaratorGCEw1CheckH64` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE1`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw1LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `thU`. -/
theorem cHE1S_thU : center3KS KvSHE1 NHE1 MHE1 8 125 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thU`. -/
theorem clHE1_thU : LHE1 8 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m21`. -/
theorem cHE1S_m21 : center3KS KvSHE1 NHE1 MHE1 19 111 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m21`. -/
theorem clHE1_m21 : LHE1 19 < 2 ^ (111 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `P42`. -/
theorem cHE1S_P42 : center3KS KvSHE1 NHE1 MHE1 75 123 73 55 25 11 8 10 36 27 ≤
     := by
