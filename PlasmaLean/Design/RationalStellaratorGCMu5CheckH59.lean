module

public import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu5KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
meta import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu5CheckH59`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `qph`. -/
theorem cHMS_qph : center3KS KvSHM NHM MHM 49 116 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `qph`. -/
theorem clHM_qph : LHM 49 < 2 ^ (116 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `dZ`. -/
theorem kHMS_dZ : norm3KS WtHM KvSHM NHM MHM trHMN_dZ (1, 0, 1) 120 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `dZ`: a priori `ℓ¹` bound. -/
theorem lHM_dZ : ExN.majN LHM trHMN_dZ < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the node `nZzP`: truncation norm. -/
theorem kHMS_nZzP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nZzP (2 : Int) 0 1 39 124 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `nZzP`: a priori `ℓ¹` bound. -/
theorem lHM_nZzP : nodeL1N SHM LHM trHMN_nZzP (2 : Int) 0 1 39 < 2 ^ (124 - 1) := by
  kron_lt

/-- Proof-term check of the node `R8`: truncation norm. -/
theorem kHMS_R8 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_R8 (1 : Int) 1 0 74 242 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `R8`: a priori `ℓ¹` bound. -/
theorem lHM_R8 : nodeL1N SHM LHM trHMN_R8 (1 : Int) 1 0 74 < 2 ^ (242 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu5
