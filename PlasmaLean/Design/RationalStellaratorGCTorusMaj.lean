/-!
# Majorants of the guiding-centre field: node validity and the Taylor constant

Computable mirrors (`Theory/KAM/PolyExprSMajQ`, `PQS`) of the polynomial leaves
(`Design/KamNewtonField`, `Design/RationalStellaratorGCPoly`) and of the expression trees of the
guiding-centre field `gcFlow (1/256)` (`Design/RationalStellaratorGCFlow`), with their embeddings
(`*_toS`), and the two numerical facts of the KAM theorem that need majorants:

* **node validity** (`gc_maj_E_*`): the majorant of the deviation `E` under the node is below `1`
  at the bounds used by the KAM step (`gcFlow_valid`);
* **the Taylor constant** (`gc_C2R`, `gc_C2Z`): `½ majD2(resR) ≤ C₂ = 59900000000.0` at the
  Taylor segment bounds `avec + T_q mvec`.

The rational majorants are evaluated by the kernel (`decide +kernel`). Generated by
`scripts/gc_kam/gc_maj.py`.
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Theory.KAM.PQS

/-- The mirror of `sumE`. -/
def sumEQ : List (PQS (Fin 6)) → PQS (Fin 6)
  | [] => .const 0
  | e :: es => .add e (sumEQ es)

/-- The mirror of `monoE`. -/
def monoEQ (c : ℚ) : List (Fin 6 × ℕ) → PQS (Fin 6)
  | [] => .const c
  | (i, k) :: l => .mul (monoEQ c l) (npowQ (.var i) k)

/-- A polynomial from its list of monomials. -/
def polyQ (L : List (ℚ × List (Fin 6 × ℕ))) : PQS (Fin 6) :=
  sumEQ (L.map fun cm => monoEQ cm.1 cm.2)

/-- `toS` of a monomial. -/
theorem toS_monoEQ (c : ℚ) : ∀ l : List (Fin 6 × ℕ),
    (monoEQ c l).toS = PolyExprS.ofPoly (monoE (c : ℂ) l)
  | [] => rfl
  | (i, k) :: l => by
    simp only [monoEQ, monoE, toS, PolyExprS.ofPoly, toS_monoEQ c l,
      toS_npowQ (p := .var i) (p' := .var i) rfl k]

/-- `toS` of a polynomial. -/
theorem toS_polyQ : ∀ L : List (ℚ × List (Fin 6 × ℕ)),
    (polyQ L).toS = PolyExprS.ofPoly (sumE (L.map fun cm => monoE (cm.1 : ℂ) cm.2))
  | [] => by simp [polyQ, sumEQ, sumE, toS, PolyExprS.ofPoly]
  | cm :: L => by
    have := toS_polyQ L
    simp only [polyQ, List.map_cons, sumEQ, sumE, toS, PolyExprS.ofPoly, toS_monoEQ] at this ⊢
    rw [this]

/-- Polynomials without nodes satisfy the node condition. -/
theorem nodesOK_polyQ (a : Fin 6 → ℝ) (g : ℝ) (L : List (ℚ × List (Fin 6 × ℕ))) :
    NodesOK a g (polyQ L).toS := by
  rw [toS_polyQ]
  generalize sumE (L.map fun cm => monoE (cm.1 : ℂ) cm.2) = e
  induction e with
  | const _ => trivial
  | var _ => trivial
  | add p q hp hq => exact ⟨hp, hq⟩
  | sub p q hp hq => exact ⟨hp, hq⟩
  | mul p q hp hq => exact ⟨hp, hq⟩

