module

public import PlasmaLean.Design.RationalStellaratorGCEw3TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 26)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw3DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 3: gyro-length `ρ_3 = 1/256 + 5 · 2⁻³⁶`, its own family torus `K_3(λ)`; the
fields at `ρ_3` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nZuP`. -/
theorem cHE3_nZuP : center3KN KvHE3 NHE3 MHE3 38 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZuP`. -/
theorem clHE3_nZuP : LHE3 38 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nZtF`. -/
theorem cHE3_nZtF : center3KN KvHE3 NHE3 MHE3 95 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZtF`. -/
theorem clHE3_nZtF : LHE3 95 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `m50`: truncation norm. -/
theorem kHE3_m50 : node3KN SHE3 NHE3 MHE3 DHE3 WtHE3 KvHE3 trHE3N_m50 (1 : Int) 1 0 26 226 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m50`: a priori `ℓ¹` bound. -/
theorem lHE3_m50 : nodeL1N SHE3 LHE3 trHE3N_m50 (1 : Int) 1 0 26 < 2 ^ (226 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
