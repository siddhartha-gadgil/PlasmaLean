/-!
# The low-memory kernel checks prove the original checks (`Design/RationalStellaratorGCMu5CheckH*`)

* `KvSHM_toInt`: the signed images `KvSHM` are the Kronecker images `KvHM` (`famS_toInt`);
* every check theorem of `Design/RationalStellaratorGCMu5CheckH*`, with its original name and
  statement, proved from its low-memory version by `node3KN_le_of_S`, `norm3KN_le_of_S` or
  `center3KN_le_of_S`.

No heavy kernel evaluation (only degree conditions). Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed images are the Kronecker images.** -/
theorem KvSHM_toInt (b W R i : ℕ) : (KvSHM b W R i).toInt = KvHM b W R i := by
  unfold KvSHM
  split_ifs with h
  · obtain ⟨hk, hb, hw⟩ := h
    have hi := lt_of_kindHM hk
    rw [KvHM_k6 hk, ite_eq_left ⟨hb, hw⟩,
      famS_toInt (staticHM i hi hk) ((dynHM i hi hk).mono hb hw)]
  · exact SInt.toInt_ofInt _

