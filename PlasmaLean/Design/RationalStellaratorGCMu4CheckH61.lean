/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH61`)

The checks of `Design/RationalStellaratorGCMu4CheckH61` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `Z`. -/
theorem cHMS_Z : center3KS KvSHM NHM MHM 5 119 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Z`. -/
theorem clHM_Z : LHM 5 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `thU`. -/
theorem cHMS_thU : center3KS KvSHM NHM MHM 8 125 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thU`. -/
theorem clHM_thU : LHM 8 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `V42`: truncation norm. -/
theorem kHMS_V42 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_V42 (1 : Int) 1 0 80 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `V42`: a priori `ℓ¹` bound. -/
theorem lHM_V42 : nodeL1N SHM LHM trHMN_V42 (1 : Int) 1 0 80 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
