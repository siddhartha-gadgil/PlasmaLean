module

public import PlasmaLean.Design.RationalStellaratorGCMuConfined
public import PlasmaLean.Design.RationalStellaratorGCMu2Confined

/-!
# Passing guiding centres with `μ > 0` confined forever: the pitch-angle range `λ ∈ [0, 1/8]`

This module combines two certified pitch-angle cells:
* `[0, 1/16]`: `Design/RationalStellaratorGCMu*`, theorem
  `rationalStellarator_gc_mu_confined_forever`;
* `[1/16, 1/8]`: `Design/RationalStellaratorGCMu2*` (same pipeline, generated by
  `scripts/gc_kam/lamcell`), theorem `Mu2.rationalStellarator_gc_mu_confined_forever`.

Together they give all-time confinement of passing (`v_∥(0) > 0`) guiding centres for every
`λ = μB₀/E ∈ [0, 1/8]`.

**Scope.** This is the Littlejohn guiding-centre model, which is supplied, not derived. It is
non-relativistic and collisionless: there is no slowing-down, so `E` and `μ` are fixed. The field is
the static vacuum model field `field (1/4)` (SI: `fieldSI B₀ R₀`), not a coil-produced field. The
gyro-length `ρ₀ = (m/q)√(2E/m)/(B₀R₀) = 1/256` is fixed: one energy at one `B₀R₀`. The pitch angles
form a set of positive measure, but at that single energy, so the set is still measure zero in 3-D
velocity space.

**Passing.** The hypothesis is `μ ∈ [0, E/(8B₀)]`, that is, `λ = μB₀/E ≤ 1/8`. On the tube
`rt ≤ 0.3` the proved bound `|B| ≤ 3 B₀` (`norm_field_le`) gives `μ|B| ≤ 3E/8 < E`, so
`v_∥ = √(2(E − μ|B|)/m)` stays positive. The theorems state this conclusion (`0 < v t`); it is
proved, not assumed (`tube_subset_muRegion` needs only `λ ≤ 1/4`). Initial pitch angles satisfy
`sin²χ = μ|B|/E ≤ |B|/(8B₀)`. Near the axis
(`|B| ≈ B₀`) this is `χ ≲ arcsin √(1/8) ≈ 20.7°` (an informal reading).

**Main results.**
* `rationalStellarator_gc_mu_confined_forever_wide` (model units);
* `gc_mu_passing_confined_forever_SI_wide` (SI);
* `alpha_gc_passing_confined_forever_wide`: 3.5 MeV alphas at
  `B₀R₀ = 256 m v/(2e) ∈ [68.9, 69] T·m`,
  every `μ ∈ [0, K/(8B₀)]`.

Top module of the wide range: `lake build PlasmaLean.Design.RationalStellaratorGCMuWide`.

**Sanity.** `wide_cells_cover`: the two cells cover `[0, 1/8]`.
-/

open scoped RealInnerProductSpace

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.RationalStellaratorGC

open Real Set PlasmaLean.Fields PlasmaLean.Design.RationalStellarator PlasmaLean.Design.KamTorusA
  PlasmaLean.Kinetic.GCLittlejohn WithLp

/-- **Sanity**: the two cells `[0, 1/16]` and `[1/16, 1/8]` cover `[0, 1/8]`. -/
theorem wide_cells_cover {lm : ℝ} (hlm : lm ∈ Set.Icc (0 : ℝ) (1 / 8)) :
    lm ∈ Set.Icc (0 : ℝ) (1 / 16) ∨ lm ∈ Set.Icc (1 / 16 : ℝ) (1 / 8) := by
  rcases le_or_gt lm (1 / 16) with h | h
  · exact Or.inl ⟨hlm.1, h⟩
  · exact Or.inr ⟨h.le, hlm.2⟩

/-- **All-time confinement of passing guiding centres with `μ > 0` for `λ ∈ [0, 1/8]`**
(Littlejohn model, model units `R₀ = B₀ = 1`, `B = field (1/4)`). For every `λ ∈ [0, 1/8]` there
is a torus profile `P` with `0.03 ≤ P ≤ 0.255` such that for all `m > 0`, `q ≠ 0`, `E > 0`,
`μ = λE` with `(m/q)√(2E/m) = 1/256`:

* every Littlejohn orbit `(X, v_∥)` with energy `H(X 0, v_∥ 0) = E` and `v_∥(0) > 0` starting on
  the axis or inside the torus stays inside it for all time (within `0.255` of the axis), and stays
  passing: `v_∥(t) = √(2(E − μ|B(X t)|)/m) > 0`;
* from every point `x₀` on the axis or inside the torus there is such an orbit with `X 0 = x₀`. -/
theorem rationalStellarator_gc_mu_confined_forever_wide {lm : ℝ}
    (hlm : lm ∈ Set.Icc (0 : ℝ) (1 / 8)) :
    ∃ P : ℝ → ℝ → ℝ, TorusProfile P ∧ (∀ a b, 3 / 100 ≤ P a b) ∧ (∀ a b, P a b ≤ 255 / 1000) ∧
      (∀ (m q μ E : ℝ) (X : ℝ → Space) (v : ℝ → ℝ), 0 < m → q ≠ 0 → 0 < E →
        m / q * √(2 * E / m) = 1 / 256 → μ = lm * E →
        LittlejohnOrbit m q μ (field (1 / 4)) X v →
        hamiltonian m μ (field (1 / 4)) (X 0) (v 0) = E → 0 < v 0 →
        (rt (X 0) = 0 ∨ rt (X 0) < P (θs (X 0)) (φs (X 0))) →
        ∀ t, rt (X t) ≤ 255 / 1000 ∧ (rt (X t) = 0 ∨ rt (X t) < P (θs (X t)) (φs (X t))) ∧
          v t = √(2 * (E - μ * ‖field (1 / 4) (X t)‖) / m) ∧ 0 < v t) ∧
      ∀ (m q μ E : ℝ) (x₀ : Space), 0 < m → q ≠ 0 → 0 < E →
        m / q * √(2 * E / m) = 1 / 256 → μ = lm * E →
        (rt x₀ = 0 ∨ rt x₀ < P (θs x₀) (φs x₀)) →
        ∃ X : ℝ → Space, LittlejohnOrbit m q μ (field (1 / 4)) X
          (fun t => √(2 * (E - μ * ‖field (1 / 4) (X t)‖) / m)) ∧ X 0 = x₀ ∧
          ∀ t, 0 < √(2 * (E - μ * ‖field (1 / 4) (X t)‖) / m) := by
  rcases wide_cells_cover hlm with h | h
  · exact rationalStellarator_gc_mu_confined_forever h
  · exact Mu2.rationalStellarator_gc_mu_confined_forever h

/-- **All-time confinement of `μ > 0` passing guiding centres in SI units, `μ ≤ E/(8B₀)`**
(Littlejohn model). Let `m > 0`, `q ≠ 0`, `E > 0`, `B₀, R₀ > 0` with
`m √(2E/m)/(q B₀ R₀) = 1/256`, and `μ ∈ [0, E/(8B₀)]` (pitch angles with
`sin²χ = μ|B|/E ≤ |B|/(8B₀)`). In the field `fieldSI B₀ R₀` there is a torus profile `P`
(`0.03 ≤ P ≤ 0.255` in units of `R₀`) such that every Littlejohn orbit with energy `E`, magnetic
moment `μ` and `v_∥(0) > 0` starting (in the scaled coordinates `X/R₀`) on the axis or inside the
torus stays inside it for all time and stays passing (`v_∥ > 0`); from every such starting point
there is such an orbit. -/
theorem gc_mu_passing_confined_forever_SI_wide {m q E B₀ R₀ μ : ℝ} (hm : 0 < m) (hq : q ≠ 0)
    (hE : 0 < E) (hB₀ : 0 < B₀) (hR₀ : 0 < R₀) (hρ : m * √(2 * E / m) / (q * B₀ * R₀) = 1 / 256)
    (hμ : μ ∈ Set.Icc (0 : ℝ) (E / (8 * B₀))) :
    ∃ P : ℝ → ℝ → ℝ, TorusProfile P ∧ (∀ a b, 3 / 100 ≤ P a b) ∧ (∀ a b, P a b ≤ 255 / 1000) ∧
      (∀ (X : ℝ → Space) (v : ℝ → ℝ), LittlejohnOrbit m q μ (fieldSI B₀ R₀) X v →
        hamiltonian m μ (fieldSI B₀ R₀) (X 0) (v 0) = E → 0 < v 0 →
        (rt (R₀⁻¹ • X 0) = 0 ∨ rt (R₀⁻¹ • X 0) < P (θs (R₀⁻¹ • X 0)) (φs (R₀⁻¹ • X 0))) →
        ∀ t, rt (R₀⁻¹ • X t) ≤ 255 / 1000 ∧
          (rt (R₀⁻¹ • X t) = 0 ∨ rt (R₀⁻¹ • X t) < P (θs (R₀⁻¹ • X t)) (φs (R₀⁻¹ • X t))) ∧
          0 < v t) ∧
      ∀ x₀ : Space,
        (rt (R₀⁻¹ • x₀) = 0 ∨ rt (R₀⁻¹ • x₀) < P (θs (R₀⁻¹ • x₀)) (φs (R₀⁻¹ • x₀))) →
        ∃ (X : ℝ → Space) (v : ℝ → ℝ), LittlejohnOrbit m q μ (fieldSI B₀ R₀) X v ∧ X 0 = x₀ ∧
          hamiltonian m μ (fieldSI B₀ R₀) (X 0) (v 0) = E ∧ ∀ t, 0 < v t := by
  set lm := μ * B₀ / E with hlmdef
  have hlm : lm ∈ Set.Icc (0 : ℝ) (1 / 8) := by
    refine ⟨by have := hμ.1; positivity, ?_⟩
    have h2 := hμ.2
    rw [le_div_iff₀ (by positivity)] at h2
    rw [hlmdef, div_le_iff₀ hE]; linarith
  obtain ⟨P, hP, hlo, hhi, hconf, hex⟩ := rationalStellarator_gc_mu_confined_forever_wide hlm
  have hB : B₀ ≠ 0 := hB₀.ne'
  have hR : R₀ ≠ 0 := hR₀.ne'
  set E₁ := E / (B₀ * R₀ ^ 2) with hE₁
  have hE1 : 0 < E₁ := by positivity
  have hρ₁ : m / B₀ / q * √(2 * E₁ / (m / B₀)) = 1 / 256 := by
    rw [hE₁, sqrt_model_param hm hB₀ hR₀, ← hρ]; field_simp
  have hμ₁ : μ / R₀ ^ 2 = lm * E₁ := by rw [hlmdef, hE₁]; field_simp
  refine ⟨P, hP, hlo, hhi, fun X v h hH hv0 h0 t => ?_, fun x₀ h0 => ?_⟩
  · have h1 := (littlejohnSI_iff hB₀ hR₀).1 h
    have hH1 : hamiltonian (m / B₀) (μ / R₀ ^ 2) (field (1 / 4)) (R₀⁻¹ • X 0) (v 0 / R₀) = E₁ := by
      rw [hamiltonian_fieldSI hB₀ hR₀] at hH
      rw [hE₁, ← hH]; field_simp
    obtain ⟨r1, r2, -, r4⟩ := hconf (m / B₀) q (μ / R₀ ^ 2) E₁ _ _ (by positivity) hq hE1 hρ₁ hμ₁
      h1 hH1 (by positivity) h0 t
    exact ⟨r1, r2, by
      have : 0 < v t / R₀ := r4
      exact (div_pos_iff_of_pos_right hR₀).1 this⟩
  · obtain ⟨Y, hY, hY0, hpos⟩ := hex (m / B₀) q (μ / R₀ ^ 2) E₁ (R₀⁻¹ • x₀) (by positivity) hq hE1
      hρ₁ hμ₁ h0
    set w := fun t => √(2 * (E₁ - μ / R₀ ^ 2 * ‖field (1 / 4) (Y t)‖) / (m / B₀)) with hw
    refine ⟨fun t => R₀ • Y t, fun t => R₀ * w t, ?_, ?_, ?_, fun t => ?_⟩
    · rw [littlejohnSI_iff hB₀ hR₀]
      have e1 : (fun t => R₀⁻¹ • R₀ • Y t) = Y := by
        funext t; rw [smul_smul, inv_mul_cancel₀ hR, one_smul]
      have e2 : (fun t => R₀ * w t / R₀) = w := by funext t; field_simp
      rw [e1, e2]; exact hY
    · change R₀ • Y 0 = x₀
      rw [hY0, smul_smul, mul_inv_cancel₀ hR, one_smul]
    · rw [hamiltonian_fieldSI hB₀ hR₀]
      have e1 : R₀⁻¹ • R₀ • Y 0 = Y 0 := by rw [smul_smul, inv_mul_cancel₀ hR, one_smul]
      have e2 : R₀ * w 0 / R₀ = w 0 := by field_simp
      rw [e1, e2, hamiltonian]
      have hp := hpos 0
      have hs : w 0 ^ 2 = 2 * (E₁ - μ / R₀ ^ 2 * ‖field (1 / 4) (Y 0)‖) / (m / B₀) :=
        Real.sq_sqrt (Real.sqrt_pos.1 hp).le
      rw [hs, hE₁]
      field_simp
      ring
    · exact mul_pos hR₀ (hpos t)

/-- **All-time confinement of passing 3.5 MeV alpha guiding centres with `μ ∈ [0, K/(8B₀)]`**
(Littlejohn model; positive measure in pitch angle, at one energy). Let
`m ∈ [6.6446, 6.6447] × 10⁻²⁷ kg`, `e ∈ [1.6021, 1.6022] × 10⁻¹⁹ C`, `q = 2e`, energy
`K = 3.5 MeV = 3.5 × 10⁶ e` J, and `B₀R₀ = 256 m √(2K/m)/(2e)`. Then `B₀R₀ ∈ [68.9, 69] T·m`. For
**every** magnetic moment `μ ∈ [0, K/(8B₀)]` there is a torus profile `P` (`0.03 ≤ P ≤ 0.255` in
units of `R₀`). The initial pitch angles satisfy `sin²χ ≤ |B|/(8B₀)`, which is up to `≈ 20.7°` near
the axis (an informal reading of `arcsin √(1/8)`; it depends on position). Every passing
(`v_∥(0) > 0`) guiding-centre orbit with energy `K` and moment `μ` that starts on the axis or
inside the scaled torus stays inside it, within `0.255 R₀` of the magnetic axis, and stays passing,
for all time. Such orbits exist from every starting point inside. -/
theorem alpha_gc_passing_confined_forever_wide {m e B₀ R₀ μ : ℝ} (hm1 : 6.6446e-27 ≤ m)
    (hm2 : m ≤ 6.6447e-27) (he1 : 1.6021e-19 ≤ e) (he2 : e ≤ 1.6022e-19) (hB₀ : 0 < B₀)
    (hR₀ : 0 < R₀) (hBR : B₀ * R₀ = 256 * m * √(2 * (3.5e6 * e) / m) / (2 * e))
    (hμ : μ ∈ Set.Icc (0 : ℝ) (3.5e6 * e / (8 * B₀))) :
    68.9 ≤ B₀ * R₀ ∧ B₀ * R₀ ≤ 69 ∧
    ∃ P : ℝ → ℝ → ℝ, TorusProfile P ∧ (∀ a b, 3 / 100 ≤ P a b) ∧ (∀ a b, P a b ≤ 255 / 1000) ∧
      (∀ (X : ℝ → Space) (v : ℝ → ℝ), LittlejohnOrbit m (2 * e) μ (fieldSI B₀ R₀) X v →
        hamiltonian m μ (fieldSI B₀ R₀) (X 0) (v 0) = 3.5e6 * e → 0 < v 0 →
        (rt (R₀⁻¹ • X 0) = 0 ∨ rt (R₀⁻¹ • X 0) < P (θs (R₀⁻¹ • X 0)) (φs (R₀⁻¹ • X 0))) →
        ∀ t, rt (R₀⁻¹ • X t) ≤ 255 / 1000 ∧
          (rt (R₀⁻¹ • X t) = 0 ∨ rt (R₀⁻¹ • X t) < P (θs (R₀⁻¹ • X t)) (φs (R₀⁻¹ • X t))) ∧
          0 < v t) ∧
      ∀ x₀ : Space,
        (rt (R₀⁻¹ • x₀) = 0 ∨ rt (R₀⁻¹ • x₀) < P (θs (R₀⁻¹ • x₀)) (φs (R₀⁻¹ • x₀))) →
        ∃ (X : ℝ → Space) (v : ℝ → ℝ), LittlejohnOrbit m (2 * e) μ (fieldSI B₀ R₀) X v ∧
          X 0 = x₀ ∧ hamiltonian m μ (fieldSI B₀ R₀) (X 0) (v 0) = 3.5e6 * e ∧ ∀ t, 0 < v t := by
  have hm : 0 < m := by linarith
  have he : 0 < e := by linarith
  obtain ⟨b1, b2⟩ := alpha_B0R0_bounds hm1 hm2 he1 he2
  refine ⟨by rw [hBR]; exact b1, by rw [hBR]; exact b2, ?_⟩
  refine gc_mu_passing_confined_forever_SI_wide hm (by positivity) (by positivity) hB₀ hR₀ ?_ hμ
  rw [show 2 * e * B₀ * R₀ = 2 * e * (B₀ * R₀) by ring, hBR]
  have : 0 < √(2 * (3.5e6 * e) / m) := Real.sqrt_pos.2 (by positivity)
  field_simp

end PlasmaLean.Design.RationalStellaratorGC
