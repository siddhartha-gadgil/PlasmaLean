/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw4CheckH28`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `nZphP`. -/
theorem cHE4S_nZphP : center3KS KvSHE4 NHE4 MHE4 40 119 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nZphP`. -/
theorem clHE4_nZphP : LHE4 40 < 2 ^ (119 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `nRtJ`. -/
theorem cHE4S_nRtJ : center3KS KvSHE4 NHE4 MHE4 97 118 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nRtJ`. -/
theorem clHE4_nRtJ : LHE4 97 < 2 ^ (118 - 1) := by
  kron_lt

/-- Proof-term check of the node `m60`: truncation norm. -/
theorem kHE4S_m60 : node3KS SHE4 NHE4 MHE4 DHE4 WtHE4 KvSHE4 trHE4N_m60 (1 : Int) 1 0 28 224 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m60`: a priori `ℓ¹` bound. -/
theorem lHE4_m60 : nodeL1N SHE4 LHE4 trHE4N_m60 (1 : Int) 1 0 28 < 2 ^ (224 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
