module

public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH26`)

The checks of `Design/RationalStellaratorGCMu4CheckH26` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m13`. -/
theorem cHMS_m13 : center3KS KvSHM NHM MHM 21 108 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m13`. -/
theorem clHM_m13 : LHM 21 < 2 ^ (108 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `K2`. -/
theorem cHMS_K2 : center3KS KvSHM NHM MHM 63 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `K2`. -/
theorem clHM_K2 : LHM 63 < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `RD`: truncation norm. -/
theorem kHMS_RD : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_RD (1 : Int) 1 0 42 239 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `RD`: a priori `ℓ¹` bound. -/
theorem lHM_RD : nodeL1N SHM LHM trHMN_RD (1 : Int) 1 0 42 < 2 ^ (239 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
