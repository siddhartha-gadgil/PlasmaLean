/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH57`)

The checks of `Design/RationalStellaratorGCMu4CheckH57` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `YnZt`. -/
theorem cHMS_YnZt : center3KS KvSHM NHM MHM 94 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `YnZt`. -/
theorem clHM_YnZt : LHM 94 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `dB`. -/
theorem kHMS_dB : norm3KS WtHM KvSHM NHM MHM trHMN_dB (1, 0, 0) 126 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `dB`: a priori `ℓ¹` bound. -/
theorem lHM_dB : ExN.majN LHM trHMN_dB < 2 ^ (126 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `R2`: truncation norm. -/
theorem kHMS_R2 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_R2 (1 : Int) 1 0 58 236 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R2`: a priori `ℓ¹` bound. -/
theorem lHM_R2 : nodeL1N SHM LHM trHMN_R2 (1 : Int) 1 0 58 < 2 ^ (236 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `P4P`: truncation norm. -/
theorem kHMS_P4P : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_P4P (1 : Int) 0 0 72 124 73 55 25 11 8 10 36 27 ≤
    0 := by
  decide +kernel

/-- Kernel check of the node `P4P`: a priori `ℓ¹` bound. -/
theorem lHM_P4P : nodeL1N SHM LHM trHMN_P4P (1 : Int) 0 0 72 < 2 ^ (124 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
