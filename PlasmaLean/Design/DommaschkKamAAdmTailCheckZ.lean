module

public import PlasmaLean.Design.DommaschkKamAAdmTailCheck
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAAdmTailCheck

/-!
# Kernel checks: closeness of the data torus A to the surrogate (the `z` part)

The weighted digit sums of the Kronecker images of the `z` difference grid `dGZ` and its `θ`- and
`ψ`-weighted versions (`Design/DommaschkKamAAdmTailCheck` has the `U` part). Generated by
`scripts/dommaschk_kam/emit_adm.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Kernel check: the weighted norm of the tail grid `Z`. -/
theorem tk_Z : wl1KronP 143 193 8 8 (2 * Mc + 1) (fun i => kwtS 68553 16 Nc (ndist i (1 * Nc)))
    (fun j => kwtS 68553 16 Mc (ndist j (1 * Mc + 0))) (packGridNM 143 193 Nc dGZ (2 * Mc + 1)) ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Kernel check: the weighted norm of the tail grid `AZ`. -/
theorem tk_AZ : wl1KronP 150 193 8 8 (2 * Mc + 1) (fun i => kwtS 68553 16 Nc (ndist i (1 * Nc)))
    (fun j => kwtS 68553 16 Mc (ndist j (1 * Mc + 0))) (packGridNM 150 193 Nc (wGc 1 0 dGZ) (2 * Mc + 1)) ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Kernel check: the weighted norm of the tail grid `PZ`. -/
theorem tk_PZ : wl1KronP 149 193 8 8 (2 * Mc + 1) (fun i => kwtS 68553 16 Nc (ndist i (1 * Nc)))
    (fun j => kwtS 68553 16 Mc (ndist j (1 * Mc + 0))) (packGridNM 149 193 Nc (wGc 0 1 dGZ) (2 * Mc + 1)) ≤  := by
  kron2_proof

end PlasmaLean.Design.DommaschkKamA
