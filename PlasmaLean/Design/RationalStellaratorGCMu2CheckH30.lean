module

public import PlasmaLean.Design.RationalStellaratorGCMu2TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu2KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH30`)

The checks of `Design/RationalStellaratorGCMu2CheckH30` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m41`. -/
theorem cHMS_m41 : center3KS KvSHM NHM MHM 25 105 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m41`. -/
theorem clHM_m41 : LHM 25 < 2 ^ (105 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `KZ`. -/
theorem cHMS_KZ : center3KS KvSHM NHM MHM 67 124 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `KZ`. -/
theorem clHM_KZ : LHM 67 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `E`: truncation norm. -/
theorem kHMS_E : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_E (1 : Int) 1 0 51 243 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `E`: a priori `ℓ¹` bound. -/
theorem lHM_E : nodeL1N SHM LHM trHMN_E (1 : Int) 1 0 51 < 2 ^ (243 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
