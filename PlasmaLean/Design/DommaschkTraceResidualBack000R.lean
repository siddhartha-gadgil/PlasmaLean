    Blocks ⟨7,80⟩ reference (dnR.drop 0) dnR0 := by
  apply Blocks.chunk 12 (ofDyadic 80 [-3250780451472426559218, -3248132096471445567283, 3972066620042605173, 1323245727690393985, -582380654242872, -116496738348195, -9792226084, -1293344700] (3555959112)) dnR12
