/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH52`)

The checks of `Design/RationalStellaratorGCMu2CheckH52` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `E`. -/
theorem cHMS_E : center3KS KvSHM NHM MHM 51 116 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `E`. -/
theorem clHM_E : LHM 51 < 2 ^ (116 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m02`: truncation norm. -/
theorem kHMS_m02 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m02 (1 : Int) 1 0 14 236 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m02`: a priori `ℓ¹` bound. -/
theorem lHM_m02 : nodeL1N SHM LHM trHMN_m02 (1 : Int) 1 0 14 < 2 ^ (236 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `nZuP`: truncation norm. -/
theorem kHMS_nZuP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_nZuP (8 : Int) 0 1 38 126 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nZuP`: a priori `ℓ¹` bound. -/
theorem lHM_nZuP : nodeL1N SHM LHM trHMN_nZuP (8 : Int) 0 1 38 < 2 ^ (126 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
