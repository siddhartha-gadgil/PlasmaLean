/-- Proof-term check of the node `R2`: a priori `ℓ¹` bound. -/
theorem lHE2_R2 : nodeL1N SHE2 LHE2 trHE2N_R2 (1 : Int) 1 0 58 < 2 ^ (236 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
