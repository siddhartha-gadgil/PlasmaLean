module

public import PlasmaLean.Design.RationalStellaratorGCEw2TreesH
public import PlasmaLean.Design.RationalStellaratorGCEw2KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw2CheckH21`)

The checks of `Design/RationalStellaratorGCEw2CheckH21` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE2`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `DzP`. -/
theorem cHE2S_DzP : center3KS KvSHE2 NHE2 MHE2 33 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DzP`. -/
theorem clHE2_DzP : LHE2 33 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `YDt`. -/
theorem cHE2S_YDt : center3KS KvSHE2 NHE2 MHE2 90 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `YDt`. -/
theorem clHE2_YDt : LHE2 90 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m13`: truncation norm. -/
theorem kHE2S_m13 : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_m13 (1 : Int) 1 0 21 228 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m13`: a priori `ℓ¹` bound. -/
theorem lHE2_m13 : nodeL1N SHE2 LHE2 trHE2N_m13 (1 : Int) 1 0 21 < 2 ^ (228 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
