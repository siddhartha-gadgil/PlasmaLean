  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m51`. -/
theorem clHE3_m51 : LHE3 27 < 2 ^ (102 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `lamv`. -/
theorem cHE3_lamv : center3KN KvHE3 NHE3 MHE3 84 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `lamv`. -/
theorem clHE3_lamv : LHE3 84 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `dB`. -/
theorem kHE3_dB : norm3KN WtHE3 KvHE3 NHE3 MHE3 trHE3N_dB (1, 0, 0) 126 73 55 25 11 8 10 36 27 ≤
