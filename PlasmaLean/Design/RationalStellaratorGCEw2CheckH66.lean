module

public import PlasmaLean.Design.RationalStellaratorGCEw2TreesH
public import PlasmaLean.Design.RationalStellaratorGCEw2KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCEw2TreesH
meta import PlasmaLean.Design.RationalStellaratorGCEw2KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw2CheckH66`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `PP4`. -/
theorem cHE2S_PP4 : center3KS KvSHE2 NHE2 MHE2 77 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `PP4`. -/
theorem clHE2_PP4 : LHE2 77 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the node `nRp`: truncation norm. -/
theorem kHE2S_nRp : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_nRp (8 : Int) 0 1 30 124 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `nRp`: a priori `ℓ¹` bound. -/
theorem lHE2_nRp : nodeL1N SHE2 LHE2 trHE2N_nRp (8 : Int) 0 1 30 < 2 ^ (124 - 1) := by
  kron_lt

/-- Proof-term check of the node `DphP`: truncation norm. -/
theorem kHE2S_DphP : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_DphP (4 : Int) 0 1 34 121 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `DphP`: a priori `ℓ¹` bound. -/
theorem lHE2_DphP : nodeL1N SHE2 LHE2 trHE2N_DphP (4 : Int) 0 1 34 < 2 ^ (121 - 1) := by
  kron_lt

/-- Proof-term check of the node `nRuP`: truncation norm. -/
theorem kHE2S_nRuP : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_nRuP (8 : Int) 0 1 35 126 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `nRuP`: a priori `ℓ¹` bound. -/
theorem lHE2_nRuP : nodeL1N SHE2 LHE2 trHE2N_nRuP (8 : Int) 0 1 35 < 2 ^ (126 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `Nm1`. -/
theorem kHE2S_Nm1 : norm3KS WtHE2 KvSHE2 NHE2 MHE2 trHE2N_Nm1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `Nm1`: a priori `ℓ¹` bound. -/
theorem lHE2_Nm1 : ExN.majN LHE2 trHE2N_Nm1 < 2 ^ (123 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
