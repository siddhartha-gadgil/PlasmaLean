module

public import PlasmaLean.Certificates.PositionFrameProjection${extra_import}
public import BackwardTraceCache.${reflected}
public import JacobianTraceCache.${jac}
public import PlasmaLean.Design.DommaschkJacobianReflection
public import PlasmaLean.Design.DommaschkPhysicalTraceStep
public import PlasmaLean.Design.DommaschkPositionFramesBack

/-! # Backward QA2R physical step at index ${index}

The whole backward trial ellipsoid fits inside the reflected forward coordinate
box. Generated by `verify_backward_physical_prefix.py`.
-/

@[expose] public section
noncomputable section
namespace PlasmaLean.Design.${name}
open Certificates PositionFrameSlabs DommaschkBounceField DommaschkKam DommaschkKam.DkPoly
open DommaschkPhysicalTraceStep DommaschkJacobian DommaschkJacobianReflection
open TrajectoryTaylorModel ${reflected} Set
open scoped RealInnerProductSpace

/-- Exact input ellipsoid inherited from the previous backward row. -/
abbrev previous := next ${previous}

/-- The actual step of the backward archive. -/
def row : Step := ${stored}

theorem checked : test pilotLimits previous row = true := by with_unfolding_all rfl

private theorem clock (t : ℝ) : coord (${index} / 64) t = 128*t-${offset} := by unfold coord; ring
private theorem stop : (${index} / 64 : ℝ) + 1 / 64 = ${end} / 64 := by norm_num
private theorem central : CenterMatches row backReference := by
  constructor <;> with_unfolding_all rfl

${membership}

/-- The backward row's own growth allowance dominates the sharp forward bound. -/
theorem fits_backward : ${jac}.logNorm ≤ row.mu := by kernel_fact

/-- Denominator, physical spatial growth, and physical central defect are
controlled on the actual backward ball with its recorded allowance. -/
theorem field_bounds : FieldBounds previous row (${index} / 64) (euclideanFlow 0 (-1))
    (velocityJacobian 0 (-1)) ballDomain := by
  apply DommaschkPhysicalTraceStep.field_bounds checked
  · intro t ht v hv
    obtain ⟨u,z⟩ := reflected_membership ht hv
    let x := reference (${index}/64) row t + moving previous row (${index}/64) t v
    have hs : |128*t-${offset}| ≤ 1 := by simpa only [clock] using abs_coord_le ht
    have radial := enclose (c := ⟨[0],1/2⟩) hs u (by kernel_fact)
    have pos : 0 < x 0 := by
      change (⟨[0],1/2⟩ : Model).Mem (128*t-${offset}) (x 0 - dkR0) at radial
      norm_num [Model.Mem,dkR0,abs_le] at radial
      linarith
    have den := ${jac}.denominator_pos (stop ▸ ht) u z
    have eq := DommaschkSectionReflection.evR_reflect
      (show DommaschkSectionReflection.parity dD 0 = true by kernel_fact) (x 0 - dkR0) (-x 1)
      (Real.cos (2*t)) (Real.sin (2*t))
    simp only [neg_neg,pow_zero,one_mul] at eq
    refine ⟨pos,?_⟩
    change atPoint dD (x 0) (0 + -1*t) (x 1) ≠ 0
    simp only [zero_add,neg_one_mul,atPoint,mul_neg,Real.cos_neg,Real.sin_neg,eq]
    exact den.ne'
  · intro t ht v hv w
    obtain ⟨u,z⟩ := reflected_membership (Ico_subset_Icc_self ht) hv
    let x := reference (${index}/64) row t + moving previous row (${index}/64) t v
    have ht' := stop ▸ Ico_subset_Icc_self ht
    have hs : |128*t-${offset}| ≤ 1 := by simpa only [clock] using abs_coord_le (Ico_subset_Icc_self ht)
    have left : previous.frame = reflectFrame ${jac}.leftFrame := rfl
    have right : row.frame = reflectFrame ${jac}.rightFrame := rfl
    have hd := det_ne_zero ((Bool.and_eq_true_iff.mp checked).1) hs
    rw [left,right,reflected_det] at hd
    have eq := moving_quadratic_eq t (128*t-${offset}) ${jac}.leftFrame
      ${jac}.rightFrame (flip x) (flip w) hd
    simp only [flip_twice] at eq
    have hj := ${jac}.physical_clock_log_norm ht' u z (flip w)
    have mu : (${jac}.logNorm : ℝ) ≤ (row.mu:ℝ) :=
      Rat.cast_le.mpr fits_backward
    change ⟪w, Fields.LogNormTrajectory.MovingFrame.jacobian (velocityJacobian 0 (-1) t x)
      (moving previous row (${index}/64) t) (frameVelocity previous.frame row.frame) w⟫ ≤ _
    rw [moving,clock,left,right,eq,velocityJacobian_spatial]
    simpa [x,add_comm] using hj.trans (mul_le_mul_of_nonneg_right mu (sq_nonneg _))
  · intro t ht
    have h := Ico_subset_Icc_self ht
    apply residual_of_pulled ((Bool.and_eq_true_iff.mp checked).1) central h
    have fm : residualFrame previous row = backFrame := by with_unfolding_all rfl
    have b : row.defect = backBudget := rfl
    simpa only [clock, fm, b] using physical_defect (stop ▸ h)

/-- The physical solution starts at the exact exit set of the preceding row. -/
theorem physical_step : Fields.TrajectorySlabs.Step (euclideanFlow 0 (-1))
    (physicalSlab previous row (${index} / 64)) (stateSet previous) (stateSet (next row)) :=
  physical_step_ball checked field_bounds

end PlasmaLean.Design.${name}
