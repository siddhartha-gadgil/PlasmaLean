/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu3CheckH43`)

The checks of `Design/RationalStellaratorGCMu3CheckH43` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZuP`. -/
theorem cHMS_nZuP : center3KS KvSHM NHM MHM 38 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZuP`. -/
theorem clHM_nZuP : LHM 38 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `lamv`. -/
theorem cHMS_lamv : center3KS KvSHM NHM MHM 84 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `lamv`. -/
theorem clHM_lamv : LHM 84 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `etaV4`. -/
theorem kHMS_etaV4 : norm3KS WtHM KvSHM NHM MHM trHMN_etaV4 (2, 0, 0) 231 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `etaV4`: a priori `ℓ¹` bound. -/
theorem lHM_etaV4 : ExN.majN LHM trHMN_etaV4 < 2 ^ (231 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu3
