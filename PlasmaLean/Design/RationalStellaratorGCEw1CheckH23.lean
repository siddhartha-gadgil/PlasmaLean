  kron_proof

/-- A priori `ℓ¹` bound of the centre `YnRt`. -/
theorem clHE1_YnRt : LHE1 92 < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the node `m31`: truncation norm. -/
theorem kHE1S_m31 : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_m31 (1 : Int) 1 0 23 228 145 109 49 13 8 19 72 54 ≤
     := by
