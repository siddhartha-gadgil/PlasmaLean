/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH19`)

The checks of `Design/RationalStellaratorGCMu2CheckH19` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m02`. -/
theorem cHMS_m02 : center3KS KvSHM NHM MHM 14 115 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m02`. -/
theorem clHM_m02 : LHM 14 < 2 ^ (115 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `W2`. -/
theorem cHMS_W2 : center3KS KvSHM NHM MHM 56 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `W2`. -/
theorem clHM_W2 : LHM 56 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m22`: truncation norm. -/
theorem kHMS_m22 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m22 (1 : Int) 1 0 22 228 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m22`: a priori `ℓ¹` bound. -/
theorem lHM_m22 : nodeL1N SHM LHM trHMN_m22 (1 : Int) 1 0 22 < 2 ^ (228 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
