module

public import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu5CheckH25`)

The checks of `Design/RationalStellaratorGCMu5CheckH25` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu5LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m30`. -/
theorem cHMS_m30 : center3KS KvSHM NHM MHM 20 113 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m30`. -/
theorem clHM_m30 : LHM 20 < 2 ^ (113 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `K1`. -/
theorem cHMS_K1 : center3KS KvSHM NHM MHM 62 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `K1`. -/
theorem clHM_K1 : LHM 62 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m60`: truncation norm. -/
theorem kHMS_m60 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m60 (1 : Int) 1 0 28 224 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m60`: a priori `ℓ¹` bound. -/
theorem lHM_m60 : nodeL1N SHM LHM trHMN_m60 (1 : Int) 1 0 28 < 2 ^ (224 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu5
