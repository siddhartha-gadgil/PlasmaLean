module

public import PlasmaLean.Design.RationalStellaratorGCMu3TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu3KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu3CheckH45`)

The checks of `Design/RationalStellaratorGCMu3CheckH45` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu3

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZphP`. -/
theorem cHMS_nZphP : center3KS KvSHM NHM MHM 40 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZphP`. -/
theorem clHM_nZphP : LHM 40 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `N0`. -/
theorem cHMS_N0 : center3KS KvSHM NHM MHM 86 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `N0`. -/
theorem clHM_N0 : LHM 86 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `Bm`: truncation norm. -/
theorem kHMS_Bm : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_Bm (1 : Int) 1 0 83 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `Bm`: a priori `ℓ¹` bound. -/
theorem lHM_Bm : nodeL1N SHM LHM trHMN_Bm (1 : Int) 1 0 83 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu3
