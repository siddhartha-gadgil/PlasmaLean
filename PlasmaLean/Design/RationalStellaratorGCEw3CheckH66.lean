/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw3CheckH66`)

The checks of `Design/RationalStellaratorGCEw3CheckH66` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE3`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw3LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `PP4`. -/
theorem cHE3S_PP4 : center3KS KvSHE3 NHE3 MHE3 77 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `PP4`. -/
theorem clHE3_PP4 : LHE3 77 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `nRp`: truncation norm. -/
theorem kHE3S_nRp : node3KS SHE3 NHE3 MHE3 DHE3 WtHE3 KvSHE3 trHE3N_nRp (8 : Int) 0 1 30 124 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nRp`: a priori `ℓ¹` bound. -/
theorem lHE3_nRp : nodeL1N SHE3 LHE3 trHE3N_nRp (8 : Int) 0 1 30 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
