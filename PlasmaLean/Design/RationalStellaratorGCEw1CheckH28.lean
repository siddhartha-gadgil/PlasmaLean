/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw1CheckH28`)

The checks of `Design/RationalStellaratorGCEw1CheckH28` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE1`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw1LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZphP`. -/
theorem cHE1S_nZphP : center3KS KvSHE1 NHE1 MHE1 40 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZphP`. -/
theorem clHE1_nZphP : LHE1 40 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nRtJ`. -/
theorem cHE1S_nRtJ : center3KS KvSHE1 NHE1 MHE1 97 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRtJ`. -/
theorem clHE1_nRtJ : LHE1 97 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m60`: truncation norm. -/
theorem kHE1S_m60 : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_m60 (1 : Int) 1 0 28 224 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m60`: a priori `ℓ¹` bound. -/
theorem lHE1_m60 : nodeL1N SHE1 LHE1 trHE1N_m60 (1 : Int) 1 0 28 < 2 ^ (224 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
