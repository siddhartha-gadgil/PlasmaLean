module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 23)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMuDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m12`. -/
theorem cHM_m12 : center3KN KvHM NHM MHM 18 111 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m12`. -/
theorem clHM_m12 : LHM 18 < 2 ^ (111 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `A1`. -/
theorem cHM_A1 : center3KN KvHM NHM MHM 60 125 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `A1`. -/
theorem clHM_A1 : LHM 60 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `m50`: truncation norm. -/
theorem kHM_m50 : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_m50 (1 : Int) 1 0 26 226 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m50`: a priori `ℓ¹` bound. -/
theorem lHM_m50 : nodeL1N SHM LHM trHMN_m50 (1 : Int) 1 0 26 < 2 ^ (226 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
