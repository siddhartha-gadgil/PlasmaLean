/-- Kernel check of the node `m40`: a priori `ℓ¹` bound. -/
theorem lHE4_m40 : nodeL1N SHE4 LHE4 trHE4N_m40 (1 : Int) 1 0 24 < 2 ^ (230 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
