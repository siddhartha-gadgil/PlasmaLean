module

public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH50`)

The checks of `Design/RationalStellaratorGCMu4CheckH50` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `RDph`. -/
theorem cHMS_RDph : center3KS KvSHM NHM MHM 45 116 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `RDph`. -/
theorem clHM_RDph : LHM 45 < 2 ^ (116 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `DtF`. -/
theorem cHMS_DtF : center3KS KvSHM NHM MHM 91 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DtF`. -/
theorem clHM_DtF : LHM 91 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `YnRt`: truncation norm. -/
theorem kHMS_YnRt : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_YnRt (1 : Int) 1 0 92 241 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `YnRt`: a priori `ℓ¹` bound. -/
theorem lHM_YnRt : nodeL1N SHM LHM trHMN_YnRt (1 : Int) 1 0 92 < 2 ^ (241 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
