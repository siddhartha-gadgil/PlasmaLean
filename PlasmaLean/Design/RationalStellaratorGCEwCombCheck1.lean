module

public import PlasmaLean.Design.RationalStellaratorGCEwCombEnv

/-!
# Kernel checks of the energy-window combinations (part 1)

Each theorem is one kernel evaluation (`decide +kernel`) of the weighted digit sum `norm3KN` of the
Kronecker image of an integer combination of node tori (`Design/RationalStellaratorGCEwCombEnv`).
Light module. Generated by `scripts/gc_kam/ew_comb.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C0U`. -/
theorem kEw_C0U : norm3KN WtEw KvEw 36 27 trEwC_C0U (1, 0, 0) 129 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C0U`. -/
theorem lEw_C0U : ExN.majN LEw trEwC_C0U < 2 ^ (129 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C3Z`. -/
theorem kEw_C3Z : norm3KN WtEw KvEw 36 27 trEwC_C3Z (1, 0, 1) 132 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C3Z`. -/
theorem lEw_C3Z : ExN.majN LEw trEwC_C3Z < 2 ^ (132 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C2LZx`. -/
theorem kEw_C2LZx : norm3KN WtEw KvEw 36 27 trEwC_C2LZx (1, 0, 0) 223 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C2LZx`. -/
theorem lEw_C2LZx : ExN.majN LEw trEwC_C2LZx < 2 ^ (223 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the combination `C1thZ`. -/
theorem kEw_C1thZ : norm3KN WtEw KvEw 36 27 trEwC_C1thZ (1, 0, 0) 133 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the combination `C1thZ`. -/
theorem lEw_C1thZ : ExN.majN LEw trEwC_C1thZ < 2 ^ (133 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
