module

public import PlasmaLean.Design.RationalStellaratorGCEw4TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 19)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw4DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 4: gyro-length `ρ_4 = 1/256 + 2⁻³²`, its own family torus `K_4(λ)`; the
fields at `ρ_4` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nZp`. -/
theorem cHE4_nZp : center3KN KvHE4 NHE4 MHE4 31 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZp`. -/
theorem clHE4_nZp : LHE4 31 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `Nn`. -/
theorem cHE4_Nn : center3KN KvHE4 NHE4 MHE4 88 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Nn`. -/
theorem clHE4_Nn : LHE4 88 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `m21`: truncation norm. -/
theorem kHE4_m21 : node3KN SHE4 NHE4 MHE4 DHE4 WtHE4 KvHE4 trHE4N_m21 (1 : Int) 1 0 19 232 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m21`: a priori `ℓ¹` bound. -/
theorem lHE4_m21 : nodeL1N SHE4 LHE4 trHE4N_m21 (1 : Int) 1 0 19 < 2 ^ (232 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
