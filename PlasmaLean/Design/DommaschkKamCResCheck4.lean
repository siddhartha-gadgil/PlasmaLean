module

public import PlasmaLean.Design.DommaschkKamCResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamCResTrees

/-!
# Proof-term checks of the torus-C residual chain (part 4)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamCResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_D5`, `kH_Dc4`, `kH_D4`, `kH_Dc3`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `D5`: truncation norm. -/
theorem kH_D5 : nodeKw 68553 16 SH NH MH WtH KvH trH_D5 (1 : ℤ) 1 0 22 276 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `D5`: a priori `ℓ¹` bound. -/
theorem lH_D5 : nodeL1 SH LH trH_D5 (1 : ℤ) 1 0 22 < 2 ^ (276 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc4`: truncation norm. -/
theorem kH_Dc4 : nodeKw 68553 16 SH NH MH WtH KvH trH_Dc4 (80000000000 : ℤ) 0 3 23 179 193 8 8 164 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc4`: a priori `ℓ¹` bound. -/
theorem lH_Dc4 : nodeL1 SH LH trH_Dc4 (80000000000 : ℤ) 0 3 23 < 2 ^ (179 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `D4`: truncation norm. -/
theorem kH_D4 : nodeKw 68553 16 SH NH MH WtH KvH trH_D4 (1 : ℤ) 1 0 24 276 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `D4`: a priori `ℓ¹` bound. -/
theorem lH_D4 : nodeL1 SH LH trH_D4 (1 : ℤ) 1 0 24 < 2 ^ (276 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc3`: truncation norm. -/
theorem kH_Dc3 : nodeKw 68553 16 SH NH MH WtH KvH trH_Dc3 (1920000000000 : ℤ) 0 3 25 185 193 8 8 165 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Dc3`: a priori `ℓ¹` bound. -/
theorem lH_Dc3 : nodeL1 SH LH trH_Dc3 (1920000000000 : ℤ) 0 3 25 < 2 ^ (185 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamC
