module

public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH51`)

The checks of `Design/RationalStellaratorGCMu4CheckH51` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `q`. -/
theorem cHMS_q : center3KS KvSHM NHM MHM 46 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `q`. -/
theorem clHM_q : LHM 46 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `YnRt`. -/
theorem cHMS_YnRt : center3KS KvSHM NHM MHM 92 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `YnRt`. -/
theorem clHM_YnRt : LHM 92 < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `YnZt`: truncation norm. -/
theorem kHMS_YnZt : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_YnZt (1 : Int) 1 0 94 245 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `YnZt`: a priori `ℓ¹` bound. -/
theorem lHM_YnZt : nodeL1N SHM LHM trHMN_YnZt (1 : Int) 1 0 94 < 2 ^ (245 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
