module

public import PlasmaLean.Design.RationalStellaratorGCFamTreesH

/-!
# Kernel checks of the guiding-centre torus family certificate (high resolution, part 10)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCFamDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/fam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the node `m11`: truncation norm. -/
theorem kHF_m11 : node3KN SHF NHF MHF DHF WtHF KvHF trHFN_m11 (1 : Int) 1 0 15 236 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m11`: a priori `ℓ¹` bound. -/
theorem lHF_m11 : nodeL1N SHF LHF trHFN_m11 (1 : Int) 1 0 15 < 2 ^ (236 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `RD`: truncation norm. -/
theorem kHF_RD : node3KN SHF NHF MHF DHF WtHF KvHF trHFN_RD (1 : Int) 1 0 42 239 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `RD`: a priori `ℓ¹` bound. -/
theorem lHF_RD : nodeL1N SHF LHF trHFN_RD (1 : Int) 1 0 42 < 2 ^ (239 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `W2`: truncation norm. -/
theorem kHF_W2 : node3KN SHF NHF MHF DHF WtHF KvHF trHFN_W2 (1 : Int) 1 0 56 244 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `W2`: a priori `ℓ¹` bound. -/
theorem lHF_W2 : nodeL1N SHF LHF trHFN_W2 (1 : Int) 1 0 56 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
