module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 52)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMuDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `E`. -/
theorem cHM_E : center3KN KvHM NHM MHM 51 116 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `E`. -/
theorem clHM_E : LHM 51 < 2 ^ (116 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `m02`: truncation norm. -/
theorem kHM_m02 : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_m02 (1 : Int) 1 0 14 236 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m02`: a priori `ℓ¹` bound. -/
theorem lHM_m02 : nodeL1N SHM LHM trHMN_m02 (1 : Int) 1 0 14 < 2 ^ (236 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `nZuP`: truncation norm. -/
theorem kHM_nZuP : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_nZuP (8 : Int) 0 1 38 126 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nZuP`: a priori `ℓ¹` bound. -/
theorem lHM_nZuP : nodeL1N SHM LHM trHMN_nZuP (8 : Int) 0 1 38 < 2 ^ (126 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
