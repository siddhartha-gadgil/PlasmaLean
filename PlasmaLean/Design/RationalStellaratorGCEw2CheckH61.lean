module

public import PlasmaLean.Design.RationalStellaratorGCEw2TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 61)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw2DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 2: gyro-length `ρ_2 = 1/256 − 5 · 2⁻³⁶`, its own family torus `K_2(λ)`; the
fields at `ρ_2` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `Z`. -/
theorem cHE2_Z : center3KN KvHE2 NHE2 MHE2 5 119 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Z`. -/
theorem clHE2_Z : LHE2 5 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m41`. -/
theorem cHE2_m41 : center3KN KvHE2 NHE2 MHE2 25 105 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m41`. -/
theorem clHE2_m41 : LHE2 25 < 2 ^ (105 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `VV4`. -/
theorem cHE2_VV4 : center3KN KvHE2 NHE2 MHE2 82 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `VV4`. -/
theorem clHE2_VV4 : LHE2 82 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `dZ`. -/
theorem kHE2_dZ : norm3KN WtHE2 KvHE2 NHE2 MHE2 trHE2N_dZ (1, 0, 1) 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `dZ`: a priori `ℓ¹` bound. -/
theorem lHE2_dZ : ExN.majN LHE2 trHE2N_dZ < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `R4`: truncation norm. -/
theorem kHE2_R4 : node3KN SHE2 NHE2 MHE2 DHE2 WtHE2 KvHE2 trHE2N_R4 (1 : Int) 1 0 73 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R4`: a priori `ℓ¹` bound. -/
theorem lHE2_R4 : nodeL1N SHE2 LHE2 trHE2N_R4 (1 : Int) 1 0 73 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
