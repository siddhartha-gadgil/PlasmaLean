/-!
# True values of the high-resolution ball pipeline of the guiding-centre torus

The value `XH i` of each variable of the high-resolution ball pipeline as an element of the strip
algebra (the torus `K = (1 + u, z)`, the field polynomials, the node `(1 + E)^{−1/2}`, the
brackets, the guiding-centre flow form and its derivatives),
and the identity of every node: `c · X n = eval X e` (`relH_*`), proved pointwise on the
torus (`ext_eval`) by `ring`.
Generated by `scripts/gc_kam/emit_lean.py`.
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall WEll1Z2 Complex PolyExpr

/-- The guiding-centre torus `u₀ = R − 1` (the high-resolution centre). -/
def u₀G : FA := xH 4

/-- The guiding-centre torus `z₀`. -/
def z₀G : FA := xH 5

/-- The low-resolution torus `u_S`. -/
def uSG : FA := xL 4

/-- The low-resolution torus `z_S`. -/
def zSG : FA := xL 5

/-- The torus point `(u₀, z₀, cos 2φ, sin 2φ, 0, 0)`. -/
def KH : Fin 6 → FA := xB u₀G z₀G

/-- The true values of the variables. -/
def XH : ℕ → FA
  | 0 => 1
  | 1 => 1
  | 2 => cS
  | 3 => sS
  | 4 => u₀G
  | 5 => z₀G
  | 6 => (2 : ℂ) ^ 96 • Lt KamTorusA.iota u₀G
  | 7 => (2 : ℂ) ^ 96 • Lt KamTorusA.iota z₀G
  | 8 => dTh u₀G
  | 9 => dTh z₀G
  | 10 => uSG
  | 11 => zSG
  | 12 => dTh uSG
  | 13 => dTh zSG
  | 14 => u₀G ^ 0 * z₀G ^ 2
  | 15 => u₀G ^ 1 * z₀G ^ 1
  | 16 => u₀G ^ 2 * z₀G ^ 0
  | 17 => u₀G ^ 0 * z₀G ^ 3
  | 18 => u₀G ^ 1 * z₀G ^ 2
  | 19 => u₀G ^ 2 * z₀G ^ 1
  | 20 => u₀G ^ 3 * z₀G ^ 0
  | 21 => u₀G ^ 1 * z₀G ^ 3
  | 22 => u₀G ^ 2 * z₀G ^ 2
  | 23 => u₀G ^ 3 * z₀G ^ 1
  | 24 => u₀G ^ 4 * z₀G ^ 0
  | 25 => u₀G ^ 4 * z₀G ^ 1
  | 26 => u₀G ^ 5 * z₀G ^ 0
  | 27 => u₀G ^ 5 * z₀G ^ 1
  | 28 => u₀G ^ 6 * z₀G ^ 0
  | 29 => PolyExpr.eval KH KamNewton.Dp
  | 30 => PolyExpr.eval KH KamNewton.nRp
  | 31 => PolyExpr.eval KH KamNewton.nZp
  | 32 => PolyExpr.eval KH DuP
  | 33 => PolyExpr.eval KH DzP
  | 34 => PolyExpr.eval KH DphP
  | 35 => PolyExpr.eval KH nRuP
  | 36 => PolyExpr.eval KH nRzP
  | 37 => PolyExpr.eval KH nRphP
  | 38 => PolyExpr.eval KH nZuP
  | 39 => PolyExpr.eval KH nZzP
  | 40 => PolyExpr.eval KH nZphP
  | 41 => PolyExpr.eval KH PuP
  | 42 => (1 + u₀G) * PolyExpr.eval KH KamNewton.Dp
  | 43 => (1 + u₀G) * PolyExpr.eval KH DuP
  | 44 => (1 + u₀G) * PolyExpr.eval KH DzP
  | 45 => (1 + u₀G) * PolyExpr.eval KH DphP
  | 46 => PolyExprS.eval KH eq
  | 47 => PolyExprS.eval KH eqR
  | 48 => PolyExprS.eval KH eqz
  | 49 => PolyExprS.eval KH eqph
  | 50 => PolyExpr.eval KH PuP ^ 2
  | 51 => PolyExpr.eval KH EpP
  | 52 => xH 52
  | 53 => PolyExprS.eval KH eV
  | 54 => PolyExprS.eval KH eW
  | 55 => PolyExprS.eval KH eW ^ 2
  | 56 => PolyExprS.eval KH eW3
  | 57 => (1 + u₀G) ^ 2
  | 58 => (1 + u₀G) ^ 3
  | 59 => (1 + u₀G) * PolyExprS.eval KH eqR
  | 60 => (1 + u₀G) * PolyExprS.eval KH eqz
  | 61 => PolyExpr.eval KH KamNewton.nZp * ((1 + u₀G) * PolyExprS.eval KH eqR) - 8 * PolyExpr.eval
          KH KamNewton.nZp * PolyExprS.eval KH eq - PolyExpr.eval KH KamNewton.nRp * ((1 + u₀G) *
          PolyExprS.eval KH eqz)
  | 62 => (1 + u₀G) * PolyExpr.eval KH KamNewton.Dp * ((1 + u₀G) * PolyExprS.eval KH eqz) -
          PolyExpr.eval KH KamNewton.nZp * PolyExprS.eval KH eqph
  | 63 => PolyExpr.eval KH KamNewton.nRp * PolyExprS.eval KH eqph - (1 + u₀G) * PolyExpr.eval KH
          KamNewton.Dp * ((1 + u₀G) * PolyExprS.eval KH eqR) + 8 * ((1 + u₀G) * PolyExpr.eval KH
          KamNewton.Dp) * PolyExprS.eval KH eq
  | 64 => PolyExprS.eval KH eKD
  | 65 => PolyExprS.eval KH eKR
  | 66 => PolyExprS.eval KH eKZ
  | 67 => PolyExprS.eval KH (gcD (1 / 256))
  | 68 => PolyExprS.eval KH (gcNR (1 / 256))
  | 69 => PolyExprS.eval KH (gcNZ (1 / 256))
  | _ => 0

