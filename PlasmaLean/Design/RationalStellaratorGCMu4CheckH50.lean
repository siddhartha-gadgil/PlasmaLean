module

public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
meta import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu4CheckH50`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `RDph`. -/
theorem cHMS_RDph : center3KS KvSHM NHM MHM 45 116 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `RDph`. -/
theorem clHM_RDph : LHM 45 < 2 ^ (116 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `DtF`. -/
theorem cHMS_DtF : center3KS KvSHM NHM MHM 91 122 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `DtF`. -/
theorem clHM_DtF : LHM 91 < 2 ^ (122 - 1) := by
  kron_lt

/-- Proof-term check of the node `YnRt`: truncation norm. -/
theorem kHMS_YnRt : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_YnRt (1 : Int) 1 0 92 241 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `YnRt`: a priori `ℓ¹` bound. -/
theorem lHM_YnRt : nodeL1N SHM LHM trHMN_YnRt (1 : Int) 1 0 92 < 2 ^ (241 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu4
