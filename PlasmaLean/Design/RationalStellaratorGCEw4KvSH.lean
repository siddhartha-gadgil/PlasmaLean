module

public import PlasmaLean.Design.RationalStellaratorGCEw4KvH
public import PlasmaLean.Certificates.KronLowMemCompute

/-!
# Low-memory Kronecker images (`Design/RationalStellaratorGCEw4KvH`)

The signed images `KvSHE4` of the variables of `Design/RationalStellaratorGCEw4KvH` for the low-
memory kernel checks (`Certificates/KronLowMemCompute`). Their integer values are the images `KvHE4`
(`KvSHE4_toInt`, `Design/RationalStellaratorGCEw4LowMemH`). Light module. Generated by
`scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

/-- **The signed Kronecker images of the variable polynomials** (`w ↦ 2^{b W R}`): stored
families with fast widths by `famS`, every other variable by its integer image `KvHE4`. -/
def KvSHE4 (b W R : Nat) (i : Nat) : SInt :=
  if kindHE4 i = 6 ∧ bMinHE4 i ≤ b ∧ wMinHE4 i ≤ W then
    famS b W R NHE4 MHE4 DHE4 (c0HE4 i) (oddHE4 i) ddHE4 drHE4 dwHE4 (famHE4 i)
  else SInt.ofInt (KvHE4 b W R i)

end PlasmaLean.Design.RationalStellaratorGC
