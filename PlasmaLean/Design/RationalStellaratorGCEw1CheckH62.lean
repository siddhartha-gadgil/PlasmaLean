module

public import PlasmaLean.Design.RationalStellaratorGCEw1TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 62)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw1DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 1: gyro-length `ρ_1 = 1/256 − 2⁻³²`, its own family torus `K_1(λ)`; the
fields at `ρ_1` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `LRx`. -/
theorem cHE1_LRx : center3KN KvHE1 NHE1 MHE1 6 221 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `LRx`. -/
theorem clHE1_LRx : LHE1 6 < 2 ^ (221 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m50`. -/
theorem cHE1_m50 : center3KN KvHE1 NHE1 MHE1 26 107 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m50`. -/
theorem clHE1_m50 : LHE1 26 < 2 ^ (107 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `Bm`. -/
theorem cHE1_Bm : center3KN KvHE1 NHE1 MHE1 83 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Bm`. -/
theorem clHE1_Bm : LHE1 83 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `dA`. -/
theorem kHE1_dA : norm3KN WtHE1 KvHE1 NHE1 MHE1 trHE1N_dA (1, 0, 3) 126 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `dA`: a priori `ℓ¹` bound. -/
theorem lHE1_dA : ExN.majN LHE1 trHE1N_dA < 2 ^ (126 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `R8`: truncation norm. -/
theorem kHE1_R8 : node3KN SHE1 NHE1 MHE1 DHE1 WtHE1 KvHE1 trHE1N_R8 (1 : Int) 1 0 74 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R8`: a priori `ℓ¹` bound. -/
theorem lHE1_R8 : nodeL1N SHE1 LHE1 trHE1N_R8 (1 : Int) 1 0 74 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
