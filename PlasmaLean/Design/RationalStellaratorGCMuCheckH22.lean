module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 22)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMuDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m03`. -/
theorem cHM_m03 : center3KN KvHM NHM MHM 17 112 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m03`. -/
theorem clHM_m03 : LHM 17 < 2 ^ (112 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `R3`. -/
theorem cHM_R3 : center3KN KvHM NHM MHM 59 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `R3`. -/
theorem clHM_R3 : LHM 59 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `m41`: truncation norm. -/
theorem kHM_m41 : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_m41 (1 : Int) 1 0 25 225 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m41`: a priori `ℓ¹` bound. -/
theorem lHM_m41 : nodeL1N SHM LHM trHMN_m41 (1 : Int) 1 0 25 < 2 ^ (225 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
