/-!
# The high-resolution environment of the `μ > 0` passing guiding-centre torus family certificate

The variable polynomials `PHE3 i` (three variables: `θ`-, `ψ`-modes and the Chebyshev variable
`w`), their degree boxes (`boxHE3`), static `ℓ¹` bounds (`l1HE3`) and Kronecker images (`kronHE3`);
the family centres `xHE3 c i` at the parameter `w = c`; the norm bounds `BHE3 i` of the centres and
the radii `EHE3 i` of the balls (supplied by the oracle, checked in
`Design/RationalStellaratorGCEw3CheckH*`).
Generated by `scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 3: gyro-length `ρ_3 = 1/256 + 5 · 2⁻³⁶`, its own family torus `K_3(λ)`; the
fields at `ρ_3` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section
noncomputable section

set_option linter.style.longLine false

namespace PlasmaLean.Design.RationalStellaratorGC

open Polynomial PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall PlasmaLean.Certificates.KronBallCheb PlasmaLean.Theory.KAM

/-- **The variable polynomials** of the family pipeline (by kind, `kindHE3`). -/
def PHE3 (i : ℕ) : P3 :=
  match kindHE3 i with
  | 0 => T3 SHE3 NHE3 MHE3 DHE3
  | 1 => V3
  | 2 => C cPoly
  | 3 => C sPoly
  | 4 => Pr3 SHE3 NHE3 MHE3 DHE3
  | 5 => 0
  | _ => famPoly NHE3 MHE3 DHE3 (if oddHE3 i then -1 else 1) (c0HE3 i : ℤ) 0 0 0 (famHE3 i)

/-- The kinds are at most `6`. -/
theorem kindHE3_le (i : ℕ) : kindHE3 i ≤ 6 :=
  getD_prop (Pr := fun k : ℕ => k ≤ 6) (by kernel_fact) (by kernel_fact) i

set_option maxRecDepth 100000 in
/-- The variables beyond the last have kind `5` (zero). -/
theorem kindHE3_ge {i : ℕ} (h : 99 ≤ i) : kindHE3 i = 5 := by
  unfold kindHE3
  rw [List.getD_eq_getElem?_getD,
    List.getElem?_eq_none ((by kernel_fact : kindHE3l.length = 99).trans_le h)]
  rfl

/-- Stored families are below the last variable. -/
theorem lt_of_kindHE3 {i : ℕ} (h : kindHE3 i = 6) : i < 99 := by
  by_contra h'
  rw [kindHE3_ge (by omega)] at h
  exact absurd h (by kernel_fact)

set_option maxRecDepth 100000 in
/-- The static conditions of the stored families. -/
theorem staticHE3 : ∀ i, i < 99 → kindHE3 i = 6 →
    FamStatic NHE3 MHE3 DHE3 ddHE3 drHE3 dwHE3 (famHE3 i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The minimal widths of the fast images. -/
theorem dynHE3 : ∀ i, i < 99 → kindHE3 i = 6 →
    FamDyn (bMinHE3 i) (wMinHE3 i) (c0HE3 i) (famHE3 i) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The static `ℓ¹` bounds of the stored families. -/
theorem l1famHE3 : ∀ i, i < 99 → kindHE3 i = 6 →
    famL1 NHE3 MHE3 (c0HE3 i : ℤ) 0 0 0 (famHE3 i) ≤ LHE3 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree boxes of the stored families. -/
theorem bx6HE3 : ∀ i, i < 99 → kindHE3 i = 6 → BxHE3 i = (2 * NHE3, 2 * MHE3, 2 * DHE3) := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `t`. -/
theorem bx0HE3 : ∀ i, i < 99 → kindHE3 i = 0 → BxHE3 i = (NHE3, MHE3, DHE3) ∧ 2 ^ SHE3 ≤ LHE3 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `V`. -/
theorem bx1HE3 : ∀ i, i < 99 → kindHE3 i = 1 → BxHE3 i = (0, 1, 0) ∧ 2 ≤ LHE3 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `cos 2φ`. -/
theorem bx2HE3 : ∀ i, i < 99 → kindHE3 i = 2 → BxHE3 i = (0, 2, 0) ∧ 2 ≤ LHE3 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of `sin 2φ`. -/
theorem bx3HE3 : ∀ i, i < 99 → kindHE3 i = 3 → BxHE3 i = (0, 2, 0) ∧ 2 ≤ LHE3 i := by
  kernel_fact

set_option maxRecDepth 100000 in
/-- The degree box and bound of the parameter. -/
theorem bx4HE3 : ∀ i, i < 99 → kindHE3 i = 4 →
    BxHE3 i = (NHE3, MHE3, DHE3 + 1) ∧ 2 ^ (SHE3 + 6) + 2 * 2 ^ (SHE3 - 1) ≤ LHE3 i := by
  kernel_fact

/-- The polynomial of `t`. -/
theorem PHE3_k0 {i : ℕ} (h : kindHE3 i = 0) : PHE3 i = T3 SHE3 NHE3 MHE3 DHE3 := by
  unfold PHE3; rw [h]; rfl
/-- The polynomial of `V`. -/
theorem PHE3_k1 {i : ℕ} (h : kindHE3 i = 1) : PHE3 i = V3 := by unfold PHE3; rw [h]; rfl
/-- The polynomial of `cos 2φ`. -/
theorem PHE3_k2 {i : ℕ} (h : kindHE3 i = 2) : PHE3 i = C cPoly := by unfold PHE3; rw [h]; rfl
/-- The polynomial of `sin 2φ`. -/
theorem PHE3_k3 {i : ℕ} (h : kindHE3 i = 3) : PHE3 i = C sPoly := by unfold PHE3; rw [h]; rfl
/-- The polynomial of the parameter. -/
theorem PHE3_k4 {i : ℕ} (h : kindHE3 i = 4) : PHE3 i = Pr3 SHE3 NHE3 MHE3 DHE3 := by
  unfold PHE3; rw [h]; rfl
/-- The polynomial of a dummy variable. -/
theorem PHE3_k5 {i : ℕ} (h : kindHE3 i = 5) : PHE3 i = 0 := by unfold PHE3; rw [h]; rfl

/-- The polynomial of a stored family. -/
theorem PHE3_fam {i : ℕ} (h : kindHE3 i = 6) :
    PHE3 i = famPoly NHE3 MHE3 DHE3 (if oddHE3 i then -1 else 1) (c0HE3 i : ℤ) 0 0 0 (famHE3 i) := by
  unfold PHE3; rw [h]; rfl

/-- The image of `t`. -/
theorem KvHE3_k0 {b W R i : ℕ} (h : kindHE3 i = 0) : KvHE3 b W R i =
    ((1 <<< SHE3 : ℕ) : ℤ) * ((1 <<< (b * (NHE3 + W * (MHE3 + R * DHE3))) : ℕ) : ℤ) := by
  unfold KvHE3; rw [h]; rfl
/-- The image of `V`. -/
theorem KvHE3_k1 {b W R i : ℕ} (h : kindHE3 i = 1) :
    KvHE3 b W R i = 2 * ((1 <<< (b * W) : ℕ) : ℤ) := by
  unfold KvHE3; rw [h]; rfl
/-- The image of `cos 2φ`. -/
theorem KvHE3_k2 {b W R i : ℕ} (h : kindHE3 i = 2) :
    KvHE3 b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) - 1 := by
  unfold KvHE3; rw [h]; rfl
/-- The image of `sin 2φ`. -/
theorem KvHE3_k3 {b W R i : ℕ} (h : kindHE3 i = 3) :
    KvHE3 b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) + 1 := by
  unfold KvHE3; rw [h]; rfl
/-- The image of the parameter. -/
theorem KvHE3_k4 {b W R i : ℕ} (h : kindHE3 i = 4) : KvHE3 b W R i =
    ((1 <<< (SHE3 + 6) : ℕ) : ℤ) * ((1 <<< (b * (NHE3 + W * (MHE3 + R * DHE3))) : ℕ) : ℤ) +
      ((1 <<< (SHE3 - 1) : ℕ) : ℤ) * (((1 <<< (b * (NHE3 + W * (MHE3 + R * (DHE3 + 1)))) : ℕ) : ℤ) +
        ((1 <<< (b * (NHE3 + W * (MHE3 + R * (DHE3 - 1)))) : ℕ) : ℤ)) := by
  unfold KvHE3; rw [h]; rfl
/-- The image of a dummy variable. -/
theorem KvHE3_k5 {b W R i : ℕ} (h : kindHE3 i = 5) : KvHE3 b W R i = 0 := by unfold KvHE3; rw [h]; rfl
/-- The image of a stored family (fast or generic). -/
theorem KvHE3_k6 {b W R i : ℕ} (h : kindHE3 i = 6) : KvHE3 b W R i =
    if bMinHE3 i ≤ b ∧ wMinHE3 i ≤ W then
      ((famTB b W R NHE3 MHE3 DHE3 (c0HE3 i) (oddHE3 i) drHE3 dwHE3 (famHE3 i) : ℕ) : ℤ) -
        ((famO b W R NHE3 MHE3 DHE3 dwHE3 (famHE3 i) : ℕ) : ℤ)
    else famPack b W R NHE3 MHE3 DHE3 (if oddHE3 i then -1 else 1) (c0HE3 i : ℤ) 0 0 ddHE3 drHE3 0
      (famHE3 i) := by
  unfold KvHE3; rw [h]; rfl

/-- The kinds of a variable. -/
theorem kindsHE3 (i : ℕ) : kindHE3 i = 0 ∨ kindHE3 i = 1 ∨ kindHE3 i = 2 ∨ kindHE3 i = 3 ∨
    kindHE3 i = 4 ∨ kindHE3 i = 5 ∨ kindHE3 i = 6 := by
  have := kindHE3_le i; omega

/-- **The Kronecker images of the variable polynomials.** -/
theorem kronHE3 (b W R i : ℕ) : kron b W (flat R (PHE3 i)) = KvHE3 b W R i := by
  rcases kindsHE3 i with h | h | h | h | h | h | h
  · rw [PHE3_k0 h, KvHE3_k0 h, kron_flat_T3, two_pow_eq_shift]
  · rw [PHE3_k1 h, KvHE3_k1 h]; exact kron_flat_V3 b W R
  · rw [PHE3_k2 h, KvHE3_k2 h, flat_C]; exact kron_cPoly b W
  · rw [PHE3_k3 h, KvHE3_k3 h, flat_C]; exact kron_sPoly b W
  · rw [PHE3_k4 h, KvHE3_k4 h]; exact kron_flat_Pr3 SHE3 NHE3 MHE3 DHE3 b W R
  · rw [PHE3_k5 h, KvHE3_k5 h]; simp
  · have hi := lt_of_kindHE3 h
    rw [PHE3_fam h, KvHE3_k6 h]
    by_cases hw : bMinHE3 i ≤ b ∧ wMinHE3 i ≤ W
    · rw [ite_eq_left hw]
      exact kron_famTB (staticHE3 i hi h) ((dynHE3 i hi h).mono hw.1 hw.2) (oddHE3 i) R
    · rw [ite_eq_right hw]
      exact (famPack_eq b W R NHE3 MHE3 DHE3 _ _ 0 0 0 (famHE3 i)
        fun sd hsd => ((staticHE3 i hi h).2.2.2 sd hsd).1).symm

/-- **Degree boxes** of the variable polynomials. -/
theorem boxHE3 (i : ℕ) : InBox3 (PHE3 i) (BxHE3 i).1 (BxHE3 i).2.1 (BxHE3 i).2.2 := by
  by_cases hi : i < 99
  · rcases kindsHE3 i with h | h | h | h | h | h | h
    · rw [PHE3_k0 h, (bx0HE3 i hi h).1]; exact inBox3_T3 SHE3 NHE3 MHE3 DHE3
    · rw [PHE3_k1 h, (bx1HE3 i hi h).1]; exact inBox3_V3
    · rw [PHE3_k2 h, (bx2HE3 i hi h).1]; exact InBox3.C box_cPoly
    · rw [PHE3_k3 h, (bx3HE3 i hi h).1]; exact InBox3.C box_sPoly
    · rw [PHE3_k4 h, (bx4HE3 i hi h).1]; exact inBox3_Pr3 SHE3 NHE3 MHE3 DHE3
    · rw [PHE3_k5 h]; exact inBox3_zero _ _ _
    · rw [PHE3_fam h, bx6HE3 i hi h]
      exact inBox3_famPoly _ _ _ _ _ _ _ 0 _ (by have := (staticHE3 i hi h).2.1; omega)
  · rw [PHE3_k5 (kindHE3_ge (by omega))]
    exact inBox3_zero _ _ _

/-- **Static `ℓ¹` bounds** of the flattened variable polynomials. -/
theorem l1HE3 (R i : ℕ) : l1 (flat R (PHE3 i)) ≤ LHE3 i := by
  by_cases hi : i < 99
  · rcases kindsHE3 i with h | h | h | h | h | h | h
    · rw [PHE3_k0 h]; exact (l1_flat_T3 SHE3 NHE3 MHE3 DHE3 R).trans (bx0HE3 i hi h).2
    · rw [PHE3_k1 h]; exact (l1_flat_V3 R).trans (bx1HE3 i hi h).2
    · rw [PHE3_k2 h, flat_C]; exact l1_cPoly.trans (bx2HE3 i hi h).2
    · rw [PHE3_k3 h, flat_C]; exact l1_sPoly.trans (bx3HE3 i hi h).2
    · rw [PHE3_k4 h]; exact (l1_flat_Pr3 SHE3 NHE3 MHE3 DHE3 R).trans (bx4HE3 i hi h).2
    · rw [PHE3_k5 h]; simp [l1, liftN]
    · rw [PHE3_fam h]
      refine (l1_flat_famPoly_le R NHE3 MHE3 DHE3 (by split_ifs <;> simp) _ 0 0 0 (famHE3 i)
        fun sd hsd => ((staticHE3 i hi h).2.2.2 sd hsd).1.2.2.2.2).trans (l1famHE3 i hi h)
  · rw [PHE3_k5 (kindHE3_ge (by omega))]
    simp [l1, liftN]

/-- The phases are below `4`. -/
theorem hWHE3 : ∀ i, (WtHE3 i).2.2 < 4 :=
  getD_prop (Pr := fun w : ℕ × ℕ × ℕ => w.2.2 < 4) (by kernel_fact) (by kernel_fact)

/-- **The family centres** at the parameter `w = c`. -/
def xHE3 (c : ℂ) (i : ℕ) : FA := ctr3 SHE3 NHE3 MHE3 DHE3 c (WtHE3 i) (PHE3 i)

/-- The centre of a stored family. -/
theorem xHE3_fam {c : ℂ} (hc : c ≠ 0) {i : ℕ} (h : kindHE3 i = 6) {p : ℕ}
    (hp : WtHE3 i = (1, 0, p)) :
    xHE3 c i = famCtr SHE3 NHE3 MHE3 p (if oddHE3 i then -1 else 1) (c0HE3 i : ℤ) 0 0 c 0
      (famHE3 i) := by
  have hi := lt_of_kindHE3 h
  rw [xHE3, hp, PHE3_fam h]
  exact ctr3_famPoly _ _ _ _ _ _ _ _ _ hc 0 _ (by have := (staticHE3 i hi h).2.1; omega)

/-- The centre of `t` is `1`. -/
theorem xHE3_t {c : ℂ} (hc : c ≠ 0) : xHE3 c 0 = 1 := by
  rw [xHE3, show WtHE3 0 = (1, 0, 0) from rfl, show PHE3 0 = T3 SHE3 NHE3 MHE3 DHE3 from rfl]
  exact ctr3_T3 _ _ _ _ hc

/-- The centre of `V` is `1`. -/
theorem xHE3_V (c : ℂ) : xHE3 c 1 = 1 := by
  rw [xHE3, show WtHE3 1 = (0, 1, 0) from rfl, show PHE3 1 = V3 from rfl]
  exact ctr3_V3 _ _ _ _ c

/-- The centre of `cos 2φ`. -/
theorem xHE3_c (c : ℂ) : xHE3 c 2 = ctr SHE3 NHE3 MHE3 (0, 1, 3) cPoly := by
  rw [xHE3, show WtHE3 2 = (0, 1, 3) from rfl, show PHE3 2 = C cPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 3 cPoly

/-- The centre of `sin 2φ`. -/
theorem xHE3_s (c : ℂ) : xHE3 c 3 = ctr SHE3 NHE3 MHE3 (0, 1, 0) sPoly := by
  rw [xHE3, show WtHE3 3 = (0, 1, 0) from rfl, show PHE3 3 = C sPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 0 sPoly

/-- The centre of the parameter `r` is `64 + (c + c⁻¹)/2`. -/
theorem xHE3_r {c : ℂ} (hc : c ≠ 0) : xHE3 c 71 = algebraMap ℂ FA (64 + (c + c⁻¹) / 2) := by
  rw [xHE3, show WtHE3 71 = (1, 0, 0) from rfl, show PHE3 71 = Pr3 SHE3 NHE3 MHE3 DHE3 from rfl]
  exact ctr3_Pr3 _ _ _ _ (by kernel_fact) (by kernel_fact) hc

/-- The centres of the variables of kind `5` (dummies) vanish. -/
theorem xHE3_zero (c : ℂ) {i : ℕ} (h : kindHE3 i = 5) : xHE3 c i = 0 := by
  rw [xHE3, PHE3_k5 h]
  simp [ctr3]

