/-!
# True values of the low-resolution family pipeline of the guiding-centre torus

The value `XLF c u z i` of each variable of the low-resolution family ball pipeline at the
parameter `w = c` (`ρ = ρF c = (64 + Re c)/2^14`) and a torus `(u, z)`: the values `XL u z i` of
the `ρ = 1/256` pipeline (`Design/RationalStellaratorGCTorusRelL`) for the variables that do not
depend on `ρ`, and the parameter `r = 2^14 ρ`, the guiding-centre corrections and the
guiding-centre flow form at `ρF c` for the new variables. The identity of every node,
`c' · X n = eval X e` (`relLF_*`): by congruence from `relL_*` for the `ρ`-independent nodes
(`rel_congr`), proved pointwise on the torus (`ext_eval`) by `ring` for the new ones.
Generated by `scripts/gc_kam/fam_emit_lean.py`.
-/

@[expose] public section
noncomputable section

set_option linter.style.longLine false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall PlasmaLean.Certificates.KronBallCheb WEll1Z2 Complex PolyExpr

/-- **The parameter of the family** at `w = c`: `ρ = (64 + Re c)/2^14` (for `c = e^{iϑ}`:
`ρ = (64 + cos ϑ)/16384`, in `[63/16384, 65/16384]`). -/
def ρF (c : ℂ) : ℝ := (64 + c.re) / 16384

/-- `c ≠ 0` on the unit circle. -/
theorem ne_zero_of_norm_one {c : ℂ} (hc : ‖c‖ = 1) : c ≠ 0 := by
  rintro rfl; simp at hc

/-- **The parameter at `w = c`** (`|c| = 1`): `2^14 ρF c = 64 + (c + c⁻¹)/2`. -/
theorem param_eq {c : ℂ} (hc : ‖c‖ = 1) : (((16384 * ρF c : ℝ)) : ℂ) = 64 + (c + c⁻¹) / 2 := by
  have h1 : c⁻¹ = (starRingEnd ℂ) c := by
    rw [Complex.inv_def, ← Complex.sq_norm, hc]; simp
  rw [h1, Complex.add_conj, ρF]
  push_cast
  ring

/-- The variables of the family pipeline whose values differ from the `ρ = 1/256` pipeline. -/
def spLF (j : ℕ) : Bool :=
  decide (j ∈ ([62, 77, 78, 79, 101, 102, 103, 104, 105, 106, 107, 109, 111, 112, 113] : List ℕ)) || decide (114 ≤ j)

/-- The values of the new variables. -/
def XLFnew (c : ℂ) (u z : FA) : ℕ → FA
  | 62 => xLF c 62
  | 114 => algebraMap ℂ FA (((16384 * ρF c : ℝ)) : ℂ)
  | 115 => PolyExprS.eval (KL u z) eW3 * PolyExprS.eval (KL u z) eKD
  | 116 => PolyExprS.eval (KL u z) (gcD (ρF c))
  | 117 => PolyExprS.eval (KL u z) eW3 * PolyExprS.eval (KL u z) eKR
  | 118 => PolyExprS.eval (KL u z) (gcNR (ρF c))
  | 119 => PolyExprS.eval (KL u z) eW3 * PolyExprS.eval (KL u z) eKZ
  | 120 => PolyExprS.eval (KL u z) (gcNZ (ρF c))
  | 121 => PolyExprS.deriv (KL u z) (Pi.single 0 1) eW3 * PolyExprS.eval (KL u z) eKD +
          PolyExprS.eval (KL u z) eW3 * PolyExprS.deriv (KL u z) (Pi.single 0 1) eKD
  | 122 => pdS (KL u z) 0 (gcD (ρF c))
  | 123 => PolyExprS.deriv (KL u z) (Pi.single 1 1) eW3 * PolyExprS.eval (KL u z) eKD +
          PolyExprS.eval (KL u z) eW3 * PolyExprS.deriv (KL u z) (Pi.single 1 1) eKD
  | 124 => pdS (KL u z) 1 (gcD (ρF c))
  | 125 => PolyExprS.deriv (KL u z) (Pi.single 0 1) eW3 * PolyExprS.eval (KL u z) eKR +
          PolyExprS.eval (KL u z) eW3 * PolyExprS.deriv (KL u z) (Pi.single 0 1) eKR
  | 126 => pdS (KL u z) 0 (gcNR (ρF c))
  | 127 => PolyExprS.deriv (KL u z) (Pi.single 1 1) eW3 * PolyExprS.eval (KL u z) eKR +
          PolyExprS.eval (KL u z) eW3 * PolyExprS.deriv (KL u z) (Pi.single 1 1) eKR
  | 128 => pdS (KL u z) 1 (gcNR (ρF c))
  | 129 => PolyExprS.deriv (KL u z) (Pi.single 0 1) eW3 * PolyExprS.eval (KL u z) eKZ +
          PolyExprS.eval (KL u z) eW3 * PolyExprS.deriv (KL u z) (Pi.single 0 1) eKZ
  | 130 => pdS (KL u z) 0 (gcNZ (ρF c))
  | 131 => PolyExprS.deriv (KL u z) (Pi.single 1 1) eW3 * PolyExprS.eval (KL u z) eKZ +
          PolyExprS.eval (KL u z) eW3 * PolyExprS.deriv (KL u z) (Pi.single 1 1) eKZ
  | 132 => pdS (KL u z) 1 (gcNZ (ρF c))
  | 133 => (gcFlow (ρF c)).Pof u z
  | 134 => PolyExprS.eval (KL u z) (gcD (ρF c)) ^ 3
  | 135 => PolyExprS.eval (KL u z) (gcD (ρF c)) ^ 3 * W0of u z ^ 2
  | 136 => xLF c 136
  | 137 => (1 + u) ^ 3 * (gcFlow (ρF c)).Pof u z * xLF c 136
  | 138 => xL 4
  | 139 => xL 5
  | 140 => dTh (xL 4)
  | 141 => dTh (xL 5)
  | _ => 0

/-- **The true values of the low-resolution family pipeline** at the parameter `w = c` and the
torus `(u, z)`. -/
def XLF (c : ℂ) (u z : FA) (j : ℕ) : FA := if spLF j = true then XLFnew c u z j else XL u z j

/-- The values of the `ρ`-independent variables. -/
theorem XLF_old (c : ℂ) (u z : FA) {j : ℕ} (h : spLF j = false) : XLF c u z j = XL u z j := by
  simp [XLF, h]

/-- The values of the new variables. -/
theorem XLF_new (c : ℂ) (u z : FA) {j : ℕ} (h : spLF j = true) : XLF c u z j = XLFnew c u z j := by
  simp [XLF, h]

/-- Congruence with the `ρ = 1/256` values. -/
theorem XLF_congr (c : ℂ) (u z : FA) : ∀ j, (!spLF j) = true → XLF c u z j = XL u z j :=
  fun _ h => XLF_old c u z (by simpa using h)

