set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the node `m30`: truncation norm. -/
theorem kH_m30 : nodeK SH NH MH WtH KvH trH_m30 (1 : ℤ) 1 0 20 251 161 8 7 120 80 60 ≤  := by
  decide +kernel

/-- Kernel check of the node `m30`: a priori `ℓ¹` bound. -/
theorem lH_m30 : nodeL1 SH LH trH_m30 (1 : ℤ) 1 0 20 < 2 ^ (251 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the node `nRzP`: truncation norm. -/
theorem kH_nRzP : nodeK SH NH MH WtH KvH trH_nRzP (8 : ℤ) 0 1 36 134 81 7 6 62 40 31 ≤  := by
  decide +kernel

/-- Kernel check of the node `nRzP`: a priori `ℓ¹` bound. -/
theorem lH_nRzP : nodeL1 SH LH trH_nRzP (8 : ℤ) 0 1 36 < 2 ^ (134 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `Vm1`. -/
theorem kH_Vm1 : normK NH MH WtH KvH trH_Vm1 (1, 0, 0) 127 81 7 6 60 40 30 ≤  := by
  decide +kernel

/-- Kernel check of the norm node `Vm1`: a priori `ℓ¹` bound. -/
theorem lH_Vm1 : Ex.majN LH trH_Vm1 < 2 ^ (127 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the node `Dt`: truncation norm. -/
theorem kH_Dt : nodeK SH NH MH WtH KvH trH_Dt (512 : ℤ) 1 0 67 251 161 8 7 120 80 60 ≤  := by
