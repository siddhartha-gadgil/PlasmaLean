/-- **Curl-free** (`φ`-component of `∇×B = 0`): `R ∂_z n_R − R ∂_u n_z + 4 n_z = 0`. -/
theorem curl1 (x : Fin 6 → FA) :
    (1 + x 0) * PolyExpr.eval x nRzP - (1 + x 0) * PolyExpr.eval x nZuP + 4 * PolyExpr.eval x
      KamNewton.nZp = 0 := by
  gc_close

/-- **Curl-free** (`R`-component): `∂_φ n_z − R² ∂_z D = 0`. -/
theorem curl2 (x : Fin 6 → FA) :
    PolyExpr.eval x nZphP - (1 + x 0) ^ 2 * PolyExpr.eval x DzP = 0 := by
  gc_close

/-- **Curl-free** (`z`-component): `R² ∂_u D − 2R D − ∂_φ n_R = 0`. -/
theorem curl3 (x : Fin 6 → FA) :
    (1 + x 0) ^ 2 * PolyExpr.eval x DuP - 2 * (1 + x 0) * PolyExpr.eval x KamNewton.Dp -
      PolyExpr.eval x nRphP = 0 := by
  gc_close

set_option maxRecDepth 20000 in
/-- `E = q P² − 1`. -/
theorem E_val (x : Fin 6 → FA) :
    PolyExpr.eval x EpP = (PolyExpr.eval x KamNewton.nRp ^ 2 + (1 + x 0) ^ 2 * PolyExpr.eval x
      KamNewton.Dp ^ 2 + PolyExpr.eval x KamNewton.nZp ^ 2) * PolyExpr.eval x PuP ^ 2 - 1 := by
  gc_close

set_option maxRecDepth 20000 in
/-- Derivative of `E = q P² − 1`. -/
theorem E_d0 (x : Fin 6 → FA) :
    pd x 0 EpP = (2 * PolyExpr.eval x KamNewton.nRp * pd x 0 KamNewton.nRp + 2 * (1 + x 0) ^ 2 *
      PolyExpr.eval x KamNewton.Dp * pd x 0 KamNewton.Dp + 2 * PolyExpr.eval x KamNewton.nZp * pd
      x 0 KamNewton.nZp + 2 * (1 + x 0) * PolyExpr.eval x KamNewton.Dp ^ 2) * PolyExpr.eval x PuP
      ^ 2 + 2 * (PolyExpr.eval x KamNewton.nRp ^ 2 + (1 + x 0) ^ 2 * PolyExpr.eval x KamNewton.Dp
      ^ 2 + PolyExpr.eval x KamNewton.nZp ^ 2) * PolyExpr.eval x PuP * pd x 0 PuP := by
  gc_close

set_option maxRecDepth 20000 in
/-- Derivative of `E = q P² − 1`. -/
theorem E_d1 (x : Fin 6 → FA) :
    pd x 1 EpP = (2 * PolyExpr.eval x KamNewton.nRp * pd x 1 KamNewton.nRp + 2 * (1 + x 0) ^ 2 *
      PolyExpr.eval x KamNewton.Dp * pd x 1 KamNewton.Dp + 2 * PolyExpr.eval x KamNewton.nZp * pd
      x 1 KamNewton.nZp) * PolyExpr.eval x PuP ^ 2 + 2 * (PolyExpr.eval x KamNewton.nRp ^ 2 + (1 +
      x 0) ^ 2 * PolyExpr.eval x KamNewton.Dp ^ 2 + PolyExpr.eval x KamNewton.nZp ^ 2) *
      PolyExpr.eval x PuP * pd x 1 PuP := by
  gc_close

set_option maxRecDepth 20000 in
/-- Derivative of `E = q P² − 1`. -/
theorem E_dph (x : Fin 6 → FA) :
    phiD x EpP = (2 * PolyExpr.eval x KamNewton.nRp * phiD x KamNewton.nRp + 2 * (1 + x 0) ^ 2 *
      PolyExpr.eval x KamNewton.Dp * phiD x KamNewton.Dp + 2 * PolyExpr.eval x KamNewton.nZp *
      phiD x KamNewton.nZp) * PolyExpr.eval x PuP ^ 2 + 2 * (PolyExpr.eval x KamNewton.nRp ^ 2 +
      (1 + x 0) ^ 2 * PolyExpr.eval x KamNewton.Dp ^ 2 + PolyExpr.eval x KamNewton.nZp ^ 2) *
      PolyExpr.eval x PuP * phiD x PuP := by
  gc_close

/-- `P` does not depend on `z`. -/
theorem P_d1 (x : Fin 6 → FA) :
    pd x 1 PuP = 0 := by
  gc_close

/-- `P` does not depend on `φ`. -/
theorem P_dph (x : Fin 6 → FA) :
    phiD x PuP = 0 := by
  gc_close

/-- Sanity: `P(0) = 1`. -/
theorem PuP_zero : PolyExpr.eval (A := ℂ) (fun _ => 0) PuP = 1 := by
  gc_poly_simp; norm_num

set_option maxRecDepth 20000 in
/-- Sanity: `E` vanishes on the magnetic axis `u = z = 0` (`q = 1` there). -/
theorem EpP_axis (c s : ℂ) : PolyExpr.eval (A := ℂ) ![0, 0, c, s, 0, 0] EpP = 0 := by
  gc_poly_simp; simp

set_option maxRecDepth 20000 in
/-- The new polynomials do not involve the velocities. -/
theorem noW_new : NoW DuP ∧ NoW DzP ∧ NoW DphP ∧ NoW nRuP ∧ NoW nRzP ∧ NoW nRphP ∧ NoW nZuP ∧
    NoW nZzP ∧ NoW nZphP ∧ NoW PuP ∧ NoW EpP := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  simp [NoW, DuP, DzP, DphP, nRuP, nRzP, nRphP, nZuP, nZzP, nZphP, PuP, EpP, sumE, monoE, npow]

set_option maxRecDepth 20000 in
/-- The new polynomials have real (rational) coefficients. -/
theorem realConsts_new : DuP.RealConsts ∧ DzP.RealConsts ∧ DphP.RealConsts ∧ nRuP.RealConsts ∧
    nRzP.RealConsts ∧ nRphP.RealConsts ∧ nZuP.RealConsts ∧ nZzP.RealConsts ∧ nZphP.RealConsts ∧
    PuP.RealConsts ∧ EpP.RealConsts := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  simp [PolyExpr.RealConsts, DuP, DzP, DphP, nRuP, nRzP, nRphP, nZuP, nZzP, nZphP, PuP, EpP, sumE,
    monoE, PolyExpr.npow, map_div₀, map_neg, map_ofNat]

