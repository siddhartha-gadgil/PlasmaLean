    ((1 : ℤ) : ℂ) • XHF c 14 = Ex.eval (XHF c) (toEx trHFN_m02) :=
  rel_rename (XHF_hmap c) (eL := trLFN_m02) rfl (by kernel_fact) (XHF_rel c (i := 14) rfl)
    (relLF_m02 c (xHF c 4) (xHF c 5))

