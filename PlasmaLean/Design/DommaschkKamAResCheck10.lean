module

public import PlasmaLean.Design.DommaschkKamAResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAResTrees

/-!
# Proof-term checks of the torus-A residual chain (part 10)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamAResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_G3`, `kH_Gc2`, `kH_G2`, `kH_Gc1`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `G3`: truncation norm. -/
theorem kH_G3 : nodeKw 68553 16 SH NH MH WtH KvH trH_G3 (1 : ℤ) 1 0 42 275 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `G3`: a priori `ℓ¹` bound. -/
theorem lH_G3 : nodeL1 SH LH trH_G3 (1 : ℤ) 1 0 42 < 2 ^ (275 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc2`: truncation norm. -/
theorem kH_Gc2 : nodeKw 68553 16 SH NH MH WtH KvH trH_Gc2 (115200000000000 : ℤ) 0 3 43 192 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc2`: a priori `ℓ¹` bound. -/
theorem lH_Gc2 : nodeL1 SH LH trH_Gc2 (115200000000000 : ℤ) 0 3 43 < 2 ^ (192 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `G2`: truncation norm. -/
theorem kH_G2 : nodeKw 68553 16 SH NH MH WtH KvH trH_G2 (1 : ℤ) 1 0 44 275 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `G2`: a priori `ℓ¹` bound. -/
theorem lH_G2 : nodeL1 SH LH trH_G2 (1 : ℤ) 1 0 44 < 2 ^ (275 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc1`: truncation norm. -/
theorem kH_Gc1 : nodeKw 68553 16 SH NH MH WtH KvH trH_Gc1 (201600000000000 : ℤ) 0 3 45 193 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc1`: a priori `ℓ¹` bound. -/
theorem lH_Gc1 : nodeL1 SH LH trH_Gc1 (201600000000000 : ℤ) 0 3 45 < 2 ^ (193 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamA
