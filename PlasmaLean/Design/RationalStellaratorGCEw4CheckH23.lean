/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw4CheckH23`)

The checks of `Design/RationalStellaratorGCEw4CheckH23` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE4`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nRuP`. -/
theorem cHE4S_nRuP : center3KS KvSHE4 NHE4 MHE4 35 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRuP`. -/
theorem clHE4_nRuP : LHE4 35 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `YnRt`. -/
theorem cHE4S_YnRt : center3KS KvSHE4 NHE4 MHE4 92 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `YnRt`. -/
theorem clHE4_YnRt : LHE4 92 < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m31`: truncation norm. -/
theorem kHE4S_m31 : node3KS SHE4 NHE4 MHE4 DHE4 WtHE4 KvSHE4 trHE4N_m31 (1 : Int) 1 0 23 228 145 109 49 13 8 19 72 54 ≤
     := by
