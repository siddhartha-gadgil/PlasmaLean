module

public import PlasmaLean.Design.RationalStellaratorGCTorusTreesH

/-!
# Kernel checks of the guiding-centre torus certificate (high resolution, part 13)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the data of
`Design/RationalStellaratorGCTorusDataH*`: the weighted digit sums (`nodeK`, `normK`, `centerK` of
`Certificates/KronBallGrid`) of the Kronecker images of the truncation polynomials of the ball
pipeline, and their a priori `ℓ¹` bounds. Generated by `scripts/gc_kam/emit_lean.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m20`. -/
theorem cH_m20 : centerK NH MH KvH 16 127 81 7 6 40 30 ≤  := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m20`. -/
theorem clH_m20 : LH 16 < 2 ^ (127 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `DuP`. -/
theorem cH_DuP : centerK NH MH KvH 32 127 81 7 6 40 30 ≤  := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DuP`. -/
theorem clH_DuP : LH 32 < 2 ^ (127 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `qz`. -/
theorem cH_qz : centerK NH MH KvH 48 127 81 7 6 40 30 ≤  := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `qz`. -/
theorem clH_qz : LH 48 < 2 ^ (127 - 1) := by
  decide +kernel

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
