module

public import PlasmaLean.Design.RationalStellaratorGCMu4TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH44`)

The checks of `Design/RationalStellaratorGCMu4CheckH44` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `nZzP`. -/
theorem cHMS_nZzP : center3KS KvSHM NHM MHM 39 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZzP`. -/
theorem clHM_nZzP : LHM 39 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `EN`. -/
theorem cHMS_EN : center3KS KvSHM NHM MHM 85 121 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `EN`. -/
theorem clHM_EN : LHM 85 < 2 ^ (121 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `VV4`: truncation norm. -/
theorem kHMS_VV4 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_VV4 (1 : Int) 1 0 82 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `VV4`: a priori `ℓ¹` bound. -/
theorem lHM_VV4 : nodeL1N SHM LHM trHMN_VV4 (1 : Int) 1 0 82 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
