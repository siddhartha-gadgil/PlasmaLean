/-- Unfolding set for the polynomials of this file and `Design/KamNewtonField`. -/
macro "gc_poly_simp" : tactic =>
  `(tactic| simp only [phiD, pd, PolyExpr.deriv, PolyExpr.eval, KamNewton.Dp, KamNewton.nRp,
    KamNewton.nZp, KamNewton.Pap, KamNewton.Pbp,
    DuP, DzP, DphP, nRuP, nRzP, nRphP, nZuP, nZzP, nZphP, PuP, EpP,
    sumE, monoE, npow, Pi.single_apply, Algebra.algebraMap_self, RingHom.id_apply,
    Fin.isValue, eval_npow])

/-- Close a polynomial identity pointwise. -/
macro "gc_close" : tactic =>
  `(tactic| (refine ext_eval fun θ ψ => ?_
             simp only [eval_add', eval_sub', eval_mul, eval_neg', eval_pow', eval_pd, eval_phiD,
               eval_polyExpr, eval_one, eval_ofNat', eval_zero']
             gc_poly_simp
             all_goals (try simp)
             all_goals ring))

/-- `∂_u` of `D`. -/
theorem pd0_D (x : Fin 6 → FA) :
    pd x 0 KamNewton.Dp = PolyExpr.eval x DuP := by
  gc_close

/-- `∂_z` of `D`. -/
theorem pd1_D (x : Fin 6 → FA) :
    pd x 1 KamNewton.Dp = PolyExpr.eval x DzP := by
  gc_close

/-- `∂_φ` of `D`. -/
theorem phiD_D (x : Fin 6 → FA) :
    phiD x KamNewton.Dp = PolyExpr.eval x DphP := by
  gc_close

/-- Symmetry `∂_z∂_u = ∂_u∂_z` for `D`. -/
theorem sym_uz_D (x : Fin 6 → FA) :
    pd x 1 DuP = pd x 0 DzP := by
  gc_close

/-- Symmetry `∂_φ∂_u = ∂_u∂_φ` for `D`. -/
theorem sym_uph_D (x : Fin 6 → FA) :
    phiD x DuP = pd x 0 DphP := by
  gc_close

/-- Symmetry `∂_φ∂_z = ∂_z∂_φ` for `D`. -/
theorem sym_zph_D (x : Fin 6 → FA) :
    phiD x DzP = pd x 1 DphP := by
  gc_close

