set_option linter.style.longLine false in
/-- Proof-term check of the norm node `dU`. -/
theorem kH_dU : normK NH MH WtH KvH trH_dU (1, 0, 0) 136 81 7 6 60 40 30 ≤  := by
  kron2_proof

/-- Proof-term check of the norm node `dU`: a priori `ℓ¹` bound. -/
theorem lH_dU : Ex.majN LH trH_dU < 2 ^ (136 - 1) := by
