module

public import PlasmaLean.Theory.Kinetic.Noether
public import Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv

/-!
# A helically symmetric straight stellarator with all-time orbit confinement

Synthetic, dimensionless straight-stellarator model (infinite aspect ratio, helical
period `π` along `z`, pitch length `h = 1`). The flux function is the rotating ellipse
`ψ = r² + ε ((x₀² - x₁²) cos 2z + 2 x₀ x₁ sin 2z)`, `r² = x₀² + x₁²`, invariant under the
screw motions generated by `K = (-x₁, x₀, 1)`. The field is
`B = |K|⁻² (∇ψ × K + F K)`; `|K|² = r² + 1 ≥ 1`, so there is no singularity.

Results:

* `field_symmetric`: `SymmetricFlux B ∇ψ K` (helical symmetry of the magnetic force);
* `field_firstIntegral`, `field_lines_confined`: `ψ` is an exact field-line first integral
  and every sublevel set is a field-line barrier;
* `region_radius`: for `|ε| ≤ 1/2`, `{ψ ≤ c}` lies in the tube `r² ≤ 2c`;
* `orbit_confined`: with `ε = 1/2`, every full Newton–Lorentz orbit with normalized rigidity
  `m ‖v‖ ≤ |q|/16` starting with `ψ ≤ 1/4` keeps `ψ ≤ 1/2`, hence stays in the tube
  `r² ≤ 1` (never reaching the wall `r² = 2`), for ALL real times;
* `psi_not_axisymmetric`, `field_not_axisymmetric`: neither `ψ` nor `B` is invariant under
  rotation about the axis (for `ε ≠ 0`), while `psi_screw_invariant` checks the helical
  invariance directly.

Scope: exact helical symmetry is the infinite-aspect-ratio idealization of quasi-helical
symmetry (e.g. HSX); toroidal curvature breaks it, which this file does not treat. `B` is
an analytic model field: it is not derived from coils, `∇·B = 0` is not formalized here
(it holds for this construction by the standard helical-symmetry calculation), and no
helical Grad–Shafranov (JFKO) equilibrium relation or MHD stability is claimed. Orbits are
supplied; their existence is not proved.
-/
public section
noncomputable section
namespace PlasmaLean.Design.HelicalStellarator
open PlasmaLean.Fields PlasmaLean.Kinetic WithLp
open scoped RealInnerProductSpace

/-- The helical symmetry generator with unit pitch length. -/
abbrev K : Space → Space := helicalK 1

/-- Squared distance from the axis. -/
@[expose] def r2 (x : Space) : ℝ := x 0 ^ 2 + x 1 ^ 2

/-- Rotating-ellipse helical flux function with ellipticity parameter `ε`. -/
@[expose] def psi (ε : ℝ) (x : Space) : ℝ :=
  r2 x + ε * ((x 0 ^ 2 - x 1 ^ 2) * Real.cos (2 * x 2) +
    2 * (x 0 * x 1) * Real.sin (2 * x 2))

/-- Explicit gradient of `psi`. -/
@[expose] def psiGrad (ε : ℝ) (x : Space) : Space :=
  toLp 2 ![2 * x 0 + ε * (2 * x 0 * Real.cos (2 * x 2) + 2 * x 1 * Real.sin (2 * x 2)),
    2 * x 1 + ε * (-2 * x 1 * Real.cos (2 * x 2) + 2 * x 0 * Real.sin (2 * x 2)),
    ε * (-2 * (x 0 ^ 2 - x 1 ^ 2) * Real.sin (2 * x 2) +
      4 * x 0 * x 1 * Real.cos (2 * x 2))]

/-- The helically symmetric field with ellipticity `ε` and axial strength `F`. -/
@[expose] def field (ε F : ℝ) (x : Space) : Space :=
  (‖K x‖ ^ 2)⁻¹ • (cross (psiGrad ε x) (K x) + F • K x)

/-- The gradient formula, as an actual Fréchet derivative. -/
theorem psi_hasFDerivAt (ε : ℝ) (x : Space) :
    HasFDerivAt (psi ε) (innerSL ℝ (psiGrad ε x)) x := by
  have h0 := (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) 0).hasFDerivAt (x := x)
  have h1 := (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) 1).hasFDerivAt (x := x)
  have h2 := (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) 2).hasFDerivAt (x := x)
  have hc := (h2.const_mul 2).cos
  have hs := (h2.const_mul 2).sin
  have h := ((h0.pow 2).add (h1.pow 2)).add
    ((((h0.pow 2).sub (h1.pow 2)).mul hc).add (((h0.mul h1).const_mul 2).mul hs)
      |>.const_mul ε)
  convert h using 1
  · funext y; rfl
  · ext v
    simp [psiGrad, EuclideanSpace.inner_eq_star_dotProduct, Fin.sum_univ_three, dotProduct]
    ring

/-- `psi` is invariant along the helical generator: `⟪K, ∇ψ⟫ = 0`. -/
theorem psi_invariant (ε : ℝ) (x : Space) : ⟪K x, psiGrad ε x⟫ = 0 := by
  simp [K, helicalK_apply, psiGrad, EuclideanSpace.inner_eq_star_dotProduct, dotProduct,
    Fin.sum_univ_three]
  ring

/-- The helical generator never vanishes: `‖K‖² = r² + 1`. -/
theorem K_norm_sq (x : Space) : ‖K x‖ ^ 2 = r2 x + 1 := by
  rw [K, helicalK_norm_sq, r2]; ring

/-- Helical symmetry of the magnetic force. -/
theorem field_symmetric (ε F : ℝ) : SymmetricFlux (field ε F) (psiGrad ε) K := by
  intro x v
  have hK : ‖K x‖ ^ 2 ≠ 0 := by
    rw [K_norm_sq]; unfold r2; positivity
  exact symmetricFlux_of_cross (K x) (psiGrad ε x) v F (psi_invariant ε x) hK

/-- `ψ` is an exact first integral of the field lines. -/
theorem field_firstIntegral (ε F : ℝ) : FirstIntegralOn (field ε F) (psi ε) Set.univ :=
  (field_symmetric ε F).firstIntegral (psi_hasFDerivAt ε)

/-- Every sublevel set of `ψ` is an all-time forward field-line barrier. -/
theorem field_lines_confined (ε F c : ℝ) :
    FieldLineConfined (field ε F) {x | psi ε x ≤ c} :=
  sublevel_confined (field_firstIntegral ε F) c

/-- The ellipse term is bounded by `r²` (Cauchy–Schwarz with `cos² + sin² = 1`). -/
theorem ellipse_le (x : Space) :
    |(x 0 ^ 2 - x 1 ^ 2) * Real.cos (2 * x 2) + 2 * x 0 * x 1 * Real.sin (2 * x 2)| ≤
      r2 x := by
  have hcs := Real.cos_sq_add_sin_sq (2 * x 2)
  have hr : 0 ≤ r2 x := by unfold r2; positivity
  apply abs_le_of_sq_le_sq' _ hr |> abs_le.mpr
  unfold r2
  nlinarith [sq_nonneg ((x 0 ^ 2 - x 1 ^ 2) * Real.sin (2 * x 2) -
    2 * x 0 * x 1 * Real.cos (2 * x 2))]

/-- For `|ε| ≤ 1/2`, `ψ ≥ r²/2`. -/
theorem psi_ge (ε : ℝ) (hε : |ε| ≤ 1 / 2) (x : Space) : r2 x / 2 ≤ psi ε x := by
  have he := ellipse_le x
  have hr : 0 ≤ r2 x := by unfold r2; positivity
  have hprod := abs_mul ε ((x 0 ^ 2 - x 1 ^ 2) * Real.cos (2 * x 2) +
    2 * x 0 * x 1 * Real.sin (2 * x 2))
  have hb : |ε * ((x 0 ^ 2 - x 1 ^ 2) * Real.cos (2 * x 2) +
      2 * x 0 * x 1 * Real.sin (2 * x 2))| ≤ r2 x / 2 := by
    rw [hprod]
    calc _ ≤ 1 / 2 * r2 x := mul_le_mul hε he (abs_nonneg _) (by norm_num)
      _ = r2 x / 2 := by ring
  unfold psi
  linarith [neg_abs_le (ε * ((x 0 ^ 2 - x 1 ^ 2) * Real.cos (2 * x 2) +
      2 * x 0 * x 1 * Real.sin (2 * x 2)))]

/-- The region `{ψ ≤ c}` lies in the tube `r² ≤ 2c` when `|ε| ≤ 1/2`. -/
theorem region_radius (ε : ℝ) (hε : |ε| ≤ 1 / 2) {c : ℝ} (x : Space) (hx : psi ε x ≤ c) :
    r2 x ≤ 2 * c := by
  have := psi_ge ε hε x
  linarith

/-- On `{ψ ≤ 1}` (with `ε = 1/2`) the symmetry generator has norm at most 2. -/
theorem K_norm_le (x : Space) (hx : psi (1 / 2) x ≤ 1) : ‖K x‖ ≤ 2 := by
  have hr := region_radius (1 / 2) (by norm_num [abs_of_pos]) x hx
  have h2 : ‖K x‖ ^ 2 ≤ 2 ^ 2 := by rw [K_norm_sq]; linarith
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by norm_num) two_ne_zero).mp h2

/-- All-time full-orbit confinement in the helically symmetric straight stellarator:
for every axial strength `F`, mass `m ≠ 0` and charge `q ≠ 0`, an orbit with normalized
rigidity at most `1/16` that starts with `ψ ≤ 1/4` satisfies `ψ ≤ 1/2` and `r² ≤ 1` for
all real times; the wall `r² = 2` is never reached. -/
theorem orbit_confined {F m q : ℝ} (hm : m ≠ 0) (hq : q ≠ 0) {x v : ℝ → Space}
    (h : LorentzOrbit m q (fun _ => 0) (field (1 / 2) F) x v)
    (hrig : |m| * ‖v 0‖ ≤ |q| / 16) (hψ0 : psi (1 / 2) (x 0) ≤ 1 / 4) (t : ℝ) :
    psi (1 / 2) (x t) ≤ 1 / 2 ∧ r2 (x t) ≤ 1 := by
  have hqpos : 0 < |q| := abs_pos.mpr hq
  have hk : |m| * ‖v 0‖ / |q| ≤ 1 / 16 := by
    rw [div_le_iff₀ hqpos]; linarith
  have hk0 : 0 ≤ |m| * ‖v 0‖ / |q| := by positivity
  have hK0 : ‖K (x 0)‖ ≤ 2 := K_norm_le _ (by linarith)
  have hgap : psi (1 / 2) (x 0) + |m| * ‖v 0‖ / |q| * (2 + ‖K (x 0)‖) ≤ 1 / 2 := by
    have : |m| * ‖v 0‖ / |q| * (2 + ‖K (x 0)‖) ≤ 1 / 16 * 4 :=
      mul_le_mul hk (by linarith) (by positivity) (by norm_num)
    linarith
  have hp := noether_orbit_trapped hm hq h (helicalK_killing 1) (psi_hasFDerivAt (1 / 2))
    (field_symmetric (1 / 2) F) (by norm_num : (1 / 2 : ℝ) < 1) (by norm_num) K_norm_le
    hgap t
  refine ⟨hp, ?_⟩
  have := region_radius (1 / 2) (by norm_num [abs_of_pos]) _ hp
  linarith

/-- The flux function is not rotation invariant: a quarter turn changes its value. -/
theorem psi_not_axisymmetric (ε : ℝ) (hε : ε ≠ 0) :
    psi ε (toLp 2 ![1, 0, 0]) ≠ psi ε (toLp 2 ![0, 1, 0]) := by
  intro h
  have h' : ε = -ε := by simpa [psi, r2] using h
  exact hε (by linarith)

/-- The field is not axisymmetric: its axial component, which rotations about the axis
preserve, differs at two points related by a quarter turn (for `ε ≠ 0`). The values are
`(2 + 2ε + F)/2` and `(2 - 2ε + F)/2`; in particular `B ≠ 0` for suitable `F`. -/
theorem field_not_axisymmetric (ε F : ℝ) (hε : ε ≠ 0) :
    field ε F (toLp 2 ![1, 0, 0]) 2 ≠ field ε F (toLp 2 ![0, 1, 0]) 2 := by
  have e1 : field ε F (toLp 2 ![1, 0, 0]) 2 = (2 + 2 * ε + F) / 2 := by
    rw [field, K_norm_sq]
    simp [r2, K, helicalK_apply, psiGrad, cross, crossProduct]
    ring
  have e2 : field ε F (toLp 2 ![0, 1, 0]) 2 = (2 - 2 * ε + F) / 2 := by
    rw [field, K_norm_sq]
    simp [r2, K, helicalK_apply, psiGrad, cross, crossProduct]
    ring
  rw [e1, e2]
  intro h
  exact hε (by linarith)

/-- Screw motion by angle `θ`: rotation about the axis combined with axial shift `θ`. -/
@[expose] def screw (θ : ℝ) (x : Space) : Space :=
  toLp 2 ![x 0 * Real.cos θ - x 1 * Real.sin θ, x 0 * Real.sin θ + x 1 * Real.cos θ, x 2 + θ]

/-- Direct check of helical symmetry: `ψ` is invariant under every screw motion. -/
theorem psi_screw_invariant (ε θ : ℝ) (x : Space) : psi ε (screw θ x) = psi ε x := by
  have hcs := Real.cos_sq_add_sin_sq θ
  have hc2 : Real.cos (2 * (x 2 + θ)) =
      Real.cos (2 * x 2) * (Real.cos θ ^ 2 - Real.sin θ ^ 2) -
        Real.sin (2 * x 2) * (2 * Real.sin θ * Real.cos θ) := by
    rw [mul_add, Real.cos_add, Real.cos_two_mul θ, Real.sin_two_mul θ]
    linear_combination Real.cos (2 * x 2) * hcs
  have hs2 : Real.sin (2 * (x 2 + θ)) =
      Real.sin (2 * x 2) * (Real.cos θ ^ 2 - Real.sin θ ^ 2) +
        Real.cos (2 * x 2) * (2 * Real.sin θ * Real.cos θ) := by
    rw [mul_add, Real.sin_add, Real.cos_two_mul θ, Real.sin_two_mul θ]
    linear_combination Real.sin (2 * x 2) * hcs
  have s0 : screw θ x 0 = x 0 * Real.cos θ - x 1 * Real.sin θ := by simp [screw]
  have s1 : screw θ x 1 = x 0 * Real.sin θ + x 1 * Real.cos θ := by simp [screw]
  have s2 : screw θ x 2 = x 2 + θ := by simp [screw]
  simp only [psi, r2, s0, s1, s2]
  rw [hc2, hs2]
  linear_combination (x 0 ^ 2 + x 1 ^ 2 + ε * ((x 0 ^ 2 - x 1 ^ 2) * Real.cos (2 * x 2) +
    2 * x 0 * x 1 * Real.sin (2 * x 2)) * (Real.cos θ ^ 2 + Real.sin θ ^ 2 + 1)) * hcs

end PlasmaLean.Design.HelicalStellarator
