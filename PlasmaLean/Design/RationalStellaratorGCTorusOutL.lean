/-- The full chain. -/
theorem ballL_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {u z : FA}
    (hU : Bd r (u - xL 4) (EL 4)) (hZ : Bd r (z - xL 5) (EL 5))
    (hA : Bd r (dTh u - xL 6) (EL 6)) (hB : Bd r (dTh z - xL 7) (EL 7)) :
    ∀ i, i < 114 → Bd r (XL u z i - xL i) (EL i) :=
  ballL_114 hr hq hU hZ hA hB

/-- A value is bounded by its centre norm plus its radius. -/
theorem valL_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {u z : FA}
    (hU : Bd r (u - xL 4) (EL 4)) (hZ : Bd r (z - xL 5) (EL 5))
    (hA : Bd r (dTh u - xL 6) (EL 6)) (hB : Bd r (dTh z - xL 7) (EL 7))
    (i : ℕ) (hi : i < 114) :
    Bd r (XL u z i) ((BL i + EL i : ℚ) : ℝ) := by
  have := (normL hq i hi).add (ballL_all hr hq hU hZ hA hB i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

