/-- The torus point `(u, z, cos 2φ, sin 2φ, 0, 0)` (`KL u z = xB u z`). -/
abbrev KL (u z : FA) : Fin 6 → FA := xB u z

/-- `pd0_D` in derivative form. -/
theorem dpd0_D (x : Fin 6 → FA) :
    PolyExpr.deriv x (Pi.single 0 1) KamNewton.Dp = PolyExpr.eval x DuP := pd0_D x

