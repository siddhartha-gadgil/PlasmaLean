  PlasmaLean.Certificates.Kron2 WEll1Z2 Complex

/-- The full chain. -/
theorem ballHE3_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) :
    ∀ i, i < 99 → Bd r (XHE3 c i - xHE3 c i) (EHE3 i) :=
  ballHE3_99 hr hq hc

/-- A value is bounded by its centre norm plus its radius. -/
theorem valHE3_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1)
    (i : ℕ) (hi : i < 99) :
    Bd r (XHE3 c i) ((BHE3 i + EHE3 i : ℚ) : ℝ) := by
  have := (normHE3 hq hc i hi).add (ballHE3_all hr hq hc i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

