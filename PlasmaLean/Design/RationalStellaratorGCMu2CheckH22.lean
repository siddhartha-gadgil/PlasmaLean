/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH22`)

The checks of `Design/RationalStellaratorGCMu2CheckH22` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m03`. -/
theorem cHMS_m03 : center3KS KvSHM NHM MHM 17 112 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m03`. -/
theorem clHM_m03 : LHM 17 < 2 ^ (112 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `R3`. -/
theorem cHMS_R3 : center3KS KvSHM NHM MHM 59 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `R3`. -/
theorem clHM_R3 : LHM 59 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m41`: truncation norm. -/
theorem kHMS_m41 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m41 (1 : Int) 1 0 25 225 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m41`: a priori `ℓ¹` bound. -/
theorem lHM_m41 : nodeL1N SHM LHM trHMN_m41 (1 : Int) 1 0 25 < 2 ^ (225 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
