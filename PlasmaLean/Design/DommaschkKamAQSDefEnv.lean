/-- The Kronecker images of the variable polynomials. -/
def KvQ (b W : ℕ) : ℕ → ℤ
  | 0 => (2 : ℤ) ^ SA * ((1 <<< (b * (NA + W * MA)) : ℕ) : ℤ)
  | 1 => 2 * ((1 <<< (b * W) : ℕ) : ℤ)
  | 2 => ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) + 1
  | 3 => ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) - 1
  | n + 4 => packGridNM b W NA (gQ (n + 4)) (2 * MA + 1)

/-- The honest centres. -/
def xQ (i : ℕ) : FA := ctr SA NA MA (WtQ i) (PlQ i)

/-- The Adm lists have 195 entries. -/
theorem gAl_length : gAl.length = 195 := by rfl

/-- The Adm grids are kept. -/
theorem gQ_lt {i : ℕ} (h : i < 195) : gQ i = gA i := by
  unfold gQ gQl gA
  rw [List.getD_append _ _ _ _ (by rw [gAl_length]; exact h)]

/-- The Adm weights are kept. -/
theorem WtQ_lt {i : ℕ} (h : i < 195) : WtQ i = WtA i := by
  unfold WtQ WtQl WtA
  rw [List.getD_append _ _ _ _ (by rw [show WtAl.length = 195 by rfl]; exact h)]

/-- The Adm `ℓ¹` bounds are kept. -/
theorem LQ_lt {i : ℕ} (h : i < 195) : LQ i = LA i := by
  unfold LQ LQl LA
  rw [List.getD_append _ _ _ _ (by rw [show LAl.length = 195 by rfl]; exact h)]

/-- The Adm polynomials are kept. -/
theorem PlQ_lt {i : ℕ} (h : i < 195) : PlQ i = PlA i := by
  match i, h with
  | 0, _ => rfl
  | 1, _ => rfl
  | 2, _ => rfl
  | 3, _ => rfl
  | n + 4, h => simp only [PlQ, PlA, gQ_lt h]

/-- **The Adm centres are kept.** -/
theorem xQ_lt {i : ℕ} (h : i < 195) : xQ i = xA i := by
  simp only [xQ, xA, WtQ_lt h, PlQ_lt h]

/-- The phases are below `4`. -/
theorem hWQ : ∀ i, (WtQ i).2.2 < 4 :=
  getD_prop (Pr := fun w : ℕ × ℕ × ℕ => w.2.2 < 4) (by kernel_fact) (by kernel_fact)

/-- Degree boxes. -/
theorem boxQ : ∀ i, InBox (PlQ i) (BxA i).1 (BxA i).2
  | 0 => InBox.monomial NA MA _
  | 1 => InBox.monomial 0 1 _
  | 2 => box_sPoly
  | 3 => box_cPoly
  | _ + 4 => box_gridPolyNM NA MA _

/-- The grids vanish beyond the last variable. -/
theorem gQ_out (n : ℕ) : gQ (n + 245) = fun _ _ => 0 := by
  unfold gQ
  have h : gQl.length = 245 := by rfl
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by omega)]
  rfl

/-- `ℓ¹` bounds of the Adm variables. -/
theorem l1Q_195 : ∀ i, i < 195 → l1 (PlQ i) ≤ LQ i := fun i h => by
  rw [PlQ_lt h, LQ_lt h]; exact l1A i

