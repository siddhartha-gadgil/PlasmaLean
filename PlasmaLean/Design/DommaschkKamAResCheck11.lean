module

public import PlasmaLean.Design.DommaschkKamAResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAResTrees

/-!
# Proof-term checks of the torus-A residual chain (part 11)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamAResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_G1`, `kH_Gc0`, `kH_G0`, `kH_Fc8`, `kH_Fc7`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `G1`: truncation norm. -/
theorem kH_G1 : nodeKw 68553 16 SH NH MH WtH KvH trH_G1 (1 : ℤ) 1 0 46 277 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `G1`: a priori `ℓ¹` bound. -/
theorem lH_G1 : nodeL1 SH LH trH_G1 (1 : ℤ) 1 0 46 < 2 ^ (277 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc0`: truncation norm. -/
theorem kH_Gc0 : nodeKw 68553 16 SH NH MH WtH KvH trH_Gc0 (537600000000000 : ℤ) 0 3 47 193 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Gc0`: a priori `ℓ¹` bound. -/
theorem lH_Gc0 : nodeL1 SH LH trH_Gc0 (537600000000000 : ℤ) 0 3 47 < 2 ^ (193 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `G0`: truncation norm. -/
theorem kH_G0 : nodeKw 68553 16 SH NH MH WtH KvH trH_G0 (1 : ℤ) 1 0 48 276 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `G0`: a priori `ℓ¹` bound. -/
theorem lH_G0 : nodeL1 SH LH trH_G0 (1 : ℤ) 1 0 48 < 2 ^ (276 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc8`: truncation norm. -/
theorem kH_Fc8 : nodeKw 68553 16 SH NH MH WtH KvH trH_Fc8 (215040000000000 : ℤ) 0 3 49 184 193 8 8 163 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc8`: a priori `ℓ¹` bound. -/
theorem lH_Fc8 : nodeL1 SH LH trH_Fc8 (215040000000000 : ℤ) 0 3 49 < 2 ^ (184 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc7`: truncation norm. -/
theorem kH_Fc7 : nodeKw 68553 16 SH NH MH WtH KvH trH_Fc7 (268800000000000 : ℤ) 0 3 50 193 193 8 8 166 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc7`: a priori `ℓ¹` bound. -/
theorem lH_Fc7 : nodeL1 SH LH trH_Fc7 (268800000000000 : ℤ) 0 3 50 < 2 ^ (193 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamA
