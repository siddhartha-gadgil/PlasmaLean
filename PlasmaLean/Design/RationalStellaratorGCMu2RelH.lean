    true, true, true, true, true, true, true]

/-- The shared variables. -/
def relHM (i : ℕ) : Bool := relHMl.getD i false

/-- The values of the variables of the high-resolution pipeline only. -/
def XHMspec (c : ℂ) : ℕ → FA
  | 6 => (2 : ℂ) ^ 96 • Lt KamTorusA.iota (xHM c 4)
  | 7 => (2 : ℂ) ^ 96 • Lt KamTorusA.iota (xHM c 5)
  | 8 => dTh (xHM c 4)
  | 9 => dTh (xHM c 5)
  | 10 => xLM c 4
  | 11 => xLM c 5
  | 12 => dTh (xLM c 4)
  | 13 => dTh (xLM c 5)
  | 52 => xHM c 52
  | 53 => xHM c 52 ^ 2
  | 79 => xHM c 79
  | 80 => xHM c 79 ^ 2
  | 86 => xHM c 86
  | 87 => xHM c 86 ^ 2
  | _ => 0

/-- **The true values of the high-resolution family pipeline** at the parameter `w = c`. -/
def XHM (c : ℂ) (i : ℕ) : FA :=
  if relHM i = true then XLM c (xHM c 4) (xHM c 5) (lmapHM i) else XHMspec c i

/-- The values of the shared variables. -/
theorem XHM_rel (c : ℂ) {i : ℕ} (h : relHM i = true) :
    XHM c i = XLM c (xHM c 4) (xHM c 5) (lmapHM i) := by
  simp [XHM, h]

/-- The values of the other variables. -/
theorem XHM_spec (c : ℂ) {i : ℕ} (h : relHM i = false) : XHM c i = XHMspec c i := by
  simp [XHM, h]

/-- The low-resolution variables whose renaming is shared. -/
def pHM (j : ℕ) : Bool := relHM (hmapHM j) && (lmapHM (hmapHM j) == j)

/-- The values at renamed variables. -/
theorem XHM_hmap (c : ℂ) :
    ∀ j, pHM j = true → XHM c (hmapHM j) = XLM c (xHM c 4) (xHM c 5) j := by
  intro j h
  simp only [pHM, Bool.and_eq_true, beq_iff_eq] at h
  rw [XHM_rel c h.1, h.2]

