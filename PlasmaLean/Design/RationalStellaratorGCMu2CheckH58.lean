module

public import PlasmaLean.Design.RationalStellaratorGCMu2TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu2KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH58`)

The checks of `Design/RationalStellaratorGCMu2CheckH58` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `qz`. -/
theorem cHMS_qz : center3KS KvSHM NHM MHM 48 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `qz`. -/
theorem clHM_qz : LHM 48 < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `dU`. -/
theorem kHMS_dU : norm3KS WtHM KvSHM NHM MHM trHMN_dU (1, 0, 0) 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `dU`: a priori `ℓ¹` bound. -/
theorem lHM_dU : ExN.majN LHM trHMN_dU < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `DzP`: truncation norm. -/
theorem kHMS_DzP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_DzP (8 : Int) 0 1 33 125 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `DzP`: a priori `ℓ¹` bound. -/
theorem lHM_DzP : nodeL1N SHM LHM trHMN_DzP (8 : Int) 0 1 33 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `R4`: truncation norm. -/
theorem kHMS_R4 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_R4 (1 : Int) 1 0 73 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R4`: a priori `ℓ¹` bound. -/
theorem lHM_R4 : nodeL1N SHM LHM trHMN_R4 (1 : Int) 1 0 73 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
