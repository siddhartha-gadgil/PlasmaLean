/-- Kernel check of the node `P42`: a priori `ℓ¹` bound. -/
theorem lHM_P42 : nodeL1N SHM LHM trHMN_P42 (1 : Int) 1 0 75 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
