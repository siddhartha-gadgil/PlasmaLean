module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 34)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMuDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `Dp`. -/
theorem cHM_Dp : center3KN KvHM NHM MHM 29 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Dp`. -/
theorem clHM_Dp : LHM 29 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `P42`. -/
theorem cHM_P42 : center3KN KvHM NHM MHM 75 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `P42`. -/
theorem clHM_P42 : LHM 75 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `R3`: truncation norm. -/
theorem kHM_R3 : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_R3 (1 : Int) 1 0 59 239 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R3`: a priori `ℓ¹` bound. -/
theorem lHM_R3 : nodeL1N SHM LHM trHMN_R3 (1 : Int) 1 0 59 < 2 ^ (239 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
