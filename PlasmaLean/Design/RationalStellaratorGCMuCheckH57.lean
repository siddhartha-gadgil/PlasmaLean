module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH
public import PlasmaLean.Design.RationalStellaratorGCMuKvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMuTreesH
meta import PlasmaLean.Design.RationalStellaratorGCMuKvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMuCheckH57`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `YnZt`. -/
theorem cHMS_YnZt : center3KS KvSHM NHM MHM 94 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `YnZt`. -/
theorem clHM_YnZt : LHM 94 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `dB`. -/
theorem kHMS_dB : norm3KS WtHM KvSHM NHM MHM trHMN_dB (1, 0, 0) 126 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `dB`: a priori `ℓ¹` bound. -/
theorem lHM_dB : ExN.majN LHM trHMN_dB < 2 ^ (126 - 1) := by
  kron_lt

/-- Proof-term check of the node `R2`: truncation norm. -/
theorem kHMS_R2 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_R2 (1 : Int) 1 0 58 236 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `R2`: a priori `ℓ¹` bound. -/
theorem lHM_R2 : nodeL1N SHM LHM trHMN_R2 (1 : Int) 1 0 58 < 2 ^ (236 - 1) := by
  kron_lt

/-- Proof-term check of the node `P4P`: truncation norm. -/
theorem kHMS_P4P : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_P4P (1 : Int) 0 0 72 124 73 55 25 11 8 10 36 27 ≤
    0 := by
  kron_proof

/-- Proof-term check of the node `P4P`: a priori `ℓ¹` bound. -/
theorem lHM_P4P : nodeL1N SHM LHM trHMN_P4P (1 : Int) 0 0 72 < 2 ^ (124 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
