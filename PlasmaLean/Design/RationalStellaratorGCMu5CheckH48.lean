module

public import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu5CheckH48`)

The checks of `Design/RationalStellaratorGCMu5CheckH48` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu5LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `RDu`. -/
theorem cHMS_RDu : center3KS KvSHM NHM MHM 43 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `RDu`. -/
theorem clHM_RDu : LHM 43 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `Fv`. -/
theorem cHMS_Fv : center3KS KvSHM NHM MHM 89 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Fv`. -/
theorem clHM_Fv : LHM 89 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `Fv`: truncation norm. -/
theorem kHMS_Fv : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_Fv (2 : Int) 1 0 89 242 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `Fv`: a priori `ℓ¹` bound. -/
theorem lHM_Fv : nodeL1N SHM LHM trHMN_Fv (2 : Int) 1 0 89 < 2 ^ (242 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu5
