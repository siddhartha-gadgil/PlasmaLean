/-- **The residual of the energy-window torus family** (`R`-component): for every scaled
gyro-length `|s| ≤ 1` and every pitch parameter `λ = lamF c`, `‖D̃ 𝓛K − ñ‖_{r_A} ≤ e₀` for the field
at `ρ = 1/256 + s 2⁻³²`. -/
theorem ewResR_family {s : ℝ} (hs : |s| ≤ 1) {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA ((gcFlowMu (1 / 256 + s * hEw) (lamF c)).resR KamTorusA.iota (uEw s c)
      (zEw s c)) e0E := by
  have hU := ana_UEw hc
  have hZ := ana_ZEw hc
  have hl : |lamF c| ≤ RationalStellaratorGCMu.lam1 := abs_lamF_le hc
  have hD0 : ∀ i, (0 : ℝ) ≤ (RationalStellaratorGCMu.aDQ i : ℝ) := fun i => by
    have := (show ∀ i, (0 : ℚ) ≤ RationalStellaratorGCMu.aDQ i by decide +kernel) i
    exact_mod_cast this
  obtain ⟨vR, vCR, mR, vZ, vCZ, mZ⟩ :=
    RationalStellaratorGCMu.ewD_valid_maj hD0 (fun _ => le_rfl) hl
  have hab : ∀ i, ∑ k : Fin 4, ((2 ^ 20 : NNReal) : ℝ) ^ k.val * bEw k i ≤
      (RationalStellaratorGCMu.aDQ i : ℝ) := by
    intro i; fin_cases i <;>
      simp [Fin.sum_univ_four, bEw, RationalStellaratorGCMu.aDQ] <;> norm_num
  have he : ∀ j, Bd KamTorusA.rA (interpF (inputsEw (UEw c) (ZEw c))
      (gcFlowMu (1 / 256) (lamF c)).resRp (corrR (lamF c)) hEw (tEw j)) (eREw j) := by
    intro j
    rw [← resR_combEw hU hZ, combEw_node, combEw_node]
    obtain ⟨r1, r2, r3, r4⟩ := rhoEw_center
    fin_cases j
    · simp only [eREw, Fin.zero_eta, Matrix.cons_val_zero]; rw [← r1]
      exact (ewResR_1 hc).le (by norm_num)
    · simp only [eREw, Fin.mk_one, Matrix.cons_val_one, Matrix.head_cons]; rw [← r2]
      exact (ewResR_2 hc).le (by norm_num)
    · simp only [eREw, Fin.reduceFinMk, Matrix.cons_val]; rw [← r3]
      exact (ewResR_3 hc).le (by norm_num)
    · simp only [eREw, Fin.reduceFinMk, Matrix.cons_val]; rw [← r4]
      exact (ewResR_4 hc).le (by norm_num)
  have hI := Bd_interp rA_nonneg' (inputsEw (UEw c) (ZEw c)) bEw (inputsEw_bd hc)
    (R := 2 ^ 20) (by norm_num) hab vR vCR (κ := hEw) (by norm_num [hEw])
    (by push_cast at mR ⊢; exact mR) tEw (wEw s) eREw s (ρ := 1) (Λ := 2) (by norm_num)
    (fun j => by fin_cases j <;> norm_num [tEw]) hs
    (wEw_leb s (abs_le.mp hs).1 (abs_le.mp hs).2) (wEw_exact s) he
  rw [uEw, zEw, resR_combEw hU hZ]
  refine hI.le ?_
  have hw := wEw_leb s (abs_le.mp hs).1 (abs_le.mp hs).2
  have hsum : ∑ j, |wEw s j| * eREw j ≤ (∑ j, |wEw s j|) * (628125 / 309485009821345068724781056 : ℝ) := by
    rw [Finset.sum_mul]
    refine Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
    fin_cases j <;> norm_num [eREw]
  have h2 : (∑ j, |wEw s j|) * (628125 / 309485009821345068724781056 : ℝ) ≤ 2 * (628125 / 309485009821345068724781056 : ℝ) :=
    mul_le_mul_of_nonneg_right hw (by norm_num)
  have hrem : (1 + 2) * (547 / 500 : ℝ) * (1 / ((2 ^ 20 : NNReal) : ℝ)) ^ 4 / (1 - 1 / ((2 ^ 20 : NNReal) : ℝ)) ≤
      7 / 10 ^ 21 - 2 * (628125 / 309485009821345068724781056 : ℝ) := by
    push_cast; norm_num
  rw [e0E]
  linarith

