theorem cHM_thUe : center3KN KvHM NHM MHM 12 125 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thUe`. -/
theorem clHM_thUe : LHM 12 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `Vn`. -/
theorem cHM_Vn : center3KN KvHM NHM MHM 54 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Vn`. -/
theorem clHM_Vn : LHM 54 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `m30`: truncation norm. -/
theorem kHM_m30 : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_m30 (1 : Int) 1 0 20 232 145 109 49 13 8 19 72 54 ≤
