module

public import PlasmaLean.Design.RationalStellaratorGCFamTreesH

/-!
# Kernel checks of the guiding-centre torus family certificate (high resolution, part 9)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCFamDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/fam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `thZ`. -/
theorem cHF_thZ : center3KN KvHF NHF MHF 9 125 73 55 21 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thZ`. -/
theorem clHF_thZ : LHF 9 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `RDu`. -/
theorem cHF_RDu : center3KN KvHF NHF MHF 43 123 73 55 21 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `RDu`. -/
theorem clHF_RDu : LHF 43 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `W3`. -/
theorem cHF_W3 : center3KN KvHF NHF MHF 57 123 73 55 21 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `W3`. -/
theorem clHF_W3 : LHF 57 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nRtF`. -/
theorem cHF_nRtF : center3KN KvHF NHF MHF 75 118 73 55 21 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nRtF`. -/
theorem clHF_nRtF : LHF 75 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `PuP`: truncation norm. -/
theorem kHF_PuP : node3KN SHF NHF MHF DHF WtHF KvHF trHFN_PuP (1 : Int) 0 0 41 124 73 55 21 11 8 10 36 27 ≤
    0 := by
  decide +kernel

/-- Kernel check of the node `PuP`: a priori `ℓ¹` bound. -/
theorem lHF_PuP : nodeL1N SHF LHF trHFN_PuP (1 : Int) 0 0 41 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `q`: truncation norm. -/
theorem kHF_q : node3KN SHF NHF MHF DHF WtHF KvHF trHFN_q (1 : Int) 1 0 46 242 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `q`: a priori `ℓ¹` bound. -/
theorem lHF_q : nodeL1N SHF LHF trHFN_q (1 : Int) 1 0 46 < 2 ^ (242 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `KZ`: truncation norm. -/
theorem kHF_KZ : node3KN SHF NHF MHF DHF WtHF KvHF trHFN_KZ (1 : Int) 1 0 67 243 145 109 41 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `KZ`: a priori `ℓ¹` bound. -/
theorem lHF_KZ : nodeL1N SHF LHF trHFN_KZ (1 : Int) 1 0 67 < 2 ^ (243 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
