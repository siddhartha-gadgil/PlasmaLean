/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw1CheckH29`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `PuP`. -/
theorem cHE1S_PuP : center3KS KvSHE1 NHE1 MHE1 41 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `PuP`. -/
theorem clHE1_PuP : LHE1 41 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `nZtJ`. -/
theorem cHE1S_nZtJ : center3KS KvSHE1 NHE1 MHE1 98 118 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nZtJ`. -/
theorem clHE1_nZtJ : LHE1 98 < 2 ^ (118 - 1) := by
  kron_lt

/-- Proof-term check of the node `RD`: truncation norm. -/
theorem kHE1S_RD : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_RD (1 : Int) 1 0 42 239 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `RD`: a priori `ℓ¹` bound. -/
theorem lHE1_RD : nodeL1N SHE1 LHE1 trHE1N_RD (1 : Int) 1 0 42 < 2 ^ (239 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
