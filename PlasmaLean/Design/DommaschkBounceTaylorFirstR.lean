/-- Real range follows from the constant coefficient and all nonconstant terms. -/
theorem dnR_range {t y : ℝ} (ht : |t| ≤ 1) (h : dnR0.Mem t y) :
    (-1161382918063492137276 : ℝ) / 2^80 ≤ y ∧ y ≤ (13871371014675509244 : ℝ) / 2^80 := by
  have hr := dyadic_range ht (show (ofDyadic 80 [-573755773524408314016, -574238828533191083750, -724448688461623541, -241259864958095589, 167254391463494, 33431646940841, -9709064974, -1290369787] (12422406755435181284)).Mem t y from h)
  have mass : (magnitude
      ([-574238828533191083750, -724448688461623541, -241259864958095589, 167254391463494, 33431646940841, -9709064974, -1290369787].map fun (z : ℤ) => (z : ℚ))) = 575204737783648641976 :=
    eq_of_beq (by kernel_fact)
  rw [mass, abs_le] at hr
  norm_num at hr ⊢
  constructor <;> linarith

end PlasmaLean.Design.DommaschkBounceTaylorFirst
