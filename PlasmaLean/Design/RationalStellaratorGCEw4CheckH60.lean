/-- Proof-term check of the norm node `dU`. -/
theorem kHE4S_dU : norm3KS WtHE4 KvSHE4 NHE4 MHE4 trHE4N_dU (1, 0, 0) 120 73 55 25 11 8 10 36 27 ≤
