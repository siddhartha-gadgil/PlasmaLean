/-- The low-resolution family chain at its own centre. -/
theorem muL_inputs : Bd KamTorusA.rA (xLM c 4 - xLM c 4) (ELM 4) ∧
    Bd KamTorusA.rA (xLM c 5 - xLM c 5) (ELM 5) ∧
    Bd KamTorusA.rA (dTh (xLM c 4) - xLM c 6) (ELM 6) ∧
    Bd KamTorusA.rA (dTh (xLM c 5) - xLM c 7) (ELM 7) := by
  have hc0 := ne_zero_of_norm_one_mu hc
  have hA6 : xLM c 6 = dTh (xLM c 4) := by rw [xLM_der_A hc0]; simp [dTh]
  have hB7 : xLM c 7 = dTh (xLM c 5) := by rw [xLM_der_B hc0]; simp [dTh]
  have z : ∀ i, Bd KamTorusA.rA (0 : FA) (ELM i) := fun i => (Bd_zero _).le (by
    have := (show ∀ i, (0 : ℚ) ≤ ELM i from getD_prop (Pr := fun q : ℚ => 0 ≤ q)
      (by decide +kernel) le_rfl) i
    exact_mod_cast this)
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [sub_self]; exact z 4
  · rw [sub_self]; exact z 5
  · rw [hA6, sub_self]; exact z 6
  · rw [hB7, sub_self]; exact z 7

/-- `u_L − u_S`: the low-resolution `λ`-family torus against the stored `μ = 0`,
`ρ = 1/256` low-resolution torus. -/
theorem muL_old_u : Bd KamTorusA.rA (xLM c 4 - xL 4) ((4263 / 5000000 : ℚ) : ℝ) := by
  obtain ⟨hU, hZ, hA, hB⟩ := muL_inputs hc
  have h := normLM_dUo rA_nonneg' exp_rA_le' hc hU hZ hA hB
  have e4 : XLM c (xLM c 4) (xLM c 5) 4 = xLM c 4 := rfl
  have e138 : XLM c (xLM c 4) (xLM c 5) 176 = xL 4 := rfl
  simpa [trLMN_dUo, toEx, Ex.eval, e4, e138] using h

/-- `z_L − z_S`. -/
theorem muL_old_z : Bd KamTorusA.rA (xLM c 5 - xL 5) ((663 / 10 ^ 6 : ℚ) : ℝ) := by
  obtain ⟨hU, hZ, hA, hB⟩ := muL_inputs hc
  have h := normLM_dZo rA_nonneg' exp_rA_le' hc hU hZ hA hB
  have e5 : XLM c (xLM c 4) (xLM c 5) 5 = xLM c 5 := rfl
  have e139 : XLM c (xLM c 4) (xLM c 5) 177 = xL 5 := rfl
  simpa [trLMN_dZo, toEx, Ex.eval, e5, e139] using h

/-- `∂_θ u_L − ∂_θ u_S`. -/
theorem muL_old_a : Bd KamTorusA.rA (dTh (xLM c 4) - dTh (xL 4)) ((447 / 625000 : ℚ) : ℝ) := by
  obtain ⟨hU, hZ, hA, hB⟩ := muL_inputs hc
  have h := normLM_dAo rA_nonneg' exp_rA_le' hc hU hZ hA hB
  have e6 : XLM c (xLM c 4) (xLM c 5) 6 = dTh (xLM c 4) := rfl
  have e140 : XLM c (xLM c 4) (xLM c 5) 178 = dTh (xL 4) := rfl
  simpa [trLMN_dAo, toEx, Ex.eval, e6, e140] using h

/-- `∂_θ z_L − ∂_θ z_S`. -/
theorem muL_old_b : Bd KamTorusA.rA (dTh (xLM c 5) - dTh (xL 5)) ((6793 / 10 ^ 7 : ℚ) : ℝ) := by
  obtain ⟨hU, hZ, hA, hB⟩ := muL_inputs hc
  have h := normLM_dBo rA_nonneg' exp_rA_le' hc hU hZ hA hB
  have e7 : XLM c (xLM c 4) (xLM c 5) 7 = dTh (xLM c 5) := rfl
  have e141 : XLM c (xLM c 4) (xLM c 5) 179 = dTh (xL 5) := rfl
  simpa [trLMN_dBo, toEx, Ex.eval, e7, e141] using h

/-- **`‖u(λ) − u₀‖ ≤ 1.85 × 10⁻³`**: the family torus is close to the `μ = 0` torus. -/
theorem muOld_u : Bd KamTorusA.rA (xHM c 4 - u₀G) (185 / 100000) :=
  (Bd_three_mu (mdist_u hc) (muL_old_u hc) dist_u).le (margin_le_mu (by decide +kernel))

