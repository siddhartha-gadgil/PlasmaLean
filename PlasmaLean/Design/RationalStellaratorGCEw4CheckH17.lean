/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw4CheckH17`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `Dp`. -/
theorem cHE4S_Dp : center3KS KvSHE4 NHE4 MHE4 29 122 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `Dp`. -/
theorem clHE4_Dp : LHE4 29 < 2 ^ (122 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `N0`. -/
theorem cHE4S_N0 : center3KS KvSHE4 NHE4 MHE4 86 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `N0`. -/
theorem clHE4_N0 : LHE4 86 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the node `m03`: truncation norm. -/
theorem kHE4S_m03 : node3KS SHE4 NHE4 MHE4 DHE4 WtHE4 KvSHE4 trHE4N_m03 (1 : Int) 1 0 17 232 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m03`: a priori `ℓ¹` bound. -/
theorem lHE4_m03 : nodeL1N SHE4 LHE4 trHE4N_m03 (1 : Int) 1 0 17 < 2 ^ (232 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
