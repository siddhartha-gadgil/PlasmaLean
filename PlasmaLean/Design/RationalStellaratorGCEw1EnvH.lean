/-!
# The high-resolution environment of the `μ > 0` passing guiding-centre torus family certificate

The variable polynomials `PHE1 i` (three variables: `θ`-, `ψ`-modes and the Chebyshev variable
`w`), their degree boxes (`boxHE1`), static `ℓ¹` bounds (`l1HE1`) and Kronecker images (`kronHE1`);
the family centres `xHE1 c i` at the parameter `w = c`; the norm bounds `BHE1 i` of the centres and
the radii `EHE1 i` of the balls (supplied by the oracle, checked in
`Design/RationalStellaratorGCEw1CheckH*`).
Generated by `scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 1: gyro-length `ρ_1 = 1/256 − 2⁻³²`, its own family torus `K_1(λ)`; the
fields at `ρ_1` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section
noncomputable section

set_option linter.style.longLine false

namespace PlasmaLean.Design.RationalStellaratorGC

open Polynomial PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall PlasmaLean.Certificates.KronBallCheb PlasmaLean.Theory.KAM

/-- **The variable polynomials** of the family pipeline (by kind, `kindHE1`). -/
def PHE1 (i : ℕ) : P3 :=
  match kindHE1 i with
  | 0 => T3 SHE1 NHE1 MHE1 DHE1
  | 1 => V3
  | 2 => C cPoly
  | 3 => C sPoly
  | 4 => Pr3 SHE1 NHE1 MHE1 DHE1
  | 5 => 0
  | _ => famPoly NHE1 MHE1 DHE1 (if oddHE1 i then -1 else 1) (c0HE1 i : ℤ) 0 0 0 (famHE1 i)

/-- The kinds are at most `6`. -/
theorem kindHE1_le (i : ℕ) : kindHE1 i ≤ 6 :=
  getD_prop (Pr := fun k : ℕ => k ≤ 6) (by decide +kernel) (by decide +kernel) i

set_option maxRecDepth 100000 in
/-- The variables beyond the last have kind `5` (zero). -/
theorem kindHE1_ge {i : ℕ} (h : 99 ≤ i) : kindHE1 i = 5 := by
  unfold kindHE1
  rw [List.getD_eq_getElem?_getD,
    List.getElem?_eq_none ((by decide +kernel : kindHE1l.length = 99).trans_le h)]
  rfl

/-- Stored families are below the last variable. -/
theorem lt_of_kindHE1 {i : ℕ} (h : kindHE1 i = 6) : i < 99 := by
  by_contra h'
  rw [kindHE1_ge (by omega)] at h
  exact absurd h (by decide +kernel)

set_option maxRecDepth 100000 in
/-- The static conditions of the stored families. -/
theorem staticHE1 : ∀ i, i < 99 → kindHE1 i = 6 →
    FamStatic NHE1 MHE1 DHE1 ddHE1 drHE1 dwHE1 (famHE1 i) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The minimal widths of the fast images. -/
theorem dynHE1 : ∀ i, i < 99 → kindHE1 i = 6 →
    FamDyn (bMinHE1 i) (wMinHE1 i) (c0HE1 i) (famHE1 i) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The static `ℓ¹` bounds of the stored families. -/
theorem l1famHE1 : ∀ i, i < 99 → kindHE1 i = 6 →
    famL1 NHE1 MHE1 (c0HE1 i : ℤ) 0 0 0 (famHE1 i) ≤ LHE1 i := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The degree boxes of the stored families. -/
theorem bx6HE1 : ∀ i, i < 99 → kindHE1 i = 6 → BxHE1 i = (2 * NHE1, 2 * MHE1, 2 * DHE1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The degree box and bound of `t`. -/
theorem bx0HE1 : ∀ i, i < 99 → kindHE1 i = 0 → BxHE1 i = (NHE1, MHE1, DHE1) ∧ 2 ^ SHE1 ≤ LHE1 i := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The degree box and bound of `V`. -/
theorem bx1HE1 : ∀ i, i < 99 → kindHE1 i = 1 → BxHE1 i = (0, 1, 0) ∧ 2 ≤ LHE1 i := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The degree box and bound of `cos 2φ`. -/
theorem bx2HE1 : ∀ i, i < 99 → kindHE1 i = 2 → BxHE1 i = (0, 2, 0) ∧ 2 ≤ LHE1 i := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The degree box and bound of `sin 2φ`. -/
theorem bx3HE1 : ∀ i, i < 99 → kindHE1 i = 3 → BxHE1 i = (0, 2, 0) ∧ 2 ≤ LHE1 i := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The degree box and bound of the parameter. -/
theorem bx4HE1 : ∀ i, i < 99 → kindHE1 i = 4 →
    BxHE1 i = (NHE1, MHE1, DHE1 + 1) ∧ 2 ^ (SHE1 + 6) + 2 * 2 ^ (SHE1 - 1) ≤ LHE1 i := by
  decide +kernel

/-- The polynomial of `t`. -/
theorem PHE1_k0 {i : ℕ} (h : kindHE1 i = 0) : PHE1 i = T3 SHE1 NHE1 MHE1 DHE1 := by
  unfold PHE1; rw [h]; rfl
/-- The polynomial of `V`. -/
theorem PHE1_k1 {i : ℕ} (h : kindHE1 i = 1) : PHE1 i = V3 := by unfold PHE1; rw [h]; rfl
/-- The polynomial of `cos 2φ`. -/
theorem PHE1_k2 {i : ℕ} (h : kindHE1 i = 2) : PHE1 i = C cPoly := by unfold PHE1; rw [h]; rfl
/-- The polynomial of `sin 2φ`. -/
theorem PHE1_k3 {i : ℕ} (h : kindHE1 i = 3) : PHE1 i = C sPoly := by unfold PHE1; rw [h]; rfl
/-- The polynomial of the parameter. -/
theorem PHE1_k4 {i : ℕ} (h : kindHE1 i = 4) : PHE1 i = Pr3 SHE1 NHE1 MHE1 DHE1 := by
  unfold PHE1; rw [h]; rfl
/-- The polynomial of a dummy variable. -/
theorem PHE1_k5 {i : ℕ} (h : kindHE1 i = 5) : PHE1 i = 0 := by unfold PHE1; rw [h]; rfl

/-- The polynomial of a stored family. -/
theorem PHE1_fam {i : ℕ} (h : kindHE1 i = 6) :
    PHE1 i = famPoly NHE1 MHE1 DHE1 (if oddHE1 i then -1 else 1) (c0HE1 i : ℤ) 0 0 0 (famHE1 i) := by
  unfold PHE1; rw [h]; rfl

/-- The image of `t`. -/
theorem KvHE1_k0 {b W R i : ℕ} (h : kindHE1 i = 0) : KvHE1 b W R i =
    ((1 <<< SHE1 : ℕ) : ℤ) * ((1 <<< (b * (NHE1 + W * (MHE1 + R * DHE1))) : ℕ) : ℤ) := by
  unfold KvHE1; rw [h]; rfl
/-- The image of `V`. -/
theorem KvHE1_k1 {b W R i : ℕ} (h : kindHE1 i = 1) :
    KvHE1 b W R i = 2 * ((1 <<< (b * W) : ℕ) : ℤ) := by
  unfold KvHE1; rw [h]; rfl
/-- The image of `cos 2φ`. -/
theorem KvHE1_k2 {b W R i : ℕ} (h : kindHE1 i = 2) :
    KvHE1 b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) - 1 := by
  unfold KvHE1; rw [h]; rfl
/-- The image of `sin 2φ`. -/
theorem KvHE1_k3 {b W R i : ℕ} (h : kindHE1 i = 3) :
    KvHE1 b W R i = ((1 <<< (b * (0 + W * 2)) : ℕ) : ℤ) + 1 := by
  unfold KvHE1; rw [h]; rfl
/-- The image of the parameter. -/
theorem KvHE1_k4 {b W R i : ℕ} (h : kindHE1 i = 4) : KvHE1 b W R i =
    ((1 <<< (SHE1 + 6) : ℕ) : ℤ) * ((1 <<< (b * (NHE1 + W * (MHE1 + R * DHE1))) : ℕ) : ℤ) +
      ((1 <<< (SHE1 - 1) : ℕ) : ℤ) * (((1 <<< (b * (NHE1 + W * (MHE1 + R * (DHE1 + 1)))) : ℕ) : ℤ) +
        ((1 <<< (b * (NHE1 + W * (MHE1 + R * (DHE1 - 1)))) : ℕ) : ℤ)) := by
  unfold KvHE1; rw [h]; rfl
/-- The image of a dummy variable. -/
theorem KvHE1_k5 {b W R i : ℕ} (h : kindHE1 i = 5) : KvHE1 b W R i = 0 := by unfold KvHE1; rw [h]; rfl
/-- The image of a stored family (fast or generic). -/
theorem KvHE1_k6 {b W R i : ℕ} (h : kindHE1 i = 6) : KvHE1 b W R i =
    if bMinHE1 i ≤ b ∧ wMinHE1 i ≤ W then
      ((famTB b W R NHE1 MHE1 DHE1 (c0HE1 i) (oddHE1 i) drHE1 dwHE1 (famHE1 i) : ℕ) : ℤ) -
        ((famO b W R NHE1 MHE1 DHE1 dwHE1 (famHE1 i) : ℕ) : ℤ)
    else famPack b W R NHE1 MHE1 DHE1 (if oddHE1 i then -1 else 1) (c0HE1 i : ℤ) 0 0 ddHE1 drHE1 0
      (famHE1 i) := by
  unfold KvHE1; rw [h]; rfl

/-- The kinds of a variable. -/
theorem kindsHE1 (i : ℕ) : kindHE1 i = 0 ∨ kindHE1 i = 1 ∨ kindHE1 i = 2 ∨ kindHE1 i = 3 ∨
    kindHE1 i = 4 ∨ kindHE1 i = 5 ∨ kindHE1 i = 6 := by
  have := kindHE1_le i; omega

/-- **The Kronecker images of the variable polynomials.** -/
theorem kronHE1 (b W R i : ℕ) : kron b W (flat R (PHE1 i)) = KvHE1 b W R i := by
  rcases kindsHE1 i with h | h | h | h | h | h | h
  · rw [PHE1_k0 h, KvHE1_k0 h, kron_flat_T3, two_pow_eq_shift]
  · rw [PHE1_k1 h, KvHE1_k1 h]; exact kron_flat_V3 b W R
  · rw [PHE1_k2 h, KvHE1_k2 h, flat_C]; exact kron_cPoly b W
  · rw [PHE1_k3 h, KvHE1_k3 h, flat_C]; exact kron_sPoly b W
  · rw [PHE1_k4 h, KvHE1_k4 h]; exact kron_flat_Pr3 SHE1 NHE1 MHE1 DHE1 b W R
  · rw [PHE1_k5 h, KvHE1_k5 h]; simp
  · have hi := lt_of_kindHE1 h
    rw [PHE1_fam h, KvHE1_k6 h]
    by_cases hw : bMinHE1 i ≤ b ∧ wMinHE1 i ≤ W
    · rw [ite_eq_left hw]
      exact kron_famTB (staticHE1 i hi h) ((dynHE1 i hi h).mono hw.1 hw.2) (oddHE1 i) R
    · rw [ite_eq_right hw]
      exact (famPack_eq b W R NHE1 MHE1 DHE1 _ _ 0 0 0 (famHE1 i)
        fun sd hsd => ((staticHE1 i hi h).2.2.2 sd hsd).1).symm

/-- **Degree boxes** of the variable polynomials. -/
theorem boxHE1 (i : ℕ) : InBox3 (PHE1 i) (BxHE1 i).1 (BxHE1 i).2.1 (BxHE1 i).2.2 := by
  by_cases hi : i < 99
  · rcases kindsHE1 i with h | h | h | h | h | h | h
    · rw [PHE1_k0 h, (bx0HE1 i hi h).1]; exact inBox3_T3 SHE1 NHE1 MHE1 DHE1
    · rw [PHE1_k1 h, (bx1HE1 i hi h).1]; exact inBox3_V3
    · rw [PHE1_k2 h, (bx2HE1 i hi h).1]; exact InBox3.C box_cPoly
    · rw [PHE1_k3 h, (bx3HE1 i hi h).1]; exact InBox3.C box_sPoly
    · rw [PHE1_k4 h, (bx4HE1 i hi h).1]; exact inBox3_Pr3 SHE1 NHE1 MHE1 DHE1
    · rw [PHE1_k5 h]; exact inBox3_zero _ _ _
    · rw [PHE1_fam h, bx6HE1 i hi h]
      exact inBox3_famPoly _ _ _ _ _ _ _ 0 _ (by have := (staticHE1 i hi h).2.1; omega)
  · rw [PHE1_k5 (kindHE1_ge (by omega))]
    exact inBox3_zero _ _ _

/-- **Static `ℓ¹` bounds** of the flattened variable polynomials. -/
theorem l1HE1 (R i : ℕ) : l1 (flat R (PHE1 i)) ≤ LHE1 i := by
  by_cases hi : i < 99
  · rcases kindsHE1 i with h | h | h | h | h | h | h
    · rw [PHE1_k0 h]; exact (l1_flat_T3 SHE1 NHE1 MHE1 DHE1 R).trans (bx0HE1 i hi h).2
    · rw [PHE1_k1 h]; exact (l1_flat_V3 R).trans (bx1HE1 i hi h).2
    · rw [PHE1_k2 h, flat_C]; exact l1_cPoly.trans (bx2HE1 i hi h).2
    · rw [PHE1_k3 h, flat_C]; exact l1_sPoly.trans (bx3HE1 i hi h).2
    · rw [PHE1_k4 h]; exact (l1_flat_Pr3 SHE1 NHE1 MHE1 DHE1 R).trans (bx4HE1 i hi h).2
    · rw [PHE1_k5 h]; simp [l1, liftN]
    · rw [PHE1_fam h]
      refine (l1_flat_famPoly_le R NHE1 MHE1 DHE1 (by split_ifs <;> simp) _ 0 0 0 (famHE1 i)
        fun sd hsd => ((staticHE1 i hi h).2.2.2 sd hsd).1.2.2.2.2).trans (l1famHE1 i hi h)
  · rw [PHE1_k5 (kindHE1_ge (by omega))]
    simp [l1, liftN]

/-- The phases are below `4`. -/
theorem hWHE1 : ∀ i, (WtHE1 i).2.2 < 4 :=
  getD_prop (Pr := fun w : ℕ × ℕ × ℕ => w.2.2 < 4) (by decide +kernel) (by decide +kernel)

/-- **The family centres** at the parameter `w = c`. -/
def xHE1 (c : ℂ) (i : ℕ) : FA := ctr3 SHE1 NHE1 MHE1 DHE1 c (WtHE1 i) (PHE1 i)

/-- The centre of a stored family. -/
theorem xHE1_fam {c : ℂ} (hc : c ≠ 0) {i : ℕ} (h : kindHE1 i = 6) {p : ℕ}
    (hp : WtHE1 i = (1, 0, p)) :
    xHE1 c i = famCtr SHE1 NHE1 MHE1 p (if oddHE1 i then -1 else 1) (c0HE1 i : ℤ) 0 0 c 0
      (famHE1 i) := by
  have hi := lt_of_kindHE1 h
  rw [xHE1, hp, PHE1_fam h]
  exact ctr3_famPoly _ _ _ _ _ _ _ _ _ hc 0 _ (by have := (staticHE1 i hi h).2.1; omega)

/-- The centre of `t` is `1`. -/
theorem xHE1_t {c : ℂ} (hc : c ≠ 0) : xHE1 c 0 = 1 := by
  rw [xHE1, show WtHE1 0 = (1, 0, 0) from rfl, show PHE1 0 = T3 SHE1 NHE1 MHE1 DHE1 from rfl]
  exact ctr3_T3 _ _ _ _ hc

/-- The centre of `V` is `1`. -/
theorem xHE1_V (c : ℂ) : xHE1 c 1 = 1 := by
  rw [xHE1, show WtHE1 1 = (0, 1, 0) from rfl, show PHE1 1 = V3 from rfl]
  exact ctr3_V3 _ _ _ _ c

/-- The centre of `cos 2φ`. -/
theorem xHE1_c (c : ℂ) : xHE1 c 2 = ctr SHE1 NHE1 MHE1 (0, 1, 3) cPoly := by
  rw [xHE1, show WtHE1 2 = (0, 1, 3) from rfl, show PHE1 2 = C cPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 3 cPoly

/-- The centre of `sin 2φ`. -/
theorem xHE1_s (c : ℂ) : xHE1 c 3 = ctr SHE1 NHE1 MHE1 (0, 1, 0) sPoly := by
  rw [xHE1, show WtHE1 3 = (0, 1, 0) from rfl, show PHE1 3 = C sPoly from rfl]
  exact ctr3_C_w0 _ _ _ _ c 1 0 sPoly

/-- The centre of the parameter `r` is `64 + (c + c⁻¹)/2`. -/
theorem xHE1_r {c : ℂ} (hc : c ≠ 0) : xHE1 c 71 = algebraMap ℂ FA (64 + (c + c⁻¹) / 2) := by
  rw [xHE1, show WtHE1 71 = (1, 0, 0) from rfl, show PHE1 71 = Pr3 SHE1 NHE1 MHE1 DHE1 from rfl]
  exact ctr3_Pr3 _ _ _ _ (by decide +kernel) (by decide +kernel) hc

/-- The centres of the variables of kind `5` (dummies) vanish. -/
theorem xHE1_zero (c : ℂ) {i : ℕ} (h : kindHE1 i = 5) : xHE1 c i = 0 := by
  rw [xHE1, PHE1_k5 h]
  simp [ctr3]

