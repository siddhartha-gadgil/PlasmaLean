meta import PlasmaLean.Design.RationalStellaratorGCEw1KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw1CheckH16`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `m60`. -/
theorem cHE1S_m60 : center3KS KvSHE1 NHE1 MHE1 28 104 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `m60`. -/
theorem clHE1_m60 : LHE1 28 < 2 ^ (104 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `EN`. -/
theorem cHE1S_EN : center3KS KvSHE1 NHE1 MHE1 85 119 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `EN`. -/
theorem clHE1_EN : LHE1 85 < 2 ^ (119 - 1) := by
  kron_lt

/-- Proof-term check of the node `m11`: truncation norm. -/
theorem kHE1S_m11 : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_m11 (1 : Int) 1 0 15 236 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m11`: a priori `ℓ¹` bound. -/
theorem lHE1_m11 : nodeL1N SHE1 LHE1 trHE1N_m11 (1 : Int) 1 0 15 < 2 ^ (236 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
