/-- Proof-term check of the node `R2`: a priori `ℓ¹` bound. -/
theorem lHE1_R2 : nodeL1N SHE1 LHE1 trHE1N_R2 (1 : Int) 1 0 58 < 2 ^ (236 - 1) := by
