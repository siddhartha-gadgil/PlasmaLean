module

public import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu5KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
meta import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu5CheckH55`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `P2`. -/
theorem cHMS_P2 : center3KS KvSHM NHM MHM 50 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `P2`. -/
theorem clHM_P2 : LHM 50 < 2 ^ (123 - 1) := by
  kron_lt

/-- Proof-term check of the node `DuP`: truncation norm. -/
theorem kHMS_DuP : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_DuP (2 : Int) 0 1 32 126 73 57 25 11 8 10 36 28 ≤
     := by
  kron_proof

/-- Proof-term check of the node `DuP`: a priori `ℓ¹` bound. -/
theorem lHM_DuP : nodeL1N SHM LHM trHMN_DuP (2 : Int) 0 1 32 < 2 ^ (126 - 1) := by
  kron_lt

/-- Proof-term check of the node `V2`: truncation norm. -/
theorem kHMS_V2 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_V2 (1 : Int) 1 0 53 244 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `V2`: a priori `ℓ¹` bound. -/
theorem lHM_V2 : nodeL1N SHM LHM trHMN_V2 (1 : Int) 1 0 53 < 2 ^ (244 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `Vm1`. -/
theorem kHMS_Vm1 : norm3KS WtHM KvSHM NHM MHM trHMN_Vm1 (1, 0, 0) 123 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `Vm1`: a priori `ℓ¹` bound. -/
theorem lHM_Vm1 : ExN.majN LHM trHMN_Vm1 < 2 ^ (123 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu5
