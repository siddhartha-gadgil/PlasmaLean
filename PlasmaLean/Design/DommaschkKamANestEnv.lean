  [(26419 / 625000 : ℚ), (98483 / 2500000 : ℚ), (326261 / 5000000 : ℚ), (23137 / 400000 : ℚ),
    (1 : ℚ), (1 : ℚ), (351092 / 125 : ℚ), (712871 / 500 : ℚ), (168667 / 50 : ℚ),
    (435863 / 10 ^ 7 : ℚ), (36981 / 625000 : ℚ), (154713 / 10 ^ 8 : ℚ), (786797 / 10 ^ 9 : ℚ),
    (2081 / 1562500 : ℚ), (296297 / 10 ^ 8 : ℚ), (74229 / 50000000 : ℚ), (127399 / 50000000 : ℚ),
    (727863 / 10 ^ 6 : ℚ), (1040967 / 10 ^ 6 : ℚ), (485573 / 50000 : ℚ), (856171 / 10 ^ 5 : ℚ),
    (277163 / 50000 : ℚ), (1216917 / 200000 : ℚ), (436989 / 5000 : ℚ), (67951 / 10 ^ 3 : ℚ),
    (10157 / 400 : ℚ), (2567509 / 10 ^ 5 : ℚ)]

/-- The norm bounds of the centres. -/
def BN (i : ℕ) : ℚ := BNl.getD i 0

/-- The radii of the balls (list; strip `0` for the new ones). -/
def ENl : List ℚ := EAl ++
  [(0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ),
    (377 / 10 ^ 19 : ℚ), (147 / 2000000000000000 : ℚ), (527 / 10 ^ 18 : ℚ),
    (853 / 5000000000000000000 : ℚ), (137 / 10 ^ 18 : ℚ), (263 / 25000000000000000 : ℚ),
    (59 / 12500000000000000 : ℚ), (493 / 50000000000000000 : ℚ), (401 / 10 ^ 14 : ℚ),
    (171 / 2000000000000 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (79 / 25000000000 : ℚ),
    (229 / 2500000000 : ℚ), (1 / 400 : ℚ), (139 / 2500 : ℚ)]

/-- The radii of the balls. -/
def EN (i : ℕ) : ℚ := ENl.getD i 0

/-- The Adm norm bounds are kept. -/
theorem BN_lt {i : ℕ} (h : i < 195) : BN i = BA i := by
  unfold BN BNl BA
  rw [List.getD_append _ _ _ _ (by rw [show BAl.length = 195 by rfl]; exact h)]

/-- The Adm radii are kept. -/
theorem EN_lt {i : ℕ} (h : i < 195) : EN i = EA i := by
  unfold EN ENl EA
  rw [List.getD_append _ _ _ _ (by rw [show EAl.length = 195 by rfl]; exact h)]

end PlasmaLean.Design.DommaschkKamA
