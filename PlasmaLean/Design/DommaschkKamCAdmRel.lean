/-- The identity of the node `R`. -/
theorem relA_R : ((32 : ℤ) : ℂ) • XA 10 = Ex.eval XA trA_R := by
  have e0 : XA 0 = 1 := rfl
  have e4 : XA 4 = xA 4 := rfl
  have e10 : XA 10 = RvA := rfl
  simp only [trA_R, Ex.eval, e10, e0, e4, RvA, R0q]
  rw [smul_add, Algebra.smul_def, ← map_mul]
  have h : (((32 : ℤ) : ℂ) * (((29 / 32 : ℚ) : ℚ) : ℂ)) = 29 := by push_cast; norm_num
  rw [h]
  simp only [Algebra.smul_def, map_ofNat, Int.cast_ofNat, mul_one]

