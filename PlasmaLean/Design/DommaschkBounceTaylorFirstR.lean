/-- Taylor enclosure of the sparse suffix starting at term 0. -/
def dnR0 : Model := ofDyadic 80 [-573755773524408314016, -574238828533191083750, -724448688461623541, -241259864958095589, 167254391463494, 33431646940841, -9709064974, -1290369787] (12422406755435181284)
