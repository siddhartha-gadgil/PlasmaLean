meta import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu5CheckH61`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `Z`. -/
theorem cHMS_Z : center3KS KvSHM NHM MHM 5 119 73 55 25 11 1 73 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `Z`. -/
theorem clHM_Z : LHM 5 < 2 ^ (119 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `thU`. -/
theorem cHMS_thU : center3KS KvSHM NHM MHM 8 125 73 55 25 11 1 73 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `thU`. -/
theorem clHM_thU : LHM 8 < 2 ^ (125 - 1) := by
  kron_lt

/-- Proof-term check of the node `V42`: truncation norm. -/
theorem kHMS_V42 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_V42 (1 : Int) 1 0 80 244 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `V42`: a priori `ℓ¹` bound. -/
theorem lHM_V42 : nodeL1N SHM LHM trHMN_V42 (1 : Int) 1 0 80 < 2 ^ (244 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu5
