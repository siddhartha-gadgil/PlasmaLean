/-!
# Checked torus-A transverse Fourier moments

Generated by `scripts/dommaschk_kam/emit_interface_columns.py`. Each of the 161 rows
lists the six full-grid integer sums over poloidal modes, for R and z and derivative
orders zero, one and two. The checks recompute seven columns at a time from Lean's
packed torus-A data using integer reduction in the kernel.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamAInterfaceColumns

open PlasmaLean.Design.DommaschkKamA PlasmaLean.Design.DommaschkKamAInterfaceFourier
open PlasmaLean.Certificates.IccListCert

/-- A transverse power sum on the complete torus-A grid. -/
def baseMoment (g : ℕ → ℕ → ℤ) (a : ℕ) (m : ℤ) : ℤ :=
  ((List.range 193).map fun (i : ℕ) =>
    let k : ℤ := -96 + (i : ℤ)
    g (k+96).toNat (m+80).toNat * k^a).sum

/-- The finite list evaluator computes the integer in the Fourier amplitude. -/
theorem baseMoment_eq (g : ℕ → ℕ → ℤ) (a : ℕ) (m : ℤ) :
    sliceNumerator Nc Mc g a 0 m = baseMoment g a m := by
  simp [sliceNumerator, Nc, Mc, sum_Icc_eq_list, baseMoment]

/-- Radius moments followed by height moments at one toroidal frequency. -/
def baseColumn (m : ℤ) : List ℤ :=
  [baseMoment gU 0 m, baseMoment gU 1 m, baseMoment gU 2 m,
    baseMoment gZ 0 m, baseMoment gZ 1 m, baseMoment gZ 2 m]

/-- Seven consecutive signed toroidal frequencies, starting at -80 for block zero. -/
def computedBlock (i : ℕ) : List (List ℤ) :=
  (List.range 7).map (fun (j : ℕ) => baseColumn ((7*i+j : ℕ) - 80 : ℤ))

