/-!
# The node tori of the energy window and their residuals

The energy window of 3.5 MeV alpha guiding centres at fixed `B₀R₀` is the interval of gyro-lengths
`|ρ − 1/256| ≤ 2⁻³²` (model units, `ρ ∝ √E`). Its four interpolation nodes are
`ρ_j = 1/256 + t_j 2⁻³²`, `t_j ∈ {−1, −5/16, 5/16, 1}`; at each node a pitch-angle family torus
`K_j(λ) = (xHE_j c 4, xHE_j c 5)` (`λ = lamF c ∈ [0, 1/16]`) is certified by its own
high-resolution ball pipeline (`Design/RationalStellaratorGCEw<j>*H`). This module extracts the
residual bounds `‖D̃ 𝓛K_j − ñ‖_{r_A}` for the flow form of `gcFlowMu ρ_j λ` (`ewResR`, `ewResZ`),
for every `|c| = 1`.

Scope: Littlejohn guiding-centre model, non-relativistic, collisionless, static vacuum model field
`field (1/4)` (not coil-produced).

**Sanity.** `rhoEw_center`: the nodes are centred at `1/256` with spacing `2⁻³²`.
Generated by `scripts/gc_kam/ew_nodes.py`.
-/

@[expose] public section
noncomputable section

set_option linter.style.longLine false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall PlasmaLean.Certificates.KronBallCheb WEll1Z2 Complex

/-- **Sanity**: `ρ_j = 1/256 + t_j 2⁻³²`. -/
theorem rhoEw_center : ((16777215 / 4294967296 : ℝ)) = 1 / 256 + tEw 0 * hEw ∧
    ((268435451 / 68719476736 : ℝ)) = 1 / 256 + tEw 1 * hEw ∧
    ((268435461 / 68719476736 : ℝ)) = 1 / 256 + tEw 2 * hEw ∧
    ((16777217 / 4294967296 : ℝ)) = 1 / 256 + tEw 3 * hEw := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> norm_num [tEw, hEw]

/-- The `R`-residual norm node of node 1 is `2^96` times the flow-form residual at `ρ_1`. -/
theorem eval_trHE1N_resR (c : ℂ) (hc : ‖c‖ = 1) :
    Ex.eval (XHE1 c) (toEx trHE1N_resR) =
      (2 : ℂ) ^ 96 • (gcFlowMu (16777215 / 4294967296 : ℝ) (lamF c)).resR KamTorusA.iota (xHE1 c 4) (xHE1 c 5) := by
  rw [FlowFieldS.resR_eq]
  have eD : XHE1 c 96 = PolyExprS.eval (xB (xHE1 c 4) (xHE1 c 5)) (gcDM (16777215 / 4294967296 : ℝ) (lamF c)) := rfl
  have eN : XHE1 c 97 = PolyExprS.eval (xB (xHE1 c 4) (xHE1 c 5)) (gcNRM (16777215 / 4294967296 : ℝ) (lamF c)) := rfl
  have eL : XHE1 c 6 = (2 : ℂ) ^ 96 • Lt KamTorusA.iota (xHE1 c 4) := rfl
  simp only [trHE1N_resR, toEx, Ex.eval, eD, eN, eL, XHE1_eq_t hc,
      xHE1_t (ne_zero_of_norm_one_mu hc),
    FlowFieldS.Dof, gcFlowMu, Algebra.smul_def, map_pow, map_ofNat, Int.cast_ofNat]
  norm_num
  ring

/-- **The residual of the node torus 1** (`R`-component) at `ρ_1 = 1/256 + (-1) 2⁻³²`. -/
theorem ewResR_1 {c : ℂ} (hc : ‖c‖ = 1) :
    Bd KamTorusA.rA ((gcFlowMu (16777215 / 4294967296 : ℝ) (lamF c)).resR KamTorusA.iota (xHE1 c 4) (xHE1 c 5))
      ((160800000 : ℚ) / 2 ^ 96 : ℝ) := by
  have h := normHE1_resR rA_nonneg' exp_rA_le' hc
  rw [eval_trHE1N_resR c hc] at h
  refine (Bd_inv_pow96 h).le ?_
  push_cast; norm_num

