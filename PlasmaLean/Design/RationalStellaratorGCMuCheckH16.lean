module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH
public import PlasmaLean.Design.RationalStellaratorGCMuKvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMuCheckH16`)

The checks of `Design/RationalStellaratorGCMuCheckH16` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMuLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `Ze`. -/
theorem cHMS_Ze : center3KS KvSHM NHM MHM 11 119 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `Ze`. -/
theorem clHM_Ze : LHM 11 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `V2`. -/
theorem cHMS_V2 : center3KS KvSHM NHM MHM 53 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `V2`. -/
theorem clHM_V2 : LHM 53 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m21`: truncation norm. -/
theorem kHMS_m21 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m21 (1 : Int) 1 0 19 232 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m21`: a priori `ℓ¹` bound. -/
theorem lHM_m21 : nodeL1N SHM LHM trHMN_m21 (1 : Int) 1 0 19 < 2 ^ (232 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
