set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the node `m40`: truncation norm. -/
theorem kH_m40 : nodeK SH NH MH WtH KvH trH_m40 (1 : ℤ) 1 0 24 251 161 8 7 120 80 60 ≤  := by
  decide +kernel

/-- Kernel check of the node `m40`: a priori `ℓ¹` bound. -/
theorem lH_m40 : nodeL1 SH LH trH_m40 (1 : ℤ) 1 0 24 < 2 ^ (251 - 1) := by
