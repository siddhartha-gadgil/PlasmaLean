module

public import PlasmaLean.Design.DommaschkKamAResTrees
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.DommaschkKamAResTrees

/-!
# Proof-term checks of the torus-A residual chain (part 13)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`; `kron_lt` for
the `ℓ¹` bounds) on the salted rows of `Design/DommaschkKamAResData*`: the weighted digit sums
(`nodeKw`, `normKw`, `centerKw` of `Design/DommaschkKamCKronW`, strip weights `68553^s 2^{16(K−s)}`)
of the Kronecker images (`imgR`, `Design/DommaschkKamCResKron`) of the truncation polynomials of the
ball chain, and their a priori `ℓ¹` bounds. Generated by `scripts/dommaschk_kam/emit_res.py`.
Checks:
`kH_F5`, `kH_Fc4`, `kH_F4`, `kH_Fc3`.
-/

@[expose] public section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

set_option linter.style.longLine false in
/-- Proof-term check of the node `F5`: truncation norm. -/
theorem kH_F5 : nodeKw 68553 16 SH NH MH WtH KvH trH_F5 (1 : ℤ) 1 0 55 277 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `F5`: a priori `ℓ¹` bound. -/
theorem lH_F5 : nodeL1 SH LH trH_F5 (1 : ℤ) 1 0 55 < 2 ^ (277 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc4`: truncation norm. -/
theorem kH_Fc4 : nodeKw 68553 16 SH NH MH WtH KvH trH_Fc4 (160000000000 : ℤ) 0 3 56 181 193 8 8 164 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc4`: a priori `ℓ¹` bound. -/
theorem lH_Fc4 : nodeL1 SH LH trH_Fc4 (160000000000 : ℤ) 0 3 56 < 2 ^ (181 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `F4`: truncation norm. -/
theorem kH_F4 : nodeKw 68553 16 SH NH MH WtH KvH trH_F4 (1 : ℤ) 1 0 57 277 385 9 9 320 192 160 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `F4`: a priori `ℓ¹` bound. -/
theorem lH_F4 : nodeL1 SH LH trH_F4 (1 : ℤ) 1 0 57 < 2 ^ (277 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc3`: truncation norm. -/
theorem kH_Fc3 : nodeKw 68553 16 SH NH MH WtH KvH trH_Fc3 (7680000000000 : ℤ) 0 3 58 180 193 8 8 163 96 83 ≤  := by
  kron2_proof

set_option linter.style.longLine false in
/-- Proof-term check of the node `Fc3`: a priori `ℓ¹` bound. -/
theorem lH_Fc3 : nodeL1 SH LH trH_Fc3 (7680000000000 : ℤ) 0 3 58 < 2 ^ (180 - 1) := by
  kron_lt

end PlasmaLean.Design.DommaschkKamA
