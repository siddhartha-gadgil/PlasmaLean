/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw1CheckH34`)

The checks of `Design/RationalStellaratorGCEw1CheckH34` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE1`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw1LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `q`. -/
theorem cHE1S_q : center3KS KvSHE1 NHE1 MHE1 46 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `q`. -/
theorem clHE1_q : LHE1 46 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm node `eta`. -/
theorem kHE1S_eta : norm3KS WtHE1 KvSHE1 NHE1 MHE1 trHE1N_eta (2, 0, 0) 237 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `eta`: a priori `ℓ¹` bound. -/
theorem lHE1_eta : ExN.majN LHE1 trHE1N_eta < 2 ^ (237 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
