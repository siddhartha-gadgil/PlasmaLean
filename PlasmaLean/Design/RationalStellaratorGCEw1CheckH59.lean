  decide +kernel

/-- A priori `ℓ¹` bound of the centre `V42`. -/
theorem clHE1_V42 : LHE1 80 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `nZzP`: truncation norm. -/
theorem kHE1_nZzP : node3KN SHE1 NHE1 MHE1 DHE1 WtHE1 KvHE1 trHE1N_nZzP (2 : Int) 0 1 39 124 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nZzP`: a priori `ℓ¹` bound. -/
theorem lHE1_nZzP : nodeL1N SHE1 LHE1 trHE1N_nZzP (2 : Int) 0 1 39 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
