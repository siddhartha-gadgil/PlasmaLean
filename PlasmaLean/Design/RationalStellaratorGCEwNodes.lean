/-- The transport centres of node 1: `‖2^96 𝓛u − x₆‖ ≤ E₆`, `‖2^96 𝓛z − x₇‖ ≤ E₇`. -/
theorem ballLt_HE1 {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ}
    (hc : ‖c‖ = 1) :
    Bd r ((2 : ℂ) ^ 96 • Lt KamTorusA.iota (xHE1 c 4) - xHE1 c 6) ((EHE1 6 : ℚ) : ℝ) ∧
    Bd r ((2 : ℂ) ^ 96 • Lt KamTorusA.iota (xHE1 c 5) - xHE1 c 7) ((EHE1 7 : ℚ) : ℝ) :=
  ⟨ballHE1_all hr hq hc 6 (by norm_num), ballHE1_all hr hq hc 7 (by norm_num)⟩

/-- The embedded low-resolution torus of node 1 is the certified one. -/
theorem embHE1 {c : ℂ} (hc : ‖c‖ = 1) : xHE1 c 10 = xLM c 4 ∧ xHE1 c 11 = xLM c 5 ∧
    xHE1 c 12 = dTh (xLM c 4) ∧ xHE1 c 13 = dTh (xLM c 5) := by
  have hc0 := ne_zero_of_norm_one_mu hc
  refine ⟨xHE1_embed_Ue hc0, xHE1_embed_Ze hc0, ?_, ?_⟩
  · rw [xHE1_der_thUe hc0, xHE1_embed_Ue hc0]; simp [dTh]
  · rw [xHE1_der_thZe hc0, xHE1_embed_Ze hc0]; simp [dTh]

