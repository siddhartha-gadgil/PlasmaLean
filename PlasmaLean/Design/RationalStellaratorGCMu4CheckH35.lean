meta import PlasmaLean.Design.RationalStellaratorGCMu4KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCMu4CheckH35`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `nRp`. -/
theorem cHMS_nRp : center3KS KvSHM NHM MHM 30 118 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `nRp`. -/
theorem clHM_nRp : LHM 30 < 2 ^ (118 - 1) := by
  kron_lt

/-- Proof-term check of the norm of the centre `E4P`. -/
theorem cHMS_E4P : center3KS KvSHM NHM MHM 76 108 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `E4P`. -/
theorem clHM_E4P : LHM 76 < 2 ^ (108 - 1) := by
  kron_lt

/-- Proof-term check of the node `A1`: truncation norm. -/
theorem kHMS_A1 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_A1 (1 : Int) 1 0 60 242 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `A1`: a priori `ℓ¹` bound. -/
theorem lHM_A1 : nodeL1N SHM LHM trHMN_A1 (1 : Int) 1 0 60 < 2 ^ (242 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC.Mu4
