set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- Kernel check of the node `m13`: truncation norm. -/
theorem kH_m13 : nodeK SH NH MH WtH KvH trH_m13 (1 : ℤ) 1 0 21 251 161 8 7 120 80 60 ≤  := by
  decide +kernel

/-- Kernel check of the node `m13`: a priori `ℓ¹` bound. -/
theorem lH_m13 : nodeL1 SH LH trH_m13 (1 : ℤ) 1 0 21 < 2 ^ (251 - 1) := by
