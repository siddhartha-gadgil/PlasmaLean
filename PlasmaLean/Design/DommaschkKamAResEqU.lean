module

public import PlasmaLean.Design.DommaschkKamAResEnv

/-!
# Identity of the residual-chain data `U`, `LUx` with the data torus A

Kernel checks, by blocks of rows, that the salted rows `rowsH_U` and `rowsH_LUx`
(`Design/DommaschkKamAResData*`) are the grid `gU` of the data torus
(`Design/DommaschkKamATorus`) and its weighted grid `(−Iqc (i − N) + 2^{Qc+1} (j − M)) gU`
(the derivative `2^{Qc} 𝓛_{ι_q}`, `dS_ctr_grid`). Generated by
`scripts/dommaschk_kam/emit_res.py`.
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

/-- The weighted grid of `gU`: `2^{Qc} 𝓛_{ι_q}` (`ι_q = −Iqc/2^{Qc}`). -/
def wgU : ℕ → ℕ → ℤ :=
  fun i j => ((-(Iqc : ℤ)) * ((i : ℤ) - NH) + (2 : ℤ) ^ (Qc + 1) * ((j : ℤ) - MH)) * gU i j

set_option linter.style.longLine false in
/-- Rows `0 … 22` of `U` and `LUx`. -/
theorem eqH_U_0 : chkGrid NH (gridR rowsH_U) gU 0 23 = true ∧
    chkGrid NH (gridR rowsH_LUx) wgU 0 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `23 … 45` of `U` and `LUx`. -/
theorem eqH_U_1 : chkGrid NH (gridR rowsH_U) gU 23 23 = true ∧
    chkGrid NH (gridR rowsH_LUx) wgU 23 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `46 … 68` of `U` and `LUx`. -/
theorem eqH_U_2 : chkGrid NH (gridR rowsH_U) gU 46 23 = true ∧
    chkGrid NH (gridR rowsH_LUx) wgU 46 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `69 … 91` of `U` and `LUx`. -/
theorem eqH_U_3 : chkGrid NH (gridR rowsH_U) gU 69 23 = true ∧
    chkGrid NH (gridR rowsH_LUx) wgU 69 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `92 … 114` of `U` and `LUx`. -/
theorem eqH_U_4 : chkGrid NH (gridR rowsH_U) gU 92 23 = true ∧
    chkGrid NH (gridR rowsH_LUx) wgU 92 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `115 … 137` of `U` and `LUx`. -/
theorem eqH_U_5 : chkGrid NH (gridR rowsH_U) gU 115 23 = true ∧
    chkGrid NH (gridR rowsH_LUx) wgU 115 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `138 … 160` of `U` and `LUx`. -/
theorem eqH_U_6 : chkGrid NH (gridR rowsH_U) gU 138 23 = true ∧
    chkGrid NH (gridR rowsH_LUx) wgU 138 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- **The rows of `U` and `LUx` are the data grids.** -/
theorem eqH_U : ∀ j < 2 * MH + 1, ∀ i < 2 * NH + 1,
    gridR rowsH_U i j = gU i j ∧ gridR rowsH_LUx i j = wgU i j := by
  intro j hj i hi
  have hj' : j < 161 := by simpa [MH] using hj
  rcases (show (0 ≤ j ∧ j < 23) ∨ (23 ≤ j ∧ j < 46) ∨ (46 ≤ j ∧ j < 69) ∨ (69 ≤ j ∧ j < 92) ∨ (92 ≤ j ∧ j < 115) ∨ (115 ≤ j ∧ j < 138) ∨ (138 ≤ j ∧ j < 161) by omega) with h | h | h | h | h | h | h
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 0 + dj := ⟨j - 0, by omega⟩
    exact ⟨chkGrid_sound eqH_U_0.1 dj (by omega) i hi, chkGrid_sound eqH_U_0.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 23 + dj := ⟨j - 23, by omega⟩
    exact ⟨chkGrid_sound eqH_U_1.1 dj (by omega) i hi, chkGrid_sound eqH_U_1.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 46 + dj := ⟨j - 46, by omega⟩
    exact ⟨chkGrid_sound eqH_U_2.1 dj (by omega) i hi, chkGrid_sound eqH_U_2.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 69 + dj := ⟨j - 69, by omega⟩
    exact ⟨chkGrid_sound eqH_U_3.1 dj (by omega) i hi, chkGrid_sound eqH_U_3.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 92 + dj := ⟨j - 92, by omega⟩
    exact ⟨chkGrid_sound eqH_U_4.1 dj (by omega) i hi, chkGrid_sound eqH_U_4.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 115 + dj := ⟨j - 115, by omega⟩
    exact ⟨chkGrid_sound eqH_U_5.1 dj (by omega) i hi, chkGrid_sound eqH_U_5.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 138 + dj := ⟨j - 138, by omega⟩
    exact ⟨chkGrid_sound eqH_U_6.1 dj (by omega) i hi, chkGrid_sound eqH_U_6.2 dj (by omega) i hi⟩

end PlasmaLean.Design.DommaschkKamA
