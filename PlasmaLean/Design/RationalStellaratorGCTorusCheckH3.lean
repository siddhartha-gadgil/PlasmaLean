module

public import PlasmaLean.Design.RationalStellaratorGCTorusTreesH
public import PlasmaLean.Certificates.KronProof2D
meta import PlasmaLean.Design.RationalStellaratorGCTorusTreesH

/-!
# Proof-term checks of the guiding-centre torus certificate (high resolution, part 3)

Each theorem is an explicit proof term (`kron2_proof` of `Certificates/KronProof2D`: block sums
of the digit reading as kernel facts; `kron_lt` for the `ℓ¹` bounds) on the data of
`Design/RationalStellaratorGCTorusDataH*`: the weighted digit sums (`nodeK`, `normK`, `centerK` of
`Certificates/KronBallGrid`) of the Kronecker images of the truncation polynomials of the ball
pipeline, and their a priori `ℓ¹` bounds. Generated by `scripts/gc_kam/emit_lean.py`.
-/

@[expose] public section

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.Kron2 PlasmaLean.Certificates.KronExpr
  PlasmaLean.Certificates.KronBall

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `LRx`. -/
theorem cH_LRx : centerK NH MH KvH 6 229 81 7 6 40 30 ≤  := by
  kron2_proof

/-- A priori `ℓ¹` bound of the centre `LRx`. -/
theorem clH_LRx : LH 6 < 2 ^ (229 - 1) := by
  kron_lt

set_option linter.style.longLine false in
/-- Proof-term check of the norm of the centre `m22`. -/
theorem cH_m22 : centerK NH MH KvH 22 127 81 7 6 40 30 ≤  := by
  kron2_proof

/-- A priori `ℓ¹` bound of the centre `m22`. -/
theorem clH_m22 : LH 22 < 2 ^ (127 - 1) := by
  kron_lt

set_option linter.style.longLine false in
