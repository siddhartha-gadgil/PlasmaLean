module

public import PlasmaLean.Design.DommaschkKamCResEnv

/-!
# Identity of the residual-chain data `Z`, `LZx` with the data torus C

Kernel checks, by blocks of rows, that the salted rows `rowsH_Z` and `rowsH_LZx`
(`Design/DommaschkKamCResData*`) are the grid `gZ` of the data torus
(`Design/DommaschkKamCTorus`) and its weighted grid `(−Iqc (i − N) + 2^{Qc+1} (j − M)) gZ`
(the derivative `2^{Qc} 𝓛_{ι_q}`, `dS_ctr_grid`). Generated by
`scripts/dommaschk_kam/emit_res.py`.
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.DommaschkKamC

open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

/-- The weighted grid of `gZ`: `2^{Qc} 𝓛_{ι_q}` (`ι_q = −Iqc/2^{Qc}`). -/
def wgZ : ℕ → ℕ → ℤ :=
  fun i j => ((-(Iqc : ℤ)) * ((i : ℤ) - NH) + (2 : ℤ) ^ (Qc + 1) * ((j : ℤ) - MH)) * gZ i j

set_option linter.style.longLine false in
/-- Rows `0 … 22` of `Z` and `LZx`. -/
theorem eqH_Z_0 : chkGrid NH (gridR rowsH_Z) gZ 0 23 = true ∧
    chkGrid NH (gridR rowsH_LZx) wgZ 0 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `23 … 45` of `Z` and `LZx`. -/
theorem eqH_Z_1 : chkGrid NH (gridR rowsH_Z) gZ 23 23 = true ∧
    chkGrid NH (gridR rowsH_LZx) wgZ 23 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `46 … 68` of `Z` and `LZx`. -/
theorem eqH_Z_2 : chkGrid NH (gridR rowsH_Z) gZ 46 23 = true ∧
    chkGrid NH (gridR rowsH_LZx) wgZ 46 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `69 … 91` of `Z` and `LZx`. -/
theorem eqH_Z_3 : chkGrid NH (gridR rowsH_Z) gZ 69 23 = true ∧
    chkGrid NH (gridR rowsH_LZx) wgZ 69 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `92 … 114` of `Z` and `LZx`. -/
theorem eqH_Z_4 : chkGrid NH (gridR rowsH_Z) gZ 92 23 = true ∧
    chkGrid NH (gridR rowsH_LZx) wgZ 92 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `115 … 137` of `Z` and `LZx`. -/
theorem eqH_Z_5 : chkGrid NH (gridR rowsH_Z) gZ 115 23 = true ∧
    chkGrid NH (gridR rowsH_LZx) wgZ 115 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
/-- Rows `138 … 160` of `Z` and `LZx`. -/
theorem eqH_Z_6 : chkGrid NH (gridR rowsH_Z) gZ 138 23 = true ∧
    chkGrid NH (gridR rowsH_LZx) wgZ 138 23 = true := by
  kernel_fact

set_option linter.style.longLine false in
set_option maxRecDepth 100000 in
/-- **The rows of `Z` and `LZx` are the data grids.** -/
theorem eqH_Z : ∀ j < 2 * MH + 1, ∀ i < 2 * NH + 1,
    gridR rowsH_Z i j = gZ i j ∧ gridR rowsH_LZx i j = wgZ i j := by
  intro j hj i hi
  have hj' : j < 161 := by simpa [MH] using hj
  rcases (show (0 ≤ j ∧ j < 23) ∨ (23 ≤ j ∧ j < 46) ∨ (46 ≤ j ∧ j < 69) ∨ (69 ≤ j ∧ j < 92) ∨ (92 ≤ j ∧ j < 115) ∨ (115 ≤ j ∧ j < 138) ∨ (138 ≤ j ∧ j < 161) by omega) with h | h | h | h | h | h | h
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 0 + dj := ⟨j - 0, by omega⟩
    exact ⟨chkGrid_sound eqH_Z_0.1 dj (by omega) i hi, chkGrid_sound eqH_Z_0.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 23 + dj := ⟨j - 23, by omega⟩
    exact ⟨chkGrid_sound eqH_Z_1.1 dj (by omega) i hi, chkGrid_sound eqH_Z_1.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 46 + dj := ⟨j - 46, by omega⟩
    exact ⟨chkGrid_sound eqH_Z_2.1 dj (by omega) i hi, chkGrid_sound eqH_Z_2.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 69 + dj := ⟨j - 69, by omega⟩
    exact ⟨chkGrid_sound eqH_Z_3.1 dj (by omega) i hi, chkGrid_sound eqH_Z_3.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 92 + dj := ⟨j - 92, by omega⟩
    exact ⟨chkGrid_sound eqH_Z_4.1 dj (by omega) i hi, chkGrid_sound eqH_Z_4.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 115 + dj := ⟨j - 115, by omega⟩
    exact ⟨chkGrid_sound eqH_Z_5.1 dj (by omega) i hi, chkGrid_sound eqH_Z_5.2 dj (by omega) i hi⟩
  · obtain ⟨dj, rfl⟩ : ∃ dj, j = 138 + dj := ⟨j - 138, by omega⟩
    exact ⟨chkGrid_sound eqH_Z_6.1 dj (by omega) i hi, chkGrid_sound eqH_Z_6.2 dj (by omega) i hi⟩

end PlasmaLean.Design.DommaschkKamC
