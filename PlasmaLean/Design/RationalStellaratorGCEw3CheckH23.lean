  kron_proof

/-- A priori `ℓ¹` bound of the centre `YnRt`. -/
theorem clHE3_YnRt : LHE3 92 < 2 ^ (120 - 1) := by
  kron_lt

/-- Proof-term check of the node `m31`: truncation norm. -/
theorem kHE3S_m31 : node3KS SHE3 NHE3 MHE3 DHE3 WtHE3 KvSHE3 trHE3N_m31 (1 : Int) 1 0 23 228 145 109 49 13 8 19 72 54 ≤
