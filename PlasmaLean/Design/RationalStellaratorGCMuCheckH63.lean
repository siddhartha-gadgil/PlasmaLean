module

public import PlasmaLean.Design.RationalStellaratorGCMuTreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 63)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCMuDataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/lam_emit_lean.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `nZtF`. -/
theorem cHM_nZtF : center3KN KvHM NHM MHM 95 118 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `nZtF`. -/
theorem clHM_nZtF : LHM 95 < 2 ^ (118 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `nRp`: truncation norm. -/
theorem kHM_nRp : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_nRp (8 : Int) 0 1 30 124 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nRp`: a priori `ℓ¹` bound. -/
theorem lHM_nRp : nodeL1N SHM LHM trHMN_nRp (8 : Int) 0 1 30 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `nZp`: truncation norm. -/
theorem kHM_nZp : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_nZp (16 : Int) 0 1 31 125 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nZp`: a priori `ℓ¹` bound. -/
theorem lHM_nZp : nodeL1N SHM LHM trHMN_nZp (16 : Int) 0 1 31 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `nRuP`: truncation norm. -/
theorem kHM_nRuP : node3KN SHM NHM MHM DHM WtHM KvHM trHMN_nRuP (8 : Int) 0 1 35 126 73 57 25 11 8 10 36 28 ≤
     := by
  decide +kernel

/-- Kernel check of the node `nRuP`: a priori `ℓ¹` bound. -/
theorem lHM_nRuP : nodeL1N SHM LHM trHMN_nRuP (8 : Int) 0 1 35 < 2 ^ (126 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
