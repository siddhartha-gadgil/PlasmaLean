module

public import PlasmaLean.Design.RationalStellaratorGCFamTreesH
public import PlasmaLean.Design.RationalStellaratorGCFamKvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCFamTreesH
meta import PlasmaLean.Design.RationalStellaratorGCFamKvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCFamCheckH5`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `r`. -/
theorem cHFS_r : center3KS KvSHF NHF MHF 71 129 37 28 12 9 8 5 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `r`. -/
theorem clHF_r : LHF 71 < 2 ^ (129 - 1) := by
  kron_lt

/-- Proof-term check of the node `m20`: truncation norm. -/
theorem kHFS_m20 : node3KS SHF NHF MHF DHF WtHF KvSHF trHFN_m20 (1 : Int) 1 0 16 236 145 109 41 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `m20`: a priori `ℓ¹` bound. -/
theorem lHF_m20 : nodeL1N SHF LHF trHFN_m20 (1 : Int) 1 0 16 < 2 ^ (236 - 1) := by
  kron_lt

/-- Proof-term check of the norm node `resZ`. -/
theorem kHFS_resZ : norm3KS WtHF KvSHF NHF MHF trHFN_resZ (2, 0, 0) 341 145 109 41 13 4 37 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the norm node `resZ`: a priori `ℓ¹` bound. -/
theorem lHF_resZ : ExN.majN LHF trHFN_resZ < 2 ^ (341 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
