module

public import PlasmaLean.Design.RationalStellaratorGCEw2TreesH
public import PlasmaLean.Design.RationalStellaratorGCEw2KvSH
public import PlasmaLean.Certificates.KronProof
meta import PlasmaLean.Design.RationalStellaratorGCEw2TreesH
meta import PlasmaLean.Design.RationalStellaratorGCEw2KvSH

/-!
# Kronecker ball checks as proof terms (`Design/RationalStellaratorGCEw2CheckH37`)

Each `node3KS`, `norm3KS`, `center3KS` check is proved by an explicit certificate built by
`kron_proof` (`Certificates/KronProof`: signed image, digit reading, final comparison), each `ℓ¹`
check by the kernel fact `Nat.ble (a + 1) c = true` (`kron_lt`); no `decide`. The statements are
those of the low-memory checks. Light module. Generated by
`scripts/gc_kam/proofterm/proofterm_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem
  PlasmaLean.Certificates.KronProof

/-- Proof-term check of the norm of the centre `qph`. -/
theorem cHE2S_qph : center3KS KvSHE2 NHE2 MHE2 49 116 73 55 25 11 8 10 36 27 ≤
     := by
  kron_proof

/-- A priori `ℓ¹` bound of the centre `qph`. -/
theorem clHE2_qph : LHE2 49 < 2 ^ (116 - 1) := by
  kron_lt

/-- Proof-term check of the node `R3`: truncation norm. -/
theorem kHE2S_R3 : node3KS SHE2 NHE2 MHE2 DHE2 WtHE2 KvSHE2 trHE2N_R3 (1 : Int) 1 0 59 239 145 109 49 13 8 19 72 54 ≤
     := by
  kron_proof

/-- Proof-term check of the node `R3`: a priori `ℓ¹` bound. -/
theorem lHE2_R3 : nodeL1N SHE2 LHE2 trHE2N_R3 (1 : Int) 1 0 59 < 2 ^ (239 - 1) := by
  kron_lt

end PlasmaLean.Design.RationalStellaratorGC
