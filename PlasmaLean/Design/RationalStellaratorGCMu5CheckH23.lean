module

public import PlasmaLean.Design.RationalStellaratorGCMu5TreesH
public import PlasmaLean.Design.RationalStellaratorGCMu5KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu5CheckH23`)

The checks of `Design/RationalStellaratorGCMu5CheckH23` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu5LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu5

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `m12`. -/
theorem cHMS_m12 : center3KS KvSHM NHM MHM 18 111 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m12`. -/
theorem clHM_m12 : LHM 18 < 2 ^ (111 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `A1`. -/
theorem cHMS_A1 : center3KS KvSHM NHM MHM 60 125 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `A1`. -/
theorem clHM_A1 : LHM 60 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m50`: truncation norm. -/
theorem kHMS_m50 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_m50 (1 : Int) 1 0 26 226 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m50`: a priori `ℓ¹` bound. -/
theorem lHM_m50 : nodeL1N SHM LHM trHMN_m50 (1 : Int) 1 0 26 < 2 ^ (226 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu5
