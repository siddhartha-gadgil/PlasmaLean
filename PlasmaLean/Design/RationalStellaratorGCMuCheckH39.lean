/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMuCheckH39`)

The checks of `Design/RationalStellaratorGCMuCheckH39` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMuLowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `DphP`. -/
theorem cHMS_DphP : center3KS KvSHM NHM MHM 34 116 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DphP`. -/
theorem clHM_DphP : LHM 34 < 2 ^ (116 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `V42`. -/
theorem cHMS_V42 : center3KS KvSHM NHM MHM 80 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `V42`. -/
theorem clHM_V42 : LHM 80 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `KZ`: truncation norm. -/
theorem kHMS_KZ : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_KZ (1 : Int) 1 0 67 243 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `KZ`: a priori `ℓ¹` bound. -/
theorem lHM_KZ : nodeL1N SHM LHM trHMN_KZ (1 : Int) 1 0 67 < 2 ^ (243 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
