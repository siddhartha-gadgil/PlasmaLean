module

public import PlasmaLean.Design.RationalStellaratorGCEw4TreesH
public import PlasmaLean.Design.RationalStellaratorGCEw4KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw4CheckH22`)

The checks of `Design/RationalStellaratorGCEw4CheckH22` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE4`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `DphP`. -/
theorem cHE4S_DphP : center3KS KvSHE4 NHE4 MHE4 34 116 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DphP`. -/
theorem clHE4_DphP : LHE4 34 < 2 ^ (116 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `DtF`. -/
theorem cHE4S_DtF : center3KS KvSHE4 NHE4 MHE4 91 122 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `DtF`. -/
theorem clHE4_DtF : LHE4 91 < 2 ^ (122 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `m22`: truncation norm. -/
theorem kHE4S_m22 : node3KS SHE4 NHE4 MHE4 DHE4 WtHE4 KvSHE4 trHE4N_m22 (1 : Int) 1 0 22 228 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `m22`: a priori `ℓ¹` bound. -/
theorem lHE4_m22 : nodeL1N SHE4 LHE4 trHE4N_m22 (1 : Int) 1 0 22 < 2 ^ (228 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
