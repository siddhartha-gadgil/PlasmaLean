/-- Kernel check of the node `m51`: a priori `ℓ¹` bound. -/
theorem lHE2_m51 : nodeL1N SHE2 LHE2 trHE2N_m51 (1 : Int) 1 0 27 < 2 ^ (222 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
