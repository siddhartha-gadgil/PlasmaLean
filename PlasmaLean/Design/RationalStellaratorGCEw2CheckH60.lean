module

public import PlasmaLean.Design.RationalStellaratorGCEw2TreesH

/-!
# Kernel checks of the `μ > 0` passing guiding-centre torus family certificate (high resolution, part 60)

Each theorem is one kernel evaluation (`decide +kernel`) of exact integer arithmetic on the stored
Chebyshev coefficients of `Design/RationalStellaratorGCEw2DataH*`: the weighted digit sums (`node3KN`, `norm3KN`,
`center3KN` of `Certificates/KronChebCompute`) of the Kronecker images of the truncation polynomials
of the family ball pipeline, and their a priori `ℓ¹` bounds. Light module. Generated by
`scripts/gc_kam/ew_emit_lean.py`.

Energy-window node 2: gyro-length `ρ_2 = 1/256 − 5 · 2⁻³⁶`, its own family torus `K_2(λ)`; the
fields at `ρ_2` are the nodes `DtJ`, `nRtJ`, `nZtJ`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `U`. -/
theorem cHE2_U : center3KN KvHE2 NHE2 MHE2 4 119 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `U`. -/
theorem clHE2_U : LHE2 4 < 2 ^ (119 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `m40`. -/
theorem cHE2_m40 : center3KN KvHE2 NHE2 MHE2 24 109 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `m40`. -/
theorem clHE2_m40 : LHE2 24 < 2 ^ (109 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm of the centre `V4n`. -/
theorem cHE2_V4n : center3KN KvHE2 NHE2 MHE2 81 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `V4n`. -/
theorem clHE2_V4n : LHE2 81 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the norm node `dU`. -/
theorem kHE2_dU : norm3KN WtHE2 KvHE2 NHE2 MHE2 trHE2N_dU (1, 0, 0) 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- Kernel check of the norm node `dU`: a priori `ℓ¹` bound. -/
theorem lHE2_dU : ExN.majN LHE2 trHE2N_dU < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel check of the node `R2`: truncation norm. -/
theorem kHE2_R2 : node3KN SHE2 NHE2 MHE2 DHE2 WtHE2 KvHE2 trHE2N_R2 (1 : Int) 1 0 58 236 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `R2`: a priori `ℓ¹` bound. -/
theorem lHE2_R2 : nodeL1N SHE2 LHE2 trHE2N_R2 (1 : Int) 1 0 58 < 2 ^ (236 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
