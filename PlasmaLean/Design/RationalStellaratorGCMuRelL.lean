/-- **The pitch parameter of the family** at `w = c`: `λ = (1 + Re c)/32` (for `c = e^{iϑ}`:
`λ = (1 + cos ϑ)/32`, in `[0, 2/32]`). -/
def lamF (c : ℂ) : ℝ := (1 + c.re) / 32

/-- `c ≠ 0` on the unit circle. -/
theorem ne_zero_of_norm_one_mu {c : ℂ} (hc : ‖c‖ = 1) : c ≠ 0 := by
  rintro rfl; simp at hc

/-- **The parameter at `w = c`** (`|c| = 1`): `63 + 32 lamF c = 64 + (c + c⁻¹)/2`. -/
theorem param_eq_mu {c : ℂ} (hc : ‖c‖ = 1) : (((63 + 32 * lamF c : ℝ)) : ℂ) = 64 + (c + c⁻¹) / 2 := by
  have h1 : c⁻¹ = (starRingEnd ℂ) c := by
    rw [Complex.inv_def, ← Complex.sq_norm, hc]; simp
  rw [h1, Complex.add_conj, lamF]
  push_cast
  ring

/-- The variables of the family pipeline whose values differ from the `ρ = 1/256` pipeline. -/
def spLM (j : ℕ) : Bool :=
  decide (j ∈ ([62, 77, 78, 79, 101, 102, 103, 104, 105, 106, 107, 109, 111, 112, 113] : List ℕ)) || decide (114 ≤ j)

