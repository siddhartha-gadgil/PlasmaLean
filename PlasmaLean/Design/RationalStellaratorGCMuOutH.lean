/-- The full chain. -/
theorem ballHM_all {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1) :
    ∀ i, i < 96 → Bd r (XHM c i - xHM c i) (EHM i) :=
  ballHM_96 hr hq hc

/-- A value is bounded by its centre norm plus its radius. -/
theorem valHM_le {r : ℝ} (hr : 0 ≤ r) (hq : Real.exp r ≤ (74315 : ℕ) / 2 ^ 16) {c : ℂ} (hc : ‖c‖ = 1)
    (i : ℕ) (hi : i < 96) :
    Bd r (XHM c i) ((BHM i + EHM i : ℚ) : ℝ) := by
  have := (normHM hq hc i hi).add (ballHM_all hr hq hc i hi)
  rw [add_sub_cancel] at this
  push_cast
  exact this

