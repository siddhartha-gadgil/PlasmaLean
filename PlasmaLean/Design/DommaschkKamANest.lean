public import PlasmaLean.Design.DommaschkKamCRadial

/-!
# Pointwise consequences of the nesting chain of the Dommaschk tori C and A

On-demand module. Build: `lake build PlasmaLean.Design.DommaschkKamANest` (after the torus-A
admissibility chain `Design/DommaschkKamAAdmTail`, `…AAdmChain`).

The nesting chain (`Design/DommaschkKamANestChain`, generated by
`scripts/dommaschk_kam/emit_nest.py`) evaluates, at the low-resolution surrogates of tori A
(`xA 4`, `xA 5`, `32 × 32`) and C (`DommaschkKamC.xA 4`, `…5`, `24 × 28`), in the oracle angle
`ψₒ = 2φ` and with `ℓ¹` norms (strip `0`):
* the **common reference curve** `ref(ψₒ) = (rU, rZ)`, the `θ`-average of the C surrogate
  (`rU = thProj (DommaschkKamC.xA 4)`, `rZ = thProj (DommaschkKamC.xA 5)`; `xN_XC`, `xN_XA`, …);
* the radial functions `Rad_T = X_T cos θ + Y_T sin θ`, `X_T = U_T − rU`, `Y_T = Z_T − rZ`;
* the quadratic gauge `G(ψₒ; X, Y) = a X² + 2 b X Y + d Y²` (`a`, `b`, `d`: dyadic trigonometric
  polynomials of degree `4` in `ψₒ`, `gaugeA`, `gaugeB`, `gaugeD`), and `F_C = 1 − G(X_C, Y_C)`,
  `F_A = G(X_A, Y_A) − 1`;
* for every `F ∈ {Rad_C, Rad_A, F_C, F_A}` an approximate inverse square root `q_F` (data) with
  `‖q_F² F − 1‖ ≤ ε_F < 1` (norm nodes `eRC`, `eRA`, `eFC`, `eFA`: `2.5e-10`, `9.9e-9`, `0.0025`,
  `0.080`).

**Positivity from a square** (`pos_of_sq_mul`): for real `q`, `F` with `‖q q F − 1‖₀ ≤ ε < 1`,
`F > 0` everywhere (`q² ≥ 0` and `q² F` is within `ε` of `1`).

**Results** (oracle frame, for every pair of real `u, z` within `10⁻¹⁰` in `ℓ¹` of the respective
surrogate; the exact tori are, by `μ`-closeness and the tail certificates):
* `radA_pos`, `radC_pos`: `(u − rU) cos θ + (z − rZ) sin θ > 0` (radial condition about the common
  reference curve; polar angle `angF`);
* `gaugeC_lt`: `G(u − rU, z − rZ) < 1` near torus C, `gaugeA_gt`: `G > 1` near torus A; the
  coefficients do not depend on `θ` (`eval_gauge_θ`).

**Sanity.** `pos_of_sq_mul_fixture` (degenerate: `q = F = 1`), `gaugeA_ne_zero` (the gauge is not
trivial), `rU_ne_zero` (the reference curve is not the origin).
-/

@[expose] public section
noncomputable section

namespace PlasmaLean.Design.DommaschkKamA

open PlasmaLean.Design.DommaschkKamC
open Polynomial PlasmaLean.Theory.KAM PlasmaLean.Design.KamNewton PlasmaLean.Certificates.Kron2
  PlasmaLean.Certificates.KronExpr PlasmaLean.Certificates.KronBall PlasmaLean.Design.DommaschkKam
  WEll1Z2 Complex

/-! ## The common reference curve and the identification of the chain data -/

/-- The radial reference `rU = thProj (DommaschkKamC.xA 4)` (oracle angle). -/
def rU : FA := thProj (DommaschkKamC.xA 4)

/-- The vertical reference `rZ = thProj (DommaschkKamC.xA 5)` (oracle angle). -/
def rZ : FA := thProj (DommaschkKamC.xA 5)

/-- The surrogate `U` of torus C, embedded in the layout `32 × 32`. -/
theorem xC4_embed : DommaschkKamC.xA 4 = ctr SA NA MA (1, 0, 0) (gridPolyNM NA MA (embC 4)) :=
  (ctr_embedGrid 64 24 28 0 8 4 0 (DommaschkKamC.gA 4)).symm

/-- The surrogate `z` of torus C, embedded in the layout `32 × 32`. -/
theorem xC5_embed : DommaschkKamC.xA 5 = ctr SA NA MA (1, 0, 1) (gridPolyNM NA MA (embC 5)) :=
  (ctr_embedGrid 64 24 28 1 8 4 0 (DommaschkKamC.gA 5)).symm

/-- `(k + 32).toNat = 32` only for `k = 0`. -/
theorem toNat_eq_NA {k : ℤ} (hk : |k| ≤ ((NA : ℕ) : ℤ)) : (k + NA).toNat = NA ↔ k = 0 := by
  have := abs_le.mp hk
  simp only [NA] at this ⊢
  omega

/-- Removing the `k = 0` column of a grid removes the `θ`-average. -/
theorem ctr_nocol (p : ℕ) (g : ℕ → ℕ → ℤ) :
    ctr SA NA MA (1, 0, p) (gridPolyNM NA MA (fun i j => if i = NA then 0 else g i j)) =
      ctr SA NA MA (1, 0, p) (gridPolyNM NA MA g) -
        thProj (ctr SA NA MA (1, 0, p) (gridPolyNM NA MA g)) := by
  refine ext_coeff fun km => ?_
  obtain ⟨k, m⟩ := km
  rw [coeff_sub, coeff_thProj, coeff_ctr_grid, coeff_ctr_grid]
  by_cases hb : |k| ≤ ((NA : ℕ) : ℤ) ∧ |m| ≤ ((MA : ℕ) : ℤ)
  · simp only [ite_eq_left hb]
    by_cases hk : k = 0
    · simp [hk, NA]
    · have h1 : (k + NA).toNat ≠ NA := fun h => hk ((toNat_eq_NA hb.1).1 h)
      simp [hk, h1]
  · simp only [ite_eq_right hb]
    split_ifs <;> simp

/-- Subtracting the `k = 0` column of another grid subtracts its `θ`-average. -/
theorem ctr_subcol (p : ℕ) (g h : ℕ → ℕ → ℤ) :
    ctr SA NA MA (1, 0, p) (gridPolyNM NA MA (fun i j => g i j - (if i = NA then h i j else 0))) =
      ctr SA NA MA (1, 0, p) (gridPolyNM NA MA g) -
        thProj (ctr SA NA MA (1, 0, p) (gridPolyNM NA MA h)) := by
  refine ext_coeff fun km => ?_
  obtain ⟨k, m⟩ := km
  rw [coeff_sub, coeff_thProj, coeff_ctr_grid, coeff_ctr_grid, coeff_ctr_grid]
  by_cases hb : |k| ≤ ((NA : ℕ) : ℤ) ∧ |m| ≤ ((MA : ℕ) : ℤ)
  · simp only [ite_eq_left hb]
    by_cases hk : k = 0
    · simp only [hk, ite_true, zero_add]
      rw [ite_eq_left (by simp [NA])]
      push_cast; ring
    · have h1 : (k + NA).toNat ≠ NA := fun h => hk ((toNat_eq_NA hb.1).1 h)
      simp [hk, h1]
  · simp only [ite_eq_right hb]
    split_ifs <;> simp

/-- **`X_C` of the chain** is the C surrogate minus the reference. -/
theorem xN_XC : xN 195 = DommaschkKamC.xA 4 - rU := by
  rw [show xN 195 = ctr SA NA MA (1, 0, 0) (gridPolyNM NA MA gN_XC) from rfl, rU, xC4_embed]
  exact ctr_nocol 0 (embC 4)

/-- **`Y_C` of the chain.** -/
theorem xN_YC : xN 196 = DommaschkKamC.xA 5 - rZ := by
  rw [show xN 196 = ctr SA NA MA (1, 0, 1) (gridPolyNM NA MA gN_YC) from rfl, rZ, xC5_embed]
  exact ctr_nocol 1 (embC 5)

/-- **`X_A` of the chain** is the A surrogate minus the reference. -/
theorem xN_XA : xN 197 = xA 4 - rU := by
  rw [show xN 197 = ctr SA NA MA (1, 0, 0) (gridPolyNM NA MA gN_XA) from rfl, rU, xC4_embed]
  exact ctr_subcol 0 (gA 4) (embC 4)

/-- **`Y_A` of the chain.** -/
theorem xN_YA : xN 198 = xA 5 - rZ := by
  rw [show xN 198 = ctr SA NA MA (1, 0, 1) (gridPolyNM NA MA gN_YA) from rfl, rZ, xC5_embed]
  exact ctr_subcol 1 (gA 5) (embC 5)

/-- `cos θ` in the strip algebra. -/
def cθ : FA := (1 / 2 : ℂ) • (mode 0 (1, 0) + mode 0 (-1, 0))

/-- `sin θ` in the strip algebra. -/
def sθ : FA := (-I / 2) • (mode 0 (1, 0) - mode 0 (-1, 0))

/-- `eval cθ = cos θ`. -/
theorem eval_cθ (θ ψ : ℝ) : eval cθ θ ψ = ((Real.cos θ : ℝ) : ℂ) := by
  rw [cθ, eval_smul', eval_add', eval_mode, eval_mode, fourierMode, fourierMode]
  push_cast
  rw [show ((1 : ℂ) * θ + 0 * ψ) * I = θ * I by ring,
    show ((-1 : ℂ) * θ + 0 * ψ) * I = -θ * I by ring, Complex.cos]
  ring_nf

/-- `eval sθ = sin θ`. -/
theorem eval_sθ (θ ψ : ℝ) : eval sθ θ ψ = ((Real.sin θ : ℝ) : ℂ) := by
  rw [sθ, eval_smul', eval_sub', eval_mode, eval_mode, fourierMode, fourierMode]
  push_cast
  rw [show ((1 : ℂ) * θ + 0 * ψ) * I = θ * I by ring,
    show ((-1 : ℂ) * θ + 0 * ψ) * I = -θ * I by ring, Complex.sin]
  ring_nf

/-- **`cos θ` of the chain.** -/
theorem xN_ct : xN 199 = cθ := by
  rw [show xN 199 = ctr SA NA MA (1, 0, 0) (gridPolyNM NA MA gN_ct) from rfl]
  refine ext_coeff fun km => ?_
  obtain ⟨k, m⟩ := km
  rw [coeff_ctr_grid, cθ, coeff_smul, coeff_add, coeff_mode, coeff_mode]
  simp only [gN_ct, Pi.single_apply, Prod.mk.injEq, SA, NA, MA]
  by_cases h1 : k = 1 ∧ m = 0
  · obtain ⟨rfl, rfl⟩ := h1; norm_num
  · by_cases h2 : k = -1 ∧ m = 0
    · obtain ⟨rfl, rfl⟩ := h2; norm_num
    · rw [ite_eq_right h1, ite_eq_right h2]
      by_cases hb : |k| ≤ 32 ∧ |m| ≤ 32
      · have := abs_le.mp hb.1
        have := abs_le.mp hb.2
        have hc : ¬(((k + 32).toNat = 32 + 1 ∨ (k + 32).toNat = 32 - 1) ∧
            (m + 32).toNat = 32) := by omega
        simp [hb, hc]
      · simp [hb]

/-- **`sin θ` of the chain.** -/
theorem xN_st : xN 200 = sθ := by
  rw [show xN 200 = ctr SA NA MA (1, 0, 1) (gridPolyNM NA MA gN_st) from rfl]
  refine ext_coeff fun km => ?_
  obtain ⟨k, m⟩ := km
  rw [coeff_ctr_grid, sθ, coeff_smul, coeff_sub, coeff_mode, coeff_mode]
  simp only [gN_st, Pi.single_apply, Prod.mk.injEq, SA, NA, MA]
  by_cases h1 : k = 1 ∧ m = 0
  · obtain ⟨rfl, rfl⟩ := h1
    norm_num
    ring
  · by_cases h2 : k = -1 ∧ m = 0
    · obtain ⟨rfl, rfl⟩ := h2
      norm_num
      ring
    · rw [ite_eq_right h1, ite_eq_right h2]
      by_cases hb : |k| ≤ 32 ∧ |m| ≤ 32
      · have := abs_le.mp hb.1
        have := abs_le.mp hb.2
        have hc : ¬((k + 32).toNat = 32 + 1 ∧ (m + 32).toNat = 32) := by omega
        have hd : ¬((k + 32).toNat = 32 - 1 ∧ (m + 32).toNat = 32) := by omega
        simp [hb, hc, hd]
      · simp [hb]

/-! ## Reality and `θ`-independence -/

/-- The C surrogate `U` is real. -/
theorem isReal_xC4 : IsReal (DommaschkKamC.xA 4) := isReal_ctr_sym _ _ _ 0 _

/-- The C surrogate `z` is real. -/
theorem isReal_xC5 : IsReal (DommaschkKamC.xA 5) := isReal_ctr_sym _ _ _ 1 _

/-- The reference curve is real. -/
theorem isReal_rU : IsReal rU := isReal_thProj isReal_xC4

/-- The reference curve is real. -/
theorem isReal_rZ : IsReal rZ := isReal_thProj isReal_xC5

/-- The gauge coefficient `a` (variable `201`). -/
def gaugeA : FA := xN 201
/-- The gauge coefficient `b` (variable `202`). -/
def gaugeB : FA := xN 202
/-- The gauge coefficient `d` (variable `203`). -/
def gaugeD : FA := xN 203

/-- The gauge coefficients are real. -/
theorem isReal_gaugeA : IsReal gaugeA := isReal_ctr_sym _ _ _ 0 _
/-- The gauge coefficients are real. -/
theorem isReal_gaugeB : IsReal gaugeB := isReal_ctr_sym _ _ _ 1 _
/-- The gauge coefficients are real. -/
theorem isReal_gaugeD : IsReal gaugeD := isReal_ctr_sym _ _ _ 0 _

/-- The grids of the gauge coefficients vanish left of the column `k = 0`. -/
theorem gauge_col_lo : ∀ i ≤ 31, ∀ j ≤ 64,
    gN 201 i j = 0 ∧ gN 202 i j = 0 ∧ gN 203 i j = 0 := by
  kernel_fact

/-- The grids of the gauge coefficients vanish right of the column `k = 0`. -/
theorem gauge_col_hi : ∀ i ≤ 31, ∀ j ≤ 64,
    gN 201 (i + 33) j = 0 ∧ gN 202 (i + 33) j = 0 ∧ gN 203 (i + 33) j = 0 := by
  kernel_fact

/-- The grids of the gauge coefficients live on the column `k = 0`. -/
theorem gauge_col : ∀ i ≤ 64, ∀ j ≤ 64, i ≠ 32 →
    gN 201 i j = 0 ∧ gN 202 i j = 0 ∧ gN 203 i j = 0 := by
  intro i hi j hj h
  rcases lt_or_gt_of_ne h with h1 | h1
  · exact gauge_col_lo i (by omega) j hj
  · obtain ⟨n, rfl⟩ : ∃ n, i = n + 33 := ⟨i - 33, by omega⟩
    exact gauge_col_hi n (by omega) j hj

/-- A grid centre supported on the column `k = 0` is its own `θ`-average. -/
theorem thProj_ctr_col (p : ℕ) {g : ℕ → ℕ → ℤ} (hg : ∀ i ≤ 64, ∀ j ≤ 64, i ≠ 32 → g i j = 0) :
    thProj (ctr SA NA MA (1, 0, p) (gridPolyNM NA MA g)) =
      ctr SA NA MA (1, 0, p) (gridPolyNM NA MA g) := by
  refine ext_coeff fun km => ?_
  obtain ⟨k, m⟩ := km
  rw [coeff_thProj, coeff_ctr_grid]
  by_cases hk : k = 0
  · simp [hk]
  · rw [ite_eq_right hk]
    by_cases hb : |k| ≤ ((NA : ℕ) : ℤ) ∧ |m| ≤ ((MA : ℕ) : ℤ)
    · have h1 : (k + NA).toNat ≠ NA := fun h => hk ((toNat_eq_NA hb.1).1 h)
      have := abs_le.mp hb.1
      have := abs_le.mp hb.2
      rw [ite_eq_left hb, hg _ (by simp only [NA] at *; omega) _ (by simp only [MA] at *; omega)
        (by simpa [NA] using h1)]
      simp
    · simp [hb]

/-- The gauge coefficients do not depend on `θ`. -/
theorem eval_gauge_θ (θ ψ : ℝ) :
    eval gaugeA θ ψ = eval gaugeA 0 ψ ∧ eval gaugeB θ ψ = eval gaugeB 0 ψ ∧
      eval gaugeD θ ψ = eval gaugeD 0 ψ := by
  have ha : thProj gaugeA = gaugeA :=
    thProj_ctr_col 0 (g := gN 201) fun i hi j hj h => (gauge_col i hi j hj h).1
  have hb : thProj gaugeB = gaugeB :=
    thProj_ctr_col 1 (g := gN 202) fun i hi j hj h => (gauge_col i hi j hj h).2.1
  have hd : thProj gaugeD = gaugeD :=
    thProj_ctr_col 0 (g := gN 203) fun i hi j hj h => (gauge_col i hi j hj h).2.2
  refine ⟨?_, ?_, ?_⟩
  · rw [← ha]; exact eval_thProj _ θ ψ
  · rw [← hb]; exact eval_thProj _ θ ψ
  · rw [← hd]; exact eval_thProj _ θ ψ

/-! ## Positivity from a square -/

/-- **Positivity from a square**: if `q` and `F` are real and `‖q q F − 1‖₀ ≤ ε < 1`, then
`F > 0` everywhere. -/
theorem pos_of_sq_mul {q F : FA} (hq : IsReal q) (hF : IsReal F) {ε : ℝ} (hε : ε < 1)
    (h : Bd 0 (q * q * F - 1) ε) (θ ψ : ℝ) : 0 < (eval F θ ψ).re := by
  have hb := norm_eval_le_of_Bd le_rfl h θ ψ
  rw [eval_sub', WEll1Z2.eval_mul, WEll1Z2.eval_mul, eval_one, eval_ofReal_re hq,
    eval_ofReal_re hF] at hb
  set a := (eval q θ ψ).re
  set f := (eval F θ ψ).re
  have e : (a : ℂ) * a * f - 1 = ((a * a * f - 1 : ℝ) : ℂ) := by push_cast; ring
  rw [e, Complex.norm_real, Real.norm_eq_abs] at hb
  have h1 : 0 < a * a * f := by have := (abs_le.mp hb).1; linarith
  by_contra! hf
  nlinarith [mul_self_nonneg a]

/-- **Sanity (degenerate fixture)**: `q = F = 1`. -/
theorem pos_of_sq_mul_fixture (θ ψ : ℝ) : 0 < (eval (1 : FA) θ ψ).re :=
  pos_of_sq_mul IsReal.one IsReal.one (ε := 0) (by norm_num) (by simpa using Bd_zero 0) θ ψ

/-! ## The radial conditions -/

/-- The norm node `e_F` with the identification `XN 0 = 1`. -/
theorem eval_eTree {s F : ℕ} {t : Ex} (ht : Ex.eval XN t = XN s * XN F - XN 0 * XN 0) :
    Ex.eval XN t = XN s * XN F - 1 := by
  rw [ht, show XN 0 = 1 by rw [XN_lt (by norm_num)]; rfl, one_mul]

/-- `q` data are real. -/
theorem isReal_q (i : ℕ) (hi : i = 214 ∨ i = 215 ∨ i = 216 ∨ i = 217) : IsReal (xN i) := by
  rcases hi with rfl | rfl | rfl | rfl <;> exact isReal_ctr_sym _ _ _ 0 _

/-- Closeness transfer for an approximate inverse square: `‖s F' − 1‖ ≤ ε + ‖s‖ ‖F' − F‖`. -/
theorem sq_near {s F F' : FA} {ε Bs δ : ℝ} (h0 : Bd 0 (s * F - 1) ε) (hs : Bd 0 s Bs)
    (hd : Bd 0 (F' - F) δ) : Bd 0 (s * F' - 1) (ε + Bs * δ) := by
  have := h0.add (hs.mul le_rfl hd)
  rwa [show s * F - 1 + s * (F' - F) = s * F' - 1 by ring] at this

/-- The real radial function at a point. -/
theorem eval_rad {u z : FA} (hu : IsReal u) (hz : IsReal z) (θ ψ : ℝ) :
    (eval ((u - rU) * cθ + (z - rZ) * sθ) θ ψ).re =
      ((eval u θ ψ).re - (eval rU 0 ψ).re) * Real.cos θ +
        ((eval z θ ψ).re - (eval rZ 0 ψ).re) * Real.sin θ := by
  have hU : eval rU θ ψ = eval rU 0 ψ := eval_thProj _ θ ψ
  have hZ : eval rZ θ ψ = eval rZ 0 ψ := eval_thProj _ θ ψ
  rw [eval_add', WEll1Z2.eval_mul, WEll1Z2.eval_mul, eval_sub', eval_sub', eval_cθ, eval_sθ, hU, hZ,
    eval_ofReal_re hu, eval_ofReal_re hz, eval_ofReal_re isReal_rU 0 ψ,
    eval_ofReal_re isReal_rZ 0 ψ]
  simp [Complex.cos_ofReal_re, Complex.sin_ofReal_re]

/-- The real radial function is real. -/
theorem isReal_rad {u z : FA} (hu : IsReal u) (hz : IsReal z) :
    IsReal ((u - rU) * cθ + (z - rZ) * sθ) := by
  have hc : IsReal cθ := (isReal_iff_eval _).2 fun θ ψ => by rw [eval_cθ, Complex.conj_ofReal]
  have hs : IsReal sθ := (isReal_iff_eval _).2 fun θ ψ => by rw [eval_sθ, Complex.conj_ofReal]
  exact ((hu.sub isReal_rU).mul hc).add ((hz.sub isReal_rZ).mul hs)

/-- `‖cos θ‖₀ ≤ 1`, `‖sin θ‖₀ ≤ 1`. -/
theorem Bd_cθ : Bd 0 cθ 1 := by
  have h := normN 199 (by norm_num)
  rw [xN_ct] at h
  exact h.le (by exact_mod_cast (show BN 199 ≤ 1 by kernel_fact))

/-- `‖sin θ‖₀ ≤ 1`. -/
theorem Bd_sθ : Bd 0 sθ 1 := by
  have h := normN 200 (by norm_num)
  rw [xN_st] at h
  exact h.le (by exact_mod_cast (show BN 200 ≤ 1 by kernel_fact))

/-- The radial function moves by at most `h + h` when `U`, `Z` move by at most `h`. -/
theorem rad_near {u z u0 z0 : FA} {h : ℝ} (hU : Bd 0 (u - u0) h) (hZ : Bd 0 (z - z0) h) :
    Bd 0 (((u - rU) * cθ + (z - rZ) * sθ) - ((u0 - rU) * cθ + (z0 - rZ) * sθ)) (h + h) := by
  have := (hU.mul le_rfl Bd_cθ).add (hZ.mul le_rfl Bd_sθ)
  rw [show (u - rU) * cθ + (z - rZ) * sθ - ((u0 - rU) * cθ + (z0 - rZ) * sθ) =
    (u - u0) * cθ + (z - z0) * sθ by ring]
  simpa using this

/-- **The radial condition near torus A** about the common reference curve. -/
theorem radA_pos {u z : FA} (hu : IsReal u) (hz : IsReal z)
    (hU : Bd 0 (u - xA 4) (1 / 10 ^ 10)) (hZ : Bd 0 (z - xA 5) (1 / 10 ^ 10)) (θ ψ : ℝ) :
    0 < ((eval u θ ψ).re - (eval rU 0 ψ).re) * Real.cos θ +
      ((eval z θ ψ).re - (eval rZ 0 ψ).re) * Real.sin θ := by
  have e0 := nN_eRA
  rw [eval_eTree (s := 219) (F := 205) (by simp only [trN_eRA, Ex.eval])] at e0
  have hR : XN 205 = (xA 4 - rU) * cθ + (xA 5 - rZ) * sθ := by
    rw [show XN 205 = xN 197 * xN 199 + xN 198 * xN 200 from rfl, xN_XA, xN_YA, xN_ct, xN_st]
  have hs : XN 219 = xN 215 * xN 215 := rfl
  have hsB := valN_le 219 (by norm_num)
  rw [hR] at e0
  have h2 := sq_near e0 hsB (rad_near hU hZ)
  rw [hs] at h2
  have hq := isReal_q 215 (by norm_num)
  have := pos_of_sq_mul hq (isReal_rad hu hz) (ε := _) ?_ h2 θ ψ
  · rwa [eval_rad hu hz] at this
  · have hq := (show (247113 / 25000000000000 : ℚ) + (BN 219 + EN 219) *
        (1 / 10 ^ 10 + 1 / 10 ^ 10) < 1 by
      kernel_fact)
    have := (Rat.cast_lt (K := ℝ)).2 hq
    push_cast at this ⊢
    linarith

/-- **The radial condition near torus C** about the common reference curve. -/
theorem radC_pos {u z : FA} (hu : IsReal u) (hz : IsReal z)
    (hU : Bd 0 (u - DommaschkKamC.xA 4) (1 / 10 ^ 10))
    (hZ : Bd 0 (z - DommaschkKamC.xA 5) (1 / 10 ^ 10)) (θ ψ : ℝ) :
    0 < ((eval u θ ψ).re - (eval rU 0 ψ).re) * Real.cos θ +
      ((eval z θ ψ).re - (eval rZ 0 ψ).re) * Real.sin θ := by
  have e0 := nN_eRC
  rw [eval_eTree (s := 218) (F := 204) (by simp only [trN_eRC, Ex.eval])] at e0
  have hR : XN 204 = (DommaschkKamC.xA 4 - rU) * cθ + (DommaschkKamC.xA 5 - rZ) * sθ := by
    rw [show XN 204 = xN 195 * xN 199 + xN 196 * xN 200 from rfl, xN_XC, xN_YC, xN_ct, xN_st]
  have hs : XN 218 = xN 214 * xN 214 := rfl
  have hsB := valN_le 218 (by norm_num)
  rw [hR] at e0
  have h2 := sq_near e0 hsB (rad_near hU hZ)
  rw [hs] at h2
  have hq := isReal_q 214 (by norm_num)
  have := pos_of_sq_mul hq (isReal_rad hu hz) (ε := _) ?_ h2 θ ψ
  · rwa [eval_rad hu hz] at this
  · have hq := (show (250743 / 10 ^ 15 : ℚ) + (BN 218 + EN 218) *
        (1 / 10 ^ 10 + 1 / 10 ^ 10) < 1 by
      kernel_fact)
    have := (Rat.cast_lt (K := ℝ)).2 hq
    push_cast at this ⊢
    linarith

/-! ## The gauge -/

/-- The gauge `G(X, Y) = a X² + 2 b X Y + d Y²` in the strip algebra. -/
def gaugeQ (X Y : FA) : FA :=
  gaugeA * (X * X) + ((2 : ℤ) : FA) * (gaugeB * (X * Y)) + gaugeD * (Y * Y)

/-- The real gauge `G(ψₒ; X, Y)` (coefficients at `θ = 0`). -/
def gaugeR (ψ X Y : ℝ) : ℝ :=
  (eval gaugeA 0 ψ).re * X ^ 2 + 2 * (eval gaugeB 0 ψ).re * X * Y + (eval gaugeD 0 ψ).re * Y ^ 2

/-- **Homogeneity**: `G(r X, r Y) = r² G(X, Y)`. -/
theorem gaugeR_smul (ψ r X Y : ℝ) : gaugeR ψ (r * X) (r * Y) = r ^ 2 * gaugeR ψ X Y := by
  unfold gaugeR; ring

/-- The gauge at a point. -/
theorem eval_gaugeQ {X Y : FA} (hX : IsReal X) (hY : IsReal Y) (θ ψ : ℝ) :
    (eval (gaugeQ X Y) θ ψ).re = gaugeR ψ (eval X θ ψ).re (eval Y θ ψ).re := by
  obtain ⟨ha, hb, hd⟩ := eval_gauge_θ θ ψ
  rw [gaugeQ, eval_add', eval_add', WEll1Z2.eval_mul, WEll1Z2.eval_mul, WEll1Z2.eval_mul,
    WEll1Z2.eval_mul, WEll1Z2.eval_mul, WEll1Z2.eval_mul,
    WEll1Z2.eval_mul, ha, hb, hd, eval_ofReal_re hX, eval_ofReal_re hY,
    eval_ofReal_re isReal_gaugeA 0 ψ, eval_ofReal_re isReal_gaugeB 0 ψ,
    eval_ofReal_re isReal_gaugeD 0 ψ]
  have e2 : eval (((2 : ℤ) : FA)) θ ψ = ((2 : ℝ) : ℂ) := by
    rw [show (((2 : ℤ) : FA)) = algebraMap ℂ FA 2 by rw [map_ofNat]; push_cast; rfl,
      eval_algebraMap]
    push_cast; rfl
  rw [e2, gaugeR]
  simp only [← Complex.ofReal_mul, ← Complex.ofReal_add, Complex.ofReal_re]
  ring

/-- The gauge is real for real arguments. -/
theorem isReal_gaugeQ {X Y : FA} (hX : IsReal X) (hY : IsReal Y) : IsReal (gaugeQ X Y) := by
  have h2 : IsReal (((2 : ℤ) : FA)) := by
    rw [show (((2 : ℤ) : FA)) = algebraMap ℂ FA ((2 : ℝ) : ℂ) by
      rw [Complex.ofReal_ofNat, map_ofNat]; push_cast; rfl]
    exact IsReal.algebraMap 2
  exact ((isReal_gaugeA.mul (hX.mul hX)).add (h2.mul (isReal_gaugeB.mul (hX.mul hY)))).add
    (isReal_gaugeD.mul (hY.mul hY))

/-- **Closeness of the gauge**: moving `X`, `Y` by at most `h` moves `G` by at most
`a h(2X + h) + 2 b (h(Y + h) + X h) + d h(2Y + h)` (norm bounds). -/
theorem gauge_near {X Y dX dY : FA} {Ba Bb Bdd BX BY h : ℝ} (ha : Bd 0 gaugeA Ba)
    (hb : Bd 0 gaugeB Bb) (hd : Bd 0 gaugeD Bdd) (hX : Bd 0 X BX) (hY : Bd 0 Y BY)
    (hdX : Bd 0 dX h) (hdY : Bd 0 dY h) :
    Bd 0 (gaugeQ (X + dX) (Y + dY) - gaugeQ X Y)
      (Ba * (h * (BX + BX + h)) + 2 * (Bb * (h * (BY + h) + BX * h)) +
        Bdd * (h * (BY + BY + h))) := by
  have e : gaugeQ (X + dX) (Y + dY) - gaugeQ X Y =
      gaugeA * (dX * (X + X + dX)) + (gaugeB * (dX * (Y + dY) + X * dY) +
        gaugeB * (dX * (Y + dY) + X * dY)) + gaugeD * (dY * (Y + Y + dY)) := by
    simp only [gaugeQ]; push_cast; ring
  rw [e]
  have h1 := ha.mul le_rfl (hdX.mul le_rfl ((hX.add hX).add hdX))
  have h2 := hb.mul le_rfl ((hdX.mul le_rfl (hY.add hdY)).add (hX.mul le_rfl hdY))
  have h3 := hd.mul le_rfl (hdY.mul le_rfl ((hY.add hY).add hdY))
  exact ((h1.add (h2.add h2)).add h3).le (le_of_eq (by ring))

/-- The honest `F_C` of the chain is `1 − G` at the C surrogate. -/
theorem XN_FC : XN 212 = 1 - gaugeQ (DommaschkKamC.xA 4 - rU) (DommaschkKamC.xA 5 - rZ) := by
  rw [show XN 212 = (XA 0 * XA 0) - ((xN 201 * (xN 195 * xN 195) + ((2 : ℤ) : FA) *
      (xN 202 * (xN 195 * xN 196))) + xN 203 * (xN 196 * xN 196)) from rfl,
    show XA 0 = 1 from rfl, xN_XC, xN_YC, one_mul]
  rfl

/-- The honest `F_A` of the chain is `G − 1` at the A surrogate. -/
theorem XN_FA : XN 213 = gaugeQ (xA 4 - rU) (xA 5 - rZ) - 1 := by
  rw [show XN 213 = ((xN 201 * (xN 197 * xN 197) + ((2 : ℤ) : FA) *
      (xN 202 * (xN 197 * xN 198))) + xN 203 * (xN 198 * xN 198)) - (XA 0 * XA 0) from rfl,
    show XA 0 = 1 from rfl, xN_XA, xN_YA, one_mul]
  rfl

/-- **The gauge is below `1` near torus C.** -/
theorem gaugeC_lt {u z : FA} (hu : IsReal u) (hz : IsReal z)
    (hU : Bd 0 (u - DommaschkKamC.xA 4) (1 / 10 ^ 10))
    (hZ : Bd 0 (z - DommaschkKamC.xA 5) (1 / 10 ^ 10)) (θ ψ : ℝ) :
    gaugeR ψ ((eval u θ ψ).re - (eval rU 0 ψ).re) ((eval z θ ψ).re - (eval rZ 0 ψ).re) < 1 := by
  have e0 := nN_eFC
  rw [eval_eTree (s := 220) (F := 212) (by simp only [trN_eFC, Ex.eval]), XN_FC] at e0
  have hs : XN 220 = xN 216 * xN 216 := rfl
  have hsB := valN_le 220 (by norm_num)
  have hG := gauge_near (valN_le 201 (by norm_num)) (valN_le 202 (by norm_num))
    (valN_le 203 (by norm_num)) (valN_le 195 (by norm_num)) (valN_le 196 (by norm_num)) hU hZ
  rw [show XN 195 = DommaschkKamC.xA 4 - rU from xN_XC,
    show XN 196 = DommaschkKamC.xA 5 - rZ from xN_YC] at hG
  rw [show DommaschkKamC.xA 4 - rU + (u - DommaschkKamC.xA 4) = u - rU by ring,
    show DommaschkKamC.xA 5 - rZ + (z - DommaschkKamC.xA 5) = z - rZ by ring] at hG
  have hG' := hG.neg
  rw [show -(gaugeQ (u - rU) (z - rZ) -
      gaugeQ (DommaschkKamC.xA 4 - rU) (DommaschkKamC.xA 5 - rZ)) =
      (1 - gaugeQ (u - rU) (z - rZ)) -
        (1 - gaugeQ (DommaschkKamC.xA 4 - rU) (DommaschkKamC.xA 5 - rZ)) by ring] at hG'
  have h2 := sq_near e0 hsB hG'
  rw [hs] at h2
  have hX : IsReal (u - rU) := hu.sub isReal_rU
  have hY : IsReal (z - rZ) := hz.sub isReal_rZ
  have hF : IsReal (1 - gaugeQ (u - rU) (z - rZ)) := IsReal.one.sub (isReal_gaugeQ hX hY)
  have := pos_of_sq_mul (isReal_q 216 (by norm_num)) hF (ε := _) ?_ h2 θ ψ
  · rw [eval_sub', eval_one, Complex.sub_re, Complex.one_re, eval_gaugeQ hX hY, eval_sub',
      eval_sub', Complex.sub_re, Complex.sub_re, show eval rU θ ψ = eval rU 0 ψ from
      eval_thProj _ θ ψ, show eval rZ θ ψ = eval rZ 0 ψ from eval_thProj _ θ ψ] at this
    linarith
  · have hq := (show (49267 / 20000000 : ℚ) + (BN 220 + EN 220) *
        ((BN 201 + EN 201) * (1 / 10 ^ 10 * ((BN 195 + EN 195) + (BN 195 + EN 195) +
          1 / 10 ^ 10)) + 2 * ((BN 202 + EN 202) * (1 / 10 ^ 10 * ((BN 196 + EN 196) +
          1 / 10 ^ 10) + (BN 195 + EN 195) * (1 / 10 ^ 10))) + (BN 203 + EN 203) *
          (1 / 10 ^ 10 * ((BN 196 + EN 196) + (BN 196 + EN 196) + 1 / 10 ^ 10))) < 1 by
      kernel_fact)
    have := (Rat.cast_lt (K := ℝ)).2 hq
    push_cast at this ⊢
    linarith

/-- **The gauge is above `1` near torus A.** -/
theorem gaugeA_gt {u z : FA} (hu : IsReal u) (hz : IsReal z)
    (hU : Bd 0 (u - xA 4) (1 / 10 ^ 10)) (hZ : Bd 0 (z - xA 5) (1 / 10 ^ 10)) (θ ψ : ℝ) :
    1 < gaugeR ψ ((eval u θ ψ).re - (eval rU 0 ψ).re) ((eval z θ ψ).re - (eval rZ 0 ψ).re) := by
  have e0 := nN_eFA
  rw [eval_eTree (s := 221) (F := 213) (by simp only [trN_eFA, Ex.eval]), XN_FA] at e0
  have hs : XN 221 = xN 217 * xN 217 := rfl
  have hsB := valN_le 221 (by norm_num)
  have hG := gauge_near (valN_le 201 (by norm_num)) (valN_le 202 (by norm_num))
    (valN_le 203 (by norm_num)) (valN_le 197 (by norm_num)) (valN_le 198 (by norm_num)) hU hZ
  rw [show XN 197 = xA 4 - rU from xN_XA, show XN 198 = xA 5 - rZ from xN_YA] at hG
  rw [show xA 4 - rU + (u - xA 4) = u - rU by ring,
    show xA 5 - rZ + (z - xA 5) = z - rZ by ring] at hG
  have hG' := hG
  rw [show gaugeQ (u - rU) (z - rZ) - gaugeQ (xA 4 - rU) (xA 5 - rZ) =
      (gaugeQ (u - rU) (z - rZ) - 1) - (gaugeQ (xA 4 - rU) (xA 5 - rZ) - 1) by ring] at hG'
  have h2 := sq_near e0 hsB hG'
  rw [hs] at h2
  have hX : IsReal (u - rU) := hu.sub isReal_rU
  have hY : IsReal (z - rZ) := hz.sub isReal_rZ
  have hF : IsReal (gaugeQ (u - rU) (z - rZ) - 1) := (isReal_gaugeQ hX hY).sub IsReal.one
  have := pos_of_sq_mul (isReal_q 217 (by norm_num)) hF (ε := _) ?_ h2 θ ψ
  · rw [eval_sub', eval_one, Complex.sub_re, Complex.one_re, eval_gaugeQ hX hY, eval_sub',
      eval_sub', Complex.sub_re, Complex.sub_re, show eval rU θ ψ = eval rU 0 ψ from
      eval_thProj _ θ ψ, show eval rZ θ ψ = eval rZ 0 ψ from eval_thProj _ θ ψ] at this
    linarith
  · have hq := (show (198941 / 2500000 : ℚ) + (BN 221 + EN 221) *
        ((BN 201 + EN 201) * (1 / 10 ^ 10 * ((BN 197 + EN 197) + (BN 197 + EN 197) +
          1 / 10 ^ 10)) + 2 * ((BN 202 + EN 202) * (1 / 10 ^ 10 * ((BN 198 + EN 198) +
          1 / 10 ^ 10) + (BN 197 + EN 197) * (1 / 10 ^ 10))) + (BN 203 + EN 203) *
          (1 / 10 ^ 10 * ((BN 198 + EN 198) + (BN 198 + EN 198) + 1 / 10 ^ 10))) < 1 by
      kernel_fact)
    have := (Rat.cast_lt (K := ℝ)).2 hq
    push_cast at this ⊢
    linarith

