/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu2CheckH46`)

The checks of `Design/RationalStellaratorGCMu2CheckH46` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu2LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu2

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `PuP`. -/
theorem cHMS_PuP : center3KS KvSHM NHM MHM 41 123 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `PuP`. -/
theorem clHM_PuP : LHM 41 < 2 ^ (123 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `N2`. -/
theorem cHMS_N2 : center3KS KvSHM NHM MHM 87 124 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `N2`. -/
theorem clHM_N2 : LHM 87 < 2 ^ (124 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `EN`: truncation norm. -/
theorem kHMS_EN : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_EN (-1 : Int) 1 0 85 241 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `EN`: a priori `ℓ¹` bound. -/
theorem lHM_EN : nodeL1N SHM LHM trHMN_EN (-1 : Int) 1 0 85 < 2 ^ (241 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu2
