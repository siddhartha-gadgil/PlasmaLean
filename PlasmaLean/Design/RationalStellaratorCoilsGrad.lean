/-! ## Circle reduction -/

/-- `τ^a (1 - τ²)^q`. -/
@[expose] def cbasis (a q : ℕ) : D1 :=
  (List.replicate a [0, 1] ++ List.replicate q [1, 0, -1]).foldr mul1 [1]

/-- Value of `cbasis`. -/
theorem ev1_cbasis (a q : ℕ) (τ : ℝ) : ev1 (cbasis a q) τ = τ ^ a * (1 - τ ^ 2) ^ q := by
  simp only [cbasis, ev1_foldr_mul1, List.map_append, List.map_replicate, List.prod_append,
    List.prod_replicate]
  have h1 : ev1 [0, 1] τ = τ := by simp [ev1, evL]
  have h2 : ev1 [1, 0, -1] τ = 1 - τ ^ 2 := by simp [ev1, evL]; ring
  rw [h1, h2]

/-- The part of `p(s, z, C, S)` with `S`-parity `par`, after `S² ↦ 1 - C²`, as a dense
polynomial in `(s, z, C)`. -/
@[expose] def circD (par : ℕ) (p : FPoly) : D3 :=
  p.foldr (fun t acc =>
    if t.2.getD 3 0 % 2 = par then
      add3 (place (t.2.getD 0 0) (t.2.getD 1 0)
        (smul1 t.1 (cbasis (t.2.getD 2 0) (t.2.getD 3 0 / 2)))) acc
    else acc) []

/-- **Circle reduction**: on `C² + S² = 1`, `p = p₀ + S p₁`. -/
theorem ev_circ (p : FPoly) (hp : ∀ u ∈ p, u.2.length ≤ 4) {s z C S : ℝ}
    (hCS : C ^ 2 + S ^ 2 = 1) :
    eval (toQ p) (vars4 s z C S) = ev3 (circD 0 p) s z C + S * ev3 (circD 1 p) s z C := by
  induction p with
  | nil => simp [toQ, circD, ev3]
  | cons u p ih =>
    have hu := hp u (by simp)
    have ih' := ih (fun x hx => hp x (by simp [hx]))
    simp only [toQ, List.map_cons, eval_cons] at ih' ⊢
    rw [ih', evalMono_four _ hu]
    simp only [vars4, List.getD_cons_zero, List.getD_cons_succ]
    have hS2 : S ^ 2 = 1 - C ^ 2 := by linarith
    have hb : u.2.getD 3 0 = 2 * (u.2.getD 3 0 / 2) + u.2.getD 3 0 % 2 :=
      (Nat.div_add_mod _ 2).symm
    rcases Nat.mod_two_eq_zero_or_one (u.2.getD 3 0) with h | h
    · have e0 : circD 0 (u :: p) = add3 (place (u.2.getD 0 0) (u.2.getD 1 0)
          (smul1 u.1 (cbasis (u.2.getD 2 0) (u.2.getD 3 0 / 2)))) (circD 0 p) := by
        simp only [circD, List.foldr_cons, h, ↓reduceIte]
      have e1 : circD 1 (u :: p) = circD 1 p := by
        simp only [circD, List.foldr_cons, h, zero_ne_one, ↓reduceIte]
      rw [e0, e1, ev3_add3, ev3_place, ev1_smul1, ev1_cbasis]
      have : S ^ u.2.getD 3 0 = (1 - C ^ 2) ^ (u.2.getD 3 0 / 2) := by
        rw [hb, h, add_zero, pow_mul, hS2, Nat.mul_div_cancel_left _ (by norm_num)]
      rw [this]; push_cast; ring
    · have e0 : circD 0 (u :: p) = circD 0 p := by
        simp only [circD, List.foldr_cons, h, one_ne_zero, ↓reduceIte]
      have e1 : circD 1 (u :: p) = add3 (place (u.2.getD 0 0) (u.2.getD 1 0)
          (smul1 u.1 (cbasis (u.2.getD 2 0) (u.2.getD 3 0 / 2)))) (circD 1 p) := by
        simp only [circD, List.foldr_cons, h, ↓reduceIte]
      rw [e0, e1, ev3_add3, ev3_place, ev1_smul1, ev1_cbasis]
      have hq : (2 * (u.2.getD 3 0 / 2) + 1) / 2 = u.2.getD 3 0 / 2 := by omega
      have : S ^ u.2.getD 3 0 = S * (1 - C ^ 2) ^ (u.2.getD 3 0 / 2) := by
        conv_lhs => rw [hb, h]
        rw [pow_add, pow_mul, hS2, pow_one]; ring
      rw [this]; push_cast; ring

/-- Value of a constant dense polynomial. -/
theorem ev3_const (k : ℤ) (σ ζ τ : ℝ) : ev3 [[[k]]] σ ζ τ = k := by
  simp [ev3, ev2, ev1, evL]

/-- **Soundness of a circle-part cover**: `|q(s, z, C)| ≤ c` on `|s|, |z| ≤ 1/10`, `|C| ≤ 1`. -/
theorem circ_bound_of {p : FPoly} {par ds dz dm : ℕ} {c : ℤ} {A : D3} {pl : Plan}
    (heq : (lenOK 0 ds (circD par p) && lenOK 1 dz (circD par p) &&
      beq3 (scale0 10 ds (scale1 10 dz (circD par p))) A) = true)
    (hchk : check true (ds, dz, dm) [] pl A [[[c * 10 ^ (ds + dz)]]] 0 = true)
    {s z C : ℝ} (hs : |s| ≤ 1 / 10) (hz : |z| ≤ 1 / 10) (hC : |C| ≤ 1) :
    |ev3 (circD par p) s z C| ≤ c := by
  have hgood := check_sound (absMode := true) (dd := (ds, dz, dm)) (lits := []) (by simp) pl A
    _ 0 hchk
  simp only [Bool.and_eq_true] at heq
  obtain ⟨⟨h0, h1⟩, h2⟩ := heq
  simp only [lenOK, decide_eq_true_eq, List.all_eq_true] at h0 h1
  have hσ : |10 * s| ≤ 1 := by rw [abs_mul]; norm_num; linarith
  have hζ : |10 * z| ≤ 1 := by rw [abs_mul]; norm_num; linarith
  have h := hgood (10 * s) (10 * z) C hσ hζ hC
  simp only [ite_true, Nat.cast_zero, add_zero] at h
  rw [← ev3_beq3 _ _ h2, ev3_scale0 10 ds (by norm_num) _ (by simpa [scale1] using h0),
    ev3_scale1 10 dz (by norm_num) _ h1, ev3_const] at h
  have e1 : 10 * s / ((10 : ℕ) : ℝ) = s := by push_cast; ring
  have e2 : 10 * z / ((10 : ℕ) : ℝ) = z := by push_cast; ring
  rw [e1, e2, abs_mul, abs_mul] at h
  have hpos : (0 : ℝ) < ((10 : ℕ) : ℝ) ^ ds * ((10 : ℕ) : ℝ) ^ dz := by positivity
  rw [abs_of_pos (by positivity : (0 : ℝ) < ((10 : ℕ) : ℝ) ^ ds),
    abs_of_pos (by positivity : (0 : ℝ) < ((10 : ℕ) : ℝ) ^ dz)] at h
  push_cast at h
  have : (10 : ℝ) ^ ds * (10 : ℝ) ^ dz * |ev3 (circD par p) s z C| ≤
      (10 : ℝ) ^ ds * (10 : ℝ) ^ dz * c := by
    calc _ = (10 : ℝ) ^ ds * ((10 : ℝ) ^ dz * |ev3 (circD par p) s z C|) := by ring
      _ ≤ c * (10 : ℝ) ^ (ds + dz) := h
      _ = _ := by ring
  exact le_of_mul_le_mul_left this (by positivity)

