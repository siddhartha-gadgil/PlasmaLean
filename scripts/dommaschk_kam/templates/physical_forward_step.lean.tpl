module

public import PlasmaLean.Design.DommaschkPositionFramesFwd
public import PlasmaLean.Design.DommaschkPhysicalTraceStep${rectangle_import}
public import ${jac_package}.${jac}
public import TraceCache.${central}

/-! # Certified physical forward slab ${index} at the phase-zero 47/100 endpoint

Generated by `verify_physical_trace_slabs.py` from authenticated sparse field
and moving-frame certificates for this same row of the archived trajectory.
-/

@[expose] public section
noncomputable section
namespace PlasmaLean.Design.${name}

open Certificates PositionFrameSlabs TrajectoryTaylorModel DommaschkKam DommaschkBounceField
open DommaschkJacobian DommaschkPhysicalTraceStep Set
open scoped RealInnerProductSpace

/-- Inherited entrance state from the preceding archived row. -/
abbrev previous := ${previous}

/-- Actual datum in its stored pilot block. -/
def row : Step := ${stored}

theorem checked : test pilotLimits previous row = true := by with_unfolding_all rfl

private theorem clock (t : ℝ) : coord (${index} / 64) t = 128*t-${offset} := by unfold coord; ring

private theorem stop : (${index} / 64 : ℝ) + 1 / 64 = ${end} / 64 := by norm_num

private theorem trialMatches : CenterMatches row ${jac}.trial := by
  constructor <;> with_unfolding_all rfl

private theorem central : CenterMatches row ${central}.reference := by
  constructor <;> with_unfolding_all rfl

private theorem member {t : ℝ} (ht : t ∈ Icc (${index} / 64) (${index} / 64 + 1 / 64)) {v : Plane}
    (hv : v ∈ Metric.closedBall (0 : Plane) (row.trial / (2 : ℝ) ^ 80)) :
    let x := reference (${index} / 64) row t + moving previous row (${index} / 64) t v
    ${jac}.trial.u.Mem (128*t-${offset}) (x 0 - dkR0) ∧
      ${jac}.trial.z.Mem (128*t-${offset}) (x 1) := by
${membership}

/-- Physical slab with regularity, transformed logarithmic norm, and
defect all certified on the same Euclidean trial ball. -/
theorem field_bounds : FieldBounds previous row (${index} / 64) (euclideanFlow 0 1)
    (velocityJacobian 0 1) ballDomain := by
  apply DommaschkPhysicalTraceStep.field_bounds checked
  · intro t ht v hv
    obtain ⟨u,z⟩ := member ht hv
    let x := reference (${index} / 64) row t + moving previous row (${index} / 64) t v
    have hs : |128*t-${offset}| ≤ 1 := by simpa only [clock] using abs_coord_le ht
    have radial := enclose (c := ⟨[0],1/2⟩) hs u (by kernel_fact)
    have pos : 0 < x 0 := by
      change (⟨[0],1/2⟩ : Model).Mem (128*t-${offset}) (x 0-dkR0) at radial
      norm_num [Model.Mem, dkR0, abs_le] at radial
      linarith
    have den := ${jac}.denominator_pos (stop ▸ ht) u z
    exact ⟨pos,by simpa only [zero_add,one_mul,atPoint] using den.ne'⟩
  · intro t ht v hv w
    have ht' := Ico_subset_Icc_self ht
    obtain ⟨u,z⟩ := member ht' hv
    let x := reference (${index} / 64) row t + moving previous row (${index} / 64) t v
    have hj := ${jac}.physical_clock_log_norm (stop ▸ ht') u z w
    have eq := velocityJacobian_spatial 0 1 t x
    simp only [zero_add, one_mul, one_smul] at eq
    change ⟪w, Fields.LogNormTrajectory.MovingFrame.jacobian (velocityJacobian 0 1 t x) _ _ w⟫ ≤ _
    rw [eq]
    have hm : (${jac}.logNorm : ℝ) ≤ (row.mu : ℝ) :=
      Rat.cast_le.mpr ${jac}.fits_record
    have l : previous.frame = ${jac}.leftFrame := rfl
    have r : row.frame = ${jac}.rightFrame := rfl
    simpa only [x, moving, l, r, clock] using hj.trans (mul_le_mul_of_nonneg_right hm (sq_nonneg _))
  · intro t ht
    have h := Ico_subset_Icc_self ht
    apply residual_of_pulled ((Bool.and_eq_true_iff.mp checked).1) central h
    have fm : residualFrame previous row = ${central}.frame := by
      with_unfolding_all rfl
    have b : row.defect = ${central}.budget := rfl
    simpa only [clock, fm, b] using ${central}.physical_defect (stop ▸ h)

/-- The true field trajectory on this row with its inherited entrance,
checked exit ellipsoid, and uniform physical position error. -/
theorem physical_step :
    Fields.TrajectorySlabs.Step (euclideanFlow 0 1) (physicalSlab previous row (${index} / 64))
      (stateSet previous) (stateSet (next row)) := physical_step_ball checked field_bounds

end PlasmaLean.Design.${name}
