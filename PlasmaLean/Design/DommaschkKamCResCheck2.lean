set_option linter.style.longLine false in
/-- Proof-term check of the node `LU`: truncation norm. -/
theorem kH_LU : nodeKw 68553 16 SH NH MH WtH KvH trH_LU (340282366920938463463374607431768211456 : ℤ) 0 0 14 265 193 8 8 160 96 80 ≤  := by
  kron2_proof

