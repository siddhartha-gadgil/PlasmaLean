module

public import PlasmaLean.Design.RationalStellaratorGCEw1TreesH
public import PlasmaLean.Design.RationalStellaratorGCEw1KvSH

/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCEw1CheckH51`)

The checks of `Design/RationalStellaratorGCEw1CheckH51` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHE1`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCEw1LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `K2`. -/
theorem cHE1S_K2 : center3KS KvSHE1 NHE1 MHE1 63 120 73 55 25 11 8 10 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `K2`. -/
theorem clHE1_K2 : LHE1 63 < 2 ^ (120 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `Fv`: truncation norm. -/
theorem kHE1S_Fv : node3KS SHE1 NHE1 MHE1 DHE1 WtHE1 KvSHE1 trHE1N_Fv (2 : Int) 1 0 89 240 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `Fv`: a priori `ℓ¹` bound. -/
theorem lHE1_Fv : nodeL1N SHE1 LHE1 trHE1N_Fv (2 : Int) 1 0 89 < 2 ^ (240 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC
