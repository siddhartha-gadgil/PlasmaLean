  have eD : XHE4 c 96 = PolyExprS.eval (xB (xHE4 c 4) (xHE4 c 5)) (gcDM (16777217 / 4294967296 : ℝ) (lamF c)) := rfl
  have eN : XHE4 c 97 = PolyExprS.eval (xB (xHE4 c 4) (xHE4 c 5)) (gcNRM (16777217 / 4294967296 : ℝ) (lamF c)) := rfl
