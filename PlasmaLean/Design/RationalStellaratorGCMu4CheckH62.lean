/-!
# Low-memory kernel checks (`Design/RationalStellaratorGCMu4CheckH62`)

The checks of `Design/RationalStellaratorGCMu4CheckH62` in the low-memory format
(`Certificates/KronLowMemCompute`): each `k*S_*`, `c*S_*` theorem is one kernel evaluation of
`node3KS`, `norm3KS` or `center3KS` on the signed images `KvSHM`, with the original bound; the `ℓ¹`
checks are unchanged. `Design/RationalStellaratorGCMu4LowMemH` derives the original statements from
them. Light module. Generated by `scripts/gc_kam/lowmem/lowmem_emit.py`.
-/

@[expose] public section

-- check the theorems one at a time (bounded memory per process)
set_option Elab.async false

namespace PlasmaLean.Design.RationalStellaratorGC.Mu4

open PlasmaLean.Certificates.KronBallCheb PlasmaLean.Certificates.KronLowMem

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `LRx`. -/
theorem cHMS_LRx : center3KS KvSHM NHM MHM 6 221 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `LRx`. -/
theorem clHM_LRx : LHM 6 < 2 ^ (221 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the norm of the centre `thZ`. -/
theorem cHMS_thZ : center3KS KvSHM NHM MHM 9 125 73 55 25 11 1 73 36 27 ≤
     := by
  decide +kernel

/-- A priori `ℓ¹` bound of the centre `thZ`. -/
theorem clHM_thZ : LHM 9 < 2 ^ (125 - 1) := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Low-memory kernel check of the node `N2`: truncation norm. -/
theorem kHMS_N2 : node3KS SHM NHM MHM DHM WtHM KvSHM trHMN_N2 (1 : Int) 1 0 87 244 145 109 49 13 8 19 72 54 ≤
     := by
  decide +kernel

/-- Kernel check of the node `N2`: a priori `ℓ¹` bound. -/
theorem lHM_N2 : nodeL1N SHM LHM trHMN_N2 (1 : Int) 1 0 87 < 2 ^ (244 - 1) := by
  decide +kernel

end PlasmaLean.Design.RationalStellaratorGC.Mu4
